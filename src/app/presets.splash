// User-requested starter records, not fixture news or Agent conclusions.
// A separate receipt prevents restart, cancellation or removal from reseeding.
let presets_file = {path: "app_presets_v1.json" writable: true recovered: false revision: 0}
fn presets_valid(value){
    record_object(value) && value["schema_version"] == 1 && record_number(value["revision"])
        && value["applied"] == true && record_number(value["initialized_at"])
}
fn app_presets_initialize(){
    let receipt = tracking_store_read(presets_file, presets_valid)
    if receipt != nil { return "" }
    if !presets_file.writable && !presets_file.recovered { return "预设状态文件不可读，原文件已保留；未添加预设" }
    let initialized_at = time_now()
    let topic_id = "preset-agent-development-v1"
    let existing = topic_find(topic_id)
    if existing == nil {
        if topic_records.topics.len() >= tracking_config.max_topics { return "关注已达上限，未添加 Agent 预设" }
        let next = topic_records.to_json().parse_json()
        let topic = {topic_id: topic_id version: 1 original_input: "关注 Agent 领域发展" supplement: ""
            title: "Agent 领域发展（预设）" purpose: "" preferences: []
            recall_rules: [{kind: "keyword" value: "Agent"} {kind: "keyword" value: "智能体"}
                {kind: "keyword" value: "agentic"} {kind: "keyword" value: "智能代理"}]
            status: "active" created_at: initialized_at updated_at: initialized_at}
        topic["scope"] = ["Agent 框架与工具" "智能体能力和应用" "Agent 生态发展"]
        next.topics.push(topic)
        let error = topics_commit(next)
        if error != "" { return "Agent 预设未保存：" + error }
    } else { initialized_at = existing.created_at }
    let error = schedule_refresh()
    if error != "" { return "上海出差预设未保存：" + error }
    if schedule_find("preset-shanghai-trip-v1") == nil {
        if user_schedules.len() >= 128 { return "日程已达上限，未添加上海出差预设" }
        // Shanghai calendar date, fourteen days after the first installation.
        let date = schedule_date_at(initialized_at + (14 * 86400) + (8 * 3600))
        let next_date = schedule_date_at(schedule_instant(date + "T00:00:00Z") + 86400)
        let item = {schedule_id: "preset-shanghai-trip-v1" version: 1 title: "上海出差（预设）"
            content: "两周后去上海出差。具体起止时间、班次和返程待补充；当前全天范围仅用于当天相关新闻筛选。"
            location: "上海" start: date + "T00:00:00+08:00" end: next_date + "T00:00:00+08:00"
            timezone: "Asia/Shanghai" status: "active" allow_reschedule: false time_precision: "day"}
        let previous = user_schedules.to_json()
        user_schedules.push(item)
        error = schedule_write()
        if error != "" { user_schedules = previous.parse_json() return "上海出差预设未保存：" + error }
    }
    error = tracking_store_write(presets_file, {schema_version: 1 revision: 1 applied: true initialized_at: initialized_at}, presets_valid)
    if error != "" { return "预设已写入，但初始化状态未保存：" + error }
    ""
}
