// Application owns result publication, reminder decisions and version checks.
let tracking_recall_generation = 0
let tracking_recall_seconds = 0
let tracking_recall_targets = nil
let tracking_recall_candidates = nil
let tracking_prompt_work = nil
let tracking_started_at = 0 let tracking_enrichment_seconds = 0
let tracking_status = "idle"
let tracking_message = "确认你的意图后，检查相关变化与日程影响"
let tracking_auto_timer = nil
let tracking_check_pending = false
let tracking_pending_run = nil
let tracking_preparation_timer = nil
let tracking_preparation_info = {phase: "idle" scanned: 0 total: 0 ranked: 0 matched: 0}
let tracking_preparation_diagnostic_error = ""
let tracking_save_active = false let tracking_save_generation = 0 let tracking_save_work = nil
fn tracking_preparation_progress(generation, progress){
    if generation != tracking_recall_generation { return }
    tracking_preparation_info = progress
    // Bounded local diagnostics, without goals, schedules, titles or prompts.
    try { fs.write("tracking_preparation_v1.json", {generation: generation status: tracking_status phase: progress.phase
        scanned: progress.scanned total: progress.total ranked: progress.ranked matched: progress.matched
        elapsed_seconds: time_now() - tracking_started_at}.to_json()) }
    { tracking_preparation_diagnostic_error = "准备进度记录未保存" }
    if tracking_status == "recalling" {
        if progress.phase == "rank" { tracking_message = "正在排序相关新闻；已检查 " + progress.scanned + "/" + progress.total + " 条" }
        else { tracking_message = "正在寻找与你意图有关的新消息；已检查 " + progress.scanned + "/" + progress.total + " 条" }
        render_analysis_controls()
    }
}
fn tracking_preparation_clear(){
    if tracking_preparation_timer != nil { stop_timer(tracking_preparation_timer) tracking_preparation_timer = nil }
    if tracking_snapshot_work != nil { tracking_prepare_release(tracking_snapshot_work) }
}
fn tracking_preparation_arm(generation){
    tracking_preparation_timer = start_timeout(tracking_config.preparation_timeout_seconds, || {
        tracking_preparation_fail(generation, "failed", "准备超时（" + tracking_preparation_info.phase + "，已检查 " + tracking_preparation_info.scanned + "/" + tracking_preparation_info.total + " 条）；已结束本次检查", "timeout")
    })
}
fn tracking_preparation_fail(generation, status, message, category){
    if generation != tracking_recall_generation { return }
    if tracking_status != "recalling" && tracking_status != "enriching" { return }
    tracking_preparation_clear()
    tracking_recall_generation = tracking_recall_generation + 1 evidence_generation = evidence_generation + 1
    tracking_status = status tracking_message = message
    check_states_record_reason(tracking_recall_targets, "failed", category, false, message)
    tracking_ui_update()
}
fn tracking_preparation_current(generation, context_key){
    if generation != tracking_recall_generation { return false }
    if intent_open || context_key != tracking_context_key() {
        tracking_preparation_fail(generation, "stale", "关注或日程已变化，本次检查已停止；请按当前关注重新检查", "stale_context")
        return false
    }
    true
}
fn tracking_article_key(row){
    {title: row.title summary: row.summary source_url: row.source_url published_at: row.published_at
        timestamp_kind: row.timestamp_kind evidence_kind: row.evidence_kind}.to_json()
}
let tracking_merged_index_rows = nil
let tracking_merged_index = {}
fn tracking_current_row(id){
    let newest = analysis_current_row(id)
    if tracking_merged_index_rows != app_feed_rows {
        tracking_merged_index_rows = app_feed_rows
        tracking_merged_index = {}
        for row in app_feed_rows { tracking_merged_index[row.news_id] = row }
    }
    let row = tracking_merged_index[id]
    if row != nil {
        // Source callbacks may precede the asynchronous merged-feed build.
        if newest != nil { if tracking_article_key(newest) != tracking_article_key(row) { return newest } }
        return row
    }
    newest
}
fn tracking_snapshot_current(snapshot){ tracking_snapshot_current_in(snapshot, tracking_context_key()) }
fn tracking_snapshot_current_in(snapshot, context_key){
    if snapshot.context_key != context_key { return false }
    for topic in snapshot.topics {
        let current = topic_find(topic.topic_id)
        if current == nil { return false }
        if current.to_json() != topic.to_json() { return false }
    }
    for schedule in snapshot.schedules {
        let current = schedule_find(schedule.schedule_id)
        if current == nil { return false }
        if current.to_json() != schedule.to_json() { return false }
    }
    for evidence in snapshot.evidence {
        let row = tracking_current_row(evidence.news_id)
        if row == nil { return false }
        if tracking_evidence_key(row) != evidence.content_key || row.retrieved_at <= 0 || time_now() - row.retrieved_at > news_config.cache_stale_seconds { return false }
        if evidence["body_key"] != nil && evidence["body_key"] != "" {
            if record_number(evidence["body_retrieved_at"]) { if time_now() - evidence.body_retrieved_at > news_config.cache_stale_seconds { return false } }
            let article = analysis_article_find(row)
            // Eviction does not erase persisted evidence, but a newly fetched
            // different body invalidates old advice before confirmation.
            if article != nil { if article.body_key != evidence.body_key { return false } }
        }
    }
    true
}
fn tracking_run_current(run){
    if run.snapshot.prompt_revision != tracking_prompt_revision { return false }
    tracking_snapshot_current(run.snapshot)
}
fn tracking_latest_item(row){
    let value = tracking_current_values()[row.news_id]
    if value == nil { return nil }
    let evidence = tracking_find(value.run.snapshot.evidence, "news_id", row.news_id)
    if evidence == nil { return nil }
    if tracking_evidence_key(row) != evidence.content_key { return nil }
    value
}
fn tracking_reminder_id(impact){
    "reminder:" + {schedule_id: impact["schedule_id"] goal_key: impact.goal_key}.to_json()
}
fn tracking_reminder(item, impact, run){
    let evidence = []
    for id in impact.evidence_ids {
        let source = tracking_find(run.snapshot.evidence, "news_id", id)
        evidence.push({news_id: id key: source.content_key})
    }
    {reminder_id: tracking_reminder_id(impact) goal_key: impact.goal_key schedule_id: impact["schedule_id"]
        schedule_version: impact.schedule_version event_start: impact.event_start event_end: impact.event_end overlap_reason: impact.overlap_reason news_id: item.news_id impact_summary: impact.impact_summary
        uncertainties: impact.uncertainties material_change: impact.material_change evidence: evidence run: run}
}
fn tracking_evidence_facts(key){
    let value = nil try { value = key.parse_json() } { return nil }
    if !record_object(value) { return nil }
    if !record_string(value["title"]) || !record_string(value["summary"]) { return nil }
    {title: value["title"] summary: value["summary"]}.to_json()
}
fn tracking_reminder_suppressed(reminder){
    for decision in topic_records.decisions {
        if decision["kind"] == "insight" { continue }
        if decision.reminder_id == reminder.reminder_id {
            if decision.evidence.to_json() == reminder.evidence.to_json() { return true }
            if reminder.material_change.trim() == "" { return true }
            // Provenance/date changes invalidate a result, but repeated text
            // from another URL is not by itself new supporting facts.
            let new_facts = false
            for evidence in reminder.evidence {
                let facts = tracking_evidence_facts(evidence.key)
                if facts == nil { return true }
                let repeated = false
                for old in decision.evidence { if tracking_evidence_facts(old.key) == facts { repeated = true } }
                if !repeated { new_facts = true }
            }
            if !new_facts { return true }
        }
    }
    false
}
fn tracking_item_reminders(value){
    let out = []
    if value == nil { return out }
    for impact in value.item.schedule_impacts {
        let item = schedule_find(impact["schedule_id"])
        if item != nil {
            if schedule_active(item) && item.version == impact.schedule_version && schedule_instant(item.end) >= time_now() {
                let reminder = tracking_reminder(value.item, impact, value.run)
                if !tracking_reminder_suppressed(reminder) { out.push(reminder) }
            }
        }
    }
    out
}
let tracking_display_values_cache = nil
let tracking_display_work = nil
fn tracking_display_key(){
    let runs = [] for run in tracking_cache.runs { runs.push(run["task_id"]) }
    tracking_context_key() + ":" + feed_data_revision + ":" + topic_records.revision + ":" + tracking_cache.revision + ":" + analysis_articles_revision + ":" + runs.to_json()
}
fn tracking_current_values(){
    if tracking_cache.runs.len() == 0 { tracking_display_work = nil return {} }
    let key = tracking_display_key()
    let cached = tracking_display_values_cache
    if cached != nil && cached.key == key && cached.rows == app_feed_rows && time_now() < cached.expires_at { return cached.values }
    if tracking_display_work == nil || tracking_display_work.key != key || tracking_display_work.rows != app_feed_rows {
        let work = {key: key rows: app_feed_rows runs: tracking_cache.runs index: tracking_cache.runs.len() - 1
            context_key: tracking_context_key() values: {} covered: {} expires_at: time_now() + news_config.cache_stale_seconds
            run: nil phase: "validate" current: false item_index: 0}
        tracking_display_work = work
        start_timeout(0.01, || tracking_display_step(work))
    }
    // Discard stale badges during recovery. Browsing does not wait for these
    // optional annotations, and write actions retain their strict live guard.
    {}
}
fn tracking_display_step(work){
    if tracking_display_work != work { return }
    if work.key != tracking_display_key() || work.rows != app_feed_rows { tracking_display_work = nil return }
    mod.gc.run()
    if work.index < 0 && work.run == nil {
        tracking_display_values_cache = {key: work.key rows: work.rows expires_at: work.expires_at values: work.values}
        tracking_display_work = nil
        start_timeout(0.01, || tracking_ui_update())
        return
    }
    if work.run == nil {
        work.run = work.runs[work.index] work.index = work.index - 1
        work.phase = "validate" work.current = false work.item_index = 0
    }
    // Validation and projection must not share the native 64 ms entry.
    // Queue the next slice first; a lost read-only annotation cannot block news.
    start_timeout(0.01, || tracking_display_step(work))
    let run = work.run
    if work.phase == "validate" {
        work.phase = "items"
        work.current = run.snapshot.prompt_revision == tracking_prompt_revision && tracking_snapshot_current_in(run.snapshot, work.context_key)
        return
    }
    if work.item_index < run.result.items.len() {
        let item = run.result.items[work.item_index] work.item_index = work.item_index + 1
        tracking_display_add_item(work, run, item, work.current)
        return
    }
    if work.current {
        for e in run.snapshot.evidence {
            let row = tracking_current_row(e.news_id)
            if row != nil { work.expires_at = min(work.expires_at, row.retrieved_at + news_config.cache_stale_seconds) }
            if record_number(e["body_retrieved_at"]) { work.expires_at = min(work.expires_at, e.body_retrieved_at + news_config.cache_stale_seconds) }
        }
    }
    work.run = nil
}
fn tracking_display_add_item(work, run, item, current){
    let values = work.values let covered = work.covered
    let remaining = {} let follow_remaining = {} let any = false
    for topic in run.snapshot.topics {
        let key = item.news_id + ":topic:" + topic.topic_id
        if covered[key] != true { remaining[topic.topic_id] = true follow_remaining["topic:" + topic.topic_id] = true any = true } covered[key] = true
    }
    for interest in run.snapshot.legacy_interests {
        let key = item.news_id + ":interest:" + interest.interest_id
        if covered[key] != true { remaining[interest.interest_id] = true follow_remaining["interest:" + interest.interest_id] = true any = true } covered[key] = true
    }
    for schedule in run.snapshot.schedules {
        let key = item.news_id + ":schedule:" + schedule.schedule_id
        if covered[key] != true { remaining[schedule.schedule_id] = true any = true } covered[key] = true
    }
    if !any || !current { return }
    // A later check of another target cannot erase a known relationship.
    let candidate = item.to_json().parse_json()
    candidate.topic_ids.retain(|id| remaining[id] == true)
    candidate.legacy_interest_ids.retain(|id| remaining[id] == true)
    candidate.schedule_impacts.retain(|impact| remaining[impact["schedule_id"]] == true)
    if candidate.relevance == "related" && candidate.topic_ids.len() + candidate.legacy_interest_ids.len() == 0 { candidate.relevance = "unrelated" }
    // A missing key means this target has not been checked. Negative judgments
    // are retained separately from whichever item supplies a schedule reminder.
    let judgments = {} let reason = ""
    for topic in run.snapshot.topics {
        if follow_remaining["topic:" + topic.topic_id] == true {
            let related = candidate.relevance == "related" && record_contains(candidate.topic_ids, topic.topic_id)
            judgments["topic:" + topic.topic_id] = related
            if related { reason = candidate.why_related }
        }
    }
    for interest in run.snapshot.legacy_interests {
        if follow_remaining["interest:" + interest.interest_id] == true {
            let related = candidate.relevance == "related" && record_contains(candidate.legacy_interest_ids, interest.interest_id)
            judgments["interest:" + interest.interest_id] = related
            if related { reason = candidate.why_related }
        }
    }
    let value = {item: candidate run: run follow_judgments: judgments follow_why_related: reason}
    let existing = values[item.news_id]
    if existing == nil { values[item.news_id] = value return }
    if record_object(existing["follow_judgments"]) {
        for key judgment in existing.follow_judgments { judgments[key] = judgment }
    }
    if record_string(existing["follow_why_related"]) && existing.follow_why_related != "" { reason = existing.follow_why_related }
    value.follow_why_related = reason
    existing.follow_judgments = judgments existing.follow_why_related = reason
    if tracking_item_reminders(existing).len() == 0 {
        if tracking_item_reminders(value).len() > 0 || (existing.item.relevance != "related" && value.item.relevance == "related") { values[item.news_id] = value }
    }
}
fn tracking_active_reminders(){
    let reminders = [] let seen = {}
    for value in tracking_current_values() {
        for reminder in tracking_item_reminders(value) {
            if seen[reminder.reminder_id] != true { reminders.push(reminder) seen[reminder.reminder_id] = true }
        }
    }
    reminders
}
fn tracking_find_reminder(id){ for item in tracking_active_reminders() { if item.reminder_id == id { return item } } nil }
fn tracking_check_reminder(reminder){
    if !tracking_run_current(reminder.run) { return "提醒已过期，关注或依据已变化，请重新检查" }
    let error = schedule_refresh()
    if error != "" { return error }
    let schedule = schedule_find(reminder.schedule_id)
    if schedule == nil { return "日程已不存在" }
    if !schedule_active(schedule) || schedule.version != reminder.schedule_version { return "日程版本已变化，请重新检查" }
    if tracking_reminder_suppressed(reminder) { return "提醒已有决定，请刷新详情" }
    // Check persisted evidence using the existing cache boundary, not model text.
    let versions = []
    for item in reminder.evidence {
        let row = tracking_current_row(item.news_id)
        if row == nil { return "依据已离开列表，请刷新" }
        versions.push(history_evidence_version(row))
    }
    history_revalidate_evidence({interest_ids: [] evidence_versions: versions})
}
fn tracking_decision(reminder, state){
    {reminder_id: reminder.reminder_id goal_key: reminder.goal_key schedule_id: reminder.schedule_id
        schedule_version: reminder.schedule_version state: state decided_at: time_now() evidence: reminder.evidence}
}
fn tracking_dismiss(id){
    let reminder = tracking_find_reminder(id)
    if reminder == nil { notice("提醒已过期或已有决定") return }
    let error = tracking_check_reminder(reminder)
    if error == "" {
        let next = topic_records.to_json().parse_json()
        if next.decisions.len() >= tracking_config.max_decisions { error = "决定记录已达上限，未保存" }
        else { next.decisions.push(tracking_decision(reminder, "dismissed")) error = topics_commit(next) }
    }
    if error == "" { notice("已忽略；相同证据不再提醒") } else { notice(error) }
    tracking_ui_update() tracking_schedule_check()
}
fn tracking_publish(snapshot, key, result, task_id){
    if !tracking_snapshot_current(snapshot) { return "结果已过期，未保存" }
    for old in tracking_cache.runs { if old.task_id == task_id { return "" } }
    let next = tracking_cache.to_json().parse_json()
    next.revision = tracking_cache.revision + 1
    let run = {task_id: task_id checked_at: time_now() input_key: key snapshot: snapshot result: result}
    next.runs.push(run)
    while next.runs.len() > tracking_config.max_runs { next.runs.remove(0) }
    let error = tracking_store_write(tracking_cache_file, next, tracking_cache_valid)
    if error == "" { tracking_cache = next tracking_pending_run = nil }
    else { tracking_pending_run = run }
    error
}
fn tracking_retry_save(){
    if tracking_pending_run == nil || tracking_in_progress() { return }
    let run = tracking_pending_run
    tracking_status = "publishing" tracking_message = "正在重试保存结果…"
    tracking_publish_async(run, || tracking_snapshot_current(run.snapshot), fn(error){
        tracking_publication_apply(run, error, nil)
    })
    tracking_ui_update()
}
fn tracking_publish_async(run, current, complete){
    tracking_pending_run = run tracking_save_active = true tracking_save_generation = tracking_save_generation + 1
    let work = {run: run current: current complete: complete generation: tracking_save_generation prepared: false done: false timer: nil}
    tracking_save_work = work
    start_timeout(0.01, || tracking_publish_prepare(work))
    // Covers an interruption before the storage owner has created its timer.
    work.timer = start_timeout(tracking_config.publication_timeout_seconds, || {
        tracking_publish_finish(work, "保存未完成，结果保留，可重试保存", nil)
    })
}
fn tracking_publish_finish(work, error, next){
    if work.done || work.generation != tracking_save_generation { return }
    work.done = true tracking_save_active = false
    if work.timer != nil { stop_timer(work.timer) work.timer = nil }
    if error == "" { tracking_cache = next tracking_pending_run = nil }
    let complete = work.complete
    work.current = nil work.complete = nil work.run = nil
    tracking_save_work = nil
    start_timeout(0.01, || complete(error))
}
fn tracking_cancel_save(){
    if tracking_save_work == nil || !tracking_save_active { return }
    tracking_publish_finish(tracking_save_work, "保存已停止，结果保留，可重试保存", nil)
}
fn tracking_publish_prepare(work){
    if work.done || work.prepared || work.generation != tracking_save_generation { return }
    start_timeout(0.01, || tracking_publish_prepare(work))
    mod.gc.run()
    if !work.current() { tracking_publish_finish(work, "结果已过期或保存已停止，未保存", nil) return }
    for old in tracking_cache.runs {
        if old.task_id == work.run.task_id {
            if old.input_key != work.run.input_key || old.result.to_json() != work.run.result.to_json() { tracking_publish_finish(work, "已有同任务的不同结果，未覆盖", nil) }
            else { tracking_publish_cache(work, tracking_cache) }
            return
        }
    }
    // Stored runs are immutable. Copy the collection, avoiding a deep JSON
    // clone of twelve complete snapshots in the same callback.
    let runs = [] for old in tracking_cache.runs { runs.push(old) } runs.push(work.run)
    while runs.len() > tracking_config.max_runs { runs.remove(0) }
    let next = {schema_version: 1 revision: tracking_cache.revision + 1 runs: runs}
    tracking_publish_cache(work, next)
}
fn tracking_publish_cache(work, next){
    work.prepared = true
    tracking_cache_save(next, || !work.done && work.generation == tracking_save_generation && work.current(), fn(error){
        tracking_publish_finish(work, error, next)
    })
}
fn tracking_publication_apply(run, error, acknowledged){
    let saved = error == ""
    if saved { tracking_status = run.result.outcome tracking_message = run.result.explanation }
    else { tracking_status = "failed" tracking_message = error }
    analysis_state = if saved {"succeeded"} else {"failed"}
    analysis_error = error analysis_error_category = if saved {""} else {"storage_error"}
    // Release the task only after verified persistence and domain state update.
    if acknowledged != nil { acknowledged(saved, error, analysis_error_category) }
    let generation = tracking_save_generation
    let message = tracking_message
    start_timeout(0.01, || {
        if generation != tracking_save_generation { return }
        check_states_record_reason(run.snapshot, if saved {"checked"} else {"failed"}, if saved {""} else {"storage_error"}, saved, message)
    })
    start_timeout(0.01, || tracking_ui_update())
}
fn tracking_prompt_base(snapshot){
    // Copy only context the model uses, without cloning bodies, fingerprints,
    // full prior results or user fact records merely to delete them afterwards.
    let base = {schema_version: snapshot.schema_version topics: snapshot.topics schedules: snapshot.schedules
        legacy_interests: snapshot.legacy_interests evidence: [] previous_result: nil decisions: []
        omitted_targets: snapshot.omitted_targets omitted_candidates: snapshot.omitted_candidates
        omitted_decisions: snapshot.omitted_decisions context_key: nil prompt_revision: snapshot.prompt_revision
        previous_by_target: [] check_scope: snapshot["check_scope"]}
    let payload = base.to_json().parse_json()
    for topic in payload.topics {
        topic.original_input = nil topic.supplement = nil topic.recall_rules = nil
        topic.created_at = nil topic.updated_at = nil
    }
    payload.reference_format = "evidence-labels-v1"
    if tracking_uses_quote_choices(snapshot.prompt_revision) { payload.quote_format = "paragraph-choices-v1" }
    payload.reschedule_enabled = tracking_config.enable_reschedule_proposals
    return payload
}
fn tracking_prompt_evidence(evidence, index, revision){
    let ids = [] let paragraphs = []
    if record_array(evidence["paragraphs"]) {
        for paragraph in evidence.paragraphs {
            ids.push(paragraph.paragraph_id)
            if tracking_uses_quote_choices(revision) {
                paragraphs.push({paragraph_id: paragraph.paragraph_id quote_choices: tracking_quote_choices(paragraph)})
            } else { paragraphs.push(paragraph.to_json().parse_json()) }
        }
        nil
    }
    return {news_id: "E" + (index + 1) title: evidence.title summary: evidence.summary
        source_url: evidence.source_url published_at: evidence.published_at timestamp_kind: evidence.timestamp_kind
        summary_truncated: evidence.summary_truncated paragraphs: paragraphs allowed_paragraph_ids: ids
        can_quote_body: ids.len() > 0 available_evidence: if ids.len() > 0 {"body_excerpt"} else {if evidence.summary.trim() != "" {"title_summary"} else {"title_only"}}
        body_error: evidence["body_error"] body_truncated: evidence["body_truncated"]}
}
fn tracking_prompt_previous(previous){
    let projected = previous.to_json().parse_json()
    for insight in projected.insights {
        insight.summary_truncated = insight.summary.to_chars().len() > 250
        insight.summary = bm25_prefix(insight.summary, 250)
        insight.uncertainties = nil insight.evidence_refs = nil insight.next_step = nil insight.reschedule = nil
        insight.evidence_ids = nil
    }
    return projected
}
fn tracking_prompt_decision(d){
    if d["kind"] == "insight" {
        let excerpt = "" if d.evidence_facts.len() > 0 { excerpt = bm25_prefix(d.evidence_facts[0], 800) }
        return {kind: d.kind target_type: d.target_type target_id: d.target_id target_version: d.target_version
            issue_key: d.issue_key state: d.state decided_at: d.decided_at baseline_excerpt: excerpt
            baseline_truncated: true evidence_facts: nil}
    }
    return {reminder_id: d.reminder_id goal_key: d.goal_key schedule_id: d.schedule_id schedule_version: d.schedule_version
        state: d.state decided_at: d.decided_at evidence: nil}
}
fn tracking_decision_issue(d){
    if d["kind"] == "insight" { return d.target_type + ":" + d.target_id + ":" + d.target_version + ":" + d.issue_key }
    d["reminder_id"]
}
fn tracking_prompt_snapshot(snapshot){
    let payload = tracking_prompt_base(snapshot)
    for i evidence in snapshot.evidence { payload.evidence.push(tracking_prompt_evidence(evidence, i, snapshot.prompt_revision)) }
    for previous in snapshot.previous_by_target { payload.previous_by_target.push(tracking_prompt_previous(previous)) }
    let seen = {}
    for i in snapshot.decisions.len() {
        let d = snapshot.decisions[snapshot.decisions.len() - 1 - i]
        let issue = tracking_decision_issue(d)
        if seen[issue] == true { continue } seen[issue] = true
        payload.decisions.push(tracking_prompt_decision(d))
    }
    tracking_prompt_work = payload
    return payload
}

fn tracking_start(row, verification = nil, target_override = nil){
    if tracking_in_progress() || octos_testing || analysis_needs_reopen { tracking_message = "助手忙碌或中断未确认，请稍后重试" tracking_ui_update() return }
    if busy { tracking_message = "新闻正在更新，整轮结束后再检查" tracking_ui_update() return }
    let targets = tracking_targets()
    if target_override != nil { targets = target_override }
    if verification != nil {
        if !tracking_run_current(verification.run) { notice("目标或依据已变化，请重新检查关注更新") return }
        targets = {topics: verification.run.snapshot.topics schedules: verification.run.snapshot.schedules
            legacy_interests: verification.run.snapshot.legacy_interests omitted_targets: verification.run.snapshot.omitted_targets}
    }
    tracking_recall_targets = targets
    if targets.topics.len() + targets.schedules.len() + targets.legacy_interests.len() == 0 { tracking_status = "no_targets" tracking_message = "先保存关注或有效日程" tracking_ui_update() return }
    let rows = app_feed_rows if row != nil { rows = [row] }
    let verification_ids = []
    if verification != nil {
        rows = []
        for old in verification.run.snapshot.evidence { let found = tracking_current_row(old.news_id) if found != nil { rows.push(found) } }
        for id in verification.insight.evidence_ids {
            let old = tracking_find(verification.run.snapshot.evidence, "news_id", id)
            if old != nil && old.paragraphs.len() == 0 && verification_ids.len() < tracking_config.max_evidence_requests { verification_ids.push(id) }
        }
        // Explicit user retry can bypass the short failed-read cooldown.
        for id in verification_ids { analysis_articles.retain(|entry| entry.news_id != id) }
        if verification_ids.len() > 0 { analysis_articles_revision = analysis_articles_revision + 1 }
    }
    tracking_recall_generation = tracking_recall_generation + 1
    let generation = tracking_recall_generation
    let context_key = tracking_context_key()
    let started = time_now()
    tracking_started_at = started tracking_enrichment_seconds = 0
    tracking_status = "recalling" tracking_message = "正在寻找与你意图有关的新消息…"
    check_states_record(targets, "pending", "", false)
    tracking_preparation_clear()
    tracking_preparation_arm(generation)
    tracking_preparation_progress(generation, {phase: "terms" scanned: 0 total: rows.len() ranked: 0 matched: 0})
    bm25_recall(rows, targets, || tracking_preparation_current(generation, context_key), fn(candidates){
        tracking_recall_candidates = candidates
        tracking_recall_seconds = time_now() - started
        tracking_status = "enriching" tracking_message = "正在读取来源已提供的正文，并补充最多两篇相关网页"
        tracking_preparation_progress(generation, {phase: "evidence" scanned: rows.len() total: rows.len() ranked: candidates.rows.len() matched: candidates.matched})
        tracking_ui_update()
        let enrichment_started = time_now()
        let enrich_rows = evidence_select(candidates.rows, tracking_recall_targets, row != nil || verification != nil)
        if verification != nil {
            let preferred = [] let seen = {}
            for id in verification_ids { let candidate = tracking_find(candidates.rows, "news_id", id) if candidate != nil { preferred.push(candidate) seen[id] = true } }
            for candidate in enrich_rows { if seen[candidate.news_id] != true { preferred.push(candidate) } }
            enrich_rows = preferred
        }
        evidence_enrich(enrich_rows, || tracking_preparation_current(generation, context_key), || {
            tracking_enrichment_seconds = time_now() - enrichment_started
            tracking_preparation_progress(generation, {phase: "snapshot" scanned: rows.len() total: rows.len() ranked: candidates.rows.len() matched: candidates.matched})
            tracking_start_candidates(tracking_recall_candidates, tracking_recall_targets, verification != nil)
        })
    }, fn(progress){ tracking_preparation_progress(generation, progress) })
    tracking_ui_update()
}
fn tracking_start_candidates(candidates, targets, verification = false){
    if analysis_busy || octos_testing || analysis_needs_reopen {
        tracking_preparation_clear()
        tracking_status = "failed" tracking_message = "助手忙碌或中断未确认，本次检查已结束，请稍后重试"
        check_states_record_reason(targets, "failed", "service_unavailable", false, tracking_message)
        tracking_ui_update() return
    }
    if candidates.rows.len() == 0 {
        tracking_preparation_clear()
        tracking_status = "no_candidates" tracking_message = "无候选新闻，本次未调用助手"
        if targets.topics.len() > 0 { tracking_message = "本轮标题未发现匹配候选，未调用助手；可刷新新闻或调整关注关键词，不能据此断言没有新动态" }
        if candidates.expired > 0 { tracking_status = "stale" tracking_message = "候选证据已过期，请刷新来源" }
        check_states_record(targets, if candidates.expired > 0 {"failed"} else {"no_candidates"}, if candidates.expired > 0 {"stale_evidence"} else {""}, candidates.expired == 0)
        tracking_ui_update() return
    }
    // Keep the existing direct candidate entry useful to bounded callers; the
    // full recall path is already enriching with its original deadline armed.
    if tracking_status != "enriching" {
        tracking_preparation_clear()
        tracking_recall_generation = tracking_recall_generation + 1
        tracking_recall_targets = targets tracking_started_at = time_now()
        tracking_status = "enriching"
        tracking_preparation_arm(tracking_recall_generation)
        tracking_preparation_progress(tracking_recall_generation, {phase: "snapshot" scanned: candidates.rows.len() total: candidates.rows.len() ranked: candidates.rows.len() matched: candidates.matched})
    }
    tracking_prepare_candidates(candidates, targets, verification)
}
fn tracking_dispatch_snapshot(snapshot, payload, key, decision_key, prompt){
    let error = agent_task_start("tracking_update", snapshot, prompt, || {
        if !tracking_snapshot_current(snapshot) { return false }
        topic_records.decisions.to_json() == decision_key
    }, fn(reply, acknowledged = nil){
        let completed_snapshot = snapshot
        if reply["snapshot"] != nil && agent_task != nil && agent_task.id == reply.task_id && agent_task.snapshot == reply.snapshot { completed_snapshot = reply.snapshot }
        let completed_key = key
        if completed_snapshot != snapshot { completed_key = tracking_input_key(completed_snapshot) }
        if !reply.success {
            if reply.result != nil && (tracking_pending_run == nil || tracking_pending_run.task_id != reply.task_id) {
                tracking_pending_run = {task_id: reply.task_id checked_at: time_now() input_key: completed_key snapshot: completed_snapshot result: reply.result}
            }
            tracking_save_active = false
            tracking_status = "failed"
            if reply.category == "stale_context" { tracking_status = "stale" }
            if reply.category == "cancelled" { tracking_status = "cancelled" notice(reply.error) }
            else { notice("追踪检查失败：" + reply.error) }
            tracking_message = reply.error
        }
        else {
            tracking_status = "publishing"
            let run = {task_id: reply.task_id checked_at: time_now() input_key: completed_key snapshot: completed_snapshot result: reply.result}
            let publication_current = || agent_task != nil && agent_task.id == reply.task_id && agent_task.publication_pending && tracking_snapshot_current(snapshot) && tracking_snapshot_current(completed_snapshot) && topic_records.decisions.to_json() == decision_key
            tracking_publish_async(run, publication_current, fn(error){
                if agent_task == nil { return }
                if agent_task.id != reply.task_id || !agent_task.publication_pending { return }
                tracking_publication_apply(run, error, acknowledged)
            })
            return
        }
        check_states_record_reason(completed_snapshot, if reply.success && tracking_pending_run == nil {"checked"} else {"failed"}, analysis_error_category, reply.success && tracking_pending_run == nil, if reply.success {tracking_message} else {reply.error})
        tracking_ui_update()
    }, true)
    // Keep the preparation continuation alive until the Agent owner has
    // accepted the task. A fresh handoff entry performs no full-evidence scan.
    tracking_preparation_clear()
    if error != "" { tracking_status = "failed" tracking_message = error }
    else if analysis_busy {
        tracking_status = "running" tracking_message = "正在检查 " + snapshot.evidence.len() + " 条候选；未覆盖目标 " + snapshot.omitted_targets + "，候选 " + snapshot.omitted_candidates
    }
    tracking_ui_update()
}
fn tracking_schedule_check(){
    if follow_check_running { return }
    if agent_preferences.paused { return }
    tracking_check_pending = true
    if tracking_auto_timer != nil { stop_timer(tracking_auto_timer) }
    tracking_auto_timer = start_timeout(tracking_config.auto_check_delay_seconds, || {
        tracking_auto_timer = nil
        if follow_check_running || busy || tracking_in_progress() || octos_testing || analysis_needs_reopen || intent_open || reader_summary.state == "running" { return }
        tracking_check_pending = false
        tracking_start(nil)
    })
}
fn tracking_ui_update(){
    render_feed() render_analysis_controls()
    if detail_kind == "story" { ui.story_content.render() }
    if page == "tracking" && tracking_section == "suggestions" && detail_kind == "" { ui.results_content.render() }
    if page == "tracking" && tracking_section == "topics" && detail_kind == "" { follow_render() }
    if detail_kind == "tracking" { ui.interest_list.render() ui.continuous_controls.render() }
    if detail_kind == "intent" { intent_render() }
}
fn tracking_in_progress(){ analysis_busy || tracking_save_active || tracking_status == "publishing" || tracking_status == "recalling" || tracking_status == "enriching" }
