// Request limits apply to one refresh; storage limits apply to domain records.
let news_config = {request_timeout_seconds: 15 max_parallel_requests: 3
    max_response_bytes: 2000000 max_redirects: 3 items_per_source: 20
    max_feed_items: 240 work_batch_items: 64 work_slice_seconds: 0.008 feed_hint_batch_items: 4
    max_bookmarks: 500 max_interests: 50 max_seen_ids: 2000
    startup_refresh_seconds: 300 cache_stale_seconds: 7200
    refresh_gesture_cooldown_seconds: 2 overlay_tap_guard_seconds: 0.2}
// One Agent, bounded lexical recall. Limits are conservative for the 32 MiB VM.
let tracking_config = {max_topics: 20 max_targets: 2 max_schedules: 8 max_candidates: 8 max_rules: 6
    bm25_k1: 1.2 bm25_b: 0.75 max_bm25_terms: 24 bm25_batch_items: 2 max_bm25_body_chars: 1800
    max_input_chars: 1000 max_prompt_bytes: 32000 max_summary_chars: 1200 max_runs: 12 max_decisions: 200
    request_timeout_seconds: 90 interrupt_timeout_seconds: 10 auto_check_delay_seconds: 0.3}
