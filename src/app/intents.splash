// Draft edits never overwrite a confirmed topic. Parsing cannot save a topic.
let intent_open = false
let intent_draft = nil
let intent_error = ""
let intent_save_timer = nil
let intent_parse_pending = false
let intent_more = false
fn intent_mode(){
    if intent_draft == nil || intent_draft["intent_kind"] == nil { return "news" }
    return intent_draft.intent_kind
}
fn intent_render(){ if detail_kind == "intent" && intent_scene_ready { ui.intent_content.render() } }
fn intent_copy_as_new(draft){
    let next = topic_new_draft(nil)
    next.original_input = draft.original_input next.supplement = draft.supplement
    next.intent_kind = draft.intent_kind next.schedule_timezone = draft.schedule_timezone
    next
}
fn intent_begin(topic_id){
    if tracking_status == "recalling" || tracking_status == "enriching" { analysis_cancel() }
    tracking_recall_generation = tracking_recall_generation + 1
    notice("")
    intent_error = ""
    if topic_id == nil && topic_records.draft != nil { intent_draft = topic_records.draft.to_json().parse_json() }
    else { intent_draft = topic_new_draft(topic_id) }
    if topic_id == nil && intent_draft.target_topic_id != nil {
        let target = topic_find(intent_draft.target_topic_id)
        if target == nil || target.status == "cancelled" {
            intent_draft = intent_copy_as_new(intent_draft)
            intent_error = "原关注已取消或不存在，已保留输入并转为新建关注。"
        }
    }
    intent_more = intent_draft.supplement != "" || intent_draft.question != ""
    intent_show()
}
fn intent_as_new(){
    if analysis_busy { intent_error = "请先取消或等待当前整理，再转为新建关注。" intent_render() return }
    intent_draft = intent_copy_as_new(intent_draft)
    intent_error = intent_save_local()
    intent_render()
}
fn intent_reload_target(){
    if analysis_busy || intent_draft == nil { return }
    let target = topic_find(intent_draft.target_topic_id)
    if target == nil || target.status == "cancelled" { intent_as_new() return }
    intent_draft.target_version = target.version
    intent_invalidate()
    intent_error = "已加载原关注的最新版本，保留了你的输入；请重新整理并确认。"
    intent_render()
}
fn intent_pick_mode(kind){
    if intent_mode() == kind { return }
    if kind == "schedule" && (intent_draft.target_topic_id != nil || intent_draft.origin_reminder_id != nil) { return }
    intent_draft.intent_kind = kind intent_draft.question = ""
    intent_invalidate()
    intent_error = "" intent_render()
}
fn intent_pick_timezone(zone){
    if intent_draft.schedule_timezone == zone { return }
    intent_draft.schedule_timezone = zone
    intent_invalidate()
    intent_error = "" intent_render()
}
fn intent_changed(value, supplement){
    if intent_draft == nil { return }
    if value.to_chars().len() > tracking_config.max_input_chars { intent_error = "输入最多1000字符；超出内容未保存" return }
    // Reapplying an input must not invalidate the in-flight request or preview.
    if supplement { if value == intent_draft.supplement { return } }
    else { if value == intent_draft.original_input { return } }
    if supplement { intent_draft.supplement = value } else { intent_draft.original_input = value }
    intent_invalidate()
}
fn intent_invalidate(){
    intent_draft.version = intent_draft.version + 1 intent_draft.state = "editing" intent_draft.understanding = nil
    intent_draft.schedule_understanding = nil
    if intent_save_timer != nil { stop_timer(intent_save_timer) }
    let version = intent_draft.version
    intent_save_timer = start_timeout(0.4, || {
        intent_save_timer = nil
        if intent_draft != nil { if version == intent_draft.version { intent_error = topic_save_draft(intent_draft) if intent_error != "" { intent_render() } } }
    })
}
fn intent_request_context_error(draft){
    let reason = ""
    if intent_draft == nil || !intent_open { reason = "输入面板已关闭或草稿已丢弃" }
    else if intent_draft.draft_id != draft.draft_id { reason = "已切换到另一份草稿" }
    else if intent_draft.intent_kind != draft.intent_kind { reason = "已切换输入类型" }
    else if intent_draft.original_input != draft.original_input { reason = "输入文字已修改" }
    else if intent_draft.supplement != draft.supplement { reason = "补充内容已修改" }
    else if intent_draft.schedule_timezone != draft.schedule_timezone { reason = "日程时区已修改" }
    else if intent_draft.version != draft.version { reason = "草稿已重新编辑" }
    else if intent_draft.target_topic_id != draft.target_topic_id || intent_draft.target_version != draft.target_version { reason = "正在修改的关注已切换" }
    else if draft.target_topic_id != nil {
        let target = topic_find(draft.target_topic_id)
        if target == nil { reason = "原关注已不存在" }
        else if target.status == "cancelled" { reason = "原关注已取消" }
        else if target.version != draft.target_version { reason = "原关注版本已更新" }
    }
    if reason == "" { return "" }
    let record = "关注"
    if draft.intent_kind == "schedule" { record = "日程" }
    reason + "，本次结果未采用；未新增或修改" + record + "。请按当前输入重新整理。"
}
fn intent_save_local(){
    if intent_save_timer != nil { stop_timer(intent_save_timer) intent_save_timer = nil }
    if intent_draft == nil { return "" }
    topic_save_draft(intent_draft)
}
fn intent_submit(){
    if intent_draft == nil { return }
    intent_error = ""
    if intent_draft.original_input.trim() == "" { intent_error = "写下一个想法，让我们从这里开始" intent_render() return }
    let context_error = intent_request_context_error(intent_draft)
    if context_error != "" { intent_error = context_error intent_render() return }
    let error = intent_save_local()
    if error != "" { intent_error = error intent_render() return }
    // User input takes priority; wait for the host's interrupt acknowledgment.
    if analysis_busy {
        if agent_task != nil {
            if agent_task.kind == "tracking_update" { intent_parse_pending = true analysis_cancel() intent_error = "正在停止新闻检查，确认中断后整理输入" intent_render() return }
        }
        intent_error = "已有输入正在整理，请先取消或等待" intent_render() return
    }
    let draft = intent_draft.to_json().parse_json()
    let current_topic = topic_find(draft.target_topic_id)
    if current_topic != nil {
        current_topic = current_topic.to_json().parse_json()
        current_topic.original_input = nil current_topic.supplement = nil
        current_topic.created_at = nil current_topic.updated_at = nil current_topic.recall_rules = nil
    }
    let snapshot = {intent_kind: intent_mode() original_input: draft.original_input supplement: draft.supplement current_topic: current_topic
        previous_question: draft.question prompt_revision: tracking_prompt_revision}
    let kind = "parse_intent" let prompt = intent_prompt
    if intent_mode() == "schedule" {
        kind = "parse_schedule_intent" prompt = schedule_intent_prompt
        let zone = draft["schedule_timezone"]
        if zone != "Asia/Shanghai" && zone != "America/New_York" { zone = "America/New_York" }
        snapshot.timezone = zone snapshot.reference_now = analysis_epoch_rfc3339(time_now())
        snapshot.reference_date = schedule_date_at(schedule_zone_seconds(time_now(), zone))
        snapshot.prompt_revision = schedule_intent_prompt_revision
    }
    intent_error = "正在理解你的想法…返回后请确认保存，当前尚未新增关注。"
    if intent_mode() == "schedule" { intent_error = "正在整理日程…返回后请确认保存，当前尚未新增日程。" }
    error = agent_task_start(kind, snapshot, prompt + snapshot.to_json(), || {
        let reason = intent_request_context_error(draft)
        if reason != "" { return reason }
        true
    }, fn(reply){
        if !reply.success { intent_error = reply.error }
        else {
            let next = draft.to_json().parse_json()
            next.state = reply.result.status next.question = reply.result.question
            if kind == "parse_schedule_intent" {
                next.schedule_understanding = reply.result.understanding next.understanding = nil
                next.schedule_prompt_revision = schedule_intent_prompt_revision
            } else { next.understanding = reply.result.understanding }
            next.version = next.version + 1
            let error = topic_save_draft(next)
            if error == "" { intent_draft = next intent_error = "" intent_more = next.question != "" || next.supplement != "" } else { intent_error = error }
        }
        intent_render()
    })
    if error != "" { intent_error = error }
    intent_render()
}
fn intent_after_interrupt(){
    if !intent_parse_pending { return }
    intent_parse_pending = false
    if intent_open && !analysis_needs_reopen { start_timeout(0.01, || intent_submit()) }
}
fn intent_confirm(){
    if intent_draft == nil { return }
    if intent_mode() == "schedule" { intent_confirm_schedule() return }
    let error = topic_confirm(intent_draft)
    if error != "" { intent_error = error intent_render() return }
    let label = "关注"
    if intent_mode() == "goal" { label = "目标关注" }
    let title = intent_draft.understanding.title
    intent_finish(label + "「" + title + "」已保存；首页将按新关注排序")
}
fn intent_finish(message){
    if intent_save_timer != nil { stop_timer(intent_save_timer) intent_save_timer = nil }
    intent_parse_pending = false intent_error = "" intent_draft = nil
    intent_hide()
    // Publish the changed records immediately, even when no model is available.
    tracking_ui_update()
    if page == "schedule" { ui.schedule_list.render() }
    notice(message)
    tracking_schedule_check()
}
fn intent_confirm_schedule(){
    if intent_draft.state != "ready" || !schedule_intent_understanding_valid(intent_draft["schedule_understanding"]) { intent_error = "请先取得完整的日程理解" intent_render() return }
    let plan = intent_draft.schedule_understanding
    let result = schedule_create_record(plan.title, plan.content, plan.location, plan.start, plan.end, plan.timezone, nil, true, intent_draft.draft_id)
    if !result.success {
        intent_error = result.error
        if result["conflicts"] != nil { intent_error = "与已有日程重叠，请调整时间后重新整理" }
        intent_render() return
    }
    let next = topic_records.to_json().parse_json() next.draft = nil
    let error = topics_commit(next)
    if error != "" { intent_error = "日程已保存；草稿清理失败，可重试确认，不会重复创建：" + error intent_render() return }
    intent_finish("日程「" + plan.title + "」已保存；首页将优先展示行程相关报道")
}
fn intent_cancel(){
    intent_parse_pending = false
    if agent_task != nil { if analysis_busy && (agent_task.kind == "parse_intent" || agent_task.kind == "parse_schedule_intent") { analysis_cancel() } }
    let error = intent_save_local()
    if error != "" { intent_error = error intent_render() return }
    intent_hide() notice("草稿已保留，可以继续补充")
    if tracking_check_pending { tracking_schedule_check() }
}
fn intent_discard(){
    let next = topic_records.to_json().parse_json() next.draft = nil
    let error = topics_commit(next)
    if error != "" { intent_error = error intent_render() return }
    intent_parse_pending = false
    if agent_task != nil { if analysis_busy && (agent_task.kind == "parse_intent" || agent_task.kind == "parse_schedule_intent") { analysis_cancel() } }
    intent_draft = nil intent_hide()
}
fn intent_follow_reminder(id){
    let reminder = tracking_find_reminder(id)
    if reminder == nil { notice("提醒已过期，请重新检查") return }
    let error = tracking_check_reminder(reminder)
    if error != "" { notice(error) return }
    let item = schedule_find(reminder.schedule_id)
    intent_draft = topic_new_draft(nil)
    intent_draft.original_input = "关注与日程「" + item.title + "」有关的信息：" + reminder.impact_summary
    if record_string(item["location"]) && item["location"] != "" { intent_draft.original_input = intent_draft.original_input + "；地点：" + item["location"] }
    intent_draft.origin_reminder_id = id
    intent_more = false
    notice("")
    intent_error = ""
    intent_show()
}
fn topic_toggle_pause(id, version, status){
    let error = topic_set_status(id, version, status)
    if error != "" { notice(error) } else {
        if status == "cancelled" { notice("已取消关注") } else { notice("关注状态已保存") }
        tracking_schedule_check()
    }
    tracking_ui_update()
}
