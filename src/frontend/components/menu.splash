let MenuToggle = GestureView{width: 32 height: 36 on_tap: |x, y| toggle_menu()
    View{width: Fill height: Fill show_bg: true
        draw_bg +: {
            pixel: fn(){
                let sdf = Sdf2d.viewport(self.pos * self.rect_size)
                sdf.box(6.0, 10.0, 20.0, 2.0, 1.0) sdf.fill(#x202126)
                sdf.box(6.0, 17.0, 20.0, 2.0, 1.0) sdf.fill(#x202126)
                sdf.box(6.0, 24.0, 20.0, 2.0, 1.0) sdf.fill(#x202126)
                return sdf.result
            }
        }
    }
}
let MenuItem = QuietButton{width: Fill height: 36 align: Align{x: 0.0}
    draw_text +: {color: ink color_hover: ink color_down: ink text_style +: {font_size: 13}}
}
let MenuPanel = View{visible: false width: Fill height: Fit flow: Down padding: Inset{left: 18 right: 18 top: 8 bottom: 8}
    show_bg: true draw_bg.color: soft
    MenuItem{text: "新闻来源" on_click: || show_settings()}
    MenuItem{text: "管理关注" on_click: || manage_tracking()}
    MenuItem{text: "关注动态" on_click: || select_page("tracking")}
    MenuItem{text: "我的收藏" on_click: || select_page("saved")}
    suggestions_button := MenuItem{text: "分析与建议" on_click: || show_analysis_results()}
    MenuItem{text: "天气预报" on_click: || show_weather()}
    menu_cancel_update := MenuItem{visible: false text: "停止新闻更新" on_click: || { close_menu() if busy { refresh() } }}
}
