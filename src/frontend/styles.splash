let ink = #x202126
let secondary = #x666873
let accent = #x6655d8
let line = #xeaeaf0
let soft = #xf2f1fa
let white = #xffffff
let Text = Label{width: Fill padding: 0 draw_text.color: ink draw_text.text_style.font_size: 14 draw_text.text_style.line_spacing: 1.15}
let Small = Text{draw_text.color: secondary draw_text.text_style.font_size: 11}
let Heading = Text{draw_text.text_style: theme.font_bold{font_size: 20 line_spacing: 1.2}}
let Section = Text{draw_text.text_style: theme.font_bold{font_size: 13 line_spacing: 1.2}}
let ReaderText = Text{draw_text.text_style.font_size: 17 draw_text.text_style.line_spacing: 1.45}
let ReaderParagraph = ReaderText{justify: true margin: Inset{bottom: 14} draw_text.text_style.line_spacing: 1.35}
let ReaderHeading = Text{margin: Inset{top: 12 bottom: 2} draw_text.text_style: theme.font_bold{font_size: 21 line_spacing: 1.3}}
let ReaderCaption = Small{draw_text.text_style.font_size: 12 draw_text.text_style.line_spacing: 1.35}
let ReaderImage = Image{width: Fill height: Fit fit: ImageFit.Horizontal}
let Divider = SolidView{width: Fill height: 1 draw_bg.color: line}
let QuietButton = ButtonFlat{height: 30 padding: Inset{left: 7 right: 7} margin: 0
    draw_bg +: {color: #x00000000 color_hover: #x00000008 color_down: #x00000010 border_size: 0.0 border_radius: 6.0}
    draw_text +: {color: secondary color_hover: ink color_down: ink text_style: theme.font_regular{font_size: 11}}
}
let LinkButton = QuietButton{draw_text +: {color: accent color_hover: accent color_down: accent}}
let HintButton = LinkButton{width: Fill height: 28 align: Align{x: 0.0} padding: 0
    draw_text +: {text_style +: {font_size: 12}}
}
let Pill = LinkButton{height: 30 padding: Inset{left: 10 right: 10}
    draw_bg +: {color: #xf0f1fa color_hover: #xe7e9f7 color_down: #xdfe2f1 border_radius: 15.0}
}
let Primary = QuietButton{height: 40 padding: Inset{left: 14 right: 14}
    draw_bg +: {color: ink color_hover: #x353741 color_down: #x454752 border_radius: 9.0}
    draw_text +: {color: white color_hover: white color_down: white text_style +: {font_size: 13}}
}
let SecondaryButton = QuietButton{height: 40 padding: Inset{left: 12 right: 12}
    draw_bg +: {color: soft color_hover: #xececf2 color_down: #xe4e4eb border_radius: 9.0}
    draw_text +: {color: ink color_hover: ink color_down: ink text_style +: {font_size: 13}}
}
let Nav = QuietButton{width: Fill height: 42
    draw_text +: {text_style +: {font_size: 13}}
}
let NavActive = Nav{
    draw_bg +: {color: soft color_hover: soft color_down: #xececf2 border_radius: 10.0}
    draw_text +: {color: ink color_hover: ink color_down: ink}
}
let Filter = Nav{height: 36}
let FilterActive = Filter{
    draw_text +: {color: ink color_hover: ink color_down: ink}
    draw_bg +: {color: soft color_hover: soft color_down: #xececf2 border_radius: 8.0}
}
let Box = RoundedView{width: Fill height: Fit flow: Down padding: 16 spacing: 10
    show_bg: true draw_bg.color: soft draw_bg.border_radius: 12.0}
let Search = TextInput{width: Fill height: 32 empty_text: "搜索新闻"
    draw_bg +: {color: soft color_hover: soft color_focus: soft color_empty: soft
        border_color: #x00000000 border_color_hover: #x00000000 border_color_focus: #x00000000 border_color_empty: #x00000000 border_radius: 8.0}
    draw_text +: {color: ink color_hover: ink color_focus: ink color_empty: secondary color_empty_hover: secondary text_style +: {font_size: 12}}
}
// Editorial feed styles are scoped so reading and management pages keep their sizing.
let editorial_ink = #x202635
let editorial_muted = #x8790a3
let editorial_accent = #x7369c6
let EditorialTitle = Text{draw_text.color: editorial_ink draw_text.text_style: theme.font_bold{font_size: 17 line_spacing: 1.16}}
let EditorialCaption = Small{draw_text.color: editorial_muted draw_text.text_style.font_size: 11}
let EditorialTag = RoundedView{width: Fit height: 22 padding: Inset{left: 9 right: 9 top: 3 bottom: 3} show_bg: true draw_bg.color: #xf1f0fb draw_bg.border_radius: 11.0}
let EditorialCard = RoundedView{width: Fill height: Fit flow: Down padding: 15 spacing: 9 show_bg: true
    draw_bg +: {color: white border_size: 1.0 border_color: #xeeeff5 border_radius: 20.0}}
let EditorialImage = Image{fit: ImageFit.CropToFill draw_bg +: {
    radius: uniform(14.0)
    pixel: fn(){
        let sdf = Sdf2d.viewport(self.pos * self.rect_size)
        let c = mix(self.get_color(), #xeef0f5, self.async_load)
        sdf.box(0.0, 0.0, self.rect_size.x, self.rect_size.y, self.radius)
        sdf.fill(vec4(c.xyz, c.w * self.opacity))
        return sdf.result
    }
}}
let EditorialIcon = View{width: 24 height: 24 show_bg: true draw_bg +: {
    kind: uniform(0.0) tint: uniform(#x8790a3)
    pixel: fn(){
        let sdf = Sdf2d.viewport(self.pos * self.rect_size)
        if self.kind < 0.5 {
            sdf.move_to(3.0, 10.0) sdf.line_to(12.0, 3.0) sdf.line_to(21.0, 10.0) sdf.stroke(self.tint, 1.7)
            sdf.box(5.0, 10.0, 14.0, 11.0, 2.0) sdf.stroke(self.tint, 1.7)
            sdf.box(10.0, 15.0, 4.0, 6.0, 0.5) sdf.stroke(self.tint, 1.5)
        } else if self.kind < 1.5 {
            sdf.circle(12.0, 12.0, 9.0) sdf.stroke(self.tint, 1.7)
            sdf.circle(12.0, 12.0, 4.0) sdf.stroke(self.tint, 1.7)
            sdf.move_to(13.0, 11.0) sdf.line_to(21.0, 3.0) sdf.stroke(self.tint, 1.7)
        } else if self.kind < 2.5 {
            sdf.box(4.0, 5.0, 16.0, 16.0, 3.0) sdf.stroke(self.tint, 1.7)
            sdf.move_to(4.0, 10.0) sdf.line_to(20.0, 10.0) sdf.stroke(self.tint, 1.5)
            sdf.move_to(8.0, 3.0) sdf.line_to(8.0, 7.0) sdf.stroke(self.tint, 1.7)
            sdf.move_to(16.0, 3.0) sdf.line_to(16.0, 7.0) sdf.stroke(self.tint, 1.7)
            sdf.move_to(8.0, 15.0) sdf.line_to(11.0, 18.0) sdf.line_to(16.0, 13.0) sdf.stroke(self.tint, 1.5)
        } else if self.kind < 3.5 {
            sdf.circle(12.0, 7.0, 4.0) sdf.stroke(self.tint, 1.7)
            sdf.box(5.0, 14.0, 14.0, 7.0, 3.0) sdf.stroke(self.tint, 1.7)
        } else {
            sdf.circle(10.0, 10.0, 6.0) sdf.stroke(self.tint, 1.7)
            sdf.move_to(15.0, 15.0) sdf.line_to(21.0, 21.0) sdf.stroke(self.tint, 1.7)
        }
        return sdf.result
    }
}}
