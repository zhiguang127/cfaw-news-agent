HostedView{width: Fill height: Fill
    full: View{width: Fill height: Fill flow: Overlay
    app_shell := View{width: Fill height: Fill flow: Down show_bg: true draw_bg.color: white
        View{width: Fill height: 88 flow: Right align: Align{y: 0.5} padding: Inset{left: 18 right: 18 top: 12 bottom: 8} spacing: 8
            View{width: Fill height: Fit flow: Down spacing: 2
                Label{text: "cfaw-news" draw_text.color: editorial_ink draw_text.text_style: TextStyle{font_size: 28 line_spacing: 1.1
                    font_family: FontFamily{latin := FontMember{res: crate_resource("makepad_widgets:resources/Serif-Bold.ttf") asc: 0.0 desc: 0.0}}} max_lines: 1}
                Small{text: "NEWS THAT MOVES YOU" draw_text.color: editorial_accent draw_text.text_style.font_size: 7.5 draw_text.text_style.letter_spacing: 1.0}
            }
            refresh_toolbar := View{width: Fit height: 42 flow: Down align: Align{x: 0.5 y: 0.5}
                refresh_news := LinkButton{height: 38 text: "刷新新闻" on_click: || refresh() draw_text.color: editorial_muted}
            }
            weather_widget := WeatherHeaderWidget{}
        }
        home_tools := View{width: Fill height: 56 flow: Right align: Align{y: 0.5} padding: Inset{left: 18 right: 18 top: 4 bottom: 8} spacing: 8
            search_box := View{width: Fill height: Fit flow: Down
                RoundedView{width: Fill height: 44 flow: Right padding: Inset{left: 12 right: 10} spacing: 10 align: Align{y: 0.5} show_bg: true draw_bg.color: #xf3f4f8 draw_bg.border_radius: 20.0
                    EditorialIcon{width: 22 height: 22 draw_bg.kind: 4.0}
                    search := Search{height: 40 empty_text: "搜索新闻、话题或来源…" on_change: |text| set_query(text)
                        draw_bg +: {color: #x00000000 color_hover: #x00000000 color_focus: #x00000000 color_empty: #x00000000}
                        draw_text +: {color_empty: #x9aA2b2 color_empty_hover: #x9aA2b2 text_style +: {font_size: 13}}}
                }
            }
        }
        main := View{width: Fill height: Fill flow: Down
            pending_suggestions := HintButton{visible: false height: 28 margin: Inset{left: 18 right: 18} text: "" on_click: || show_analysis_results()}
            feed_filters := FeedFilters{}
            feed_context := FeedContext{}
            tracking_header := TrackingHeader{}
            bookmarks_header := BookmarksHeader{}
            status := EditorialCaption{text: "正在准备新闻来源…" padding: Inset{left: 20 right: 18 top: 4 bottom: 4}}
            feed_list := View{width: Fill height: Fill flow: Overlay
                empty_panel := GestureView{visible: false width: Fill height: Fill flow: Down padding: 28 spacing: 12 on_swipe: |dx, dy| feed_swipe_refresh(dx, dy)
                    Section{text: "这里暂时没有内容"}
                    empty_message := Text{text: "" draw_text.color: secondary}
                }
                list_container := View{width: Fill height: Fill flow: Down
                    list := NewsList{}
                    on_render: || { list := NewsList{} }
                }
                View{width: Fill height: Fill align: Align{x: 1.0 y: 1.0} padding: Inset{right: 14 bottom: 18}
                    back_to_top := Primary{visible: false width: 40 height: 40 text: "↑" on_click: || return_feed_top()
                        draw_bg +: {border_radius: 20.0 color: #x2e4b75 color_hover: #x3c5d89 color_down: #x496f9e}
                        draw_text.text_style.font_size: 20}
                }
            }
            schedule_page := SchedulePage{}
            account_page := AccountPage{}
            results_panel := AnalysisResultsPage{}
        }
        detail_pane := View{visible: false width: Fill height: Fill flow: Down
            View{width: Fill height: 44 flow: Right align: Align{y: 0.5} padding: Inset{left: 12 right: 18} spacing: 8
                QuietButton{text: "‹ 返回" on_click: || close_detail()}
                detail_title := Small{width: Fill text: "新闻详情" align: Align{x: 1.0}}
            }
            Divider{}
            story_panel := StoryPage{}
            original_pane := View{visible: false width: Fill height: Fill flow: Down
                View{width: Fill height: Fit flow: Down spacing: 6 padding: Inset{left: 18 right: 18 top: 8 bottom: 8}
                    original_title := Small{width: Fill text: "" max_lines: 2}
                    original_hint := Small{width: Fill text: ""}
                    original_error := Small{width: Fill text: ""}
                    LinkButton{text: "重新打开网页" on_click: || open_original_article()}
                }
                original_reader := WebReader{width: Fill height: Fill on_error: || original_article_failed()}
            }
            settings_panel := SourcesPage{}
            tracking_panel := TrackingEditor{}
            weather_panel := WeatherPage{}
        }
        feedback_panel := View{visible: false width: Fill height: Fit flow: Right padding: Inset{left: 18 right: 12 top: 6 bottom: 6} align: Align{y: 0.5}
            feedback := Small{text: "" max_lines: 2}
            QuietButton{text: "关闭" on_click: || notice("")}
        }
        navigation := View{width: Fill height: 72 flow: Down show_bg: true draw_bg.color: white
            Divider{}
            View{width: Fill height: 66 flow: Right padding: Inset{left: 18 right: 18 top: 6 bottom: 6} spacing: 8
                View{width: Fill height: 54 flow: Overlay
                    View{width: Fill height: Fill align: Align{x: 0.5 y: 0.1} EditorialIcon{draw_bg.kind: 0.0}}
                    feed_tab_active := RoundedView{width: Fill height: Fill align: Align{x: 0.5 y: 0.1} show_bg: true draw_bg.color: #xeeecfa draw_bg.border_radius: 22.0 EditorialIcon{draw_bg.kind: 0.0 draw_bg.tint: editorial_accent}}
                    feed_tab := Nav{height: 54 text: "首页" align: Align{x: 0.5 y: 1.0} padding: Inset{bottom: 2} draw_text +: {color: editorial_ink color_focus: editorial_accent text_style +: {font_size: 11}} on_click: || select_page("feed")}
                }
                View{width: Fill height: 54 flow: Overlay
                    View{width: Fill height: Fill align: Align{x: 0.5 y: 0.1} EditorialIcon{draw_bg.kind: 1.0}}
                    tracking_tab_active := RoundedView{visible: false width: Fill height: Fill align: Align{x: 0.5 y: 0.1} show_bg: true draw_bg.color: #xeeecfa draw_bg.border_radius: 22.0 EditorialIcon{draw_bg.kind: 1.0 draw_bg.tint: editorial_accent}}
                    tracking_tab := Nav{height: 54 text: "关注" align: Align{x: 0.5 y: 1.0} padding: Inset{bottom: 2} draw_text +: {color: editorial_muted color_focus: editorial_accent text_style +: {font_size: 11}} on_click: || select_page("tracking")}
                }
                View{width: Fill height: 54 flow: Overlay
                    View{width: Fill height: Fill align: Align{x: 0.5 y: 0.1} EditorialIcon{draw_bg.kind: 2.0}}
                    schedule_tab_active := RoundedView{visible: false width: Fill height: Fill align: Align{x: 0.5 y: 0.1} show_bg: true draw_bg.color: #xeeecfa draw_bg.border_radius: 22.0 EditorialIcon{draw_bg.kind: 2.0 draw_bg.tint: editorial_accent}}
                    schedule_tab := Nav{height: 54 text: "日程" align: Align{x: 0.5 y: 1.0} padding: Inset{bottom: 2} draw_text +: {color: editorial_muted color_focus: editorial_accent text_style +: {font_size: 11}} on_click: || select_page("schedule")}
                }
                View{width: Fill height: 54 flow: Overlay
                    View{width: Fill height: Fill align: Align{x: 0.5 y: 0.1} EditorialIcon{draw_bg.kind: 3.0}}
                    account_tab_active := RoundedView{visible: false width: Fill height: Fill align: Align{x: 0.5 y: 0.1} show_bg: true draw_bg.color: #xeeecfa draw_bg.border_radius: 22.0 EditorialIcon{draw_bg.kind: 3.0 draw_bg.tint: editorial_accent}}
                    account_tab := Nav{height: 54 text: "我的" align: Align{x: 0.5 y: 1.0} padding: Inset{bottom: 2} draw_text +: {color: editorial_muted color_focus: editorial_accent text_style +: {font_size: 11}} on_click: || select_page("account")}
                }
            }
        }
    }
    floating_ai := View{width: Fill height: Fill flow: Overlay
        if orb_native_supported { GestureView{width: Fill height: Fill on_viewport: |w,h| orb_viewport(w,h)} }
        orb_position := View{width: Fill height: Fill align: Align{x: 1.0 y: 0.86} padding: Inset{left: 18 right: 18 top: 36 bottom: 100} on_render: || { align: Align{x: orb_x y: orb_y} }
            ai_orb := View{width: 72 height: 72
            if orb_native_supported {
                GestureView{width: 72 height: 72 long_press_seconds: 0.4 on_press: || orb_press() on_tap: |x,y| orb_tap(x,y) on_long_press: |x,y| orb_long_press(x,y)
                on_pan_viewport: |dx,dy,phase,w,h| orb_pan(dx,dy,phase,w,h) on_release: || orb_release()
                AIOrb{enabled: false}
                }
            } else {
                AIOrb{on_press: || intent_orb_press() on_click: || {if !intent_open { intent_begin(nil) }}}
            }
            }
        }
    }
    intent_overlay := View{visible: false width: Fill height: Fill flow: Overlay
        intent_wave := View{width: Fill height: Fill on_render: || { IntentReveal{draw_bg.progress: intent_reveal draw_bg.origin_x: orb_x draw_bg.origin_y: orb_y} }}
        intent_scene := IntentBackdrop{visible: false flow: Down
            View{width: Fill height: 64 flow: Right padding: Inset{left: 22 right: 18 top: 14 bottom: 10} align: Align{y: 0.5}
                Section{width: Fill text: "✦ 意图空间" draw_text.color: #x455789 draw_text.text_style.font_size: 14}
                intent_close := QuietButton{width: 36 height: 36 text: "×" draw_text.text_style.font_size: 22 on_click: || intent_cancel()}
            }
            intent_panel := IntentPanel{visible: true}
        }
    }
    }
    tile: View{width: Fill height: Fill flow: Down padding: 14 spacing: 8 show_bg: true draw_bg.color: white
        Section{text: "cfaw news" draw_text.color: accent}
        tile_list := View{width: Fill height: Fill flow: Down spacing: 8 on_render: || {
            if app_feed_rows.len() == 0 { Small{text: "真实新闻尚未加载"} }
            for i row in app_feed_rows { if i < 3 { Text{text: row.title max_lines: 2 draw_text.text_style.font_size: 12} } }
        }}
    }
}
