fn results_pending_page(offset){ results_pending_offset = offset ui.results_content.render() }
let AnalysisResultsPage = View{visible: false width: Fill height: Fill flow: Down
    results_content := ScrollYView{width: Fill height: Fill flow: Down padding: 20 spacing: 12 on_render: || {
        Section{text: "本轮目标变化"}
        let insights = []
        for value in current_insights() {
            if value.state == "pending" || value.state == "watch" { insights.push(value) }
        }
        if insights.len() == 0 { Small{text: "尚无当前有效的目标变化；可先保存关注并检查。"} }
        for value in insights {
            Section{text: value.title}
            Small{text: insight_label(value)}
            Text{text: value.insight.summary}
            if value.insight.next_step != nil { Small{text: "下一步核实：" + value.insight.next_step} }
            for uncertainty in value.insight.uncertainties { Small{text: "待核实：" + uncertainty} }
            for id in value.insight.evidence_ids {
                let e = tracking_find(value.run.snapshot.evidence, "news_id", id)
                Small{text: "来源：" + e.title}
                if e.paragraphs.len() == 0 { Small{text: "标题/摘要证据 · " + e.body_error} }
                else if e.body_truncated { Small{text: "有界正文证据 · 部分段落已截断"} }
                SecondaryButton{text: "查看来源与引用段落" on_click: || insight_open_evidence(value, id)}
            }
            if value.state != "withdrawn" {
                View{width: Fill height: Fit flow: Right spacing: 6
                    QuietButton{text: "观察" on_click: || insight_decide(value, "watch")}
                    QuietButton{text: "已处理" on_click: || insight_decide(value, "handled")}
                    QuietButton{text: "忽略" on_click: || insight_decide(value, "dismissed")}
                }
            }
            if value.insight["reschedule"] != nil { SecondaryButton{text: "预览改期提案" on_click: || reschedule_begin(value)} }
            Divider{}
        }
        if reschedule_preview != nil {
            let s = tracking_find(reschedule_preview.run.snapshot.schedules, "schedule_id", reschedule_preview.insight.target_id)
            let p = reschedule_preview.insight.reschedule
            Section{text: "确认应用内改期"}
            Text{text: "原安排：" + schedule_display_time(s.start, s.timezone) + " → " + schedule_display_time(s.end, s.timezone)}
            Text{text: "新安排：" + schedule_display_time(p.start, s.timezone) + " → " + schedule_display_time(p.end, s.timezone)}
            Small{text: p.reason}
            for uncertainty in reschedule_preview.insight.uncertainties { Small{text: "未知项：" + uncertainty} }
            for ref in p.evidence_refs { Text{text: ref.paragraph_id + "：" + ref.quote} }
            Primary{text: "确认并保存改期" on_click: || reschedule_confirm()}
            SecondaryButton{text: "继续原计划并记录决定" on_click: || reschedule_keep_original()}
            QuietButton{text: "取消提案" on_click: || {reschedule_preview = nil ui.results_content.render()}}
        }
        for a in schedule_actions.items {
            if a.state != "prepared" { continue }
            Section{text: "待完成的改期"}
            Small{text: a.original.title + " · " + schedule_action_state_label(a.state)}
            Small{text: "原：" + schedule_display_time(a.original.start, a.original.timezone) + " → " + schedule_display_time(a.original.end, a.original.timezone)}
            Small{text: "新：" + schedule_display_time(a.start, a.original.timezone) + " → " + schedule_display_time(a.end, a.original.timezone)}
            if a.state == "prepared" { SecondaryButton{text: "恢复已确认的改期记录" on_click: || {notice(reschedule_resume(a.action_id)) tracking_ui_update()}} }
        }
        Section{text: "待关注日程影响"}
        Small{text: tracking_message max_lines: 5}
        if tracking_pending_run != nil { SecondaryButton{text: "重试保存结果" on_click: || tracking_retry_save()} }
        let reminders = tracking_active_reminders()
        if reminders.len() == 0 { Small{text: "暂无当前有效的日程影响提醒"} }
        for reminder in reminders {
            let schedule = schedule_find(reminder.schedule_id)
            Text{text: "可能影响日程「" + schedule.title + "」：" + reminder.impact_summary}
            SecondaryButton{text: "查看提醒依据" on_click: || open_story(tracking_current_row(reminder.news_id))}
        }
        SecondaryButton{text: "检查关注与日程" on_click: || tracking_start(nil)}
        Divider{}
        Section{text: "待确认建议"}
        if analysis_state == "failed" || analysis_needs_reopen {
            Small{text: analysis_error_hint() draw_text.color: accent}
            QuietButton{text: "查看具体原因" on_click: || {results_show_error_detail = !results_show_error_detail ui.results_content.render()}}
            if results_show_error_detail { Small{text: analysis_error} }
        }
        if tracking_in_progress() { Small{text: "分析正在进行，可继续浏览其他页面。"} SecondaryButton{text: "取消分析" on_click: || analysis_cancel()} }
        if history_dirty { Small{text: "结果尚未完整保存，重开应用可能丢失本次结果。" draw_text.color: accent} SecondaryButton{text: "重试保存" on_click: || retry_analysis_save()} }
        if analysis_history_warning != "" { Small{text: analysis_history_warning draw_text.color: accent} }
        let pending = 0
        for item in suggestion_history {
            if item.state == "pending" || item.state == "needs_review" {
                pending = pending + 1
                if pending > results_pending_offset && pending <= results_pending_offset + 20 {
                Small{text: history_state_label(item.state)}
                Text{text: item.change_summary}
                SecondaryButton{text: "查看证据与建议" on_click: || open_suggestion_record(item.suggestion_id)}
                }
            }
        }
        if results_pending_offset > 0 { SecondaryButton{text: "上一页建议" on_click: || results_pending_page(max(0, results_pending_offset - 20))} }
        if pending > results_pending_offset + 20 { SecondaryButton{text: "下一页建议" on_click: || results_pending_page(results_pending_offset + 20)} }
        if pending == 0 { Small{text: "暂无待确认建议。可在跟踪页检查关注更新，或分析一条新闻。"} }
    }}
}
