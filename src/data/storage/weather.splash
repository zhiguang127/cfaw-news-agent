// Persisted city selection. Follows the conventions in records.splash: one
// writer, {schema_version, ...} on disk, a warning string instead of a thrown
// error, and the in-memory value stays usable when the write fails.
//
// Forecasts themselves are cache, not user records: weather_read_cache owns
// those files and a corrupt cache degrades to "not loaded" without touching
// anything the user authored.
let weather_file = {path: "weather_selection_v1.json" writable: true recovered: false}
let weather_warning = ""

fn weather_warn(text){
    if weather_warning != "" {
        weather_warning = weather_warning + "; "
    }
    weather_warning = weather_warning + text
}

fn weather_selection_document_valid(value){
    if !record_object(value) || value["schema_version"] != 1 { return false }
    if !record_array(value["tracked"]) { return false }
    weather_tracked_valid(value["tracked"])
}

fn weather_selection_read(){
    if !fs.exists(weather_file["path"]) {
        return
    }
    // fs.read and parse_json are isolated in their own try, as in
    // records.splash: a trap inside a larger try body is not dependable.
    let raw = ""
    try { raw = fs.read(weather_file["path"]) } { raw = "" }
    if raw == "" {
        weather_warn("城市设置读取失败，本次使用默认值")
        return
    }
    let parsed = nil
    try { parsed = raw.parse_json() } { parsed = nil }
    if parsed == nil {
        weather_warn("城市设置不是有效 JSON，本次使用默认值")
        weather_file.writable = false
        return
    }
    if !weather_selection_document_valid(parsed) {
        weather_warn("城市设置格式不受支持，本次使用默认值；原文件未覆盖")
        return
    }
    weather_tracked = []
    for cid in parsed["tracked"] { weather_track(cid, weather_generation) }
}

fn weather_selection_write(){
    if !weather_file.writable {
        weather_warn("城市设置只读，本次选择仅在当前会话有效")
        return
    }
    try {
        fs.write(weather_file["path"], {schema_version: 1 tracked: weather_tracked}.to_json())
        weather_warning = ""
    } {
        weather_warn("城市设置保存失败，本次选择仅在当前会话有效")
    }
}

fn weather_load(){
    weather_file.writable = true
    weather_file.recovered = false
    weather_warning = ""
    weather_initialize()
    weather_selection_read()
    for city in weather_cities { weather_read_cache(city) }
}
