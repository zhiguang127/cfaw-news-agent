// Read-only reader; bounded paragraphs can also populate the separate evidence
// cache. Each Agent run preserves exactly the paragraphs it actually received.
let article_hosts = ["www.airchinagroup.com", "www.theverge.com", "arstechnica.com", "venturebeat.com", "news.mit.edu", "arxiv.org", "www.bbc.com", "www.bbc.co.uk", "www.theguardian.com", "www.cnbc.com", "techcrunch.com", "www.techmeme.com", "news.ycombinator.com"]
let article_image_hosts = ["ichef.bbci.co.uk", "i.guim.co.uk", "cdn.arstechnica.net", "cdn.vox-cdn.com", "duet-cdn.vox-cdn.com"]
let article_config = {max_paragraphs: 80 max_text_bytes: 24000 max_nodes: 350 max_images: 6
    max_image_bytes: 2000000 max_total_image_bytes: 6000000 image_timeout_seconds: 10}
let article_state = {generation: 0 state: "idle" paragraphs: [] blocks: [] images: [] image_bytes: 0 error: "" truncated: false}
let article_http_request = |url, redirects, callback| news_http_request(url, redirects, callback)
fn article_url_allowed(url){
    if !record_string(url) { return false }
    let parts = url.split("/")
    parts.len() >= 3 && parts[0] == "https:" && parts[1] == "" && record_contains(article_hosts, parts[2])
}
fn article_original_allowed(url){
    if !record_string(url) { return false }
    let parts = url.split("/")
    parts.len() >= 3 && (parts[0] == "https:" || parts[0] == "http:") && parts[1] == "" && regex("^[a-zA-Z0-9.-]+$").test(parts[2])
}
fn article_resolve_url(base, value){
    if !record_string(value) || value.trim() == "" { return nil }
    value = value.trim()
    if regex("^https://").test(value) { return value }
    if regex("^//").test(value) { return "https:" + value }
    if !article_original_allowed(base) || regex("^[a-zA-Z][a-zA-Z0-9+.-]*:").test(value) { return nil }
    let parts = base.split("?")[0].split("#")[0].split("/")
    let path = []
    if !regex("^/").test(value) { for i part in parts { if i >= 3 && i < parts.len() - 1 && part != "" { path.push(part) } } }
    for part in value.split("/") {
        if part == ".." { if path.len() > 0 { path.remove(path.len() - 1) } }
        else if part != "" && part != "." { path.push(part) }
    }
    let resolved = "https://" + parts[2]
    for part in path { resolved = resolved + "/" + part }
    resolved
}
fn article_image_allowed(url){
    if !record_string(url) { return false }
    let parts = url.split("/")
    parts.len() >= 3 && parts[0] == "https:" && parts[1] == "" && (record_contains(article_hosts, parts[2]) || record_contains(article_image_hosts, parts[2]))
}
fn article_add_image(blocks, images, seen, base, value, caption){
    let url = article_resolve_url(base, value)
    if !article_image_allowed(url) || seen[url] == true || images.len() >= article_config.max_images { return }
    seen[url] = true
    if !record_string(caption) { caption = "" }
    let block = {kind: "image" url: url text: caption state: "loading" resource: nil}
    images.push(block) blocks.push(block)
}
fn article_extract(body, source_url = nil){
    let doc = body.parse_html()
    // Restrict extraction to article/main containers. Never present navigation,
    // consent pages or the entire HTML document as a news article.
    let container = nil
    for selector in ["div.news-article--content--body" "div.ArticleBody-articleBody" "div.article-body" "div.article-content" "div.entry-content" "article" "main"] {
        let found = doc.query(selector + "[0]")
        if found != nil && found.query("p").length > 0 { container = found break }
    }
    let values = []
    if container != nil { values = container.query("p.text") if record_string(values) { values = [values] } }
    let paragraphs = [] let count = 0 let truncated = false
    for value in values {
        if !record_string(value) || value.trim() == "" { continue }
        let text = value.trim()
        if paragraphs.len() >= article_config.max_paragraphs || count + text.to_bytes().len() > article_config.max_text_bytes { truncated = true break }
        paragraphs.push(text) count = count + text.to_bytes().len()
    }
    let blocks = [] let images = [] let seen = {}
    if source_url != nil && container != nil {
        // The cover lives outside the body on several publishers (e.g. MIT).
        for meta in doc.query("meta").array() {
            if meta.attr("property") == "og:image" { article_add_image(blocks, images, seen, source_url, meta.attr("content"), "") break }
        }
        let visited = 0 let text_bytes = 0 let paragraph_count = 0
        for node in container.query("*").array() {
            visited = visited + 1
            if visited > article_config.max_nodes { truncated = true break }
            let html = node.html
            if regex("^<img[ >]").test(html) {
                let value = node.attr("data-src")
                if !record_string(value) || value == "" { value = node.attr("src") }
                article_add_image(blocks, images, seen, source_url, value, node.attr("alt"))
                continue
            }
            let kind = nil
            if regex("^<p[ >]").test(html) { kind = "paragraph" }
            if regex("^<h[234][ >]").test(html) { kind = "heading" }
            if regex("^<li[ >]").test(html) && node.query("p").length == 0 { kind = "list" }
            if regex("^<blockquote[ >]").test(html) && node.query("p").length == 0 { kind = "quote" }
            if regex("^<figcaption[ >]").test(html) { kind = "caption" }
            if kind == nil { continue }
            let text = node.text.trim()
            if text == "" { continue }
            if text_bytes + text.to_bytes().len() > article_config.max_text_bytes || paragraph_count >= article_config.max_paragraphs { truncated = true break }
            text_bytes = text_bytes + text.to_bytes().len()
            if kind == "paragraph" { paragraph_count = paragraph_count + 1 }
            blocks.push({kind: kind text: text})
        }
    }
    {paragraphs: paragraphs blocks: blocks images: images truncated: truncated}
}
fn article_cancel(){ article_state.generation = article_state.generation + 1 }
fn article_prepare(){
    article_cancel()
    article_state.state = "loading" article_state.paragraphs = [] article_state.blocks = [] article_state.images = [] article_state.image_bytes = 0 article_state.error = "" article_state.truncated = false
}
fn article_load(row, complete){
    article_prepare()
    let generation = article_state.generation
    if !article_url_allowed(row.source_url) {
        article_state.state = "unavailable"
        article_state.error = "此来源暂不支持应用内提取，请点击“打开图文原文”阅读。"
        complete() return
    }
    article_http_request(row.source_url, 0, fn(reply){
        if generation != article_state.generation || article_state.state != "loading" { return }
        if !reply.success {
            if reply.category == "verification" {
                article_state.state = "unavailable"
                article_state.error = "网站要求人机验证，应用暂时无法读取正文。请点击“打开图文原文”在浏览器阅读。"
            } else { article_state.state = "failed" article_state.error = "正文读取失败：" + reply.error }
            complete() return
        }
        let result = nil
        try { result = article_extract(reply.body, row.source_url) } { result = nil }
        if result == nil || result.paragraphs.len() == 0 {
            article_state.state = "unavailable" article_state.error = "来源网页未提供可读取的正文，以下保留来源摘要。"
        } else {
            article_state.state = "ready" article_state.paragraphs = result.paragraphs article_state.truncated = result.truncated
            article_state.blocks = result.blocks article_state.images = result.images
            analysis_article_store(row, result, "")
        }
        complete()
        if article_state.state == "ready" { article_images_next(0, generation, complete) }
    })
}
fn article_image_step(url, redirects, context){
    if context.done { return }
    if !article_image_allowed(url) { news_http_finish(context, {success: false}) return }
    try {
        net.http_request(net.HttpRequest{url: url method: net.HttpMethod.GET max_response_body_bytes: article_config.max_image_bytes}) do net.HttpEvents{
            on_response: |response| {
                if context.done { return }
                if record_contains([301 302 303 307 308], response.status_code) {
                    let locations = response.headers["location"] if locations == nil { locations = response.headers["Location"] }
                    let target = nil if locations != nil && locations.len() > 0 { target = article_resolve_url(url, locations[0]) }
                    if target == nil || redirects >= news_config.max_redirects { news_http_finish(context, {success: false}) return }
                    article_image_step(target, redirects + 1, context)
                } else { news_http_finish(context, {success: response.status_code == 200 && response.body != nil bytes: response.body}) }
            }
            on_error: |error| news_http_finish(context, {success: false})
        }
    } { news_http_finish(context, {success: false}) }
}
let article_image_request = fn(url, callback){
    let context = {done: false timer: nil callback: callback}
    context.timer = start_timeout(article_config.image_timeout_seconds, || news_http_finish(context, {success: false}))
    article_image_step(url, 0, context)
}
fn article_image_bytes_supported(bytes){
    // Some sites return an HTML challenge with HTTP 200 instead of an image.
    // Keep the original-link fallback rather than handing that page to Image.
    if !record_array(bytes) || bytes.len() < 12 { return false }
    if bytes[0] == 255 && bytes[1] == 216 && bytes[2] == 255 { return true }
    if bytes[0] == 137 && bytes[1] == 80 && bytes[2] == 78 && bytes[3] == 71 { return true }
    if bytes[0] == 71 && bytes[1] == 73 && bytes[2] == 70 { return true }
    bytes[0] == 82 && bytes[1] == 73 && bytes[2] == 70 && bytes[3] == 70 && bytes[8] == 87 && bytes[9] == 69 && bytes[10] == 66 && bytes[11] == 80
}
fn article_images_next(index, generation, complete){
    if generation != article_state.generation || index >= article_state.images.len() { return }
    let image = article_state.images[index]
    article_image_request(image.url, fn(reply){
        if generation != article_state.generation || image.state != "loading" { return }
        image.state = "failed"
        if reply.success && article_image_bytes_supported(reply.bytes) && article_state.image_bytes + reply.bytes.len() <= article_config.max_total_image_bytes {
            try { image.resource = binary_resource(reply.bytes) image.state = "ready" article_state.image_bytes = article_state.image_bytes + reply.bytes.len() } { image.state = "failed" }
        }
        complete()
        start_timeout(0.01, || article_images_next(index + 1, generation, complete))
    })
}
