// One allowlist for every outbound request. News feeds use news_hosts, city
// forecasts use weather_hosts, the holiday calendar uses holiday_hosts. All are
// generated by scripts/assemble.py or declared next to the module that needs
// them, so a host cannot be requested without being declared there and listed in
// bundle/manifest.json.
fn news_request_allowed(url){
    if !record_string(url) { return false }
    let parts = url.split("/")
    if parts.len() < 3 || parts[0] != "https:" || parts[1] != "" { return false }
    record_contains(news_hosts, parts[2]) || record_contains(weather_hosts, parts[2]) || record_contains(holiday_hosts, parts[2]) || record_contains(fx_hosts, parts[2]) || record_contains(article_hosts, parts[2])
}
fn news_redirect_url(current, location){
    if !record_string(location) { return nil }
    if regex("^https://").test(location) { return location }
    if regex("^//").test(location) { return "https:" + location }
    if regex("^/").test(location) { return "https://" + current.split("/")[2] + location }
    nil
}
fn news_http_finish(context, result){
    if context.done { return }
    context.done = true
    stop_timer(context.timer)
    context.callback(result)
}
fn news_http_request(url, redirects, callback){
    let context = {done: false timer: nil callback: callback}
    context.timer = start_timeout(news_config.request_timeout_seconds, || {
        news_http_finish(context, {success: false error: "请求超时" category: "timeout"})
    })
    news_http_step(url, redirects, context)
}
fn news_http_verification(headers){
    if headers == nil { return false }
    let actions = headers["x-amzn-waf-action"]
    if actions == nil { actions = headers["X-Amzn-Waf-Action"] }
    if actions == nil { actions = headers["X-AMZN-WAF-ACTION"] }
    if !record_array(actions) { return false }
    for action in actions { if action == "captcha" || action == "challenge" { return true } }
    false
}
fn news_http_step(url, redirects, context){
    if context.done { return }
    if !news_request_allowed(url) { news_http_finish(context, {success: false error: "请求或重定向域名未获许可" category: "permission"}); return }
    try {
        net.http_request(net.HttpRequest{url: url method: net.HttpMethod.GET
            max_response_body_bytes: news_config.max_response_bytes
            // The pinned Windows backend owns User-Agent; overriding it is refused.
            headers: {"Accept": ["application/rss+xml, application/atom+xml, application/json, text/html, text/xml, */*"]}}) do net.HttpEvents{
            on_response: |response| {
                if context.done { return }
                let status = response.status_code
                if news_http_verification(response.headers) {
                    news_http_finish(context, {success: false error: "网站要求浏览器人机验证，暂不支持直接读取" category: "verification"})
                    return
                }
                if status == 301 || status == 302 || status == 303 || status == 307 || status == 308 {
                    let locations = response.headers["location"]
                    if locations == nil { locations = response.headers["Location"] }
                    let target = nil
                    if locations != nil && locations.len() > 0 { target = news_redirect_url(url, locations[0]) }
                    if target == nil || redirects >= news_config.max_redirects { news_http_finish(context, {success: false error: "重定向无效或次数超限" category: "redirect"}); return }
                    news_http_step(target, redirects + 1, context)
                } else if status != 200 { news_http_finish(context, {success: false error: "HTTP " + status category: "http"}) }
                else if response.body == nil { news_http_finish(context, {success: false error: "响应缺少正文" category: "body"}) }
                else { news_http_finish(context, {success: true body: response.body.to_string()}) }
            }
            on_error: |error| {
                news_http_finish(context, {success: false error: error.message category: "network"})
            }
        }
    } {
        news_http_finish(context, {success: false error: "宿主拒绝或无法发起网络请求" category: "host"})
    }
}
