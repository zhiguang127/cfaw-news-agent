// Lexical recall, not semantic indexing. Stable feed order, unique article IDs.
fn topic_rule_matches(row, topic){
    if topic.status != "active" || !topic_is_user_record(topic) { return [] }
    let rules = []
    for i rule in topic.recall_rules { rules.push({interest_id: topic.topic_id + ":" + i kind: rule.kind value: rule.value enabled: true}) }
    interest_matches(row, rules)
}
fn tracking_rule_hint(row){
    for topic in topic_records.topics {
        if topic_rule_matches(row, topic).len() > 0 { return "规则匹配 · " + topic.title }
    }
    let reasons = interest_matches(row, user_interests)
    if reasons.len() > 0 { return "规则匹配 · " + reasons[0] }
    ""
}
// Recall for browsing only. A location/title match does not prove a dated impact.
fn tracking_schedule_rules(){
    let rules = []
    for item in user_schedules {
        if !schedule_is_user_record(item) || !schedule_active(item) || schedule_instant(item.end) < time_now() { continue }
        let words = [item.title]
        if record_string(item["location"]) && item.location.trim() != "" { words.push(item.location) }
        if item["news_keywords"] != nil { for word in item.news_keywords { words.push(word) } }
        for i word in words { rules.push({interest_id: "schedule:" + item.schedule_id + ":" + item.version + ":" + i kind: "keyword" value: word enabled: true
            schedule_id: item.schedule_id schedule_version: item.version}) }
    }
    rules
}
fn tracking_schedule_decisions(){
    let handled = {}
    for decision in topic_records.decisions {
        if decision["kind"] == "insight" { continue }
        for evidence in decision.evidence {
            let key = decision.schedule_id + ":" + decision.schedule_version + ":" + evidence.news_id
            let keys = handled[key]
            if keys == nil { keys = [] handled[key] = keys }
            keys.push(evidence.key)
        }
    }
    handled
}
fn tracking_schedule_candidate(row, rules, handled){
    let evidence_key = ""
    for rule in rules {
        if interest_matches(row, [rule]).len() == 0 { continue }
        let keys = handled[rule.schedule_id + ":" + rule.schedule_version + ":" + row.news_id]
        let suppressed = false
        if keys != nil {
            if evidence_key == "" { evidence_key = tracking_evidence_key(row) }
            for key in keys { if key == evidence_key { suppressed = true } }
        }
        if !suppressed { return true }
    }
    false
}
fn tracking_target_checked(kind, id, version){
    let checked_at = 0
    let state = check_state_find(kind, id, version)
    if state != nil { checked_at = state.watermark }
    for run in tracking_cache.runs {
        let values = run.snapshot.topics let field = "topic_id"
        if kind == "schedule" { values = run.snapshot.schedules field = "schedule_id" }
        if kind == "legacy" { values = run.snapshot.legacy_interests field = "interest_id" }
        for item in values {
            if item[field] == id {
                if kind == "legacy" || item["version"] == version { checked_at = max(checked_at, run.checked_at) }
            }
        }
    }
    checked_at
}
fn tracking_targets(){
    let units = []
    for item in user_schedules {
        if schedule_is_user_record(item) && schedule_active(item) && schedule_instant(item.end) >= time_now() {
            let checked = tracking_target_checked("schedule", item.schedule_id, item.version)
            if schedule_instant(item.start) - time_now() <= 7 * 86400 { checked = checked - agent_preferences.interval_seconds }
            units.push({kind: "schedule" item: item checked_at: checked})
        }
    }
    for item in topic_records.topics {
        if topic_is_user_record(item) && item.status == "active" { units.push({kind: "topic" item: item checked_at: tracking_target_checked("topic", item.topic_id, item.version)}) }
    }
    let legacy = [] for item in user_interests { if item.enabled { legacy.push(item) } }
    if legacy.len() > 0 { units.push({kind: "legacy" item: legacy checked_at: tracking_target_checked("legacy", legacy[0].interest_id, 1)}) }
    let total = units.len() let topics = [] let schedules = [] let interests = []
    // Least-recently checked units rotate bounded coverage across later triggers.
    for step in min(tracking_config.max_targets, total) {
        let index = 0
        for i item in units { if item.checked_at < units[index].checked_at { index = i } }
        let chosen = units.remove(index)
        if chosen.kind == "topic" { topics.push(chosen.item) }
        if chosen.kind == "schedule" { schedules.push(chosen.item) }
        if chosen.kind == "legacy" { interests = chosen.item }
    }
    {topics: topics schedules: schedules legacy_interests: interests omitted_targets: max(0, total - tracking_config.max_targets)}
}
fn tracking_context_key(){
    let topics = [] let schedules = []
    for item in topic_records.topics { topics.push({topic_id: item.topic_id version: item.version status: item.status}) }
    for item in user_schedules { schedules.push({schedule_id: item.schedule_id version: item.version status: item["status"]}) }
    {topics: topics legacy: user_interests schedules: schedules revision: tracking_prompt_revision config: tracking_config}.to_json()
}
fn tracking_snapshot(rows, targets){
    let evidence = []
    for row in rows {
        let summary = row.summary
        let truncated = summary.len() > tracking_config.max_summary_chars
        if truncated { summary = bm25_prefix(summary, tracking_config.max_summary_chars) }
        evidence.push({news_id: row.news_id title: row.title summary: summary source_url: row.source_url
            published_at: row.published_at retrieved_at: row.retrieved_at evidence_kind: row.evidence_kind
            timestamp_kind: row.timestamp_kind summary_truncated: truncated references: row.references
            content_key: tracking_evidence_key(row)})
    }
    let previous = nil
    // Old per-item context is restricted to exactly the same target set/version.
    for i in tracking_cache.runs.len() {
        let old = tracking_cache.runs[tracking_cache.runs.len() - 1 - i]
        if old.snapshot.topics.to_json() == targets.topics.to_json() && old.snapshot.schedules.to_json() == targets.schedules.to_json() && old.snapshot.legacy_interests.to_json() == targets.legacy_interests.to_json() { previous = old.result break }
    }
    let decisions = []
    for item in topic_records.decisions {
        let relevant = false
        if item["kind"] == "insight" {
            for topic in targets.topics { if item.target_type == "topic" && item.target_id == topic.topic_id && item.target_version == topic.version { relevant = true } }
            for schedule in targets.schedules { if item.target_type == "schedule" && item.target_id == schedule.schedule_id && item.target_version == schedule.version { relevant = true } }
        } else { for schedule in targets.schedules { if schedule.schedule_id == item.schedule_id { relevant = true } } }
        if relevant { decisions.push(item) }
    }
    let omitted_decisions = max(0, decisions.len() - 12)
    while decisions.len() > 12 { decisions.remove(0) }
    let snapshot = {schema_version: 1 topics: targets.topics schedules: targets.schedules legacy_interests: targets.legacy_interests
        evidence: evidence previous_result: previous decisions: decisions omitted_targets: targets.omitted_targets
        omitted_candidates: 0 omitted_decisions: omitted_decisions context_key: tracking_context_key() prompt_revision: tracking_prompt_revision previous_by_target: []}
    snapshot.previous_by_target = insight_previous_for(snapshot)
    evidence_attach(snapshot, rows)
    snapshot
}
fn tracking_input_key(snapshot){
    let evidence = [] for item in snapshot.evidence { evidence.push({news_id: item.news_id content_key: item.content_key body_key: item["body_key"]}) }
    {context: snapshot.context_key evidence: evidence decisions: snapshot.decisions
        topics: snapshot.topics schedules: snapshot.schedules omitted_targets: snapshot.omitted_targets omitted_candidates: snapshot.omitted_candidates revision: tracking_prompt_revision}.to_json()
}
