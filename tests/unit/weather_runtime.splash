// Execute the city forecast modules under the pinned native runtime.
// Fixtures are real Open-Meteo responses; expectations are stated values, not
// re-derived from the same code under test.
let weather_test_passes = 0
let weather_test_failures = 0
let weather_test_requests = []
fn weather_test(condition, message){
    if condition { weather_test_passes = weather_test_passes + 1 }
    else {
        weather_test_failures = weather_test_failures + 1
        let previous = ""
        if fs.exists("weather-failures.txt") { previous = fs.read("weather-failures.txt") }
        fs.write("weather-failures.txt", previous + "FAIL weather: " + message + "\n")
    }
}
fn weather_test_reset(){
    weather_initialize()
    weather_tracked = []
    weather_selection = ""
    weather_test_requests = []
}

fn weather_test_run(){
    // A fixed request adapter records callbacks; these cases never contact a provider.
    weather_http_request = fn(url, redirects, callback){ weather_test_requests.push({url: url callback: callback}) }
    // --- condition mapping -------------------------------------------------
    weather_test(weather_condition(0) == "晴", "WMO 0 clear")
    weather_test(weather_condition(61) == "小雨" && weather_condition(65) == "大雨", "rain bands separated")
    weather_test(weather_condition(95) == "雷暴" && weather_condition(82) == "暴雨", "severe codes mapped")
    weather_test(weather_condition(3) == "阴", "overcast")
    weather_test(weather_condition(999) == "天气变化", "unknown code falls back")

    // --- civil date from a UTC epoch, at the fixed UTC+8 offset ------------
    weather_test(weather_day_stamp(0) == "1970-01-01", "epoch")
    weather_test(weather_day_stamp(1790755200) == "2026-09-30", "2026-09-30")
    weather_test(weather_day_stamp(1759276800) == "2025-10-01", "2025-10-01")
    weather_test(weather_day_stamp(1767225600) == "2026-01-01", "2026-01-01")
    weather_test(weather_day_stamp(1735689600) == "2025-01-01", "2025-01-01")
    weather_test(weather_day_stamp(1709164800) == "2024-02-29", "leap day")
    weather_test(weather_day_stamp(951782400) == "2000-02-29", "century leap day")
    weather_test(weather_day_stamp(4107542400) == "2100-03-01", "non-leap century rolls to March")

    // --- parsing a real daily payload ------------------------------------
    weather_test(weather_cities.len() == 30, "thirty supported cities")
    let city = weather_city_by_name("北京")
    weather_test(city != nil && city.cid == "w01", "city resolved by name")
    weather_test(weather_city_by_cid("w99") == nil, "unknown city id resolves to nil")
    let rows = weather_parse(city, fixture_weather, 1000)
    weather_test(rows != nil && rows.len() == 3, "three forecast days parsed")
    weather_test(rows[0].day == "2026-10-02" && rows[0].city_id == "w01", "day and city carried")
    weather_test(rows[0].forecast_id == "w01:2026-10-02", "stable forecast identity")
    weather_test(rows[0].condition == "多云" && rows[1].condition == "多云" && rows[2].condition == "阴", "conditions from codes 2,2,3")
    weather_test(rows[0].temp_min_c == 15.5 && rows[0].temp_max_c == 24.3, "temperature range")
    weather_test(rows[0].precipitation_mm == 0.0, "precipitation carried")
    weather_test(rows[0].fetched_at == 1000, "fetch time, not a publication time")

    // --- refusals ---------------------------------------------------------
    weather_test(weather_parse(city, "{\"daily\":null}", 1000) == nil, "missing daily block refused")
    weather_test(weather_parse(city, "not json", 1000) == nil, "unparseable body refused")
    weather_test(weather_parse(city, "{\"daily\":{\"time\":[\"2026-13-45\"]}}", 1000) == nil, "impossible date refused")
    weather_test(weather_parse(weather_city_by_name("杭州"), "{\"daily\":{\"time\":[]}}", 1000) == nil, "empty day list refused")
    weather_test(weather_parse(city, "{\"daily\":{\"time\":[\"2026-10-02\"]}}", 1000) == nil, "date without required measurements is not invented sunny weather")
    weather_test(weather_parse(city, "{\"daily\":{\"time\":[\"2026-10-02\"],\"weather_code\":[null],\"precipitation_sum\":[0]}}", 1000) == nil, "null weather code is unknown, not clear")
    weather_test(weather_parse(city, "{\"daily\":{\"time\":[\"2026-10-02\"],\"weather_code\":[0],\"precipitation_sum\":[null]}}", 1000) == nil, "null rainfall is unknown, not zero")
    weather_test(weather_parse(city, "{\"daily\":{\"time\":[\"2026-10-02\",\"2026-10-03\"],\"weather_code\":[0],\"precipitation_sum\":[0,0]}}", 1000) == nil, "truncated measurement arrays refused")
    weather_test(weather_parse(city, "{\"daily\":{\"time\":[\"2026-02-31\"],\"weather_code\":[0],\"precipitation_sum\":[0]}}", 1000) == nil, "calendar-impossible date refused")
    weather_test(weather_parse(city, "{\"daily\":{\"time\":[\"2026-10-02\",\"2026-10-02\"],\"weather_code\":[0,0],\"precipitation_sum\":[0,0]}}", 1000) == nil, "duplicate forecast identity refused")
    weather_test(weather_parse(city, "{\"daily\":{\"time\":[\"2026-10-02\"],\"weather_code\":[0],\"precipitation_sum\":[0]}}", 1000) != nil, "observed clear code and zero rainfall remain valid")
    weather_test(!forecast_valid({}) && !forecast_valid({forecast_id: "w01:2026-10-02"}), "incomplete forecast refused")
    let broken = test_clone(rows[0])
    broken.precipitation_mm = -1
    weather_test(!forecast_valid(broken), "negative precipitation refused")
    broken = test_clone(rows[0])
    broken.code = -1
    weather_test(!forecast_valid(broken), "negative weather code refused")
    broken = test_clone(rows[0])
    broken.condition = "晴"
    weather_test(!forecast_valid(broken), "condition cannot contradict its weather code")
    let mismatched = test_clone(rows[0])
    mismatched.forecast_id = "w02:2026-10-02"
    weather_test(!forecast_valid(mismatched), "identity must match city and day")
    let wrongcity = test_clone(rows[0])
    wrongcity.city_id = "w02"
    weather_test(!forecast_valid(wrongcity), "identity must agree with the city field")

    // --- city catalog admission -------------------------------------------
    weather_test(city_valid({cid: "w01" name: "北京" lat: "39.9" lon: "116.4"}), "valid city")
    weather_test(city_valid(weather_cities[0]), "numeric coordinates in generated catalog accepted")
    weather_test(!city_valid({cid: "w01" name: "北京" lat: 91 lon: 116.4}), "out-of-range numeric coordinate refused")
    weather_test(!city_valid({cid: "w01" name: "北京" lat: "39.9" lon: "181"}), "out-of-range textual coordinate refused")
    weather_test(!city_valid({cid: "北京" name: "北京" lat: "39.9" lon: "116.4"}), "non-identifier id refused")
    weather_test(!city_valid({cid: "w01" name: "北京" lat: "north" lon: "116.4"}), "non-numeric coordinate refused")
    weather_test(weather_tracked_valid(["w01" "w02"]), "known ids accepted")
    weather_test(!weather_tracked_valid(["w99"]) && !weather_tracked_valid("w01"), "unknown or non-array rejected")
    weather_test(!weather_tracked_valid(["w01" "w01"]), "duplicate tracked city refused")

    // --- host admission ----------------------------------------------------
    weather_test(weather_request_allowed(weather_url(city)), "forecast host admitted")
    weather_test(!weather_request_allowed("https://example.invalid/v1/forecast"), "unlisted host refused")
    weather_test(!weather_request_allowed("http://api.open-meteo.com/v1/forecast"), "plain http refused")

    // --- on-demand tracking and selection ---------------------------------
    weather_load()
    weather_test(weather_tracked.len() == 0, "starts with nothing tracked")
    weather_select("杭州")
    weather_test(weather_is_tracked("w07"), "picking a city tracks it")
    weather_select("全部")
    weather_test(weather_tracked.len() == 1, "selecting 全部 does not add a city")
    weather_select("并不存在的城市")
    weather_test(weather_tracked.len() == 1, "unknown city name ignored")
    weather_test(weather_rows().len() == 0, "no rows until a fetch lands")
    weather_select("杭州")
    weather_test(weather_tracked.len() == 1, "already tracked city is not duplicated")

    // --- rows are grouped and filtered -------------------------------------
    weather_initialize()
    for cid in ["w01" "w02"] {
        let c = weather_city_by_cid(cid)
        weather_rows_by_city[cid] = weather_parse(c, fixture_weather, 1000)
    }
    weather_tracked = ["w01" "w02"]
    weather_selection = ""
    weather_test(weather_rows().len() == 6, "both cities merged")
    weather_test(weather_rows()[0].city_id == "w01" && weather_rows()[3].city_id == "w02", "grouped by city")
    weather_selection = "上海"
    weather_test(weather_rows().len() == 3 && weather_rows()[0].city_name == "上海", "selection filters to one city")
    weather_selection = ""
    start_timeout(0.01, || weather_test_risks())
}
fn weather_test_risks(){
    // --- explicit coverage and freshness, independent of the display filter ---
    weather_test_reset()
    let event = {start: 1790755200}
    let checked_at = 1790755000
    let risk = weather_event_risk_at(event, checked_at)
    weather_test(!risk.known && risk.checked_cities == 0, "no tracked city is unknown, not safe")
    weather_tracked = ["w01"]
    risk = weather_event_risk_at(event, checked_at)
    weather_test(!risk.known && risk.missing_cities == 1, "unavailable forecast is unknown")
    let city = weather_city_by_name("北京")
    weather_rows_by_city["w01"] = weather_parse(city, fixture_weather, checked_at - 60)
    risk = weather_event_risk_at(event, checked_at)
    weather_test(!risk.known && risk.missing_cities == 1, "event outside forecast coverage is unknown")
    let wet_city = test_clone(weather_rows_by_city["w01"][0])
    wet_city.day = weather_day_stamp(event.start)
    wet_city.forecast_id = "w01:" + wet_city.day
    wet_city.precipitation_mm = 4.9
    weather_rows_by_city["w01"] = [wet_city]
    risk = weather_event_risk_at(event, checked_at)
    weather_test(risk.known && risk.wet_cities == 0 && risk.severe == nil, "observed rainfall below 5mm is known without an alert")
    wet_city.precipitation_mm = 5
    risk = weather_event_risk_at(event, checked_at)
    weather_test(risk.known && risk.wet_cities == 1, "5mm boundary produces a wet-city signal")
    wet_city.precipitation_mm = 0 wet_city.code = 95 wet_city.condition = "雷暴"
    risk = weather_event_risk_at(event, checked_at)
    weather_test(risk.known && risk.wet_cities == 0 && risk.severe == "雷暴", "severe code triggers independently of rainfall")
    wet_city.fetched_at = checked_at - weather_cache_ttl_seconds
    risk = weather_event_risk_at(event, checked_at)
    weather_test(!risk.known && risk.severe == nil && risk.missing_cities == 1, "exact TTL expiry cannot support a weather verdict")
    wet_city.fetched_at = checked_at + 1
    weather_test(!weather_event_risk_at(event, checked_at).known, "future retrieval time is not fresh evidence")
    wet_city.fetched_at = checked_at - 60
    wet_city.code = 3 wet_city.condition = "阴" wet_city.precipitation_mm = 9
    weather_tracked = ["w01" "w02"]
    weather_selection = "上海"
    risk = weather_event_risk_at(event, checked_at)
    weather_test(!risk.known && risk.checked_cities == 1 && risk.missing_cities == 1 && risk.wet_cities == 1, "partial coverage preserves observed risk and cannot claim complete knowledge")
    weather_selection = ""
    weather_test(weather_event_risk_at(event, checked_at).wet_cities == risk.wet_cities, "display selection cannot change event evidence")
    weather_test(weather_event_risk({}) == nil && weather_event_risk({start: "soon"}) == nil, "malformed event refused without crashing")
    start_timeout(0.01, || weather_test_persistence())
}
fn weather_test_persistence(){
    // --- persistence -------------------------------------------------------
    for path in ["weather_selection_v1.json"] { if fs.exists(path) { fs.remove(path) } }
    weather_file = {path: "weather_selection_v1.json" writable: true recovered: false}
    weather_tracked = ["w01" "w03"]
    weather_selection_write()
    weather_test(fs.exists("weather_selection_v1.json"), "selection written")
    weather_tracked = []
    weather_load()
    weather_test(weather_is_tracked("w01") && weather_is_tracked("w03") && weather_tracked.len() == 2, "selection restored")
    weather_test(weather_primary_city().cid == "w01", "legacy selection defaults to its first saved city")
    weather_primary_cid = "w03"
    weather_selection_write()
    weather_primary_cid = ""
    weather_load()
    weather_test(weather_primary_city().cid == "w03", "selected weather city survives restart")
    weather_test(!weather_selection_document_valid({schema_version: 1 tracked: ["w01"] selected_city_id: "w03"}), "selected city must belong to saved cities")
    weather_file.writable = false
    weather_tracked = ["w01"]
    weather_selection_write()
    weather_test(weather_warning != "", "read-only file reports a warning")
    weather_file.writable = true
    fs.write("weather_selection_v1.json", "{\"schema_version\":1,\"tracked\":[\"nope\"]}")
    weather_tracked = ["w02"]
    weather_load()
    weather_test(weather_tracked.len() == 1 && weather_is_tracked("w02"), "unsupported stored ids ignored, prior selection kept")
    let unknown_id = fs.read("weather_selection_v1.json")
    weather_tracked = ["w01"]
    weather_test(!weather_selection_write() && fs.read("weather_selection_v1.json") == unknown_id, "unsupported stored ids cannot be overwritten by defaults")
    fs.write("weather_selection_v1.json", "{\"schema_version\":2,\"tracked\":[\"w03\"]}")
    weather_load()
    let newer_schema = fs.read("weather_selection_v1.json")
    weather_test(!weather_file.writable && !weather_selection_write() && fs.read("weather_selection_v1.json") == newer_schema, "unknown storage version preserved across attempted save")
    fs.write("weather_selection_v1.json", "")
    weather_load()
    weather_test(!weather_file.writable && !weather_selection_write() && fs.read("weather_selection_v1.json") == "", "unreadable or empty user record blocks overwrite")
    fs.write("weather_selection_v1.json", "not json")
    weather_load()
    weather_test(weather_warning != "", "corrupt selection warns instead of pretending to be saved")
    weather_test(!weather_selection_write() && fs.read("weather_selection_v1.json") == "not json", "malformed JSON remains intact")
    fs.write("weather_selection_v1.json", "{\"schema_version\":1,\"tracked\":[\"w02\"]}")
    weather_load()
    weather_tracked = ["w01"]
    fs.write("weather_selection_v1.json", "{\"schema_version\":9,\"tracked\":[\"w03\"]}")
    let changed_file = fs.read("weather_selection_v1.json")
    weather_test(!weather_selection_write() && fs.read("weather_selection_v1.json") == changed_file, "write revalidates user record changed after load")
    fs.write("weather_selection_v1.json", "{\"schema_version\":1,\"tracked\":[\"w02\"]}")
    weather_load()
    weather_tracked = ["w01"]
    weather_test(weather_selection_write() && fs.read("weather_selection_v1.json.backup") == "{\"schema_version\":1,\"tracked\":[\"w02\"]}", "valid previous selection retained before replacement")
    start_timeout(0.01, || weather_test_limits())
}
fn weather_test_limits(){
    weather_test_reset()
    for i in 13 { weather_select_at(weather_cities[i].name, 1000) }
    weather_test(weather_tracked.len() == weather_max_cities && weather_test_requests.len() == weather_max_cities, "selection enforces the twelve-city request and persistence limit")
    weather_test(!weather_track_at("w13", weather_generation, 1000) && !weather_track_at("w99", weather_generation, 1000), "tracking cannot add an excess or unknown city")
    weather_test(weather_selection_document_valid({schema_version: 1 tracked: weather_tracked}), "every selected city list remains persistable")
    fs.write("weather_selection_v1.json", "{\"schema_version\":1,\"tracked\":[\"w02\"]}")
    weather_file.writable = true
    weather_test(weather_selection_write(), "maximum-size valid selection saves")
    weather_tracked = []
    weather_load()
    weather_test(weather_tracked.len() == weather_max_cities, "maximum-size saved selection restores")
    let before = fs.read("weather_selection_v1.json")
    weather_tracked = []
    for i in 13 { weather_tracked.push(weather_cities[i].cid) }
    weather_test(!weather_selection_write() && fs.read("weather_selection_v1.json") == before, "oversized in-memory selection cannot overwrite valid record")
    weather_test(!weather_fetch_cities_at(weather_tracked, weather_generation, 1000), "oversized batch rejected before requests")
    weather_tracked = ["w01" "w01"]
    weather_test(!weather_selection_write() && fs.read("weather_selection_v1.json") == before, "duplicate selection cannot overwrite valid record")
    start_timeout(0.01, || weather_test_refresh())
}
fn weather_test_refresh(){
    weather_test_reset()
    let checked_at = 1790928000
    let city = weather_city_by_name("北京")
    weather_tracked = ["w01"]
    weather_accept(city, {success: true body: fixture_weather}, checked_at)
    weather_fetch_city("w01", weather_generation)
    weather_test_requests[0].callback({success: false error: "Fixture unavailable"})
    weather_select_at("北京", checked_at)
    weather_test(weather_test_requests.len() == 2, "failed refresh retries despite a still-usable older cache")
    weather_test_reset()
    weather_track_at("w01", weather_generation, checked_at)
    weather_test_requests[0].callback({success: false error: "Fixture unavailable"})
    weather_select_at("北京", checked_at)
    weather_test(weather_test_requests.len() == 2 && weather_tracked.len() == 1, "reselecting a tracked city retries failed retrieval without adding a duplicate")
    weather_test_requests[1].callback({success: false error: "Fixture unavailable"})
    weather_accept(city, {success: true body: fixture_weather}, checked_at)
    weather_fetch_cities_at(["w01"], weather_generation, checked_at + weather_cache_ttl_seconds - 1)
    weather_test(weather_test_requests.len() == 2, "unexpired forecast avoids redundant network work")
    weather_fetch_cities_at(["w01"], weather_generation, checked_at + weather_cache_ttl_seconds)
    weather_test(weather_test_requests.len() == 3 && weather_pending == 1, "expired forecast starts a new request at the TTL boundary")
    weather_fetch_cities_at(["w01"], weather_generation, checked_at + weather_cache_ttl_seconds)
    weather_test(weather_test_requests.len() == 3, "in-flight city request is not duplicated")
    let old_reply = weather_test_requests[2].callback
    weather_cancel()
    old_reply({success: true body: fixture_weather})
    weather_test(weather_pending == 0 && weather_status_by_city["w01"].fetched_at == checked_at, "cancelled completion cannot overwrite retained forecast or pending count")
    weather_refresh()
    weather_test(weather_test_requests.len() == 4 && weather_pending == 1, "explicit refresh rechecks a tracked city even before cache expiry")
    let reply = weather_test_requests[3].callback
    reply({success: true body: fixture_weather})
    reply({success: false error: "Duplicate fixture callback"})
    weather_test(weather_pending == 0 && weather_status_by_city["w01"].state == "fresh", "duplicate callback cannot reverse accepted data or underflow pending count")
    weather_fetch_city("w01", weather_generation)
    let superseded = weather_test_requests[4].callback
    weather_initialize()
    superseded({success: true body: fixture_weather})
    weather_test(weather_pending == 0 && weather_rows_by_city["w01"].len() == 0, "reinitialization invalidates previous request completions")
    weather_test_finish()
}
fn weather_test_finish(){
    let report = {passed: weather_test_passes failed: weather_test_failures stage: "complete" failure_detail: ""}
    if weather_test_failures > 0 {
        if fs.exists("weather-failures.txt") { report.failure_detail = fs.read("weather-failures.txt") }
    }
    fs.write("weather-report.json", report.to_json())
}
HostedView{full: View{Label{text: "CFAW weather runtime tests"}}}
start_timeout(0.05, || {
    weather_test_run()
})
