// Execute the city forecast modules under the pinned native runtime.
// Fixtures are real Open-Meteo responses; expectations are stated values, not
// re-derived from the same code under test.
let weather_test_passes = 0
let weather_test_failures = 0
fn weather_test(condition, message){
    if condition { weather_test_passes = weather_test_passes + 1 }
    else {
        weather_test_failures = weather_test_failures + 1
        let previous = ""
        if fs.exists("weather-failures.txt") { previous = fs.read("weather-failures.txt") }
        fs.write("weather-failures.txt", previous + "FAIL weather: " + message + "\n")
    }
}

fn weather_test_run(){
    // --- condition mapping -------------------------------------------------
    weather_test(weather_condition(0) == "晴", "WMO 0 clear")
    weather_test(weather_condition(61) == "小雨" && weather_condition(65) == "大雨", "rain bands separated")
    weather_test(weather_condition(95) == "雷暴" && weather_condition(82) == "暴雨", "severe codes mapped")
    weather_test(weather_condition(3) == "阴", "overcast")
    weather_test(weather_condition(999) == "天气变化", "unknown code falls back")

    // --- civil date from a UTC epoch, at the fixed UTC+8 offset ------------
    weather_test(weather_day_stamp(0) == "1970-01-01", "epoch")
    weather_test(weather_day_stamp(1790755200) == "2026-09-30", "2026-09-30")
    weather_test(weather_day_stamp(1759276800) == "2025-10-01", "2025-10-01")
    weather_test(weather_day_stamp(1767225600) == "2026-01-01", "2026-01-01")
    weather_test(weather_day_stamp(1735689600) == "2025-01-01", "2025-01-01")
    weather_test(weather_day_stamp(1709164800) == "2024-02-29", "leap day")
    weather_test(weather_day_stamp(951782400) == "2000-02-29", "century leap day")
    weather_test(weather_day_stamp(4107542400) == "2100-03-01", "non-leap century rolls to March")

    // --- parsing a real daily payload ------------------------------------
    weather_test(weather_cities.len() == 30, "thirty supported cities")
    let city = weather_city_by_name("北京")
    weather_test(city != nil && city.cid == "w01", "city resolved by name")
    weather_test(weather_city_by_cid("w99") == nil, "unknown city id resolves to nil")
    let rows = weather_parse(city, fixture_weather, 1000)
    weather_test(rows != nil && rows.len() == 3, "three forecast days parsed")
    weather_test(rows[0].day == "2026-10-02" && rows[0].city_id == "w01", "day and city carried")
    weather_test(rows[0].forecast_id == "w01:2026-10-02", "stable forecast identity")
    weather_test(rows[0].condition == "多云" && rows[1].condition == "多云" && rows[2].condition == "阴", "conditions from codes 2,2,3")
    weather_test(rows[0].temp_min_c == 15.5 && rows[0].temp_max_c == 24.3, "temperature range")
    weather_test(rows[0].precipitation_mm == 0.0, "precipitation carried")
    weather_test(rows[0].fetched_at == 1000, "fetch time, not a publication time")

    // --- refusals ---------------------------------------------------------
    weather_test(weather_parse(city, "{\"daily\":null}", 1000) == nil, "missing daily block refused")
    weather_test(weather_parse(city, "not json", 1000) == nil, "unparseable body refused")
    weather_test(weather_parse(city, "{\"daily\":{\"time\":[\"2026-13-45\"]}}", 1000) == nil, "impossible date refused")
    weather_test(weather_parse(weather_city_by_name("杭州"), "{\"daily\":{\"time\":[]}}", 1000) == nil, "empty day list refused")
    weather_test(!forecast_valid({}) && !forecast_valid({forecast_id: "w01:2026-10-02"}), "incomplete forecast refused")
    let broken = test_clone(rows[0])
    broken.precipitation_mm = -1
    weather_test(!forecast_valid(broken), "negative precipitation refused")
    let mismatched = test_clone(rows[0])
    mismatched.forecast_id = "w02:2026-10-02"
    weather_test(!forecast_valid(mismatched), "identity must match city and day")
    let wrongcity = test_clone(rows[0])
    wrongcity.city_id = "w02"
    weather_test(!forecast_valid(wrongcity), "identity must agree with the city field")

    // --- city catalog admission -------------------------------------------
    weather_test(city_valid({cid: "w01" name: "北京" lat: "39.9" lon: "116.4"}), "valid city")
    weather_test(!city_valid({cid: "北京" name: "北京" lat: "39.9" lon: "116.4"}), "non-identifier id refused")
    weather_test(!city_valid({cid: "w01" name: "北京" lat: "north" lon: "116.4"}), "non-numeric coordinate refused")
    weather_test(weather_tracked_valid(["w01" "w02"]), "known ids accepted")
    weather_test(!weather_tracked_valid(["w99"]) && !weather_tracked_valid("w01"), "unknown or non-array rejected")

    // --- host admission ----------------------------------------------------
    weather_test(weather_request_allowed(weather_url(city)), "forecast host admitted")
    weather_test(!weather_request_allowed("https://example.invalid/v1/forecast"), "unlisted host refused")
    weather_test(!weather_request_allowed("http://api.open-meteo.com/v1/forecast"), "plain http refused")

    // --- on-demand tracking and selection ---------------------------------
    weather_load()
    weather_test(weather_tracked.len() == 0, "starts with nothing tracked")
    weather_select("杭州")
    weather_test(weather_is_tracked("w07"), "picking a city tracks it")
    weather_select("全部")
    weather_test(weather_tracked.len() == 1, "selecting 全部 does not add a city")
    weather_select("并不存在的城市")
    weather_test(weather_tracked.len() == 1, "unknown city name ignored")
    weather_test(weather_rows().len() == 0, "no rows until a fetch lands")
    weather_select("杭州")
    weather_test(weather_tracked.len() == 1, "already tracked city is not duplicated")

    // --- rows are grouped and filtered -------------------------------------
    weather_initialize()
    for cid in ["w01" "w02"] {
        let c = weather_city_by_cid(cid)
        weather_rows_by_city[cid] = weather_parse(c, fixture_weather, 1000)
    }
    weather_tracked = ["w01" "w02"]
    weather_selection = ""
    weather_test(weather_rows().len() == 6, "both cities merged")
    weather_test(weather_rows()[0].city_id == "w01" && weather_rows()[3].city_id == "w02", "grouped by city")
    weather_selection = "上海"
    weather_test(weather_rows().len() == 3 && weather_rows()[0].city_name == "上海", "selection filters to one city")
    weather_selection = ""

    // --- event risk is a rule, not a judgement -----------------------------
    weather_test(weather_event_risk({start: 1790755200}) == nil, "no risk without matching day")
    let wet_city = test_clone(weather_rows()[0])
    wet_city.day = weather_day_stamp(1790755200)
    wet_city.precipitation_mm = 9.0
    weather_rows_by_city["w01"] = [wet_city]
    let risk = weather_event_risk({start: 1790755200})
    weather_test(risk != nil && risk.wet_cities == 1, "rain on the event day is reported")
    weather_test(weather_event_risk({}) == nil && weather_event_risk({start: "soon"}) == nil, "malformed event refused without crashing")

    // --- persistence -------------------------------------------------------
    for path in ["weather_selection_v1.json"] { if fs.exists(path) { fs.remove(path) } }
    weather_file = {path: "weather_selection_v1.json" writable: true recovered: false}
    weather_tracked = ["w01" "w03"]
    weather_selection_write()
    weather_test(fs.exists("weather_selection_v1.json"), "selection written")
    weather_tracked = []
    weather_load()
    weather_test(weather_is_tracked("w01") && weather_is_tracked("w03") && weather_tracked.len() == 2, "selection restored")
    weather_file.writable = false
    weather_tracked = ["w01"]
    weather_selection_write()
    weather_test(weather_warning != "", "read-only file reports a warning")
    weather_file.writable = true
    fs.write("weather_selection_v1.json", "{\"schema_version\":1,\"tracked\":[\"nope\"]}")
    weather_tracked = ["w02"]
    weather_load()
    weather_test(weather_tracked.len() == 1 && weather_is_tracked("w02"), "unsupported stored ids ignored, prior selection kept")
    fs.write("weather_selection_v1.json", "not json")
    weather_load()
    weather_test(weather_warning != "", "corrupt selection warns instead of pretending to be saved")
}
HostedView{full: View{Label{text: "CFAW weather runtime tests"}}}
start_timeout(0.05, || {
    weather_test_run()
    start_timeout(0.02, || {
        let report = {passed: weather_test_passes failed: weather_test_failures stage: "complete"}
        if weather_test_failures > 0 {
            if fs.exists("weather-failures.txt") { report.failure_detail = fs.read("weather-failures.txt") }
        }
        fs.write("weather-report.json", report.to_json())
    })
})
