// Execute the actual application data modules under the pinned native runtime.
let test_passes = []
let test_failures = []
let test_stage = "startup"
let test_async_ids = []
let test_stale_builds = 0
fn test_assert(condition, label){
    if condition { test_passes.push(label) } else { test_failures.push(label) }
}
fn test_clone(value){ value.to_json().parse_json() }
fn test_reset_records(){
    for path in ["bookmarks_v1.json" "interests_v1.json" "tracking_state_v1.json" "saved.json"] {
        if fs.exists(path) { fs.remove(path) }
        if fs.exists(path + ".backup") { fs.remove(path + ".backup") }
    }
    bookmark_file = {path: "bookmarks_v1.json" writable: true recovered: false}
    interest_file = {path: "interests_v1.json" writable: true recovered: false}
    tracking_file = {path: "tracking_state_v1.json" writable: true recovered: false}
    records_load()
}
fn test_run(){
    test_stage = "parsing"
    let source = news_source("bbc")
    let rows = news_parse(fixture_rss, source, 100)
    test_assert(rows.len() == 2, "RSS items parsed")
    test_assert(rows[0].published_at == 1790755200 && rows[1].published_at == nil, "published date and unknown date preserved")
    test_assert(rows[0].summary == "Fixture summary only.", "RSS HTML summary stripped")
    test_assert(rows[0].news_id == "https://example.org/first", "fragment removed from stable identity")
    let imaged = news_normalize({title: "Image fixture" link: "https://example.org/image" image: "https://ichef.bbci.co.uk/fixture.png"}, source, 100)
    test_assert(news_record_valid(imaged) && imaged.image_url == "https://ichef.bbci.co.uk/fixture.png", "optional HTTPS thumbnail preserved and validated")
    let unsafe_image = news_normalize({title: "Image fixture" link: "https://example.org/image" image: "http://example.org/fixture.png"}, source, 100)
    test_assert(news_record_valid(unsafe_image) && unsafe_image.image_url == nil, "insecure thumbnail omitted without discarding article")
    imaged.image_url = 3
    test_assert(!news_record_valid(imaged), "invalid stored thumbnail type rejected")
    let legacy_image_row = test_clone(rows[0]) legacy_image_row.image_url = nil
    test_assert(news_record_valid(legacy_image_row), "legacy news without thumbnail remains valid")
    test_assert(!news_record_valid({}) && news_normalize({title: "Incomplete fixture"}, source, 100) == nil, "incomplete records refused without crashing")
    test_assert(!records_document_valid({schema_version: 1 items: rows}, "bookmarks"), "bookmark without saved timestamp refused")
    let atom = news_parse(fixture_atom, source, 100)
    test_assert(atom.len() == 1 && atom[0].source_url == "https://example.org/atom", "Atom link parsed")
    let article = article_extract("<html><nav><p>Navigation</p></nav><article><p>First &amp; evidence.</p><p>Second <b>paragraph</b>.</p></article></html>")
    test_assert(article.paragraphs.len() == 2 && article.paragraphs[0] == "First & evidence." && article.paragraphs[1] == "Second paragraph.", "reader extracts decoded article paragraphs and excludes navigation")
    test_assert(article_extract("<html><p>Cookie consent only</p></html>").paragraphs.len() == 0, "reader refuses non-article page text")
    test_assert(article_url_allowed("https://www.bbc.com/news/fixture") && !article_url_allowed("https://www.bbc.com@evil.example/fixture") && !article_url_allowed("javascript:alert(1)"), "reader confines source pages to configured HTTPS hosts")
    test_assert(article_srcset_url("/small.jpg 320w, /reader.jpg 900w, /print.jpg 3000w") == "/reader.jpg" && article_srcset_url("/print.jpg 3000w") == nil, "reader selects bounded responsive image rather than oversized print source")
    test_assert(article_srcset_url("/tiny.jpg 320w,https://cdn.vox-cdn.com/photo.jpg?auto=format,compress 900w,/print.jpg 3000w") == "https://cdn.vox-cdn.com/photo.jpg?auto=format,compress", "responsive URL query commas and compact separators are preserved")
    let responsive = article_extract("<meta property='og:image' content='/images/cover.jpg'><img width='270' src='/thumb/cover.jpg'><img width='900' data-src='/reader/cover_0.jpg' src='/placeholder.jpg'><article><p>Real body fixture</p><img data-srcset='/tiny.jpg 320w, /body.jpg 900w, /large.jpg 3000w' src='data:image/gif;base64,AA=='></article>", "https://news.mit.edu/test")
    test_assert(responsive.images.len() == 2 && responsive.images[0].url == "https://news.mit.edu/reader/cover_0.jpg" && responsive.images[1].url == "https://news.mit.edu/body.jpg", "cover uses publisher reader derivative and lazy srcset preserves body image")
    test_assert(!article_image_allowed("https://news.mit.edu@evil.example/photo.jpg") && !article_image_bytes_supported("<html>challenge</html>".to_bytes()), "images retain host permission and reject HTML challenge bytes")
    let old_article_request = article_http_request
    // The standalone data suite omits app/tracking; use its data fingerprint
    // at the reader cache boundary while exercising stale/duplicate replies.
    let old_article_key = analysis_article_key
    analysis_article_key = fn(row){ tracking_evidence_key(row) }
    let article_replies = []
    article_http_request = fn(url, redirects, callback){ article_replies.push(callback) }
    let obsolete_article_callbacks = 0
    article_load(news_normalize({title: "First reader fixture" link: "https://www.bbc.com/news/first"}, source, 100), || { obsolete_article_callbacks = obsolete_article_callbacks + 1 })
    article_load(news_normalize({title: "Second reader fixture" link: "https://www.bbc.com/news/second"}, source, 100), || {})
    article_replies[0]({success: true body: "<article><p>Old article</p></article>"})
    test_assert(article_state.state == "loading" && article_state.paragraphs.len() == 0 && obsolete_article_callbacks == 0, "late article cannot replace a newer reader request")
    article_replies[1]({success: true body: "<article><p>Current article</p></article>"})
    article_replies[1]({success: true body: "<article><p>Duplicate callback</p></article>"})
    test_assert(article_state.paragraphs[0] == "Current article", "reader ignores duplicate completions")
    test_assert(news_http_verification({"x-amzn-waf-action": ["captcha"]}) && news_http_verification({"X-Amzn-Waf-Action": ["challenge"]}), "AWS verification headers recognized for captcha and challenge")
    test_assert(!news_http_verification({}) && !news_http_verification(nil) && !news_http_verification({"x-amzn-waf-action": ["other"]}), "ordinary responses not mistaken for verification")
    article_load(news_normalize({title: "Protected reader fixture" link: "https://arstechnica.com/protected"}, source, 100), || {})
    article_replies[2]({success: false error: "Verification" category: "verification"})
    test_assert(article_state.state == "unavailable" && article_state.requires_verification && article_state.paragraphs.len() == 0 && article_state.error == "网站需要验证。请在应用内原文页完成验证后继续阅读。", "verification routes to in-app original without fabricated body")
    test_assert(news_http_verification({"cf-mitigated": ["challenge"]}) && !news_http_verification({"cf-mitigated": ["other"]}), "Cloudflare verification distinguished from ordinary responses")
    article_http_request = old_article_request
    analysis_article_key = old_article_key
    test_stage = "HN JSON decode"
    let hn_data = fixture_hn.parse_json()
    test_assert(record_object(hn_data) && record_array(hn_data.hits), "HN JSON object and hits validated")
    test_stage = "HN normalize first hit"
    let hn_hit = hn_data.hits[0]
    test_assert(record_string(hn_hit.objectID) && record_number(hn_hit.created_at_i), "HN ID and submission time validated")
    test_assert(news_normalize({title: hn_hit.title link: hn_hit.url summary: "" published: hn_hit.created_at_i}, news_source("hn"), 100) != nil, "HN row normalizes")
    test_stage = "HN parse adapter"
    let hn_source = news_source("hn")
    let hn_rows = news_parse(fixture_hn, hn_source, 100)
    test_assert(hn_rows.len() == 2 && hn_rows[0].timestamp_kind == "submitted", "HN submission timestamp distinct")
    test_assert(hn_rows[1].source_url == "https://news.ycombinator.com/item?id=124", "HN missing external URL uses discussion")
    test_stage = "HTML refusal"
    let invalid_feed = news_parse("<html>error</html>", source, 100)
    test_assert(invalid_feed == nil, "HTML response refused")
    test_assert(news_parse("{\"hits\":[]}", news_source("hn"), 100).len() == 0, "valid empty JSON feed accepted")
    start_timeout(0.02, || {
    test_stage = "merge and interests"
    let other = test_clone(rows[0])
    other.source_id = "guardian"
    other.references = [{source_id: "guardian" source: "Fixture Guardian" source_url: other.source_url feed_url: "https://example.org/feed"}]
    let other_group = [other]
    let merged = news_merge([rows other_group atom])
    test_assert(merged.len() == 3 && merged[1].references.len() == 2, "duplicate URL merged with provenance")
    test_assert(rows[0].references.len() == 1, "merge does not mutate cached inputs")
    test_assert(merged[2].published_at == nil, "unknown dates sort after known dates")
    let rules = [{interest_id: "keyword:C++" kind: "keyword" value: "C++" enabled: true created_at: 1}]
    test_assert(interest_matches(rows[0], rules).len() == 1 && interest_matches(rows[1], rules).len() == 0, "keyword metacharacters treated literally")
    rules[0].enabled = false
    test_assert(interest_matches(rows[0], rules).len() == 0, "disabled rules ignored")
    start_timeout(0.02, || {
    test_stage = "persistent records"
    test_reset_records()
    test_assert(records_toggle_bookmark(rows[0]) == "", "bookmark write succeeds")
    let expected_title = rows[0].title
    rows[0].title = "Changed input"
    test_assert(user_bookmarks[0].title == expected_title, "bookmark owns independent article snapshot")
    rows[0].title = expected_title
    records_add_interest("source", rows[0].source)
    records_add_interest("category", "world")
    records_add_interest("keyword", "C++")
    records_load()
    test_assert(user_bookmarks.len() == 1 && user_interests.len() == 3, "bookmarks and interests reload from storage")
    test_assert(records_add_interest("keyword", "C++") != "" && user_interests.len() == 3, "duplicate interest refused")
    records_toggle_source("bbc")
    records_load()
    test_assert(!record_contains(enabled_source_ids, "bbc"), "source selection survives reload")
    start_timeout(0.02, || {
    test_stage = "tracking changes"
    records_check_tracking(rows, user_interests, 100, || true, fn(error){
    test_assert(tracking_state.unread_ids.len() == 0, "first successful check establishes baseline")
    let new_row = test_clone(rows[0])
    new_row.news_id = "https://example.org/new"
    new_row.source_url = new_row.news_id
    records_check_tracking([new_row], user_interests, 101, || true, fn(error){
    records_check_tracking([new_row], user_interests, 102, || true, fn(error){
    test_assert(tracking_state.unread_ids.len() == 1, "new matching news marked once across repeated checks")
    records_mark_read(new_row.news_id)
    records_load()
    test_assert(tracking_state.unread_ids.len() == 0 && record_contains(tracking_state.seen_ids, new_row.news_id), "read decision persists")
    start_timeout(0.02, || {
    test_stage = "storage recovery"
    records_toggle_bookmark(rows[1])
    let damaged = "broken fixture record"
    fs.write(bookmark_file.path, damaged)
    bookmark_file = {path: "bookmarks_v1.json" writable: true recovered: false}
    let recovered = records_read(bookmark_file, "bookmarks")
    test_assert(recovered != nil && bookmark_file.recovered, "corrupt primary recovers previous valid backup")
    test_assert(records_write(bookmark_file, recovered, "bookmarks") == "" && fs.read(bookmark_file.path) == damaged, "recovery preserves damaged original")
    fs.write(bookmark_file.path, "{\"schema_version\":99,\"items\":[]}")
    bookmark_file = {path: "bookmarks_v1.json" writable: true recovered: false}
    test_assert(records_read(bookmark_file, "bookmarks") == nil && !bookmark_file.writable && !bookmark_file.recovered, "unknown schema preserved without downgrading backup")
    test_reset_records()
    fs.write("saved.json", "[{\"title\":\"Legacy fixture\",\"link\":\"https://example.org/legacy\",\"source\":\"Fixture\",\"published\":0,\"summary\":\"\"}]")
    records_load()
    test_assert(user_bookmarks.len() == 1 && user_bookmarks[0].published_at == nil && fs.exists("saved.json"), "legacy bookmarks migrate without invented dates or deleting original")
    test_reset_records()
    fs.write("saved.json", "[{\"title\":\"broken fixture\"}]")
    records_load()
    test_assert(!bookmark_file.writable && fs.exists("saved.json") && !fs.exists(bookmark_file.path), "incomplete migration preserves original and refuses overwrite")
    start_timeout(0.02, || {
    test_stage = "request boundaries"
    test_assert(news_request_allowed(news_source("bbc").url), "catalog HTTPS host allowed")
    test_assert(!news_request_allowed("https://evil.example/feed") && !news_request_allowed("http://feeds.bbci.co.uk/feed"), "unknown hosts and HTTP refused")
    test_assert(news_redirect_url(source.url, "/new") == "https://feeds.bbci.co.uk/new", "same-host redirect resolved")
    start_timeout(0.02, || {
    test_stage = "refresh cancellation and callbacks"
    feed_load_cache()
    let demo = test_clone(rows[0]) demo.demo_data = true
    fs.write("news_cache_v1_bbc.json", {schema_version: 1 source_id: "bbc" retrieved_at: 100 items: [demo rows[1]]}.to_json())
    feed_read_cache(source)
    test_assert(feed_rows_by_source["bbc"].len() == 1 && feed_rows_by_source["bbc"][0].news_id == rows[1].news_id, "mixed cache removes demo and preserves real news")
    test_assert(fs.read("news_cache_v1_bbc.json").parse_json().items.len() == 1, "clean cache persists after reload")
    fs.write("news_cache_v1_bbc.json", {schema_version: 1 source_id: "bbc" retrieved_at: 100 items: [demo]}.to_json())
    feed_read_cache(source)
    test_assert(feed_rows_by_source["bbc"].len() == 0 && feed_refresh_needed_ids(["bbc"], 101).len() == 1, "demo-only cache is empty and requests real refresh")
    test_assert(news_merge([[demo rows[1]]]).len() == 1, "merge cannot expose demo news")
    let saved_demo = test_clone(demo) saved_demo.bookmarked_at = 1
    let saved_real = test_clone(rows[1]) saved_real.bookmarked_at = 1
    fs.write(bookmark_file.path, {schema_version: 1 items: [saved_demo saved_real]}.to_json())
    fs.write(bookmark_file.path + ".backup", {schema_version: 1 items: [saved_demo]}.to_json())
    records_load()
    test_assert(user_bookmarks.len() == 1 && fs.read(bookmark_file.path).parse_json().items.len() == 1 && fs.read(bookmark_file.path + ".backup").parse_json().items.len() == 0, "demo bookmarks and recovery backup cleaned with real bookmark preserved")
    let requests = []
    let request = fn(url, redirects, callback){ requests.push({url: url callback: callback}) }
    let updates = 0
    let completions = 0
    feed_refresh(["bbc" "guardian" "cnbc" "jin10"], || { updates = updates + 1 }, fn(count){ completions = completions + 1 }, request)
    test_assert(requests.len() == 3 && feed_task.active == 3, "refresh bounds concurrent requests")
    let first = requests[0].callback
    first({success: true body: fixture_rss})
    first({success: true body: fixture_atom})
    start_timeout(0.03, || {
    test_assert(updates == 1 && requests.len() == 4 && feed_task.completed == 1, "duplicate callback cannot complete a request twice")
    feed_cancel()
    let prior = feed_rows_by_source["bbc"].to_json()
    requests[1].callback({success: true body: fixture_atom})
    test_assert(updates == 1 && completions == 0 && feed_rows_by_source["bbc"].to_json() == prior, "cancelled generation ignores stale callback")
    requests = []
    feed_refresh(["bbc"], || { updates = updates + 1 }, fn(count){ completions = completions + 1 }, request)
    requests[0].callback({success: false error: "fixture offline"})
    test_assert(feed_rows_by_source["bbc"].len() == 2 && feed_status_by_source["bbc"].state == "error", "failed source retains real cached rows and failure")
    start_timeout(0.03, || {
    test_assert(completions == 1, "refresh completion delivered once")
    requests = []
    feed_refresh(["hn"], || {}, fn(count){ completions = completions + 1 }, request)
    requests[0].callback({success: true body: "{\"hits\":[]}"})
    test_assert(feed_rows_by_source["hn"].len() == 0 && feed_status_by_source["hn"].state == "fresh", "valid empty result distinct from failed request")
    feed_status_by_source["bbc"].retrieved_at = 1000
    test_assert(feed_refresh_needed_ids(["bbc"], 1100).len() == 0, "recent cache skips startup network refresh")
    test_assert(feed_refresh_needed_ids(["bbc"], 1000 + news_config.startup_refresh_seconds).len() == 1, "startup retries cache at refresh age boundary")
    test_assert(feed_refresh_needed_ids(["bbc"], 999).len() == 1, "future retrieval time cannot suppress startup refresh")
    start_timeout(0.03, || test_simultaneous_completion())
    })
    })
    })
    })
    })
    })
    })
    })
    })
    })
    })
}
fn test_report(){ fs.write("runtime-report.json", {passed: test_passes.len() failed: test_failures.len() failures: test_failures stage: test_stage}.to_json()) }
fn test_simultaneous_completion(){
    test_stage = "simultaneous source completion"
    let updates = 0
    let completed_after_updates = 0
    let requests = []
    feed_refresh(["bbc" "guardian" "cnbc"], || { updates = updates + 1 }, fn(count){ completed_after_updates = updates },
        fn(url, redirects, callback){ requests.push(callback) })
    for callback in requests { callback({success: false error: "synthetic simultaneous failure"}) }
    start_timeout(0.04, || {
        test_assert(updates == 3 && completed_after_updates == 3, "final completion follows all source updates even when responses arrive together")
        test_capacity_seed(0)
    })
}
fn test_capacity_seed(index){
    test_stage = "bounded feed capacity"
    if index >= news_sources.len() {
        // The fixture seeds items_per_source rows per source with
        // published = index*20 + i, so the newest and the retained-oldest
        // timestamps follow from the source count. Deriving them keeps this
        // correct when a source is added instead of pinning one catalog.
        let seeded = news_sources.len() * news_config.items_per_source
        let newest = (news_sources.len() - 1) * news_config.items_per_source + news_config.items_per_source - 1
        let oldest_kept = newest - news_config.max_feed_items + 1
        feed_build_rows(test_async_ids, fn(rows){ test_stale_builds = test_stale_builds + 1 })
        feed_build_rows(test_async_ids, fn(rows){
            test_assert(seeded >= news_config.max_feed_items, "fixture seeds more rows than the feed cap")
            test_assert(rows.len() == news_config.max_feed_items && rows[0].published_at == newest && rows[news_config.max_feed_items - 1].published_at == oldest_kept, "every enabled source merges and sorts within runtime budgets")
            test_assert(test_stale_builds == 0, "superseded asynchronous list build ignored")
            tracking_state = {schema_version: 1 last_checked_at: 1 seen_ids: [] unread_ids: []}
            tracking_unread_index = {}
            test_tracking_seed(rows, 0)
        })
        return
    }
    let source = news_sources[index]
    test_async_ids.push(source.id)
    let rows = []
    for i in news_config.items_per_source {
        rows.push(news_normalize({title: "Synthetic capacity fixture" link: "https://example.org/capacity/" + source.id + "/" + i
            source: source.label summary: "Test fixture only" published: index * 20 + i}, source, 100))
    }
    feed_rows_by_source[source.id] = rows
    start_timeout(0.01, || test_capacity_seed(index + 1))
}
fn test_tracking_seed(rows, index){
    test_stage = "bounded tracking capacity"
    let end = min(index + news_config.work_batch_items, news_config.max_seen_ids)
    while index < end { tracking_state.seen_ids.push("https://example.org/history/" + index) index = index + 1 }
    if index < news_config.max_seen_ids { start_timeout(0.01, || test_tracking_seed(rows, index)) return }
    let interests = [{interest_id: "keyword:Synthetic" kind: "keyword" value: "Synthetic" enabled: true created_at: 1}]
    records_check_tracking(rows, interests, 200, || true, fn(error){
        test_assert(error == "" && tracking_state.seen_ids.len() == news_config.max_seen_ids, "full tracking history is pruned and persisted within runtime budgets")
        test_assert(tracking_state.unread_ids.len() == rows.len() && tracking_state.seen_ids[0] == "https://example.org/history/" + rows.len(), "new matching capacity rows become unread and only oldest IDs are evicted")
        let read_id = rows[0].news_id
        records_check_tracking(rows, interests, 201, || true, fn(error){
            test_assert(!records_is_unread(read_id) && tracking_state.unread_ids.len() == rows.len() - 1, "reading during a batched check survives its completion")
            test_stage = "complete"
            test_report()
        })
        start_timeout(0.02, || records_mark_read(read_id))
    })
}
HostedView{full: View{Label{text: "CFAW data runtime tests — synthetic fixtures"}}}
start_timeout(0.05, || {
    test_run()
})
