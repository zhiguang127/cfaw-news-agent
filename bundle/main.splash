    if !regex("^[0-9]{4}-[0-9]{2}-[0-9]{2}$").test(day) { return false }
    let parts = day.split("-")
    if parts.len() != 3 { return false }
    if !record_contains(weather_months, parts[1]) || !record_contains(weather_day_numbers, parts[2]) { return false }
    day == weather_day_stamp(weather_time_stamp(day))
}
