let octos_testing = false
let octos_timeout_seconds = 90
let octos_message = "未测试。点击后显示真实回复或错误。"
fn set_octos_message(text){
    octos_message = text
    if detail_kind == "settings" { ui.octos_status.set_text(text) }
}

// Uses the assistant selected in Rinx, never a model endpoint or app-owned key.
fn test_octos(){
    if octos_testing { return }
    if !host.has("octos.session.open") || !host.has("octos.turn.start") || !host.has("octos.turn.interrupt") {
        set_octos_message("Octos permissions missing. Review the updated bundle and run it again.")
        return
    }
    octos_testing = true
    set_octos_message("Opening Octos context...")
    let done = false
    let timer = start_timeout(octos_timeout_seconds, || {
        if done { return }
        done = true
        set_octos_message("Octos timed out after 90 seconds. Stopping request...")
        let stopping = true
        let stop_timer_id = start_timeout(10, || {
            if stopping {
                set_octos_message("Octos timed out; stop was not acknowledged. Close and reopen this app before retrying.")
            }
        })
        host.request("octos.turn.interrupt", {}, fn(stopped){
            if !stopping { return }
            stopping = false
            stop_timer(stop_timer_id)
            if stopped.is_ok {
                octos_testing = false
                set_octos_message("Octos timed out; request stopped. Check the host/model connection, then retry.")
            } else {
                set_octos_message("Octos timed out; close and reopen this app. Stop error: " + stopped.error)
            }
        })
    })
    host.request("octos.session.open", {}, fn(opened){
        if done { return }
        if !opened.is_ok {
            done = true
            stop_timer(timer)
            octos_testing = false
            set_octos_message("Octos context failed: " + opened.error)
            return
        }
        set_octos_message("Context opened. Waiting for a real model reply...")
        host.request("octos.turn.start", {text: "Connectivity test. Do not use tools. Reply with only OCTOS_OK."}, fn(reply){
            if done { return }
            done = true
            stop_timer(timer)
            octos_testing = false
            if !reply.is_ok {
                set_octos_message("Octos model request failed: " + reply.error)
            } else if reply.data == nil || reply.data.text == nil || reply.data.text == "" {
                set_octos_message("Octos returned no model text; connectivity is not confirmed.")
            } else {
                set_octos_message("Octos replied: " + reply.data.text)
            }
        })
    })
}
// Where stories come from: the host's `news` service when this shell offers
// it (it fetches on a timer and keeps the stories, so News opens from its
// cache), else this script's own fetch, as in shells without the service.
// TODO(App-Hub#18): the shells register the service, but manifest.json does
// not request `news` yet: App Hub's pinned admission does not know the
// capability. Add it once App Hub is repinned past OctoSense-App-Hub#18.
let use_service = false
let service_waiting = 0
let service_relist = false
let specials = ["\\" "." "*" "+" "?" "(" ")" "[" "]" "{" "}" "|" "^" "$"]

// CFAW Rinx adapter: bounded callbacks avoid the pending await path in this host.
fn request_feed(url, extra, callback){
    let done = false
    let timer = start_timeout(8, || { if !done { done = true callback(nil) } })
    let headers = {"User-Agent": "OctoSense-News/1.0"}
    if extra != nil { headers = {"User-Agent": "OctoSense-News/1.0" "X-QW-Api-Key": extra} }
    net.http_request(net.HttpRequest{url: url method: net.HttpMethod.GET headers: headers}) do net.HttpEvents{
        on_response: |r| { if !done { done = true stop_timer(timer) callback(r) } }
        on_error: |_e| { if !done { done = true stop_timer(timer) callback(nil) } }
    }
}

// Hacker News through Algolia: one page with points, comments and times.
fn hn_rows(body){
    let out = []
    let data = body.parse_json()
    if data == nil || data.hits == nil { return out }
    for hit in data.hits {
        if hit.title == nil || hit.title == "" { continue }
        let discussion = "https://news.ycombinator.com/item?id=" + hit.objectID
        let link = discussion
        if hit.url != nil && hit.url != "" { link = hit.url }
        let published = 0
        if hit.created_at_i != nil { published = hit.created_at_i }
        out.push({title: hit.title link: link source: "Hacker News" published: published summary: ""
            image: "" discussion: discussion points: hit.points comments: hit.num_comments})
    }
    out
}

// RSS or Atom, in the same row shape as Hacker News's.
fn feed_rows(body, s){
    let items = body.parse_feed(s.kind)
    if items == nil { return nil }
    let out = []
    for it in items {
        let source = it.source
        if source == "" { source = s.label }
        out.push({title: it.title link: it.link source: source published: it.published summary: it.summary
            image: it.image discussion: "" points: nil comments: nil})
    }
    out
}

// Open-Meteo daily forecast, in the same row shape as the news sources.
// `published` is the fetch time (retrieved_at); the forecast's valid date is
// kept in `day` (YYYY-MM-DD) so the analysis adapter can map it to a
// schedule without inventing a publication timestamp.
fn wmo_text(code){
    if code == 0 { return "晴" }
    if code == 1 || code == 2 { return "多云" }
    if code == 3 { return "阴" }
    if code == 45 || code == 48 { return "雾" }
    if code == 51 || code == 53 || code == 55 { return "毛毛雨" }
    if code == 56 || code == 57 { return "冻毛毛雨" }
    if code == 61 { return "小雨" }
    if code == 63 { return "中雨" }
    if code == 65 { return "大雨" }
    if code == 66 || code == 67 { return "冻雨" }
    if code == 71 { return "小雪" }
    if code == 73 { return "中雪" }
    if code == 75 || code == 77 { return "大雪" }
    if code == 80 || code == 81 { return "阵雨" }
    if code == 82 { return "暴雨" }
    if code == 85 || code == 86 { return "阵雪" }
    if code == 95 || code == 96 || code == 99 { return "雷暴" }
    "天气变化"
}

fn weather_rows(body, s){
    let out = []
    let data = body.parse_json()
    if data == nil || data.daily == nil || data.daily.time == nil { return out }
    let days = data.daily.time
    let fetched = time_now()
    for i day in days {
        let wmo = nil
        if data.daily.weather_code != nil && i < data.daily.weather_code.len() { wmo = data.daily.weather_code[i] }
        let tmax = nil
        if data.daily.temperature_2m_max != nil && i < data.daily.temperature_2m_max.len() { tmax = data.daily.temperature_2m_max[i] }
        let tmin = nil
        if data.daily.temperature_2m_min != nil && i < data.daily.temperature_2m_min.len() { tmin = data.daily.temperature_2m_min[i] }
        let precip = 0
        if data.daily.precipitation_sum != nil && i < data.daily.precipitation_sum.len() && data.daily.precipitation_sum[i] != nil { precip = data.daily.precipitation_sum[i] }
        let cond = wmo_text(wmo)
        let title = s.city + " " + day + " " + cond
        if tmax != nil && tmin != nil { title = title + " · " + tmin + "~" + tmax + "°C" }
        let tip = "无降水。"
        if precip >= 5 { tip = "降水 " + precip + "mm，出门带伞。" }
        else if precip > 0 { tip = "降水 " + precip + "mm，可能有零星降水。" }
        out.push({title: title link: "https://open-meteo.com/en/docs#latitude=39.90&longitude=116.40" source: s.label published: fetched day: day summary: tip image: "" discussion: "" points: nil comments: nil})
    }
    out
}

// Hefeng hourly: next 8 hours only, in the feed row shape.
// fxTime is kept readable with plain string replacements only.
fn hefeng_rows(body, s){
    let out = []
    let data = body.parse_json()
    if data == nil || data.code != "200" || data.hourly == nil { return out }
    let count = 0
    for h in data.hourly {
        if count < 8 {
            let when = ""
            if h.fxTime != nil { when = h.fxTime.replace("T", " ").replace("+08:00", "") }
            let cond = ""
            if h.text != nil { cond = h.text }
            let temp = ""
            if h.temp != nil { temp = h.temp + "°C" }
            let title = s.city + " " + when + " " + cond + " " + temp
            let precip = "0.0"
            if h.precip != nil { precip = h.precip }
            let wind = ""
            if h.windDir != nil { wind = h.windDir }
            if h.windScale != nil { wind = wind + h.windScale + "级" }
            let detail = "降水 " + precip + "mm"
            if wind != "" { detail = detail + "，" + wind }
            if h.humidity != nil { detail = detail + "，湿度" + h.humidity + "%" }
            detail = detail + "。"
            out.push({title: title link: "https://www.qweather.com/weather/beijing-101010100.html" source: s.label published: time_now() day: "" summary: detail image: "" discussion: "" points: nil comments: nil})
            count = count + 1
        }
    }
    out
}

// Hefeng weather alerts: one row per active alert, empty when zeroResult.
// issuedTime stays in the summary so the adapter can use the real time.
fn hefeng_warn_rows(body, s){
    let out = []
    let data = body.parse_json()
    if data == nil || data.alerts == nil { return out }
    for a in data.alerts {
        let headline = "天气预警"
        if a.headline != nil && a.headline != "" { headline = a.headline }
        let sev = ""
        if a.severity != nil { sev = "（严重程度 " + a.severity + "）" }
        let desc = ""
        if a.issuedTime != nil { desc = "发布：" + a.issuedTime + "。" }
        if a.description != nil { desc = desc + a.description }
        if a.instruction != nil && a.instruction != "" { desc = desc + " 防御指南：" + a.instruction }
        out.push({title: s.city + "预警 · " + headline + sev link: "https://www.qweather.com/" source: s.label published: time_now() day: "" summary: desc image: "" discussion: "" points: nil comments: nil})
    }
    out
}

fn accept_source(s, res){
    failed_by[s.id] = true
    if res == nil || res.status_code != 200 || res.body == nil { return }
    if res.body.len() > 2000000 { return }
    let rows = nil
    try {
        let body = res.body.to_string()
        if s.kind == "hn" { rows = hn_rows(body) } else if s.kind == "weather" { rows = weather_rows(body, s) } else if s.kind == "hefeng" { rows = hefeng_rows(body, s) } else if s.kind == "hefeng_warn" { rows = hefeng_warn_rows(body, s) } else { rows = feed_rows(body, s) }
    } { rows = nil }
    if rows == nil { return }
    let limited = []
    for r in rows { if limited.len() < 30 { limited.push(r) } }
    rows_by[s.id] = limited
    failed_by[s.id] = false
    updated = time_now()
    try { fs.write("cache_" + s.id + ".json", limited.to_json()) } { }
}

fn load_next(index){
    if index >= sources.len() {
        busy = false
        sync_status()
        render_feed()
        ui.tile_list.render()
        return
    }
    let s = sources[index]
    if s.needs_key == true && HEFENG_KEY == "" {
        failed_by[s.id] = true
        render_feed()
        ui.tile_list.render()
        sync_status()
        load_next(index + 1)
        return
    }
    let extra = nil
    if s.needs_key == true { extra = HEFENG_KEY }
    request_feed(s.url, extra, fn(res){
        accept_source(s, res)
        render_feed()
        ui.tile_list.render()
        sync_status()
        load_next(index + 1)
    })
}

fn refresh(){
    if demo_mode { return }
    if busy { return }
    if use_service { refresh_service(); return }
    busy = true
    sync_status()
    load_next(0)
}

// A story as the news service keeps it, in this script's row shape.
fn service_row(it){
    let image = ""
    if it.image != nil { image = it.image }
    let discussion = ""
    if it.discussion != nil { discussion = it.discussion }
    let row = {title: it.title link: it.url source: it.source published: it.published summary: it.summary
        image: image discussion: discussion points: it.points comments: it.comments}
    row
}

// Each tab shows exactly its source's latest fetch, in the source's order.
fn list_service(){
    service_waiting = sources.len()
    for s in sources {
        host.request("news.list", {feed: s.id current: true limit: 30}, fn(r){
            if r.is_ok {
                let rows = []
                for it in r.data.items { rows.push(service_row(it)) }
                if rows.len() > 0 {
                    rows_by[s.id] = rows
                    fs.write("cache_" + s.id + ".json", rows.to_json())
                }
                failed_by[s.id] = r.data.feed_error != nil
                if r.data.updated > updated { updated = r.data.updated }
            } else {
                // Granted but not answered (no service registered): fetch here.
                use_service = false
            }
            service_waiting = service_waiting - 1
            if service_waiting == 0 { listed_service() }
        })
    }
}

fn listed_service(){
    busy = false
    if !use_service {
        refresh()
        return
    }
    render_feed()
    sync_status()
    ui.tile_list.render()
    if service_relist {
        service_relist = false
        busy = true
        list_service()
    }
}

// Show what the service has now, ask it to fetch what is due, then show that.
fn refresh_service(){
    busy = true
    sync_status()
    list_service()
    host.request("news.refresh", {}, fn(r){
        if !use_service { return }
        if busy { service_relist = true }
        else {
            busy = true
            list_service()
        }
    })
}

fn load_state(){
    if fs.exists("demo_ui_state_v1.json") {
        try {
            let v = fs.read("demo_ui_state_v1.json").parse_json()
            if v == nil || v.schema_version != 1 || v.saved == nil || v.followed == nil || v.decision == nil {
                demo_storage_ok = false
            } else if v.decision != "pending" && v.decision != "accepted" && v.decision != "kept" {
                demo_storage_ok = false
            } else {
                demo_saved = v.saved
                demo_followed = v.followed
                decision = v.decision
            }
        } { demo_storage_ok = false }
    }
    if fs.exists("saved.json") {
        let v = fs.read("saved.json").parse_json()
        if v != nil { saved = v }
    }
    for s in sources {
        let path = "cache_" + s.id + ".json"
        if fs.exists(path) {
            let v = fs.read(path).parse_json()
            if v != nil { rows_by[s.id] = v }
        }
    }
}


// Keep the original news sources and local bookmarks available in live mode.
// All weather sources in one list, grouped by city then day, so a trip with
// several stops reads top to bottom. Rows already carry city in the title and
// the forecast day in `day`.
fn weather_all_rows(){
    let out = []
    for s in sources {
        if s.kind != "weather" { continue }
        let rows = rows_by[s.id]
        for i in 7 {
            if i < rows.len() { out.push(rows[i]) }
        }
    }
    out
}

// News only. Weather sources are excluded so five city forecasts cannot
// crowd the interleaved Today feed; they have their own tab.
fn today_rows(){
    let out = []
    for i in 30 {
        for s in sources {
            if s.kind == "weather" { continue }
            let rows = rows_by[s.id]
            if i < rows.len() { out.push(rows[i]) }
        }
    }
    out
}
fn escape(text){
    let out = text
    for c in specials { out = out.replace(c, "\\" + c) }
    out
}
fn mock_row(r){
    for item in demo_rows { if item.link == r.link { return true } }
    false
}
fn contains(items, value){
    for item in items { if item == value { return true } }
    false
}
fn is_saved(link){
    for r in demo_rows { if r.link == link { return contains(demo_saved, link) } }
    for s in saved { if s.link == link { return true } }
    false
}
fn is_followed(r){
    if mock_row(r) { return contains(demo_followed, r.topic) }
    contains(live_followed, r.source)
}
fn has_hint(r){
    if !mock_row(r) || !is_followed(r) { return false }
    if r.id == "northstar" && decision != "pending" { return false }
    r.hint != ""
}
// Lexical retrieval over the cached rows. This is keyword scoring, not BM25
// and not vector search: the query is split on whitespace and each term is
// matched case-insensitively against the title (weight 3) and summary (weight
// 1), plus a recency bonus. `data.md` names this strategy "keyword"; it must
// not be called semantic or hybrid until a real index exists.
//
// The runtime exposes only these string methods (len, trim, replace, split,
// index, search, match_str, captures, parse_json, to_chars), so matching goes
// through `regex` rather than a `contains` helper, and ranking uses a repeated
// max scan because there is no array sort.

fn query_terms(q){
    let terms = []
    for t in q.split(" ") {
        let term = t.trim()
        if term != "" { terms.push(term) }
    }
    terms
}

// Recency bonus decays over three days. A missing or future time gets the full
// bonus rather than a negative score.
fn recency_bonus(published){
    if published == nil { return 0 }
    let age_h = floor((time_now() - published) / 3600)
    if age_h < 0 { age_h = 0 }
    let bonus = 3 - floor(age_h / 24)
    if bonus < 0 { return 0 }
    bonus
}

fn score_rows(rows, terms){
    let scored = []
    let idx = 0
    for r in rows {
        let score = 0
        for t in terms {
            let re = regex(escape(t), "i")
            if re.test(r.title) { score = score + 3 }
            if r.summary != nil && r.summary != "" && re.test(r.summary) { score = score + 1 }
        }
        if score > 0 { score = score + recency_bonus(r.published) }
        scored.push({idx: idx row: r score: score})
        idx = idx + 1
    }
    scored
}

fn top_rows(scored, limit){
    let taken = []
    let out = []
    let n = scored.len()
    for step in limit {
        let best = nil
        let best_score = 0
        for i in n {
            let p = scored[i]
            let used = false
            for u in taken { if u == p.idx { used = true } }
            if !used && p.score > best_score { best_score = p.score best = p }
        }
        if best != nil {
            taken.push(best.idx)
            out.push(best.row)
        }
    }
    out
}

// Returns ranked rows and records how the answer was produced, so the UI and
// the Agent adapter can tell a real ranking from a degraded one.
fn retrieve(q, rows, limit){
    retrieve_strategy = "keyword"
    retrieve_degraded = false
    retrieve_considered = 0
    let terms = query_terms(q)
    if terms.len() == 0 {
        retrieve_strategy = "fallback_recent"
        retrieve_degraded = true
        return rows
    }
    let scored = score_rows(rows, terms)
    retrieve_considered = scored.len()
    top_rows(scored, limit)
}

fn visible_rows(){
    let rows = []
    if demo_mode { rows = demo_rows }
    else if page == "saved" { rows = saved }
    else if tab == "today" { rows = today_rows() }
    else if tab == "weather_all" { rows = weather_all_rows() }
    else { rows = rows_by[tab] }
    let out = []
    let re = regex(escape(query), "i")
    for r in rows {
        if page == "saved" && !is_saved(r.link) { continue }
        if page == "tracking" && !is_followed(r) { continue }
        if page == "feed" && related_only && !has_hint(r) { continue }
        if query != "" && !re.test(r.title) && !re.test(r.summary) && !re.test(r.source) { continue }
        out.push(r)
    }
    if !demo_mode && query != "" && out.len() > 0 { return retrieve(query, out, 40) }
    out
}
fn ago(secs){
    if secs == nil || secs <= 0 { return "时间未知" }
    let d = time_now() - secs
    if d < 60 { return "刚刚" }
    if d < 3600 { return "" + floor(d / 60) + " 分钟前" }
    if d < 86400 { return "" + floor(d / 3600) + " 小时前" }
    "" + floor(d / 86400) + " 天前"
}
fn meta(r){
    if mock_row(r) { return r.source + "  ·  " + r.time_label }
    r.source + "  ·  " + ago(r.published)
}
fn avatar(r){
    if mock_row(r) { return r.avatar }
    if r.source == "Hacker News" { return "HN" }
    if r.source == "TechMeme" { return "T" }
    "G"
}
fn notice(text){
    ui.feedback.set_text(text)
    ui.feedback.set_visible(text != "")
}
fn persist_demo(){
    if !demo_storage_ok {
        notice("示例状态读取失败；本次使用临时状态，原文件未覆盖。")
        return
    }
    let result = fs.write("demo_ui_state_v1.json", {schema_version: 1 saved: demo_saved followed: demo_followed decision: decision}.to_json())
    if result != nil { notice("示例状态保存失败；本次修改仅在当前会话保留。") }
}
fn sync_status(){
    let text = ""
    if !demo_mode {
        if busy { text = "正在请求真实新闻…" }
        else if updated > 0 { text = "真实新闻 · 更新于 " + ago(updated) }
        else { text = "真实新闻尚未加载" }
        let ready = 0
        for s in sources { if rows_by[s.id].len() > 0 { ready = ready + 1 } }
        text = text + " · 源 " + ready + "/" + sources.len()
        for s in sources {
            if failed_by[s.id] { text = text + " · " + s.label + " 请求失败（仅保留旧缓存）" }
        }
        if query != "" {
            text = text + " · 检索 " + retrieve_strategy + "（候选 " + retrieve_considered + "）"
            if retrieve_degraded { text = text + " 降级" }
        }
    }
    ui.status.set_text(text)
    ui.status.set_visible(!demo_mode && page != "schedule")
}
fn sync_header(){
    if demo_mode {
        ui.mode_note.set_text("MOCK 演示 · 新闻、Agent 判断与日程均为虚构")
        ui.mode_button.set_text("真实新闻")
        if decision == "pending" { ui.pending.set_text("1 条日程建议  ›") }
        else { ui.pending.set_text("建议已处理  ›") }
    } else {
        ui.mode_note.set_text("真实新闻 · Agent 分析与日程仍为演示功能")
        ui.mode_button.set_text("Mock 示例")
    }
    ui.pending.set_visible(demo_mode)
    ui.refresh_button.set_visible(!demo_mode)
}
fn render_feed(){
    ui.list.render()
    let empty = visible_rows().len() == 0
    ui.list_container.set_visible(!empty)
    ui.empty_panel.set_visible(empty)
    ui.empty_message.set_text(empty_text())
}
fn sync_schedule(){
    ui.live_schedule_note.set_visible(!demo_mode)
    if decision == "accepted" {
        ui.schedule_time.set_text("下周一 14:00—15:00")
        ui.schedule_note.set_text("已确认示例改期 · 未写入系统日历")
    } else {
        ui.schedule_time.set_text("周五 14:00—15:00")
        if decision == "pending" { ui.schedule_note.set_text("1 条待确认建议 · 当前安排尚未修改") }
        else { ui.schedule_note.set_text("已保留原计划 · 建议已处理") }
    }
}
fn render_main(){
    let text = ""
    if page == "tracking" {
        text = "关注的主题 · 点击已跟踪可取消"
        if !demo_mode { text = "已跟踪的来源 · 仅作本地筛选，暂无后台监测" }
    }
    if page == "saved" { text = "你的收藏 · 示例和真实新闻分开保存" }
    if page == "schedule" { text = "应用内日程 · MOCK 示例" }
    ui.page_note.set_text(text)
    ui.tabbar.render()
    ui.navigation.render()
    render_feed()
    sync_schedule()
    ui.tile_list.render()
    // render reapplies declaration properties; visibility must be set afterward.
    ui.tabbar.set_visible(page == "feed")
    ui.search_box.set_visible(page != "schedule")
    ui.feed_list.set_visible(page != "schedule")
    ui.schedule_page.set_visible(page == "schedule")
    ui.page_note.set_visible(page != "feed")
    sync_status()
    sync_header()
}
fn select_page(id){
    page = id
    reading = nil
    detail_kind = ""
    ui.detail_pane.set_visible(false)
    ui.main.set_visible(true)
    query = ""
    ui.search.set_text("")
    notice("")
    render_main()
}
fn switch_mode(){
    demo_mode = !demo_mode
    related_only = false
    tab = "today"
    select_page("feed")
    if !demo_mode { refresh() }
}
fn pick(id){
    if demo_mode { related_only = id == "related" }
    else { tab = id }
    ui.tabbar.render()
    render_feed()
    sync_status()
}
fn set_query(text){
    query = ("" + text).trim()
    render_feed()
}
fn toggle_follow(r){
    if mock_row(r) {
        if is_followed(r) { demo_followed.retain(|t| t != r.topic) }
        else { demo_followed.push(r.topic) }
        persist_demo()
    } else {
        if is_followed(r) { live_followed.retain(|t| t != r.source) }
        else { live_followed.push(r.source) }
    }
    render_feed()
    if detail_kind == "story" { render_detail() }
}
fn toggle_save(r){
    if mock_row(r) {
        if contains(demo_saved, r.link) { demo_saved.retain(|link| link != r.link) }
        else { demo_saved.push(r.link) }
        persist_demo()
    } else {
        let exists = false
        for item in saved { if item.link == r.link { exists = true } }
        if exists { saved.retain(|item| item.link != r.link) } else { saved.push(r) }
        let result = fs.write("saved.json", saved.to_json())
        if result != nil { notice("收藏保存失败，本次会话中仍可查看。") }
    }
    render_feed()
    if detail_kind == "story" { render_detail() }
}
fn render_detail(){
    if detail_kind == "story" { ui.story_content.render() }
    if detail_kind == "plan" { ui.plan_content.render() }
    ui.story_panel.set_visible(detail_kind == "story")
    ui.plan_panel.set_visible(detail_kind == "plan")
    ui.settings_panel.set_visible(detail_kind == "settings")
}
fn show_detail(kind, title){
    detail_kind = kind
    ui.detail_title.set_text(title)
    ui.main.set_visible(false)
    ui.detail_pane.set_visible(true)
    render_detail()
}
fn open_story(r){
    reading = r
    evidence_open = false
    notice("")
    show_detail("story", "新闻详情")
}
fn open_agent(r){
    reading = r
    evidence_open = true
    notice("")
    show_detail("story", "Agent · 关联依据")
}
fn toggle_evidence(){
    evidence_open = !evidence_open
    render_detail()
}
fn open_plan(){
    notice("")
    show_detail("plan", "日程建议 · MOCK")
}
fn show_settings(){
    notice("")
    show_detail("settings", "Octos 连接")
}
fn close_detail(){
    ui.detail_pane.set_visible(false)
    ui.main.set_visible(true)
    detail_kind = ""
    reading = nil
    sync_header()
}
fn decide(value){
    if !demo_mode || decision != "pending" { return }
    decision = value
    persist_demo()
    sync_schedule()
    sync_header()
    render_feed()
    render_detail()
    if value == "accepted" { notice("MOCK：示例日程已改期；未写入系统日历。") }
    else { notice("MOCK：保留原计划，建议已处理。") }
}
fn reconsider(){
    decision = "pending"
    persist_demo()
    sync_schedule()
    notice("MOCK：已重置示例建议。")
    sync_header()
    render_feed()
    render_detail()
}
fn empty_text(){
    if query != "" { return "没有匹配的新闻，试试其他关键词。" }
    if page == "saved" { return "还没有收藏。回到动态，收藏值得再看的新闻。" }
    if page == "tracking" { return "还没有跟踪内容。回到动态，选择感兴趣的主题。" }
    if related_only { return "暂时没有新的关联提示。" }
    "新闻暂未加载。可以点击刷新；请求失败不会替换为 Mock 数据。"
}
fn boot(){
    load_state()
    use_service = host.has("news")
    render_main()
    if !demo_storage_ok { notice("示例状态读取失败；本次使用临时状态，原文件未覆盖。") }
}
start_timeout(0.05, || boot())
start_interval(900, || { if !demo_mode { refresh() } })

let ink = #x202126
let secondary = #x666873
let accent = #x515db4
let line = #xeaeaf0
let soft = #xf6f6f9
let white = #xffffff
