// Pure shared checks. All timestamps are UTC Unix seconds; nil means unknown.
fn record_string(value){ return value.is_string() }
fn record_array(value){ return value.is_array() }
fn record_object(value){ return value.is_object() }
fn record_number(value){ return value.is_number() && value >= 0 && value < 1000000000000 }
fn record_url(value){ return record_string(value) && regex("^https?://[^/ ]+").test(value) }
fn record_contains(values, value){
    for item in values { if item == value { return true } }
    false
}
fn news_record_valid(r){
    if !record_object(r) { return false }
    if !record_url(r["source_url"]) || !record_string(r["news_id"]) || !record_string(r["title"]) || r["title"] == "" { return false }
    if !record_string(r["source"]) || !record_string(r["source_id"]) || !record_string(r["summary"]) { return false }
    if !record_string(r["category"]) || !record_string(r["feed_url"]) || !record_string(r["evidence_kind"]) || !record_string(r["language"]) { return false }
    if r["timestamp_kind"] != "published" && r["timestamp_kind"] != "submitted" { return false }
    if r["published_at"] != nil && !record_number(r["published_at"]) { return false }
    if !record_number(r["retrieved_at"]) || !record_array(r["references"]) { return false }
    if r["references"].len() == 0 || r["references"].len() > 30 { return false }
    for ref in r["references"] {
        if !record_object(ref) || !record_string(ref["source_id"]) || !record_string(ref["source"]) || !record_url(ref["source_url"]) || !record_string(ref["feed_url"]) { return false }
    }
    r["news_id"] == news_identity(r["source_url"]) && r["title"].len() <= 1500 && r["summary"].len() <= 6000 && r["news_id"].len() <= 4000
}
fn interest_record_valid(r){
    if !record_object(r) || !record_string(r["interest_id"]) || !record_string(r["value"]) || r["value"] == "" { return false }
    if r["kind"] != "source" && r["kind"] != "category" && r["kind"] != "keyword" { return false }
    if r["enabled"] != true && r["enabled"] != false { return false }
    record_number(r["created_at"]) && r["value"].len() <= 200 && r["interest_id"] == r["kind"] + ":" + r["value"]
}
