// BEGIN src/frontend/pages/tracking.splash
let TrackingHeader = View{visible: false width: Fill height: Fit flow: Down padding: Inset{left: 18 right: 18 top: 10 bottom: 8} spacing: 6
    View{width: Fill height: 30 flow: Right align: Align{y: 0.5}
        tracking_summary := Small{width: Fill text: "我的关注"}
        manage_tracking_button := LinkButton{visible: false text: "管理关注" on_click: || manage_tracking()}
    }
    tracking_analysis_actions := View{width: Fill height: Fit flow: Down spacing: 6 on_render: || {
        Small{text: analysis_check_status() max_lines: 2}
        View{width: Fill height: Fit flow: Right spacing: 8
            if !analysis_has_focus() { SecondaryButton{text: "添加关注" on_click: || manage_tracking()} }
            else if analysis_batch_busy || analysis_busy { SecondaryButton{text: "停止检查" on_click: || analysis_cancel()} }
            else { SecondaryButton{text: "检查关注更新" on_click: || analyze_changes()} }
            QuietButton{text: "查看分析与建议" on_click: || show_analysis_results()}
        }
    }}
}
let TrackingEditor = View{visible: false width: Fill height: Fill flow: Down
    ScrollYView{width: Fill height: Fill flow: Down padding: 18 spacing: 12
        Heading{text: "关注你想持续了解的变化"}
        Small{text: "添加主题、关键词或来源，相关新闻会出现在跟踪页。"}
        Section{text: "添加关键词"}
        keyword_input := Search{empty_text: "例如：端侧 AI、NVIDIA（每次添加一个）" on_change: |text| {keyword_draft = text}}
        Primary{text: "添加关注" on_click: || add_keyword()}
        Section{text: "关注主题"}
        topic_list := View{width: Fill height: Fit flow: Down spacing: 4 on_render: || {
            for item in category_filters {
                if item.id != "all" {
                    View{width: Fill height: 34 flow: Right align: Align{y: 0.5}
                        Text{text: category_label(item.id)}
                        if records_has_interest("category", item.id) { LinkButton{text: "已关注" on_click: || toggle_topic(item.id)} }
                        else { QuietButton{text: "关注" on_click: || toggle_topic(item.id)} }
                    }
                }
            }
        }}
        Divider{}
        Section{text: "我的关注"}
        interest_list := View{width: Fill height: Fit flow: Down spacing: 4 on_render: || {
            if user_interests.len() == 0 { Small{text: "尚未添加关注。也可在新闻条目上关注来源。"} }
            for item in user_interests {
                View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 8
                    View{width: Fill height: Fit flow: Down spacing: 2
                        if item.kind == "category" { Text{text: category_label(item.value)} }
                        else { Text{text: item.value} }
                        if item.kind == "keyword" { Small{text: "标题 / 摘要关键词 · 忽略英文大小写"} }
                        if item.kind == "source" { Small{text: "新闻发布方"} }
                        if item.kind == "category" { Small{text: "新闻源所属主题"} }
                    }
                    QuietButton{text: "取消关注" on_click: || remove_interest(item.interest_id)}
                }
                Divider{}
            }
        }}
    }
}
// END src/frontend/pages/tracking.splash

