// BEGIN src/contracts/weather.splash
// Pure shared checks for city forecasts. A forecast has no publication
// timestamp, so it is deliberately not a news_record: see
// src/contracts/weather.md for why the two contracts are separate.
fn weather_number_text(value){ regex("^-?[0-9]{1,3}(\\.[0-9]+)?$").test(value) }

fn weather_coordinate_valid(value, limit){
