// BEGIN src/app/startup.splash
let boot_phase = "准备启动"
let boot_finished = false
let boot_topics_restoring = false
fn boot_status(phase){
    boot_phase = phase
    ui.status.set_text("正在启动：" + phase)
}
fn boot(){
    start_timeout(12.0, || {
        if !boot_finished {
            if boot_topics_restoring { ui.status.set_text("正在恢复关注与分析历史，请稍候…") }
            else { ui.status.set_text("启动未完成：" + boot_phase + "；请重新 Run 或查看宿主日志") }
        }
    })
    boot_load_step(0)
}
fn boot_load_step(index){
    // The host limits each callback to 64 ms. Existing account records must
    // not share one slice with every other repository and the first render.
    let loaders = [records_load schedules_load history_load topics_load agent_preferences_load schedule_actions_load check_states_load agent_metrics_load]
    if index < loaders.len() {
        let labels = ["收藏与来源设置" "日程" "分析历史" "关注记录" "助手设置" "日程操作" "检查状态" "诊断记录"]
        boot_status(labels[index])
        if index == 3 {
            boot_topics_restoring = true
            topics_load_async(|| {boot_topics_restoring = false boot_load_step(index + 1)})
            return
        }
        loaders[index]()
        start_timeout(0.01, || boot_load_step(index + 1))
        return
    }
    agent_progress_handler = agent_progress
    foreground_tracking_arm()
    start_timeout(0.01, || boot_demo_initialize())
}
fn boot_demo_initialize(){
    boot_status("准备新闻来源")
    demo_news_initialize()
    start_timeout(0.01, || boot_loaded())
}
fn boot_loaded(){
    boot_status("准备新闻来源")
    presets_initialize(time_now())
    feed_initialize()
    render_main()
    boot_finished = true
    start_timeout(0.01, || weather_app_boot())
    if records_warning != "" || schedule_warning != "" || analysis_history_warning != "" || topic_warning != "" { notice(records_warning + " " + schedule_warning + " " + analysis_history_warning + " " + topic_warning) }
    // records_load/history_load/render_main already spent most of this 64ms
    // slice; defer the cache restore so its first source read gets a fresh budget.
    start_timeout(0.01, || feed_restore_cache(enabled_source_ids, 0, feed_generation, || {
        rebuild_feed(|| {
            render_main()
            tracking_schedule_check()
            let ids = feed_refresh_needed_ids(enabled_source_ids, time_now())
            start_timeout(0.01, || refresh_sources(ids))
        })
    }))
}
// Defer until all page prototypes and widget references have been mounted.
start_timeout(0.05, || boot())
// END src/app/startup.splash
