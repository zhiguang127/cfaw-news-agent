// BEGIN src/frontend/components/news_list.splash
let NewsList = ScrollYView{width: Fill height: Fill flow: Down padding: Inset{left: 14 right: 14 top: 8 bottom: 14} spacing: 10 on_render: || {
    let featured_rows = []
    let image_rows = []
    let text_rows = []
    for row in display_rows {
        if record_string(row["image_url"]) && row.image_url != "" {
            if featured_rows.len() < 3 { featured_rows.push(row) }
            else { image_rows.push(row) }
        } else { text_rows.push(row) }
    }
    if featured_rows.len() > 0 {
        Section{text: "今日热点" padding: Inset{left: 2 top: 2}}
        ScrollXView{width: Fill height: 170 flow: Right spacing: 10 padding: Inset{bottom: 4}
            for row in featured_rows {
                GestureView{width: 286 height: 158 on_tap: |x, y| open_story(row)
                    RoundedView{width: Fill height: Fill flow: Down padding: 8 spacing: 6
                        show_bg: true draw_bg.color: white draw_bg.border_size: 1.0 draw_bg.border_color: line draw_bg.border_radius: 14.0
                        Image{width: Fill height: 98 fit: ImageFit.CropToFill src: http_resource(row.image_url)}
                        Small{text: news_meta(row) max_lines: 1 draw_text.text_style.font_size: 10}
                        Text{text: row.title max_lines: 2 draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 13 line_spacing: 1.15}}
                    }
                }
            }
        }
    }
    let ordered_rows = []
    for row in image_rows { ordered_rows.push(row) }
    for row in text_rows { ordered_rows.push(row) }
    for row in ordered_rows {
        let agent_hint = row_agent_hint(row)
        let cache_note = row_cache_note(row)
        let has_image = record_string(row["image_url"]) && row.image_url != ""
        GestureView{width: Fill height: Fit flow: Down on_swipe: |dx, dy| feed_swipe_refresh(dx, dy)
            RoundedView{width: Fill height: Fit flow: Down padding: 14 spacing: 9
                show_bg: true draw_bg.color: white draw_bg.border_size: 1.0 draw_bg.border_color: line draw_bg.border_radius: 14.0
                View{width: Fill height: Fit flow: Right spacing: 7 align: Align{y: 0.5}
                    RoundedView{width: 22 height: 22 show_bg: true draw_bg.color: soft draw_bg.border_radius: 11.0 align: Align{x: 0.5 y: 0.5}
                        Label{text: news_avatar(row) draw_text.color: secondary draw_text.text_style: theme.font_bold{font_size: 10}}
                    }
                    Small{width: Fill text: news_meta(row) max_lines: 1 draw_text.text_style: theme.font_regular{font_size: 11 line_spacing: 1.1}}
                }
                View{width: Fill height: Fit flow: Right spacing: 12 align: Align{y: 0.0}
                    View{width: Fill height: Fit flow: Down spacing: 7
                        GestureView{width: Fill height: Fit on_tap: |x, y| open_story(row) on_swipe: |dx, dy| feed_swipe_refresh(dx, dy)
                            Text{text: row.title max_lines: 3 draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 16 line_spacing: 1.2}}
                        }
                        View{width: Fit height: 20 flow: Right
                            RoundedView{width: Fit height: 20 padding: Inset{left: 7 right: 7 top: 2 bottom: 2} show_bg: true draw_bg.color: #xffffef draw_bg.border_radius: 10.0
                                Small{text: category_label(row.category) draw_text.color: #x8d742d draw_text.text_style: theme.font_regular{font_size: 10}}
                            }
                        }
                    }
                    if has_image {
                        Image{width: 104 height: 82 fit: ImageFit.CropToFill src: http_resource(row.image_url)}
                    }
                }
                if agent_hint != nil {
                    HintButton{height: 22 text: agent_hint.text + " ›" on_click: || open_feed_hint(row)}
                }
                if cache_note != "" { Small{text: cache_note max_lines: 2}}
                View{width: Fill height: 26 flow: Right spacing: 8 align: Align{y: 0.5}
                    if records_has_interest("source", row.source) { LinkButton{text: "已跟踪" on_click: || toggle_follow(row)} }
                    else { QuietButton{text: "关注来源" on_click: || toggle_follow(row)} }
                    if records_is_bookmarked(row.news_id) { LinkButton{text: "已收藏" on_click: || toggle_save(row)} }
                    else { QuietButton{text: "收藏" on_click: || toggle_save(row)} }
                    View{width: Fill height: 1}
                    QuietButton{text: "查看" on_click: || open_story(row)}
                }
            }
        }
    }
}}
// END src/frontend/components/news_list.splash

// BEGIN src/frontend/components/weather_widget.splash
// Static SDF art keeps the weather glance visible without a continuous redraw
// loop. The native Makepad weather app's full Rust view is not bundled here.
let ForecastGlyph = View{width: 56 height: 56 show_bg: true
    draw_bg +: {
        condition: uniform(7.0)
        pixel: fn(){
            let sdf = Sdf2d.viewport(self.pos * self.rect_size)
            let w = self.rect_size.x
            let h = self.rect_size.y
            if self.condition < 1.5 {
                let sx = w * 0.44
                let sy = h * 0.38
                sdf.circle(sx, sy, w * 0.24) sdf.fill(#xffcf70)
                sdf.circle(sx, sy, w * 0.18) sdf.fill(#xffe6a6)
                sdf.box(sx - 1.0, h * 0.04, 2.0, h * 0.08, 1.0) sdf.fill(#xffe6a6)
                sdf.box(w * 0.07, sy - 1.0, w * 0.08, 2.0, 1.0) sdf.fill(#xffe6a6)
                sdf.box(w * 0.72, sy - 1.0, w * 0.08, 2.0, 1.0) sdf.fill(#xffe6a6)
            }
            if self.condition > 0.5 {
                sdf.circle(w * 0.32, h * 0.53, w * 0.17) sdf.fill(#xc9dcec)
                sdf.circle(w * 0.52, h * 0.42, w * 0.23) sdf.fill(#xf1f7fc)
                sdf.circle(w * 0.75, h * 0.54, w * 0.16) sdf.fill(#xe1edf6)
                sdf.box(w * 0.18, h * 0.53, w * 0.69, h * 0.14, h * 0.065) sdf.fill(#xe1edf6)
            }
            if self.condition > 2.5 && self.condition < 4.5 {
                sdf.box(w * 0.30, h * 0.74, w * 0.045, h * 0.16, w * 0.02) sdf.fill(#x8ed9ff)
                sdf.box(w * 0.50, h * 0.76, w * 0.045, h * 0.16, w * 0.02) sdf.fill(#x8ed9ff)
                sdf.box(w * 0.70, h * 0.74, w * 0.045, h * 0.16, w * 0.02) sdf.fill(#x8ed9ff)
            }
            if self.condition > 3.5 && self.condition < 4.5 {
                sdf.box(w * 0.52, h * 0.50, w * 0.07, h * 0.22, 1.0) sdf.fill(#xffda76)
            }
            if self.condition > 4.5 && self.condition < 5.5 {
                sdf.circle(w * 0.30, h * 0.82, w * 0.035) sdf.fill(#xffffff)
                sdf.circle(w * 0.51, h * 0.86, w * 0.035) sdf.fill(#xffffff)
                sdf.circle(w * 0.71, h * 0.82, w * 0.035) sdf.fill(#xffffff)
            }
            if self.condition > 5.5 {
                sdf.box(w * 0.22, h * 0.77, w * 0.57, 2.0, 1.0) sdf.fill(#xbccee1)
                sdf.box(w * 0.30, h * 0.87, w * 0.43, 2.0, 1.0) sdf.fill(#xbccee1)
            }
            return sdf.result
        }
    }
}
let ForecastSky = RoundedView{width: Fill height: Fit flow: Down show_bg: true
    draw_bg +: {
        border_radius: 16.0
        pixel: fn(){
            let sdf = Sdf2d.viewport(self.pos * self.rect_size)
            let glow = max(0.0, 1.0 - length(self.pos - vec2(0.84, 0.12)))
            let sky = mix(#x243d68, #x476e99, glow * 0.85)
            sdf.box(0.0, 0.0, self.rect_size.x, self.rect_size.y, self.border_radius)
            sdf.fill(sky)
            return sdf.result
        }
    }
}
let WeatherHeaderWidget = View{width: 132 height: 50
    weather_header_content := View{width: Fill height: Fill on_render: || {
        let city = weather_primary_city()
        let today = weather_today()
        weather_header_hit := GestureView{width: Fill height: Fill on_tap: |x, y| show_weather()
            ForecastSky{width: Fill height: Fill padding: 8 draw_bg.border_radius: 12.0
                View{width: Fill height: Fill flow: Right spacing: 6 align: Align{y: 0.5}
                    ForecastGlyph{width: 30 height: 30 draw_bg.condition: weather_glyph_condition(today)}
                    View{width: Fill height: Fit flow: Down spacing: 3
                        if city != nil {
                            Small{text: city.name + " · " + weather_header_condition(today) draw_text.color: #xd7e6f7 max_lines: 1 draw_text.text_style.font_size: 9}
                            if today != nil {
                                Text{text: weather_temperature(today.temp_min_c) + " / " + weather_temperature(today.temp_max_c)
                                    max_lines: 1 draw_text.color: white draw_text.text_style: theme.font_bold{font_size: 13}}
                            } else { Small{text: "查看预报 ›" draw_text.color: white max_lines: 1} }
                        } else {
                            Small{text: "城市天气" draw_text.color: #xd7e6f7 max_lines: 1 draw_text.text_style.font_size: 9}
                            Small{text: "选择城市 ›" draw_text.color: white max_lines: 1}
                        }
                    }
                }
            }
        }
    }}
}
// END src/frontend/components/weather_widget.splash

