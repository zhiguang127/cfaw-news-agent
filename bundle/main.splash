// BEGIN src/app/config.splash
// Request limits apply to one refresh; storage limits apply to domain records.
let news_config = {request_timeout_seconds: 15 max_parallel_requests: 3
    max_response_bytes: 2000000 max_redirects: 3 items_per_source: 20
    max_feed_items: 240 work_batch_items: 5 max_bookmarks: 500 max_interests: 50 max_seen_ids: 2000
    cache_stale_seconds: 7200}
