    intent_overlay := View{visible: false width: Fill height: Fill flow: Overlay
        intent_wave := View{width: Fill height: Fill on_render: || { IntentReveal{draw_bg.progress: intent_reveal draw_bg.origin_x: 0.5 draw_bg.origin_y: 1.0} }}
        intent_scene := IntentBackdrop{visible: false flow: Down
