let HintButton = LinkButton{width: Fill height: 28 align: Align{x: 0.0} padding: 0
    draw_text +: {text_style +: {font_size: 12}}
}
let Pill = LinkButton{height: 30 padding: Inset{left: 10 right: 10}
    draw_bg +: {color: #xf0f1fa color_hover: #xe7e9f7 color_down: #xdfe2f1 border_radius: 15.0}
}
let Primary = QuietButton{height: 40 padding: Inset{left: 14 right: 14}
    draw_bg +: {color: ink color_hover: #x353741 color_down: #x454752 border_radius: 9.0}
    draw_text +: {color: white color_hover: white color_down: white text_style +: {font_size: 13}}
}
let SecondaryButton = QuietButton{height: 40 padding: Inset{left: 12 right: 12}
    draw_bg +: {color: soft color_hover: #xececf2 color_down: #xe4e4eb border_radius: 9.0}
    draw_text +: {color: ink color_hover: ink color_down: ink text_style +: {font_size: 13}}
}
let Nav = QuietButton{width: Fill height: 42
    draw_text +: {text_style +: {font_size: 13}}
}
let NavActive = Nav{
    draw_bg +: {color: soft color_hover: soft color_down: #xececf2 border_radius: 10.0}
    draw_text +: {color: ink color_hover: ink color_down: ink}
}
let Filter = Nav{height: 36}
let FilterActive = Filter{
    draw_text +: {color: ink color_hover: ink color_down: ink}
    draw_bg +: {color: soft color_hover: soft color_down: #xececf2 border_radius: 8.0}
}
let Box = RoundedView{width: Fill height: Fit flow: Down padding: 16 spacing: 10
    show_bg: true draw_bg.color: soft draw_bg.border_radius: 12.0}
let Search = TextInput{width: Fill height: 32 empty_text: "搜索新闻"
    draw_bg +: {color: soft color_hover: soft color_focus: soft color_empty: soft
        border_color: #x00000000 border_color_hover: #x00000000 border_color_focus: #x00000000 border_color_empty: #x00000000 border_radius: 8.0}
    draw_text +: {color: ink color_hover: ink color_focus: ink color_empty: secondary color_empty_hover: secondary text_style +: {font_size: 12}}
}

HostedView{width: Fill height: Fill
    full: View{width: Fill height: Fill flow: Down show_bg: true draw_bg.color: white
        View{width: Fill height: 60 flow: Right align: Align{y: 0.5} padding: Inset{left: 18 right: 14} spacing: 8
            Label{width: Fill text: "cfaw news" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 23}}
            pending := Pill{text: "1 条日程建议  ›" on_click: || open_plan()}
        }
        View{width: Fill height: Fit flow: Down padding: Inset{left: 18 right: 14 bottom: 6} spacing: 2
            mode_note := Small{text: "MOCK 演示 · 新闻、Agent 判断与日程均为虚构"}
            View{width: Fill height: 28 flow: Right spacing: 5
                mode_button := LinkButton{text: "真实新闻" on_click: || switch_mode()}
                refresh_button := QuietButton{visible: false text: "刷新" on_click: || refresh()}
                View{width: Fill}
                LinkButton{text: "Octos 连接" on_click: || show_settings()}
            }
        }
        Divider{}
        main := View{width: Fill height: Fill flow: Down
            tabbar := View{width: Fill height: 42 flow: Right padding: Inset{left: 12 right: 12 top: 3 bottom: 3} spacing: 4 on_render: || {
                if demo_mode {
                    for f in [{id: "today" label: "最新动态"} {id: "related" label: "与你有关"}] {
                        let active = (f.id == "related" && related_only) || (f.id == "today" && !related_only)
                        if active { FilterActive{text: f.label on_click: || pick(f.id)} }
                        else { Filter{text: f.label on_click: || pick(f.id)} }
                    }
                } else {
                    for t in tabs {
                        if t.id != "saved" {
                            if t.id == tab { FilterActive{text: t.label on_click: || pick(t.id)} }
                            else { Filter{text: t.label on_click: || pick(t.id)} }
                        }
                    }
                }
            }}
            page_note := Small{visible: false text: "" padding: Inset{left: 18 right: 18 top: 14 bottom: 8}}
            search_box := View{width: Fill height: Fit padding: Inset{left: 18 right: 18 top: 4 bottom: 8}
                search := Search{on_change: |text| set_query(text)}
            }
            status := Small{visible: false text: "" padding: Inset{left: 18 right: 18 bottom: 6}}
            feed_list := View{width: Fill height: Fill flow: Down
                empty_panel := View{visible: false width: Fill height: Fill flow: Down padding: 28 spacing: 12
                    Section{text: "这里暂时没有内容"}
                    empty_message := Text{text: "" draw_text.color: secondary}
                }
                list_container := View{width: Fill height: Fill flow: Down
                list := ScrollYView{width: Fill height: Fill flow: Down on_render: || {
                    let rows = visible_rows()
                    for i r in rows {
                        View{width: Fill height: Fit flow: Down
                            View{width: Fill height: Fit flow: Right spacing: 10 padding: Inset{left: 18 right: 18 top: 12 bottom: 8}
                                RoundedView{width: 32 height: 32 show_bg: true draw_bg.color: soft draw_bg.border_radius: 16.0 align: Align{x: 0.5 y: 0.5}
                                    Label{text: avatar(r) draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 12}}
                                }
                                View{width: Fill height: Fit flow: Down spacing: 4
                                    Small{text: meta(r) draw_text.text_style: theme.font_bold{font_size: 11 line_spacing: 1.15}}
                                    GestureView{width: Fill height: Fit on_tap: |x, y| open_story(r)
                                        Text{text: r.title max_lines: 3 draw_text.text_style.font_size: 14}
                                    }
                                    if has_hint(r) { HintButton{text: "Agent · " + r.hint + "  ›" on_click: || open_agent(r)} }
                                    View{width: Fill height: 28 flow: Right spacing: 10
                                        if is_followed(r) { LinkButton{text: "已跟踪" on_click: || toggle_follow(r)} }
                                        else { QuietButton{text: "跟踪" on_click: || toggle_follow(r)} }
                                        if is_saved(r.link) { LinkButton{text: "已收藏" on_click: || toggle_save(r)} }
                                        else { QuietButton{text: "收藏" on_click: || toggle_save(r)} }
                                        QuietButton{text: "查看  ›" on_click: || open_story(r)}
                                    }
                                }
                            }
                            Divider{}
                        }
                        if i == 2 && page == "feed" && demo_mode && !related_only && decision == "pending" {
                            View{width: Fill height: Fit flow: Right padding: Inset{left: 18 right: 18 top: 10 bottom: 10} spacing: 8 show_bg: true draw_bg.color: soft
                                View{width: Fill height: Fit flow: Down spacing: 3
                                    Section{text: "Agent · 一项安排值得重新考虑" draw_text.color: accent draw_text.text_style.font_size: 12}
                                    Small{text: "MOCK · 测试延期，周五可能无法实测"}
                                }
                                LinkButton{text: "查看  ›" on_click: || open_plan()}
                            }
                            Divider{}
                        }
                    }
                }}
                }
            }
            schedule_page := View{visible: false width: Fill height: Fill flow: Down
                ScrollYView{width: Fill height: Fill flow: Down padding: 18 spacing: 16
                    live_schedule_note := Small{visible: false text: "以下为独立的虚构日程示例，没有使用真实新闻生成建议。"}
                    schedule_primary := Box{
                        Small{text: "MOCK · 你的安排"}
                        Heading{text: "新版工具实测"}
                        schedule_time := Text{text: "周五 14:00—15:00"}
                        schedule_note := Small{text: "1 条待确认建议 · 当前安排尚未修改"}
                        LinkButton{text: "查看日程建议  ›" on_click: || open_plan()}
                    }
                    schedule_secondary := Box{
                        Small{text: "MOCK · 无需调整"}
                        Section{text: "周五上午 · 资料准备"}
                        Text{text: "保留阅读接口文档和整理评估问题的安排。"}
                    }
                }
            }
        }
        detail_pane := View{visible: false width: Fill height: Fill flow: Down
            View{width: Fill height: 44 flow: Right align: Align{y: 0.5} padding: Inset{left: 12 right: 18} spacing: 8
                QuietButton{text: "‹ 返回" on_click: || close_detail()}
                detail_title := Small{width: Fill text: "新闻详情" align: Align{x: 1.0}}
            }
            Divider{}
            settings_panel := View{visible: false width: Fill height: Fill flow: Down
                ScrollYView{width: Fill height: Fill flow: Down padding: 20 spacing: 16
                    Heading{text: "连接你的 Octos"}
                    Text{text: "此按钮会真实调用宿主所选的 Octos 和模型；不会使用 Mock 回复。"}
                    Small{text: "在 Rinx 导入页配置模型并点 Use this device，或选择已有服务后点 Connect Octos。"}
                    Primary{text: "Test Octos" on_click: || test_octos()}
                    octos_status := Text{text: octos_message}
                }
            }
            plan_panel := View{visible: false width: Fill height: Fill flow: Down
                plan_content := ScrollYView{width: Fill height: Fill flow: Down padding: 20 spacing: 16 on_render: || {
                    Small{text: "MOCK · Agent 建议，依据与日期均为虚构" draw_text.color: accent}
                    Heading{text: "把实测安排到测试开放之后"}
                    Text{text: "Northstar 的公开测试延期。你可以保留周五的资料准备，将实测移到下周一。"}
                    Box{
                        Section{text: "新版工具实测"}
                        Small{text: "原安排"}
                        Text{text: "周五 14:00—15:00"}
                        if decision == "accepted" { Small{text: "已调整为"} }
                        else { Small{text: "建议时间"} }
                        Text{text: "下周一 14:00—15:00"}
                    }
                    Small{text: "仅修改示例状态 · 未核对其他日程冲突 · 不写入系统日历"}
                    if !demo_mode {
                        Text{text: "请先切换 Mock 示例模式，再体验确认交互。"}
                    } else if decision == "pending" {
                        Primary{text: "确认改期" on_click: || decide("accepted")}
                        SecondaryButton{text: "保留原计划" on_click: || decide("kept")}
                    } else {
                        if decision == "accepted" { Section{text: "已确认改期" draw_text.color: accent} }
                        else { Section{text: "已保留原计划"} }
                        SecondaryButton{text: "重置示例建议" on_click: || reconsider()}
                    }
                    LinkButton{text: "查看新闻依据  ›" on_click: || open_agent(demo_rows[0])}
                }}
            }
            story_panel := View{visible: false width: Fill height: Fill flow: Down
                story_content := ScrollYView{width: Fill height: Fill flow: Down padding: 20 spacing: 16 on_render: || {
                    if reading != nil {
                    Small{text: meta(reading)}
                    Heading{text: reading.title}
                    if mock_row(reading) { Small{text: "MOCK 新闻 · 虚构来源，仅用于交互演示" draw_text.color: accent} }
                    else { Small{text: "真实 feed 摘要，非文章全文"} }
                    if reading.summary == "" { Text{text: "此新闻源未提供摘要。" draw_text.color: secondary} }
                    else { Text{text: reading.summary} }
                    Small{text: "来源 URL（可复制）"}
                    Search{text: reading.link empty_text: "来源 URL"}
                    if mock_row(reading) && reading.hint != "" {
                        Divider{}
                        Section{text: "Agent · 为什么与你有关" draw_text.color: accent}
                        if reading.id == "northstar" {
                            Text{text: "示例中你关注了开发工具，并在周五安排了新版工具实测。测试延期可能影响原计划。"}
                        } else {
                            Text{text: "示例中你关注了端侧 AI。这次补充设备测试，值得阅读，但不足以直接形成日程建议。"}
                        }
                        if !evidence_open { SecondaryButton{text: "展开依据与判断" on_click: || toggle_evidence()} }
                        else {
                            SecondaryButton{text: "收起依据" on_click: || toggle_evidence()}
                            Box{
                                Section{text: "新闻事实（MOCK）"}
                                if reading.id == "northstar" { Text{text: "公开测试由周五推迟至下周一。"} }
                                else { Text{text: "新增低内存设备测试，公布测试条件与限制。"} }
                                Section{text: "关联依据（MOCK）"}
                                if reading.id == "northstar" { Text{text: "关注：开发工具；日程：周五 14:00 工具实测。"} }
                                else { Text{text: "关注：端侧 AI；需要结合自己的目标设备判断。"} }
                                Section{text: "Agent 判断（MOCK）"}
                                if reading.id == "northstar" { Text{text: "可考虑改期；未核对其他安排，是否调整由你确认。"} }
                                else { Text{text: "值得进一步阅读；暂不建议调整日程。"} }
                            }
                        }
                        if reading.id == "northstar" { Primary{text: "查看日程建议" on_click: || open_plan()} }
                    }
                    View{width: Fill height: Fit flow: Right spacing: 10
                        if is_followed(reading) { SecondaryButton{text: "已跟踪" on_click: || toggle_follow(reading)} }
                        else { SecondaryButton{text: "跟踪" on_click: || toggle_follow(reading)} }
                        if is_saved(reading.link) { SecondaryButton{text: "已收藏" on_click: || toggle_save(reading)} }
                        else { SecondaryButton{text: "收藏" on_click: || toggle_save(reading)} }
                    }                    }
                }}
            }
        }
        feedback := Small{visible: false text: "" padding: Inset{left: 18 right: 18 top: 8 bottom: 8}}
        Divider{}
        navigation := View{width: Fill height: 58 flow: Right padding: Inset{left: 12 right: 12 top: 7 bottom: 9} spacing: 4 on_render: || {
            for n in [{id: "feed" label: "动态"} {id: "tracking" label: "跟踪"} {id: "schedule" label: "日程"} {id: "saved" label: "收藏"}] {
                if page == n.id { NavActive{text: n.label on_click: || select_page(n.id)} }
                else { Nav{text: n.label on_click: || select_page(n.id)} }
            }
        }}
    }
    tile: View{width: Fill height: Fill flow: Down padding: 14 spacing: 8 show_bg: true draw_bg.color: white
        Section{text: "cfaw news" draw_text.color: accent}
        tile_list := View{width: Fill height: Fill flow: Down spacing: 8 on_render: || {
            let rows = demo_rows
            if !demo_mode { rows = today_rows() }
            if demo_mode { Small{text: "MOCK · 虚构示例"} }
            for i r in rows { if i < 3 { Text{text: r.title max_lines: 2 draw_text.text_style.font_size: 12} } }
        }}
    }
}
