    header_brand_content := View{width: Fill height: Fill flow: Down align: Align{y: 0.5} spacing: 2 on_render: || {
        Label{width: Fill padding: 0 text: "cfaw-news" draw_text.color: editorial_ink draw_text.text_style: TextStyle{font_size: header_brand_font_size line_spacing: 1.1
            font_family: FontFamily{latin := FontMember{res: crate_resource("makepad_widgets:resources/Serif-Bold.ttf") asc: 0.0 desc: 0.0}}} max_lines: 1}
        Small{text: "NEWS THAT MOVES YOU" draw_text.color: editorial_accent draw_text.text_style.font_size: 7.5 draw_text.text_style.letter_spacing: 1.0}
    }}
}
