// BEGIN src/frontend/pages/schedule.splash
let SchedulePage = View{visible: false width: Fill height: Fill flow: Down
    ScrollYView{width: Fill height: Fill flow: Down padding: 20 spacing: 12
        Heading{text: "我的日程"}
        Small{text: "应用内日程；时间采用 24 小时制。"}
        if schedule_warning != "" { Small{text: schedule_warning draw_text.color: accent} }
        schedule_list := View{width: Fill height: Fit flow: Down spacing: 8 on_render: || {
            if user_schedules.len() == 0 { Small{text: "暂无日程。添加安排后，Agent 可结合内容与地点分析影响。"} }
            for item in user_schedules {
                View{width: Fill height: Fit flow: Down spacing: 3
                    Text{text: item.title}
                    if record_string(item["content"]) && item.content != "" { Small{text: item.content} }
                    if record_string(item["location"]) && item.location != "" { Small{text: "地点：" + item.location} }
                    Small{text: schedule_display_time(item.start, item.timezone) + " → " + schedule_display_time(item.end, item.timezone)}
                    Small{text: schedule_zone_label(item.timezone) + " · 24 小时制"}
                    QuietButton{text: "编辑" on_click: || schedule_begin_edit(item.schedule_id)}
                }
                Divider{}
            }
        }}
        Divider{}
        schedule_editor := View{width: Fill height: Fit flow: Down spacing: 7 on_render: || {
            if schedule_edit_id == nil { Section{text: "录入日程"} }
            else { Section{text: "编辑日程"} }
            Small{text: "日程标题"}
            Search{text: schedule_title_draft empty_text: "例如：项目讨论" on_change: |value| {schedule_title_draft = value}}
            Small{text: "日程内容"}
            Search{text: schedule_content_draft empty_text: "例如：讨论新闻 Agent 的演示方案" on_change: |value| {schedule_content_draft = value}}
            Small{text: "地点"}
            Search{text: schedule_location_draft empty_text: "例如：会议室 / 线上会议" on_change: |value| {schedule_location_draft = value}}
            Small{text: "时间标准（默认北京时间）"}
            View{width: Fill height: Fit flow: Right spacing: 6
                if schedule_timezone_draft == "Asia/Shanghai" { Pill{text: "✓ 北京时间" on_click: || schedule_pick_zone("Asia/Shanghai")} }
                else { QuietButton{text: "北京时间" on_click: || schedule_pick_zone("Asia/Shanghai")} }
                if schedule_timezone_draft == "America/New_York" { Pill{text: "✓ 美国东部" on_click: || schedule_pick_zone("America/New_York")} }
                else { QuietButton{text: "美国东部" on_click: || schedule_pick_zone("America/New_York")} }
            }
            if schedule_timezone_draft == "America/New_York" { Small{text: "纽约时间；自动处理夏令时。"} }
            Small{text: "日程日期"}
            View{width: Fill height: Fit flow: Right spacing: 8
                QuietButton{text: "今天" on_click: || schedule_pick_day(0)}
                QuietButton{text: "明天" on_click: || schedule_pick_day(1)}
                Search{width: Fill text: schedule_date_draft empty_text: "年-月-日" on_change: |value| {
                    schedule_date_draft = value schedule_custom_date = true
                    if !schedule_next_day { schedule_end_date_draft = value }
                    else if schedule_instant(value + "T00:00:00Z") != nil { schedule_end_date_draft = schedule_date_at(schedule_instant(value + "T00:00:00Z") + 86400) }
                }}
            }
            Small{text: "开始时间 · 24 小时制"}
            View{width: Fill height: Fit flow: Right spacing: 6 align: Align{y: 0.5}
                Search{width: 66 text: schedule_start_hour_draft empty_text: "0–23" on_change: |value| {schedule_start_hour_draft = value}}
                Small{width: Fit text: "时"}
                Search{width: 66 text: schedule_start_minute_draft empty_text: "0–59" on_change: |value| {schedule_start_minute_draft = value}}
                Small{width: Fit text: "分"}
            }
            Small{text: "预计结束时间 · 24 小时制"}
            View{width: Fill height: Fit flow: Right spacing: 6 align: Align{y: 0.5}
                Search{width: 66 text: schedule_end_hour_draft empty_text: "0–23" on_change: |value| {schedule_end_hour_draft = value}}
                Small{width: Fit text: "时"}
                Search{width: 66 text: schedule_end_minute_draft empty_text: "0–59" on_change: |value| {schedule_end_minute_draft = value}}
                Small{width: Fit text: "分"}
            }
            View{width: Fill height: Fit flow: Right spacing: 8
                if !schedule_next_day { Pill{text: "✓ 当日结束" on_click: || schedule_pick_end_day(false)} }
                else { QuietButton{text: "当日结束" on_click: || schedule_pick_end_day(false)} }
                if schedule_next_day { Pill{text: "✓ 次日结束" on_click: || schedule_pick_end_day(true)} }
                else { QuietButton{text: "次日结束" on_click: || schedule_pick_end_day(true)} }
            }
            if schedule_next_day { Search{text: schedule_end_date_draft empty_text: "结束日期：年-月-日" on_change: |value| {schedule_end_date_draft = value}} }
            if schedule_edit_error != "" { Small{text: schedule_edit_error draw_text.color: accent} }
            View{width: Fill height: Fit flow: Right spacing: 8
                Primary{text: "保存日程" on_click: || schedule_save_draft()}
                if schedule_edit_id != nil { QuietButton{text: "新建" on_click: || schedule_begin_new()} }
            }
        }}
    }
}
// END src/frontend/pages/schedule.splash

// BEGIN src/frontend/pages/detail.splash
let StoryPage = View{visible: false width: Fill height: Fill flow: Down
    story_content := ScrollYView{width: Fill height: Fill flow: Down padding: 20 spacing: 14 on_render: || {
        if reading != nil {
            Small{text: news_meta(reading)}
            Heading{text: reading.title}
            if reading["demo_data"] == true { Small{text: "演示缓存 · 非实时新闻" draw_text.color: accent} }
            if reading.evidence_kind == "hn_submission" { Small{text: "HN 提交记录；提交时间不等于原文发布时间"} }
            else { Small{text: "真实 RSS / Atom 摘要，非文章全文"} }
            if reading.summary == "" { Text{text: "来源未提供摘要，请通过条目链接查看。" draw_text.color: secondary} }
            else { Text{text: reading.summary} }
            Small{text: "抓取于 " + age_label(reading.retrieved_at)}
            Section{text: "条目链接（可复制）"}
            Search{text: reading.source_url empty_text: "条目 URL"}
            if news_source(reading.source_id) != nil {
                Small{text: "抓取来源：" + news_source(reading.source_id).label}
                if news_source(reading.source_id).kind == "google" { Small{text: "通过 Google News 聚合；条目可能保留聚合跳转链接。"} }
            }
            if reading.references.len() > 1 {
                Small{text: "相同链接已合并；重复收录不代表独立证据。"}
                for ref in reading.references { Small{text: ref.source + " · " + ref.source_id} }
            }
            let reasons = interest_matches(reading, user_interests)
            if reasons.len() > 0 {
                Divider{}
                Section{text: "与你有关 · 规则匹配" draw_text.color: accent}
                for reason in reasons { Text{text: reason} }
            }
            Divider{}
            Section{text: "Agent 影响分析"}
            Small{text: "分析仅使用此条新闻的标题和摘要；日程变更须经用户确认。"}
            agent_status := Small{text: "尚未分析"}
            if analysis_state == "succeeded" && analysis_result != nil && analysis_active_row_id == reading.news_id {
                if analysis_result.outcome == "no_change" { Small{text: "结论：目前无需调整"} }
                else if analysis_result.outcome == "insufficient_evidence" { Small{text: "结论：现有证据不足"} }
                else { Small{text: "结论：值得关注；建议不自动修改日程"} }
                Text{text: analysis_result.explanation}
                for suggestion in analysis_result.suggestions {
                    Text{text: suggestion.change_summary}
                    Text{text: suggestion.rationale}
                    for uncertainty in suggestion.uncertainties { Small{text: "不确定性：" + uncertainty} }
                    for id in suggestion.evidence_ids { Small{text: "证据：" + id} }
                }
            }
            let saved_suggestions = history_suggestions_for_news(reading.news_id)
            if saved_suggestions.len() > 0 {
                Divider{}
                Section{text: "建议历史"}
                for saved in saved_suggestions {
                    Small{text: history_state_label(saved.state)}
                    Text{text: saved.change_summary}
                    if saved.proposed_action != nil {
                        Small{text: "拟议日程：" + saved.proposed_action.kind + " · " + saved.proposed_action.title}
                        Small{text: saved.proposed_action.start + " → " + saved.proposed_action.end + " · " + saved.proposed_action.timezone}
                    }
                    if saved.state == "pending" {
                        View{width: Fill height: Fit flow: Right spacing: 8
                            SecondaryButton{text: "接受" on_click: || update_suggestion_state(saved.suggestion_id, "accepted")}
                            SecondaryButton{text: "忽略" on_click: || update_suggestion_state(saved.suggestion_id, "dismissed")}
                            SecondaryButton{text: "撤回" on_click: || update_suggestion_state(saved.suggestion_id, "withdrawn")}
                        }
                    }
                    if schedule_confirmation_id == saved.suggestion_id {
                        Section{text: "用户确认 · 日程写入预览"}
                        Small{text: "确认时重新读取日程版本并检查时间冲突；失败不会将建议标记为已接受。"}
                        if saved.proposed_action == nil { Small{text: "此建议没有日程动作；确认仅记录你的决定。"} }
                        else {
                            if saved.proposed_action.kind == "reschedule" { Small{text: "更新日程 " + saved.proposed_action.schedule_id + "（预期 v" + saved.proposed_action.schedule_version + "）"} }
                            let collisions = schedule_conflicts(saved.proposed_action, saved.proposed_action.schedule_id)
                            if collisions.len() > 0 { Small{text: "当前时间冲突：" + change_join(collisions) draw_text.color: accent} }
                        }
                        View{width: Fill height: Fit flow: Right spacing: 8
                            Primary{text: "确认并保存" on_click: || schedule_confirm()}
                            QuietButton{text: "取消" on_click: || schedule_cancel_confirm()}
                        }
                    }
                }
            }
            View{width: Fill height: Fit flow: Right spacing: 10
                if analysis_busy { SecondaryButton{text: "取消分析" on_click: || analysis_cancel()} }
                else { SecondaryButton{text: "分析影响" on_click: || analysis_start(reading)} }
            }
            View{width: Fill height: Fit flow: Right spacing: 10
                if records_has_interest("source", reading.source) { SecondaryButton{text: "已跟踪来源" on_click: || toggle_follow(reading)} }
                else { SecondaryButton{text: "跟踪来源" on_click: || toggle_follow(reading)} }
                if records_is_bookmarked(reading.news_id) { SecondaryButton{text: "已收藏" on_click: || toggle_save(reading)} }
                else { SecondaryButton{text: "收藏" on_click: || toggle_save(reading)} }
            }
        }
    }}
}
// END src/frontend/pages/detail.splash

// BEGIN src/frontend/pages/settings.splash
let SourcesPage = View{visible: false width: Fill height: Fill flow: Down
    ScrollYView{width: Fill height: Fill flow: Down padding: 18 spacing: 12
        Heading{text: "选择新闻来源"}
        Small{text: "启用来源后点击刷新。各来源独立失败，已有缓存继续可读。"}
        Primary{text: "刷新已启用来源" on_click: || refresh()}
        source_list := View{width: Fill height: Fit flow: Down spacing: 8 on_render: || {
            for source in news_sources {
                View{width: Fill height: Fit flow: Down spacing: 4
                    View{width: Fill height: 30 flow: Right align: Align{y: 0.5} spacing: 6
                        Section{width: Fill text: source.label}
                        if source_enabled(source.id) { LinkButton{text: "已启用" on_click: || toggle_source(source.id)} }
                        else { QuietButton{text: "启用" on_click: || toggle_source(source.id)} }
                    }
                    Small{text: category_label(source.category) + " · " + source.language}
                    Small{text: source_status_text(source)}
                    Divider{}
                }
            }
        }}
        Section{text: "Agent 状态"}
        Small{text: "新闻分析暂未启用。下方为已有的手动连接测试，仅点击时调用模型。"}
        SecondaryButton{text: "Test Octos" on_click: || test_octos()}
        octos_status := Text{text: octos_message}
    }
}
// END src/frontend/pages/settings.splash

// BEGIN src/frontend/app_view.splash
HostedView{width: Fill height: Fill
    full: View{width: Fill height: Fill flow: Down show_bg: true draw_bg.color: white
        View{width: Fill height: 58 flow: Right align: Align{y: 0.5} padding: Inset{left: 18 right: 14} spacing: 8
            Label{width: Fill text: "cfaw news" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 23}}
            refresh_button := LinkButton{text: "刷新" on_click: || refresh()}
            QuietButton{text: "来源" on_click: || show_settings()}
        }
        Small{text: "真实新闻 · 收藏与追踪保存在本地" padding: Inset{left: 18 right: 18 bottom: 8}}
        Divider{}
        main := View{width: Fill height: Fill flow: Down
            feed_filters := FeedFilters{}
            tracking_header := TrackingHeader{}
            bookmarks_header := BookmarksHeader{}
            search_box := View{width: Fill height: Fit padding: Inset{left: 18 right: 18 top: 4 bottom: 8}
                search := Search{on_change: |text| set_query(text)}
            }
            status := Small{text: "正在准备新闻来源…" padding: Inset{left: 18 right: 18 bottom: 6}}
            feed_list := View{width: Fill height: Fill flow: Down
                empty_panel := View{visible: false width: Fill height: Fill flow: Down padding: 28 spacing: 12
                    Section{text: "这里暂时没有内容"}
                    empty_message := Text{text: "" draw_text.color: secondary}
                }
                list_container := View{width: Fill height: Fill flow: Down
                    list := NewsList{}
                    more_button := QuietButton{visible: false text: "加载更多" on_click: || show_more()}
                }
            }
            schedule_page := SchedulePage{}
        }
        detail_pane := View{visible: false width: Fill height: Fill flow: Down
            View{width: Fill height: 44 flow: Right align: Align{y: 0.5} padding: Inset{left: 12 right: 18} spacing: 8
                QuietButton{text: "‹ 返回" on_click: || close_detail()}
                detail_title := Small{width: Fill text: "新闻详情" align: Align{x: 1.0}}
            }
            Divider{}
            story_panel := StoryPage{}
            settings_panel := SourcesPage{}
            tracking_panel := TrackingEditor{}
        }
        feedback := Small{visible: false text: "" padding: Inset{left: 18 right: 18 top: 8 bottom: 8}}
        Divider{}
        navigation := View{width: Fill height: 58 flow: Right padding: Inset{left: 12 right: 12 top: 7 bottom: 9} spacing: 4 on_render: || {
            for item in [{id: "feed" label: "动态"} {id: "tracking" label: "跟踪"} {id: "schedule" label: "日程"} {id: "saved" label: "收藏"}] {
                if page == item.id { NavActive{text: item.label on_click: || select_page(item.id)} }
                else { Nav{text: item.label on_click: || select_page(item.id)} }
            }
        }}
    }
    tile: View{width: Fill height: Fill flow: Down padding: 14 spacing: 8 show_bg: true draw_bg.color: white
        Section{text: "cfaw news" draw_text.color: accent}
        tile_list := View{width: Fill height: Fill flow: Down spacing: 8 on_render: || {
            if app_feed_rows.len() == 0 { Small{text: "真实新闻尚未加载"} }
            for i row in app_feed_rows { if i < 3 { Text{text: row.title max_lines: 2 draw_text.text_style.font_size: 12} } }
        }}
    }
}
// END src/frontend/app_view.splash

// BEGIN src/app/startup.splash
fn boot(){
    records_load()
    schedules_load()
    history_load()
    feed_initialize()
    render_main()
    if records_warning != "" { notice(records_warning) }
    // records_load/history_load/render_main already spent most of this 64ms
    // slice; defer the cache restore so its first source read gets a fresh budget.
    start_timeout(0.01, || feed_restore_cache(0, feed_generation, || {
        rebuild_feed(|| {
            render_main()
            let demo_cache = false
            for row in app_feed_rows { if row["demo_data"] == true { demo_cache = true } }
            if demo_cache { notice("演示缓存仅供测试，非实时新闻；手动刷新可尝试获取真实来源。") }
            else { start_timeout(0.01, || refresh()) }
        })
    }))
}
// Defer until all page prototypes and widget references have been mounted.
start_timeout(0.05, || boot())
// END src/app/startup.splash
