// BEGIN src/data/ingestion/normalize.splash
fn news_source(id){
    for s in news_sources { if s.id == id { return s } }
    nil
}
fn news_identity(url){ return url.split("#")[0] }
fn news_normalize(item, source, retrieved_at){
    if !record_object(item) || !record_string(item["title"]) || item.title.trim() == "" || !record_url(item["link"]) { return nil }
    let publisher = source.label
    if record_string(item["source"]) && item.source != "" { publisher = item.source }
    let summary = ""
    if record_string(item["summary"]) { summary = item.summary }
    let image_url = nil
    // RSS images are optional and untrusted; only retain bounded HTTPS URLs.
    if record_string(item["image"]) && item.image.len() <= 4096 && regex("^https://[^/ ]+").test(item.image) { image_url = item.image }
    let published_at = nil
    if record_number(item["published"]) && item.published > 0 { published_at = item.published }
    let kind = "rss_summary"
    let timestamp_kind = "published"
    if source.kind == "hn" {
        kind = "hn_submission"
        timestamp_kind = "submitted"
    }
    let row = {news_id: news_identity(item.link) evidence_id: news_identity(item.link) content_version: item.title.trim() + "\n" + summary title: item.title.trim() source: publisher
        source_id: source.id source_url: item.link feed_url: source.url category: source.category
        language: source.language summary: summary image_url: image_url published_at: published_at retrieved_at: retrieved_at
        evidence_kind: kind timestamp_kind: timestamp_kind
        references: [{source_id: source.id source: publisher source_url: item.link feed_url: source.url}]}
    if record_string(item["body_html"]) {
        row.source_summary = summary row.body_html = item.body_html
        row.body_truncated = item["body_truncated"] == true row.body_origin = item["body_origin"]
    }
    if record_string(item["publisher_byline"]) { row.publisher_byline = item.publisher_byline }
    if record_string(item["publisher_license"]) { row.publisher_license = item.publisher_license }
    if item["timestamp_parser_revision"] == 1 { row.timestamp_parser_revision = 1 }
    if !news_record_valid(row) { return nil }
    return row
}
fn news_hn_items(body){
    let data = nil
    try { data = body.parse_json() } { data = nil }
    if !record_object(data) || !record_array(data["hits"]) { return nil }
    let items = []
    for hit in data.hits {
        if !record_object(hit) || !record_string(hit["objectID"]) { continue }
        let link = "https://news.ycombinator.com/item?id=" + hit.objectID
        if record_url(hit["url"]) { link = hit.url }
        items.push({title: hit["title"] link: link source: "Hacker News" summary: "" published: hit["created_at_i"]})
    }
    return items
}
fn news_parse(body, source, retrieved_at){
    let items = nil
    if source["reading_feed"] == true { items = reading_feed_items(body, source) }
    else if source.kind == "hn" { items = news_hn_items(body) }
    else {
        // The pinned native parser has no return value for unsupported XML.
        if !regex("<(rss|feed|rdf:RDF)([ >\\r\\n\\t])").test(body) { return nil }
        try { items = body.parse_feed(source.kind) } { items = nil }
    }
    if items == nil { return nil }
    let rows = []
    for item in items {
        if rows.len() >= news_config.items_per_source { break }
        let row = news_normalize(item, source, retrieved_at)
        if row != nil { rows.push(row) }
    }
    return rows
}
fn news_newer(a, b){
    if a.published_at == nil { return false }
    if b.published_at == nil { return true }
    a.published_at > b.published_at
}
fn news_sort(rows){
    // Bottom-up merge sort bounds work when all cached sources load together.
    let width = 1
    while width < rows.len() {
        let next = []
        let start = 0
        while start < rows.len() {
            let left = start
            let middle = min(start + width, rows.len())
            let right = middle
            let end = min(start + width + width, rows.len())
            while left < middle || right < end {
                if left < middle && (right >= end || !news_newer(rows[right], rows[left])) {
                    next.push(rows[left]) left = left + 1
                } else { next.push(rows[right]) right = right + 1 }
            }
            start = end
        }
        rows = next
        width = width + width
    }
    return rows
}
fn news_merge_copy(row){
    // Strings are immutable: reuse full publisher bodies instead of serializing
    // them again on every source update. Provenance remains independently owned.
    let copy = {news_id: row.news_id evidence_id: row.evidence_id content_version: row.content_version
        title: row.title source: row.source source_id: row.source_id source_url: row.source_url
        feed_url: row.feed_url category: row.category language: row.language summary: row.summary
        image_url: row.image_url published_at: row.published_at retrieved_at: row.retrieved_at
        evidence_kind: row.evidence_kind timestamp_kind: row.timestamp_kind
        references: row.references.to_json().parse_json()}
    if row["body_html"] != nil {
        copy.body_html = row.body_html copy.source_summary = row["source_summary"]
        copy.body_truncated = row["body_truncated"] copy.body_origin = row["body_origin"]
    }
    if row["publisher_byline"] != nil { copy.publisher_byline = row.publisher_byline }
    if row["publisher_license"] != nil { copy.publisher_license = row.publisher_license }
    if row["bookmarked_at"] != nil { copy.bookmarked_at = row.bookmarked_at }
    if row["timestamp_parser_revision"] != nil { copy.timestamp_parser_revision = row.timestamp_parser_revision }
    if row["fixed_article"] == true {
        for field in ["fixed_article" "original_title" "source_role" "same_event_as" "archive_captured_at" "source_published_date" "source_updated_date" "source_verified_date" "coverage_note"] { copy[field] = row[field] }
    }
    return copy
}
fn news_append_unique(out, indexed, row){
    if news_is_demo(row) { return false }
    let existing_index = indexed[row.news_id]
    if existing_index != nil {
        let existing = out[existing_index]
        let references = existing.references
        if row.retrieved_at > existing.retrieved_at {
            existing = news_merge_copy(row)
            existing.references = references
            out[existing_index] = existing
        }
        let ids = []
        for ref in existing.references { ids.push(ref.source_id) }
        for ref in row.references {
            if !record_contains(ids, ref.source_id) { existing.references.push(ref.to_json().parse_json()) ids.push(ref.source_id) }
        }
        return true
    }
    indexed[row.news_id] = out.len()
    out.push(news_merge_copy(row))
    return true
}
fn news_merge(groups){
    let out = []
    let indexed = {}
    for rows in groups { for row in rows { news_append_unique(out, indexed, row) } }
    let limited = []
    for row in news_sort(out) { if limited.len() < news_config.max_feed_items { limited.push(row) } }
    limited
}
// END src/data/ingestion/normalize.splash

// BEGIN src/data/ingestion/reading_feeds.splash
// Publisher RSS adapters preserve body HTML separately from publisher summaries.
// The host's generic feed parser shortens all descriptions to 280 characters.
fn reading_feed_field(xml, tag){
    let exact = xml.split("<" + tag + ">")
    let value = ""
    if exact.len() > 1 { value = exact[1].split("</" + tag + ">")[0].trim() }
    else {
        let parts = xml.split("<" + tag)
        if parts.len() < 2 { return "" }
        // Atom attributes need the fallback; ordinary RSS keeps its fast path.
        for index part in parts {
            if index == 0 { continue }
            if regex("^(>|[ \\t\\r\\n])").test(part) {
                value = part.split("</" + tag + ">")[0].replace(regex("^[^>]*>"), "").trim()
                break
            }
        }
    }
    if regex("^<!\\[CDATA\\[").test(value) {
        value = value.strip_prefix("<![CDATA[").strip_suffix("]]> ").strip_suffix("]]>")
    } else {
        // XML text encodes HTML markup; decode the XML layer only once.
        if regex("&(?:lt|gt|quot|apos|amp);").test(value) {
            let decoded = ("<div>" + value + "</div>").parse_html().query("div[0]")
            if decoded != nil { value = decoded.text }
        }
    }
    value.trim()
}
fn reading_feed_text(html){
    if html == "" { return "" }
    let doc = ("<article>" + html + "</article>").parse_html()
    let node = doc.query("article[0]")
    if node == nil { return "" }
    node.text.replace("查看全文", "").trim()
}
fn reading_feed_items(body, source){
    let items = []
    let limit = news_config.items_per_source
    if record_number(source["max_items"]) { limit = min(limit, source.max_items) }
    let entry_tag = "item"
    if source.kind == "atom" { entry_tag = "entry" }
    for i chunk in body.split("<" + entry_tag) {
        if i == 0 { continue }
        if items.len() >= limit { break }
        let xml = chunk.split("</" + entry_tag + ">")[0]
        // Expreview writes hour-only numeric zones (+08). The native parser
        // treats these as UTC; expand this publisher's zone before parsing.
        if source["pubdate_short_zone"] == true {
            let date = reading_feed_field(xml, "pubDate")
            let parts = date.split(" ")
            let zone = parts[parts.len() - 1]
            if regex("^[+-][0-9]{2}$").test(zone) {
                let corrected = date.strip_suffix(zone) + zone + "00"
                xml = xml.replace(date, corrected)
            }
        }
        // Preserve the pinned native parser's URL/date handling per entry.
        let document = "<rss><channel><item" + xml + "</item></channel></rss>"
        // Internal parser envelope: native parse_feed identifies Atom by the
        // feed/entry elements, so no XML namespace or external asset is needed.
        if source.kind == "atom" { document = "<feed><entry" + xml + "</entry></feed>" }
        let parsed = document.parse_feed(source.kind)
        if parsed == nil { continue }
        if parsed.len() == 0 { continue }
        let item = parsed[0]
        if source["pubdate_short_zone"] == true { item.timestamp_parser_revision = 1 }
        if source["feed_image"] == false { item.image = "" }
        item.summary = ""
        if source["summary_field"] != "none" { item.summary = reading_feed_text(reading_feed_field(xml, source.summary_field)) }
        let html = ""
        if source["body_field"] != "none" { html = reading_feed_field(xml, source.body_field) }
        item.body_html = html
        item.body_truncated = false
        if html.len() > 160000 { item.body_html = "" item.body_truncated = true }
        item.body_origin = "publisher_rss"
        if source.kind == "atom" {
            item.publisher_byline = reading_feed_text(reading_feed_field(xml, "name"))
            item.publisher_license = reading_feed_text(reading_feed_field(xml, "rights"))
            item.body_origin = "publisher_atom"
        }
        items.push(item)
    }
    items
}

// Native callbacks have a 64 ms budget. Parse one publisher entry per slice;
// cancel with the refresh generation instead of publishing a partial old feed.
fn reading_feed_parse_async(body, source, retrieved_at, generation, complete){
    mod.gc.run()
    if !record_string(body) || !regex("<(rss|feed|rdf:RDF)([ >\\r\\n\\t])").test(body) { complete(nil) return }
    let tag = "item"
    if source.kind == "atom" { tag = "entry" }
    let limit = news_config.items_per_source
    if record_number(source["max_items"]) { limit = min(limit, source.max_items) }
    let chunks = body.split("<" + tag)
    chunks[0] = ""
    let bounded = []
    for i chunk in chunks { if i > 0 && bounded.len() < limit { bounded.push(chunk) } }
    // Do not retain entries beyond the display limit in callback scopes.
    chunks = [] body = ""
    let work = {chunks: bounded tag: tag index: 0 rows: [] source: source
        retrieved_at: retrieved_at generation: generation limit: limit complete: complete}
    start_timeout(0.01, || reading_feed_parse_step(work))
}
fn reading_feed_parse_step(work){
    if work.generation != feed_generation { return }
    // Publisher HTML/native parser temporaries accumulate across callbacks
    // on the host's growth-only GC. Reclaim before parsing another entry.
    mod.gc.run()
    if work.index >= work.chunks.len() || work.rows.len() >= work.limit {
        work.chunks = []
        work.complete(work.rows)
        return
    }
    let chunk = work.chunks[work.index].split("</" + work.tag + ">")[0]
    let document = "<rss><channel><item" + chunk + "</item></channel></rss>"
    if work.source.kind == "atom" { document = "<feed><entry" + chunk + "</entry></feed>" }
    let rows = news_parse(document, work.source, work.retrieved_at)
    if rows != nil { for row in rows { work.rows.push(row) } }
    work.chunks[work.index] = ""
    work.index = work.index + 1
    start_timeout(0.01, || reading_feed_parse_step(work))
}
// END src/data/ingestion/reading_feeds.splash

// BEGIN src/data/storage/records.splash
// The repository owns user records. The host exposes read/write/exists, no rename.
// Keep a previous valid snapshot before replacing a primary file.
let user_bookmarks = []
let user_interests = []
let enabled_source_ids = []
let tracking_state = {schema_version: 1 last_checked_at: 0 seen_ids: [] unread_ids: []}
let tracking_unread_index = {}
let tracking_revision = 0
let tracking_check_id = 0
fn records_index_unread(){
    tracking_unread_index = {}
    for id in tracking_state.unread_ids { tracking_unread_index[id] = true }
}
fn records_is_unread(id){ tracking_unread_index[id] == true }
let records_warning = ""
let bookmark_file = {path: "bookmarks_v1.json" writable: true recovered: false}
let interest_file = {path: "interests_v1.json" writable: true recovered: false}
let tracking_file = {path: "tracking_state_v1.json" writable: true recovered: false}

fn records_warn(message){
    if records_warning != "" { records_warning = records_warning + "；" }
    records_warning = records_warning + message
}
fn records_document_valid(value, kind){
    if !record_object(value) || value["schema_version"] != 1 { return false }
    if kind == "tracking" {
        if !record_number(value["last_checked_at"]) || !record_array(value["seen_ids"]) || !record_array(value["unread_ids"]) { return false }
        if value["seen_ids"].len() > news_config.max_seen_ids || value["unread_ids"].len() > news_config.max_seen_ids { return false }
        for id in value["seen_ids"] { if !record_string(id) { return false } }
        for id in value["unread_ids"] { if !record_string(id) { return false } }
        return true
    }
    if !record_array(value["items"]) { return false }
    if kind == "bookmarks" && value["items"].len() > news_config.max_bookmarks { return false }
    if kind == "interests" && value["items"].len() > news_config.max_interests { return false }
    if value.items.len() > 0 {
        for item in value.items {
            if kind == "bookmarks" && (!news_record_valid(item) || !record_number(item["bookmarked_at"])) { return false }
            if kind == "interests" && !interest_record_valid(item) { return false }
        }
    }
    if kind == "interests" {
        if !record_array(value["enabled_source_ids"]) { return false }
        if value["enabled_source_ids"].len() > news_sources.len() { return false }
        for id in value["enabled_source_ids"] { if !record_string(id) { return false } }
    }
    true
}
fn records_read(file, kind){
    let exists = false
    try { exists = fs.exists(file.path) } { file.writable = false records_warn(file.path + "：无法检查存储") }
    if exists {
        let value = nil
        try { value = fs.read(file.path).parse_json() } { value = nil }
        if records_document_valid(value, kind) { return value }
        if record_object(value) && value["schema_version"] != nil && value["schema_version"] != 1 {
            file.writable = false
            records_warn(file.path + "：不支持的版本，原记录已保留；当前修改仅在会话内保留")
            return nil
        }
        // An unknown schema or broken file is never replaced by defaults.
        file.writable = false
        records_warn(file.path + "：格式无效，原文件已保留")
    }
    let backup = nil
    try {
        if fs.exists(file.path + ".backup") { backup = fs.read(file.path + ".backup").parse_json() }
    } { records_warn(file.path + "：备份读取失败") }
    if records_document_valid(backup, kind) {
        file.recovered = true
        records_warn(file.path + "：已从备份恢复；修改继续保存到备份")
        return backup
    }
    nil
}
fn records_write(file, value, kind){
    if !records_document_valid(value, kind) { return "记录未通过校验，未保存" }
    if !file.writable && !file.recovered { return "原存储文件无法读取，本次修改仅在会话内保留" }
    let error = ""
    try {
        if file.recovered {
            fs.write(file.path + ".backup", value.to_json())
        } else {
            if fs.exists(file.path) {
                let previous = fs.read(file.path).parse_json()
                if !records_document_valid(previous, kind) {
                    file.writable = false
                    error = "存储文件发生变化，原文件已保留"
                } else { fs.write(file.path + ".backup", previous.to_json()) }
            }
            if error == "" { fs.write(file.path, value.to_json()) }
        }
    } { error = "本地存储写入失败，可能空间不足；本次修改仍在会话内保留" }
    error
}
fn records_load(){
    tracking_revision = tracking_revision + 1
    user_bookmarks = []
    user_interests = []
    enabled_source_ids = []
    tracking_state = {schema_version: 1 last_checked_at: 0 seen_ids: [] unread_ids: []}
    records_warning = ""
    for source in news_sources { if source.enabled { enabled_source_ids.push(source.id) } }
    let bookmarks = records_read(bookmark_file, "bookmarks")
    if bookmarks != nil { user_bookmarks = bookmarks.items }
    else if bookmark_file.writable {
        try { if !fs.exists(bookmark_file.path) { records_migrate_bookmarks() } }
        { bookmark_file.writable = false records_warn("旧收藏迁移检查失败，原文件已保留") }
    }
    let interests = records_read(interest_file, "interests")
    if interests != nil { records_apply_interests(interests) }
    let tracking = records_read(tracking_file, "tracking")
    if tracking != nil { tracking_state = tracking }
    records_index_unread()
    if user_bookmarks.len() > 0 { user_bookmarks.retain(|row| !news_is_demo(row)) }
    records_clean_demo_bookmarks(bookmark_file.path)
    records_clean_demo_bookmarks(bookmark_file.path + ".backup")
}
fn records_apply_interests(interests){
    user_interests = interests.items
    if interests["reading_sources_revision"] != 2 && interests["reading_sources_revision"] != 3 {
        let error = records_save_interests()
        if error != "" { records_warn(error) }
        return true
    }
    let selected = {}
    for id in interests.enabled_source_ids { selected[id] = true }
    let ids = []
    for source in news_sources { if selected[source.id] == true { ids.push(source.id) } }
    enabled_source_ids = ids
    true
}
fn records_clean_demo_bookmarks(path){
    // Clean both snapshots so recovery cannot resurrect removed demo news.
    try {
        if !fs.exists(path) { return }
        let value = fs.read(path).parse_json()
        if !records_document_valid(value, "bookmarks") { return }
        let count = value.items.len()
        if value.items.len() > 0 { value.items.retain(|row| !news_is_demo(row)) }
        if count != value.items.len() { fs.write(path, value.to_json()) }
    } { records_warn("演示收藏已隐藏，但本地清理保存失败") }
}
fn records_migrate_bookmarks(){
    if !fs.exists("saved.json") { return false }
    let migrated = []
    let valid = true
    let legacy = nil
    try { legacy = fs.read("saved.json").parse_json() } { legacy = nil }
    if !record_array(legacy) { valid = false }
    else { migrated = records_convert_legacy(legacy) if migrated == nil { valid = false } }
    if !valid {
        bookmark_file.writable = false
        records_warn("旧收藏 saved.json 无法完整迁移；文件已保留")
        return false
    }
    user_bookmarks = migrated
    let error = records_save_bookmarks()
    if error != "" { records_warn("旧收藏已读取；" + error) }
    return error == ""
}
fn records_convert_legacy(legacy){
    if legacy.len() > news_config.max_bookmarks { return nil }
    let migrated = []
    let migrated_ids = []
    for item in legacy {
        let source = {id: "legacy" label: "历史收藏" kind: "rss" category: "other" language: "" url: ""}
        if record_string(item["source"]) { source.label = item["source"] }
        let row = news_normalize(item, source, 0)
        if row == nil { return nil }
        if !record_contains(migrated_ids, row.news_id) { row.bookmarked_at = 0 migrated.push(row) migrated_ids.push(row.news_id) }
    }
    return migrated
}
fn records_save_bookmarks(){
    records_write(bookmark_file, {schema_version: 1 items: user_bookmarks}, "bookmarks")
}
fn records_save_interests(){
    records_write(interest_file, {schema_version: 1 reading_sources_revision: 3 items: user_interests enabled_source_ids: enabled_source_ids}, "interests")
}
fn records_save_tracking(){ records_write(tracking_file, tracking_state, "tracking") }
fn records_is_bookmarked(id){
    for item in user_bookmarks { if item.news_id == id { return true } }
    false
}
fn records_toggle_bookmark(row){
    if records_is_bookmarked(row.news_id) { user_bookmarks.retain(|item| item.news_id != row.news_id) }
    else {
        if user_bookmarks.len() >= news_config.max_bookmarks { return "收藏已达上限，请先整理已有收藏" }
        // Store an independent snapshot; refreshing or evicting the feed cannot erase it.
        let snapshot = row.to_json().parse_json()
        snapshot.bookmarked_at = time_now()
        user_bookmarks.push(snapshot)
    }
    records_save_bookmarks()
}
fn records_has_interest(kind, value){
    for item in user_interests { if item.kind == kind && item.value == value && item.enabled { return true } }
    false
}
fn records_add_interest(kind, value){
    value = value.trim()
    if value == "" || value.len() > 200 { return "请输入 1–200 字节的来源、主题或关键词" }
    for item in user_interests { if item.kind == kind && item.value == value { return "已在追踪列表中" } }
    if user_interests.len() >= news_config.max_interests { return "追踪已达上限，请先整理已有规则" }
    let item = {interest_id: kind + ":" + value kind: kind value: value enabled: true created_at: time_now()}
    if !interest_record_valid(item) { return "追踪规则无效" }
    user_interests.push(item)
    interest_reset_matchers()
    records_save_interests()
}
fn records_remove_interest(id){
    user_interests.retain(|item| item.interest_id != id)
    interest_reset_matchers()
    records_save_interests()
}
fn records_toggle_source(id){
    if record_contains(enabled_source_ids, id) { enabled_source_ids.retain(|value| value != id) }
    else { enabled_source_ids.push(id) }
    records_save_interests()
}
fn records_check_tracking(rows, interests, checked_at, current, complete){
    tracking_check_id = tracking_check_id + 1
    let work = {id: tracking_check_id revision: tracking_revision rows: rows interests: interests checked_at: checked_at
        current: current complete: complete previous: tracking_state baseline: tracking_state.last_checked_at == 0
        phase: "seen" index: 0 seen: [] unread: [] seen_index: {} unread_index: {}
        retained_seen: [] retained_unread: [] retained_index: {} retained_unread_index: {}}
    // Copy and match on fresh slices; publish only a complete, current snapshot.
    start_timeout(0.01, || records_tracking_step(work))
}
fn records_tracking_step(work){
    if work.id != tracking_check_id || !work.current() { return }
    if work.revision != tracking_revision {
        // Reading a story while checking must not be undone by an older snapshot.
        records_check_tracking(work.rows, work.interests, work.checked_at, work.current, work.complete)
        return
    }
    let processed = 0
    let started_at = time_now()
    while processed < news_config.work_batch_items && time_now() - started_at < news_config.work_slice_seconds {
        if work.phase == "seen" {
            if work.index >= work.previous.seen_ids.len() { work.phase = "unread" work.index = 0 continue }
            let id = work.previous.seen_ids[work.index]
            work.seen.push(id) work.seen_index[id] = true
        } else if work.phase == "unread" {
            if work.index >= work.previous.unread_ids.len() { work.phase = "news" work.index = 0 continue }
            let id = work.previous.unread_ids[work.index]
            work.unread.push(id) work.unread_index[id] = true
        } else if work.phase == "news" {
            if work.index >= work.rows.len() {
                work.phase = "retain_seen" work.index = max(0, work.seen.len() - news_config.max_seen_ids) continue
            }
            let row = work.rows[work.index]
            if work.seen_index[row.news_id] != true {
                work.seen.push(row.news_id) work.seen_index[row.news_id] = true
                if !work.baseline {
                    if work.unread_index[row.news_id] != true && interest_matches(row, work.interests).len() > 0 {
                        work.unread.push(row.news_id) work.unread_index[row.news_id] = true
                    }
                }
            }
        } else if work.phase == "retain_seen" {
            if work.index >= work.seen.len() { work.phase = "retain_unread" work.index = 0 continue }
            let id = work.seen[work.index]
            work.retained_seen.push(id) work.retained_index[id] = true
        } else if work.phase == "retain_unread" {
            if work.index >= work.unread.len() {
                start_timeout(0.01, || records_tracking_commit(work))
                return
            }
            let id = work.unread[work.index]
            if work.retained_index[id] == true {
                work.retained_unread.push(id) work.retained_unread_index[id] = true
            }
        }
        work.index = work.index + 1 processed = processed + 1
    }
    start_timeout(0.01, || records_tracking_step(work))
}
fn records_tracking_commit(work){
    if work.id != tracking_check_id || !work.current() { return }
    if work.revision != tracking_revision { records_tracking_step(work) return }
    tracking_state = {schema_version: 1 last_checked_at: work.checked_at seen_ids: work.retained_seen unread_ids: work.retained_unread}
    tracking_unread_index = work.retained_unread_index
    tracking_revision = tracking_revision + 1
    let error = records_save_tracking()
    // Saving/validating a full history must not share the UI completion's budget.
    start_timeout(0.01, || { if work.id == tracking_check_id && work.current() { work.complete(error) } })
}
fn records_mark_read(id){
    if !record_contains(tracking_state.unread_ids, id) { return "" }
    tracking_revision = tracking_revision + 1
    tracking_state.unread_ids.retain(|value| value != id)
    tracking_unread_index[id] = false
    records_save_tracking()
}
// END src/data/storage/records.splash

// BEGIN src/data/storage/schedules.splash
// App-owned calendar. RFC3339 offsets define instants; timezone is a display label.
let user_schedules = []
let schedule_file = {path: "schedules_v1.json" writable: true recovered: false}
let schedule_warning = ""
let schedule_counter = 0
fn schedule_warn(text){ if schedule_warning != "" { schedule_warning = schedule_warning + "; " } schedule_warning = schedule_warning + text }
fn schedule_active(item){ item["status"] == nil || item.status == "active" }
fn schedule_status_label(item){
    if item["status"] == "cancelled" { return "已取消" }
    if item["status"] == "completed" { return "已完成" }
    "进行中"
}
fn schedule_set_status(id, version, status){
    if status != "active" && status != "cancelled" && status != "completed" { return "不支持的日程状态" }
    let error = schedule_refresh()
    if error != "" { return error }
    let item = schedule_find(id)
    if item == nil || item.version != version { return "日程已变化，请重新查看" }
    let previous = user_schedules.to_json()
    item.status = status item.version = item.version + 1
    error = schedule_write()
    if error != "" { user_schedules = previous.parse_json() }
    error
}
fn schedule_instant(text){
    if !analysis_rfc3339(text) { return nil }
    let date = text.split("T")[0].split("-")
    let clock = text.split("T")[1]
    let local = clock.split("Z")[0].split("+")[0].split("-")[0].split(":")
    let year = date[0].to_f64()
    let month = date[1].to_f64()
    let day = date[2].to_f64()
    let hour = local[0].to_f64()
    let minute = local[1].to_f64()
    let second = local[2].to_f64()
    if year < 1 || month < 1 || month > 12 || day < 1 || hour > 23 || minute > 59 || second > 59 { return nil }
    let max_day = 31
    if month == 4 || month == 6 || month == 9 || month == 11 { max_day = 30 }
    if month == 2 {
        max_day = 28
        if year % 4 == 0 { max_day = 29 }
        if year % 100 == 0 { max_day = 28 }
        if year % 400 == 0 { max_day = 29 }
    }
    if day > max_day { return nil }
    let offset = 0
    let parts = clock.split("+")
    let sign = 1
    if parts.len() == 1 { parts = clock.split("-") sign = -1 }
    if parts.len() > 1 {
        let zone = parts[1].split(":")
        let zone_hour = zone[0].to_f64()
        let zone_minute = zone[1].to_f64()
        if zone_hour > 14 || zone_minute > 59 { return nil }
        if zone_hour == 14 && zone_minute > 0 { return nil }
        offset = sign * (zone_hour * 60 + zone_minute)
    }
    let y = year
    if month <= 2 { y = y - 1 }
    let era = floor(y / 400)
    let yoe = y - era * 400
    let mp = month - 3
    if month <= 2 { mp = month + 9 }
    let doy = floor((153 * mp + 2) / 5) + day - 1
    let days = era * 146097 + yoe * 365 + floor(yoe / 4) - floor(yoe / 100) + doy - 719468
    days * 86400 + hour * 3600 + (minute - offset) * 60 + second
}
fn schedule_interval(start, end){
    let a = schedule_instant(start)
    let b = schedule_instant(end)
    if a == nil || b == nil { return false }
    b > a
}
fn schedule_valid(item){
    if !record_object(item) || !record_string(item["schedule_id"]) || item.schedule_id == "" { return false }
    if !record_number(item["version"]) || item.version < 1 { return false }
    if !record_string(item["title"]) || item.title.trim() == "" { return false }
    if !record_string(item["timezone"]) || item.timezone.trim() == "" { return false }
    if item["content"] != nil && !record_string(item["content"]) { return false }
    if item["location"] != nil && !record_string(item["location"]) { return false }
    if item["status"] != nil && item.status != "active" && item.status != "cancelled" && item.status != "completed" { return false }
    if item["allow_reschedule"] != nil && item.allow_reschedule != true && item.allow_reschedule != false { return false }
    if item["origin_intent_id"] != nil && (!record_string(item.origin_intent_id) || item.origin_intent_id == "" || item.origin_intent_id.len() > 200) { return false }
    if item["news_keywords"] != nil && !tracking_strings(item.news_keywords, 6, 120) { return false }
    if item["demo_preset"] != nil && item.demo_preset != true && item.demo_preset != false { return false }
    schedule_interval(item["start"], item["end"])
}
fn schedule_doc_valid(value){
    if !record_object(value) || value["schema_version"] != 1 || !record_array(value["items"]) { return false }
    let ids = {}
    for item in value.items {
        if !schedule_valid(item) || ids[item.schedule_id] == true { return false }
        ids[item.schedule_id] = true
    }
    true
}
fn schedule_read(){
    let exists = false
    try { exists = fs.exists(schedule_file.path) } { schedule_file.writable = false schedule_warn("Schedule storage unavailable") }
    if exists {
        let value = nil
        try { value = fs.read(schedule_file.path).parse_json() } { value = nil }
        if schedule_doc_valid(value) { return value.items }
        schedule_file.writable = false
        schedule_warn("Invalid schedule file; original preserved")
    }
    let backup = nil
    try { if fs.exists(schedule_file.path + ".backup") { backup = fs.read(schedule_file.path + ".backup").parse_json() } } { schedule_warn("Schedule backup unreadable") }
    if schedule_doc_valid(backup) { schedule_file.recovered = true schedule_warn("Schedules recovered from backup") return backup.items }
    []
}
fn schedules_load(){ schedule_file.writable = true schedule_file.recovered = false schedule_warning = "" user_schedules = schedule_read() }
fn schedule_refresh(){
    if !schedule_file.writable && !schedule_file.recovered { return "Schedule storage unavailable" }
    let rows = schedule_read()
    if !schedule_file.writable && !schedule_file.recovered { return "Schedule storage changed; original preserved" }
    user_schedules = rows
    ""
}
fn schedule_write(){
    let value = {schema_version: 1 items: user_schedules}
    if !schedule_doc_valid(value) { return "Invalid schedule data; nothing saved" }
    if !schedule_file.writable && !schedule_file.recovered { return "Schedule storage is read-only" }
    let error = ""
    try {
        if schedule_file.recovered { fs.write(schedule_file.path + ".backup", value.to_json()) }
        else {
            if fs.exists(schedule_file.path) {
                let old = fs.read(schedule_file.path).parse_json()
                if !schedule_doc_valid(old) { error = "Schedule storage changed; original preserved" schedule_file.writable = false }
                else { fs.write(schedule_file.path + ".backup", old.to_json()) }
            }
            if error == "" { fs.write(schedule_file.path, value.to_json()) }
        }
    } { error = "Schedule write failed; previous data preserved" }
    error
}
fn schedule_find(id){ for item in user_schedules { if item.schedule_id == id { return item } } nil }
fn schedule_conflicts(candidate, ignore_id){
    let out = []
    let a = schedule_instant(candidate.start)
    let b = schedule_instant(candidate.end)
    if a == nil || b == nil { return out }
    for item in user_schedules {
        if item.schedule_id != ignore_id && schedule_active(item) {
            if a < schedule_instant(item.end) {
                if schedule_instant(item.start) < b { out.push(item.schedule_id) }
            }
        }
    }
    out
}
fn schedule_create(title, start, end, timezone, suggestion_id){
    schedule_create_details(title, "", "", start, end, timezone, suggestion_id)
}
fn schedule_create_details(title, content, location, start, end, timezone, suggestion_id){
    schedule_create_options(title, content, location, start, end, timezone, suggestion_id, true)
}
fn schedule_create_options(title, content, location, start, end, timezone, suggestion_id, allow){
    schedule_create_record(title, content, location, start, end, timezone, suggestion_id, allow, nil)
}
fn schedule_create_record(title, content, location, start, end, timezone, suggestion_id, allow, intent_id){
    if !record_string(content) || !record_string(location) { return {success: false error: "Invalid schedule content or location"} }
    if record_string(title) && (title.len() > 200 || content.len() > 2000 || location.len() > 300) { return {success: false error: "标题最多200字，内容最多2000字，地点最多300字"} }
    if !schedule_interval(start, end) || !record_string(title) || title.trim() == "" { return {success: false error: "Invalid schedule title or interval"} }
    if !record_string(timezone) || timezone.trim() == "" { return {success: false error: "Timezone label required"} }
    let error = schedule_refresh()
    if error != "" { return {success: false error: error} }
    if suggestion_id != nil {
        for item in user_schedules { if item["origin_suggestion_id"] == suggestion_id { return {success: true item: item idempotent: true} } }
    }
    if intent_id != nil {
        for item in user_schedules {
            if item["origin_intent_id"] == intent_id {
                if item.title != title.trim() || item.content != content.trim() || item.location != location.trim() || item.start != start || item.end != end || item.timezone != timezone {
                    return {success: false error: "这份草稿已经保存为日程；请丢弃草稿后创建新的安排"}
                }
                return {success: true item: item idempotent: true}
            }
        }
    }
    if user_schedules.len() >= 128 { return {success: false error: "日程容量已达128条；原日程保留，请先备份并整理日程记录"} }
    let id = "schedule-" + time_now() + "-" + schedule_counter
    while schedule_find(id) != nil { schedule_counter = schedule_counter + 1 id = "schedule-" + time_now() + "-" + schedule_counter }
    let candidate = {schedule_id: id version: 1 title: title.trim() content: content.trim() location: location.trim() start: start end: end timezone: timezone origin_suggestion_id: suggestion_id status: "active" allow_reschedule: allow}
    if intent_id != nil { candidate.origin_intent_id = intent_id }
    let conflicts = schedule_conflicts(candidate, nil)
    if conflicts.len() > 0 { return {success: false error: "Schedule conflict" conflicts: conflicts} }
    schedule_counter = schedule_counter + 1
    user_schedules.push(candidate)
    error = schedule_write()
    if error != "" { user_schedules.remove(user_schedules.len() - 1) return {success: false error: error} }
    {success: true item: candidate}
}
fn schedule_update(id, expected_version, title, start, end, timezone, suggestion_id){
    let current = schedule_find(id)
    let content = ""
    let location = ""
    if current != nil {
        if record_string(current["content"]) { content = current.content }
        if record_string(current["location"]) { location = current.location }
    }
    schedule_update_details(id, expected_version, title, content, location, start, end, timezone, suggestion_id)
}
fn schedule_update_details(id, expected_version, title, content, location, start, end, timezone, suggestion_id){
    let current = schedule_find(id)
    let allow = false
    if current != nil { allow = current["allow_reschedule"] == true }
    schedule_update_options(id, expected_version, title, content, location, start, end, timezone, suggestion_id, allow)
}
fn schedule_update_options(id, expected_version, title, content, location, start, end, timezone, suggestion_id, allow){
    if record_string(title) && record_string(content) && record_string(location) && (title.len() > 200 || content.len() > 2000 || location.len() > 300) { return {success: false error: "标题最多200字，内容最多2000字，地点最多300字"} }
    if !record_string(content) || !record_string(location) { return {success: false error: "Invalid schedule content or location"} }
    if !schedule_interval(start, end) || !record_string(title) || title.trim() == "" { return {success: false error: "Invalid schedule title or interval"} }
    if !record_string(timezone) || timezone.trim() == "" { return {success: false error: "Timezone label required"} }
    let error = schedule_refresh()
    if error != "" { return {success: false error: error} }
    let current = schedule_find(id)
    if current == nil { return {success: false error: "Schedule no longer exists" stale: true} }
    if suggestion_id != nil { if current["last_suggestion_id"] == suggestion_id { return {success: true item: current idempotent: true} } }
    if current.version != expected_version { return {success: false error: "Schedule version changed; review again" stale: true} }
    let old_content = ""
    let old_location = ""
    if record_string(current["content"]) { old_content = current.content }
    if record_string(current["location"]) { old_location = current.location }
    if current.title == title.trim() && current.start == start && current.end == end && current.timezone == timezone && old_content == content.trim() && old_location == location.trim() && (current["allow_reschedule"] == true) == allow {
        return {success: true item: current unchanged: true}
    }
    let candidate = {schedule_id: id version: expected_version + 1 title: title.trim() start: start end: end timezone: timezone last_suggestion_id: suggestion_id}
    let conflicts = schedule_conflicts(candidate, id)
    if conflicts.len() > 0 { return {success: false error: "Schedule conflict" conflicts: conflicts} }
    let previous = user_schedules.to_json()
    if current["time_precision"] == "day" && (current.start != candidate.start || current.end != candidate.end) { current.time_precision = "exact" }
    current.version = candidate.version current.title = candidate.title current.start = candidate.start current.end = candidate.end current.timezone = candidate.timezone
    current.content = content.trim() current.location = location.trim()
    current.allow_reschedule = allow
    current.last_suggestion_id = suggestion_id
    error = schedule_write()
    if error != "" { user_schedules = previous.parse_json() return {success: false error: error} }
    {success: true item: current}
}
fn schedule_apply_action(action, suggestion_id){
    if !record_object(action) { return {success: false error: "No schedule action"} }
    if action.kind == "create" { return schedule_create(action.title, action.start, action.end, action.timezone, suggestion_id) }
    if action.kind == "reschedule" {
        let error = schedule_refresh()
        if error != "" { return {success: false error: error} }
        let item = schedule_find(action.schedule_id)
        if item == nil { return {success: false error: "日程已不存在"} }
        if item["last_suggestion_id"] == suggestion_id { return {success: true item: item idempotent: true} }
        if !schedule_active(item) || item["allow_reschedule"] != true { return {success: false error: "该日程未允许 Agent 改期，或已取消/完成。"} }
        return schedule_update(action.schedule_id, action.schedule_version, action.title, action.start, action.end, action.timezone, suggestion_id)
    }
    {success: false error: "Unsupported schedule action"}
}
// END src/data/storage/schedules.splash

// BEGIN src/data/storage/schedule_time.splash
// Simple wall-clock entry; serialize to offset timestamps at the storage boundary.
// New York uses the US DST rules effective since 2007. Ambiguous/nonexistent
// transition hours are rejected rather than silently choosing an instant.
fn schedule_date_at(seconds){ analysis_epoch_rfc3339(seconds).split("T")[0] }
fn schedule_sunday(year, month, occurrence){
    let first = analysis_four_digits(year) + "-" + analysis_two_digits(month) + "-01"
    let days = schedule_instant(first + "T00:00:00Z") / 86400
    let weekday = (days + 4) % 7
    1 + ((7 - weekday) % 7) + (occurrence - 1) * 7
}
fn schedule_ny_offset(date, hour){
    let parts = date.split("-")
    let year = parts[0].to_f64()
    let month = parts[1].to_f64()
    let day = parts[2].to_f64()
    if year < 2007 { return {valid: false error: "纽约时间目前支持 2007 年及以后的日期。"} }
    let spring = schedule_sunday(year, 3, 2)
    let autumn = schedule_sunday(year, 11, 1)
    if month == 3 && day == spring && hour == 2 { return {valid: false error: "纽约这天切换夏令时，02 时不存在，请选择其他时间。"} }
    if month == 11 && day == autumn && hour == 1 { return {valid: false error: "纽约这天结束夏令时，01 时会出现两次，请选择其他时间以避免歧义。"} }
    let daylight = month > 3 && month < 11
    if month == 3 { daylight = day > spring || (day == spring && hour >= 3) }
    if month == 11 { daylight = day < autumn || (day == autumn && hour < 1) }
    let offset = "-05:00"
    if daylight { offset = "-04:00" }
    {valid: true offset: offset}
}
fn schedule_entry_timestamp(date, hour_text, minute_text, zone){
    if !regex("^[0-9]{4}-[0-9]{2}-[0-9]{2}$").test(date) || schedule_instant(date + "T00:00:00Z") == nil {
        return {valid: false error: "请填写有效日期，例如 2026-10-03。"}
    }
    if !regex("^[0-9]{1,2}$").test(hour_text.trim()) || !regex("^[0-9]{1,2}$").test(minute_text.trim()) {
        return {valid: false error: "时间使用 24 小时制，请分别填写时（0–23）和分（0–59）。"}
    }
    let hour = hour_text.trim().to_f64()
    let minute = minute_text.trim().to_f64()
    if hour > 23 || minute > 59 { return {valid: false error: "时必须为 0–23，分必须为 0–59（24 小时制）。"} }
    let offset = "+08:00"
    if zone == "America/New_York" {
        let resolved = schedule_ny_offset(date, hour)
        if !resolved.valid { return resolved }
        offset = resolved.offset
    } else if zone != "Asia/Shanghai" { return {valid: false error: "请选择北京时间或美国东部时间。"} }
    {valid: true timestamp: date + "T" + analysis_two_digits(hour) + ":" + analysis_two_digits(minute) + ":00" + offset}
}
fn schedule_zone_seconds(seconds, zone){
    if zone != "America/New_York" { return seconds + 8 * 3600 }
    let year = analysis_epoch_rfc3339(seconds).split("T")[0].split("-")[0].to_f64()
    let spring = analysis_four_digits(year) + "-03-" + analysis_two_digits(schedule_sunday(year, 3, 2)) + "T07:00:00Z"
    let autumn = analysis_four_digits(year) + "-11-" + analysis_two_digits(schedule_sunday(year, 11, 1)) + "T06:00:00Z"
    let offset = -5 * 3600
    if seconds >= schedule_instant(spring) && seconds < schedule_instant(autumn) { offset = -4 * 3600 }
    seconds + offset
}
fn schedule_entry_parts(timestamp, zone){
    let value = analysis_epoch_rfc3339(schedule_zone_seconds(schedule_instant(timestamp), zone)).split("T")
    let clock = value[1].split(":")
    {date: value[0] hour: clock[0] minute: clock[1]}
}
fn schedule_zone_label(zone){
    if zone == "America/New_York" { return "美国东部时间（纽约）" }
    if zone == "Asia/Shanghai" { return "北京时间" }
    zone
}
fn schedule_display_time(timestamp, zone){
    if zone != "Asia/Shanghai" && zone != "America/New_York" { return timestamp }
    let value = schedule_entry_parts(timestamp, zone)
    value.date + " " + value.hour + ":" + value.minute
}
// END src/data/storage/schedule_time.splash

// BEGIN src/data/storage/weather.splash
// Persisted city selection. Follows the conventions in records.splash: one
// writer, {schema_version, ...} on disk, a warning string instead of a thrown
// error, and the in-memory value stays usable when the write fails.
//
// Forecasts themselves are cache, not user records: weather_read_cache owns
// those files and a corrupt cache degrades to "not loaded" without touching
// anything the user authored.
let weather_file = {path: "weather_selection_v1.json" writable: true recovered: false}
let weather_warning = ""

fn weather_warn(text){
    if weather_warning != "" {
        weather_warning = weather_warning + "; "
    }
    weather_warning = weather_warning + text
}

fn weather_selection_document_valid(value){
    if !record_object(value) || value["schema_version"] != 1 { return false }
    if !record_array(value["tracked"]) { return false }
    if value["selected_city_id"] != nil {
        if !record_string(value["selected_city_id"]) { return false }
        if value["selected_city_id"] != "" && !record_contains(value["tracked"], value["selected_city_id"]) { return false }
    }
    weather_tracked_valid(value["tracked"])
}

fn weather_selection_read(){
    let exists = false
    try { exists = fs.exists(weather_file["path"]) } {
        weather_file.writable = false
        weather_warn("无法检查城市设置，原文件已保留；本次选择仅在当前会话有效")
        return
    }
    if !exists { return }
    // fs.read and parse_json are isolated in their own try, as in
    // records.splash: a trap inside a larger try body is not dependable.
    let raw = ""
    try { raw = fs.read(weather_file["path"]) } { raw = "" }
    if raw == "" {
        weather_file.writable = false
        weather_warn("城市设置读取失败，原文件已保留；保留当前选择")
        return
    }
    let parsed = nil
    try { parsed = raw.parse_json() } { parsed = nil }
    if parsed == nil {
        weather_warn("城市设置不是有效 JSON，原文件已保留；保留当前选择")
        weather_file.writable = false
        return
    }
    if !weather_selection_document_valid(parsed) {
        weather_file.writable = false
        weather_warn("城市设置格式不受支持，原文件已保留；保留当前选择")
        return
    }
    weather_tracked = []
    for cid in parsed["tracked"] { weather_tracked.push(cid) }
    weather_primary_cid = ""
    if parsed["selected_city_id"] != nil { weather_primary_cid = parsed["selected_city_id"] }
}

fn weather_selection_write(){
    let selected = ""
    let city = weather_primary_city()
    if city != nil { selected = city.cid }
    let document = {schema_version: 1 tracked: weather_tracked selected_city_id: selected}
    if !weather_selection_document_valid(document) {
        weather_warn("城市选择未通过校验，原文件未覆盖")
        return false
    }
    if !weather_file.writable {
        weather_warn("城市设置只读，本次选择仅在当前会话有效")
        return false
    }
    let exists = false
    try { exists = fs.exists(weather_file["path"]) } {
        weather_file.writable = false
        weather_warn("无法检查城市设置，原文件未覆盖")
        return false
    }
    let previous = ""
    if exists {
        try { previous = fs.read(weather_file["path"]) } { previous = "" }
        let parsed = nil
        try { parsed = previous.parse_json() } { parsed = nil }
        if !weather_selection_document_valid(parsed) {
            weather_file.writable = false
            weather_warn("城市设置无法读取或已变为不支持的格式，原文件未覆盖")
            return false
        }
    }
    let saved = false
    try {
        if exists { fs.write(weather_file["path"] + ".backup", previous) }
        fs.write(weather_file["path"], document.to_json())
        weather_warning = ""
        saved = true
    } {
        weather_warn("城市设置保存失败，本次选择仅在当前会话有效")
    }
    saved
}

fn weather_load(){
    weather_file.writable = true
    weather_file.recovered = false
    weather_warning = ""
    weather_initialize()
    weather_selection_read()
    for city in weather_cities { weather_read_cache(city) }
    weather_fetch_cities(weather_tracked, weather_generation)
}
// END src/data/storage/weather.splash

// BEGIN src/data/storage/topics.splash
// User records and decisions are one transactional document; disposable runs
// live separately. The pinned host has no rename: retain a validated backup.
let topic_records = {schema_version: 2 revision: 0 topics: [] draft: nil decisions: []}
let tracking_cache = {schema_version: 1 revision: 0 runs: []}
let topic_file = {path: "topics_v2.json" writable: true recovered: false revision: 0}
let tracking_cache_file = {path: "tracking_results_v1.json" writable: true recovered: false revision: 0}
let topic_warning = ""
let tracking_storage_write = |path, text| fs.write(path, text)
fn topic_document_valid(value){
    if !topic_document_header_valid(value) { return false }
    let ids = {}
    for item in value["topics"] { if !topic_valid(item) || ids[item.topic_id] == true { return false } ids[item.topic_id] = true }
    if topic_visible_count(value.topics) > tracking_config.max_topics { return false }
    for item in value["decisions"] { if !topic_decision_valid(item) { return false } }
    true
}
fn topic_document_header_valid(value){
    if !record_object(value) || value["schema_version"] != 2 || !record_number(value["revision"]) { return false }
    if !record_array(value["topics"]) || value.topics.len() > tracking_config.max_topic_records || !topic_draft_valid(value["draft"]) { return false }
    record_array(value["decisions"]) && value.decisions.len() <= tracking_config.max_decisions
}
fn topic_decision_valid(item){
    if !record_object(item) { return false }
    if item["kind"] == "insight" {
        return record_contains(["topic" "schedule"], item["target_type"]) && tracking_text(item["target_id"], 200) && record_number(item["target_version"]) && tracking_text(item["issue_key"], 120) && record_contains(["watch" "handled" "dismissed"], item["state"]) && record_number(item["decided_at"]) && tracking_strings(item["evidence_facts"], 8, 16000)
    }
    if !tracking_text(item["reminder_id"], 400) || !tracking_text(item["goal_key"], 120) || !tracking_text(item["schedule_id"], 200) { return false }
    if item["state"] != "dismissed" && item["state"] != "followed" { return false }
    if !record_number(item["schedule_version"]) || !record_number(item["decided_at"]) || !record_array(item["evidence"]) { return false }
    if item.evidence.len() == 0 || item.evidence.len() > tracking_config.max_candidates { return false }
    for evidence in item.evidence {
        if !record_object(evidence) || !tracking_text(evidence["news_id"], 4000) || !tracking_text(evidence["key"], 16000) { return false }
    }
    true
}
fn tracking_cache_valid(value){
    if !tracking_cache_header_valid(value) { return false }
    for run in value.runs { if !tracking_cache_run_valid(run) { return false } }
    true
}
fn tracking_cache_header_valid(value){
    record_object(value) && value["schema_version"] == 1 && record_number(value["revision"]) && record_array(value["runs"]) && value.runs.len() <= tracking_config.max_runs
}
fn tracking_cache_run_valid(run){
    if !record_object(run) || !record_string(run["task_id"]) || !record_number(run["checked_at"]) || !record_string(run["input_key"]) || !record_object(run["snapshot"]) { return false }
    tracking_validate(run["result"], run["snapshot"]).valid
}
fn tracking_store_read(file, valid){
    file.writable = true file.recovered = false
    let value = nil let exists = false
    try { exists = fs.exists(file.path) if exists { value = fs.read(file.path).parse_json() } }
    { file.writable = false topic_warning = topic_warning + file.path + "：读取失败；" }
    if valid(value) { file.revision = value.revision return value }
    if exists { file.writable = false topic_warning = topic_warning + file.path + "：坏文件或未知版本已保留；" }
    let backup = nil
    try { if fs.exists(file.path + ".backup") { backup = fs.read(file.path + ".backup").parse_json() } }
    { topic_warning = topic_warning + file.path + "：备份读取失败；" }
    if valid(backup) { file.recovered = true file.revision = backup.revision topic_warning = topic_warning + "已从备份恢复，继续写入备份；" return backup }
    file.revision = 0
    nil
}
fn topics_load(){
    topic_warning = ""
    topic_records = {schema_version: 2 revision: 0 topics: [] draft: nil decisions: []}
    tracking_cache = {schema_version: 1 revision: 0 runs: []}
    let document = tracking_store_read(topic_file, topic_document_valid)
    if document != nil { topic_records = document }
    let cache = tracking_store_read(tracking_cache_file, tracking_cache_valid)
    if cache != nil { tracking_cache = cache }
    // v1 rules/bookmarks/schedules/suggestions retain their existing readers;
    // no destructive migration, and legacy rules also participate in recall.
}
fn tracking_store_write(file, value, valid){
    if !valid(value) { return "记录未通过校验，未保存" }
    if !file.writable && !file.recovered { return "原文件已保留，存储只读；请恢复有效备份后重开" }
    let path = file.path
    if file.recovered { path = path + ".backup" }
    let error = ""
    try {
        if fs.exists(path) {
            let previous = fs.read(path).parse_json()
            if !valid(previous) { error = "磁盘记录已损坏，原文件已保留" file.writable = false file.recovered = false }
            else if previous.revision != file.revision { error = "磁盘记录版本已变化，请重开后再保存" }
            else if !file.recovered { tracking_storage_write(path + ".backup", previous.to_json()) }
        } else if file.revision != 0 { error = "磁盘记录已移除，请重开后恢复" }
        if error == "" {
            tracking_storage_write(path, value.to_json())
            let stored = fs.read(path).parse_json()
            if !valid(stored) || stored.to_json() != value.to_json() { error = "写入核验失败，已有备份可恢复" }
        }
    } { error = "本地写入失败，未保存；已有记录和备份保留，可重试" }
    if error == "" { file.revision = value.revision }
    error
}
fn topics_commit(next){
    next.revision = topic_records.revision + 1
    let error = tracking_store_write(topic_file, next, topic_document_valid)
    if error == "" { topic_records = next }
    error
}
fn topic_find(id){ for item in topic_records.topics { if item.topic_id == id { return item } } nil }
fn topic_visible_count(topics){
    let count = 0
    for item in topics { if item.status != "cancelled" { count = count + 1 } }
    count
}
fn topic_new_draft(id){
    let draft = {draft_id: "draft-" + time_now() version: 1 target_topic_id: nil target_version: nil
        original_input: "" supplement: "" understanding: nil understanding_edit: nil state: "editing" question: "" origin_reminder_id: nil
        intent_kind: "news" schedule_understanding: nil schedule_timezone: "America/New_York"}
    let topic = topic_find(id)
    if topic != nil {
        draft.target_topic_id = topic.topic_id draft.target_version = topic.version
        draft.original_input = topic.original_input draft.supplement = topic.supplement
        draft.understanding = topic.to_json().parse_json()
        if topic["intent_kind"] == "goal" { draft.intent_kind = "goal" }
    }
    draft
}
fn topic_save_draft(draft){
    let next = topic_records.to_json().parse_json() next.draft = draft.to_json().parse_json()
    topics_commit(next)
}
fn topic_set_status(id, version, status){
    let current = topic_find(id)
    if current == nil { return "关注已不存在" }
    if current.version != version { return "关注版本已变化，请重新查看" }
    let next = topic_records.to_json().parse_json()
    for item in next.topics { if item.topic_id == id { item.status = status item.version = item.version + 1 item.updated_at = time_now() } }
    topics_commit(next)
}
fn topic_confirm(draft){
    if draft["understanding_edit"] != nil { return "请先应用修改，再确认保存" }
    if draft.state != "ready" || !topic_understanding_valid(draft.understanding) { return "请先取得待确认的理解结果" }
    let current = topic_find(draft.target_topic_id)
    if draft.target_topic_id != nil {
        if current == nil { return "原关注已不存在，请重新打开" }
        if current.status == "cancelled" { return "原关注已取消，请将输入作为新关注保存" }
        if current.version != draft.target_version { return "原关注版本已变化，请重新打开修改" }
    } else {
        if topic_visible_count(topic_records.topics) >= tracking_config.max_topics { return "已达到20个专题上限，原关注保留" }
        if topic_records.topics.len() >= tracking_config.max_topic_records { return "本地关注记录已达上限，原记录保留" }
    }
    let next = topic_records.to_json().parse_json()
    let topic = draft.understanding.to_json().parse_json()
    topic.topic_id = "topic-" + draft.draft_id topic.version = 1
    topic.original_input = draft.original_input topic.supplement = draft.supplement
    topic.created_at = time_now() topic.updated_at = time_now() topic.status = "active"
    topic.intent_kind = "news"
    if draft["intent_kind"] == "goal" { topic.intent_kind = "goal" }
    // Editing a starter makes this the user's own confirmed tracking intent.
    topic.demo_preset = false
    if current != nil { topic.topic_id = current.topic_id topic.version = current.version + 1 topic.created_at = current.created_at }
    next.topics.retain(|item| item.topic_id != topic.topic_id) next.topics.push(topic) next.draft = nil
    if draft.origin_reminder_id != nil {
        let reminder = tracking_find_reminder(draft.origin_reminder_id)
        if reminder == nil { return "提醒已过期，请重新查看依据" }
        let error = tracking_check_reminder(reminder)
        if error != "" { return error }
        if next.decisions.len() >= tracking_config.max_decisions { return "决定记录已达上限，未保存" }
        next.decisions.push(tracking_decision(reminder, "followed"))
    }
    topics_commit(next)
}
// END src/data/storage/topics.splash

// BEGIN src/data/storage/topics_restore.splash
// Startup restores the same documents and contracts as topics_load, but each
// topic, decision and historical run gets its own native callback budget.
fn topics_load_async(complete){
    topic_warning = ""
    topic_records = {schema_version: 2 revision: 0 topics: [] draft: nil decisions: []}
    tracking_cache = {schema_version: 1 revision: 0 runs: []}
    topics_restore_read(topic_file, "topics", |document| {
        if document != nil { topic_records = document }
        topics_restore_read(tracking_cache_file, "runs", |cache| {
            if cache != nil { tracking_cache = cache }
            start_timeout(0.01, complete)
        })
    })
}
fn topics_restore_read(file, kind, complete){
    file.writable = true file.recovered = false file.revision = 0
    let work = {file: file kind: kind complete: complete phase: "read" backup: false exists: false
        text: nil value: nil index: 0 ids: {} done: false timer: nil}
    work.timer = start_timeout(tracking_config.publication_timeout_seconds, || {
        if work.done { return }
        work.file.writable = false work.file.recovered = false
        topic_warning = topic_warning + work.file.path + "：恢复超时（" + work.phase + "），原文件保留且只读；"
        topics_restore_finish(work, nil)
    })
    start_timeout(0.01, || topics_restore_step(work))
}
fn topics_restore_finish(work, value){
    if work.done { return }
    work.done = true
    if work.timer != nil { stop_timer(work.timer) work.timer = nil }
    let complete = work.complete
    work.value = nil work.text = nil work.ids = nil work.complete = nil
    start_timeout(0.01, || complete(value))
}
fn topics_restore_reject(work, reason){
    if work.backup {
        if work.exists { topic_warning = topic_warning + work.file.path + "：备份" + reason + "；" }
        topics_restore_finish(work, nil)
        return
    }
    if work.exists {
        work.file.writable = false
        topic_warning = topic_warning + work.file.path + "：" + reason + "，原文件保留；"
    }
    work.backup = true work.exists = false work.text = nil work.value = nil
    work.ids = {} work.index = 0 work.phase = "read"
}
fn topics_restore_step(work){
    if work.done { return }
    // Prequeue before native work: a budget interruption cannot strand boot.
    // Retry the uncommitted step; the deadline ends permanently expensive work.
    start_timeout(0.01, || topics_restore_step(work))
    mod.gc.run()
    let failure = ""
    try {
        if work.phase == "read" {
            let path = work.file.path if work.backup { path = path + ".backup" }
            work.exists = fs.exists(path)
            if work.exists { work.text = fs.read(path) work.phase = "parse" }
            else { topics_restore_reject(work, "未找到记录") return }
        } else if work.phase == "parse" {
            work.value = work.text.parse_json()
            work.text = nil work.phase = "header"
        } else if work.phase == "header" {
            let valid = false
            if work.kind == "topics" { valid = topic_document_header_valid(work.value) }
            else { valid = tracking_cache_header_valid(work.value) }
            if !valid { failure = "格式无效或未知版本" }
            else { work.phase = work.kind work.index = 0 }
        } else if work.phase == "topics" {
            if work.index < work.value.topics.len() {
                let item = work.value.topics[work.index]
                let seen = work.ids[item["topic_id"]]
                if !topic_valid(item) || (seen != nil && seen != work.index) { failure = "关注条目无效或重复" }
                else {
                    // Repeating an interrupted commit recognizes its own index.
                    work.ids[item.topic_id] = work.index work.index = work.index + 1
                }
            } else if topic_visible_count(work.value.topics) > tracking_config.max_topics { failure = "有效关注超过上限" }
            else { work.phase = "decisions" work.index = 0 }
        } else if work.phase == "decisions" {
            if work.index < work.value.decisions.len() {
                if !topic_decision_valid(work.value.decisions[work.index]) { failure = "决定记录无效" }
                else { work.index = work.index + 1 }
            } else { work.phase = "accept" }
        } else if work.phase == "runs" {
            if work.index < work.value.runs.len() {
                if !tracking_cache_run_valid(work.value.runs[work.index]) { failure = "分析历史未通过证据校验" }
                else { work.index = work.index + 1 }
            } else { work.phase = "accept" }
        } else if work.phase == "accept" {
            work.file.revision = work.value.revision
            work.file.recovered = work.backup
            if work.backup { topic_warning = topic_warning + work.file.path + "：已从备份恢复，继续写入备份；" }
            topics_restore_finish(work, work.value)
            return
        }
    } { work.file.writable = false failure = "读取或校验失败" }
    if failure != "" { topics_restore_reject(work, failure) }
}
// END src/data/storage/topics_restore.splash

// BEGIN src/data/storage/tracking_save.splash
// The cache can hold twelve full runs. Validate one run per callback; keep
// backup, write and readback in separate budget slices. No host rename exists.
fn tracking_cache_save(value, current, complete){
    let path = tracking_cache_file.path
    if tracking_cache_file.recovered { path = path + ".backup" }
    let work = {value: value current: current complete: complete file: tracking_cache_file path: path
        revision: tracking_cache_file.revision phase: "value" index: 0 done: false timer: nil
        text: nil previous: nil previous_text: nil}
    work.timer = start_timeout(tracking_config.publication_timeout_seconds, || {
        tracking_cache_save_finish(work, "本地保存超时（" + work.phase + "）；结果保留，可重试")
    })
    start_timeout(0.01, || tracking_cache_save_step(work))
    work
}
fn tracking_cache_save_finish(work, error){
    if work.done { return }
    work.done = true
    if work.timer != nil { stop_timer(work.timer) work.timer = nil }
    let complete = work.complete
    // Cancelled/queued native timers may still retain the small work object.
    // They must not retain three full parsed copies of twelve historical runs.
    work.value = nil work.previous = nil work.text = nil work.previous_text = nil
    work.current = nil work.complete = nil
    start_timeout(0.01, || complete(error))
}
fn tracking_cache_save_step(work){
    if work.done { return }
    // Queue continuation before native work. A budget bail repeats this
    // phase, including an idempotent write of the exact same serialized bytes.
    start_timeout(0.01, || tracking_cache_save_step(work))
    mod.gc.run()
    if !work.current() { tracking_cache_save_finish(work, "结果已过期或保存已停止，未继续写入") return }
    let error = ""
    try {
        if work.phase == "value" {
            if !tracking_cache_header_valid(work.value) { error = "记录未通过校验，未保存" }
            else if !work.file.writable && !work.file.recovered { error = "原文件已保留，存储只读；请恢复有效备份后重开" }
            else if work.index < work.value.runs.len() {
                if !tracking_cache_run_valid(work.value.runs[work.index]) { error = "记录未通过校验，未保存" }
                else { work.index = work.index + 1 }
            } else { work.phase = "serialize" }
        } else if work.phase == "serialize" {
            work.text = work.value.to_json() work.phase = "read"
        } else if work.phase == "read" {
            if fs.exists(work.path) {
                work.previous_text = fs.read(work.path)
                if work.previous_text == work.text {
                    // The candidate was validated before serialization. Exact
                    // readback bytes prove an earlier write of that same value.
                    work.file.revision = work.value.revision
                    tracking_cache_save_finish(work, "") return
                }
                if !regex("^\\s*\\{").test(work.previous_text) {
                    work.file.writable = false work.file.recovered = false
                    tracking_cache_save_finish(work, "磁盘记录已损坏，原文件已保留") return
                }
                work.previous = work.previous_text.parse_json()
                if !tracking_cache_header_valid(work.previous) {
                    work.file.writable = false work.file.recovered = false error = "磁盘记录已损坏，原文件已保留"
                } else if work.previous.revision != work.revision { error = "磁盘记录版本已变化，请重开后再保存" }
                else { work.index = 0 work.phase = "previous" }
            } else if work.revision != 0 { error = "磁盘记录已移除，请重开后恢复" }
            else { work.phase = "write" }
        } else if work.phase == "previous" {
            if work.index < work.previous.runs.len() {
                if !tracking_cache_run_valid(work.previous.runs[work.index]) {
                    work.file.writable = false work.file.recovered = false error = "磁盘记录已损坏，原文件已保留"
                } else { work.index = work.index + 1 }
            } else { work.phase = "backup" }
        } else if work.phase == "backup" {
            if !work.file.recovered { tracking_storage_write(work.path + ".backup", work.previous_text) }
            work.previous = nil
            work.phase = "write"
        } else if work.phase == "write" {
            // Recheck disk immediately before writing: an external revision
            // change between validation and backup must not be overwritten.
            let exists = fs.exists(work.path)
            let disk = nil if exists { disk = fs.read(work.path) }
            if disk == work.text { work.phase = "readback" }
            else if (work.previous_text != nil && disk != work.previous_text) || (work.previous_text == nil && exists) {
                error = "磁盘记录版本已变化，请重开后再保存"
            } else {
                tracking_storage_write(work.path, work.text) work.phase = "readback"
            }
        } else if work.phase == "readback" {
            work.previous = nil work.previous_text = nil
            let text = fs.read(work.path)
            if text != work.text { error = "写入核验失败，已有备份可恢复" }
            else {
                // Compare against the serialization of the already validated
                // candidate, avoiding a third full parsed copy on a 32MiB VM.
                work.file.revision = work.value.revision
                tracking_cache_save_finish(work, "") return
            }
        }
    } { error = "本地写入失败，结果保留，可重试；已有记录和备份保留" }
    if error != "" { tracking_cache_save_finish(work, error) }
}
// END src/data/storage/tracking_save.splash

// BEGIN src/data/storage/agent_metrics.splash
// Diagnostic owner: bounded metadata only, no input, prompt, bodies or secrets.
let agent_metrics = {schema_version: 1 revision: 0 samples: []}
let agent_launch_id = "launch-" + time_now()
let agent_launch_calls = {}
let agent_metrics_origin = "live_host"
let agent_metrics_flush_timer = nil
fn agent_metrics_load(){
    if !fs.exists("agent_metrics_v1.json") { return }
    try {
        let value = fs.read("agent_metrics_v1.json").parse_json()
        if record_object(value) && value["schema_version"] == 1 && record_array(value["samples"]) && value.samples.len() <= 120 && record_number(value["revision"]) { agent_metrics = value }
        else { agent_last_error = "诊断记录不可读，业务记录保留" }
    } { agent_last_error = "诊断记录读取失败，业务记录保留" }
}
fn agent_metrics_record(sample){
    agent_metrics.samples.push(sample)
    while agent_metrics.samples.len() > 120 { agent_metrics.samples.remove(0) }
    agent_metrics.revision = agent_metrics.revision + 1
    if agent_metrics_flush_timer == nil {
        agent_metrics_flush_timer = start_timeout(0.01, || {
            agent_metrics_flush_timer = nil
            try { fs.write("agent_metrics_v1.json", agent_metrics.to_json()) }
            { agent_last_error = "诊断耗时记录写入失败；业务记录不受影响" }
        })
    }
}
// END src/data/storage/agent_metrics.splash

// BEGIN src/data/storage/agent_preferences.splash
// orb_x/orb_y remain required only so existing schema 1 files stay readable
// after the floating entry was replaced by the fixed center navigation button.
let agent_preferences = {schema_version: 1 revision: 0 paused: false important_only: false interval_seconds: 900 orb_x: 1.0 orb_y: 0.86}
let agent_preferences_file = {path: "agent_preferences_v1.json" revision: 0 writable: true recovered: false}
fn agent_preferences_valid(v){
    if !record_object(v) || v["schema_version"] != 1 || !record_number(v["revision"]) { return false }
    if (v["paused"] != true && v["paused"] != false) || (v["important_only"] != true && v["important_only"] != false) || !record_contains([300 900 3600], v["interval_seconds"]) { return false }
    record_number(v["orb_x"]) && record_number(v["orb_y"]) && v.orb_x >= 0 && v.orb_x <= 1 && v.orb_y >= 0 && v.orb_y <= 1
}
fn agent_preferences_load(){
    if !fs.exists(agent_preferences_file.path) { return }
    try {
        let value = fs.read(agent_preferences_file.path).parse_json()
        if agent_preferences_valid(value) { agent_preferences = value agent_preferences_file.revision = value.revision }
        else { agent_preferences_file.writable = false notice("检查偏好损坏，原文件保留") }
    } { agent_preferences_file.writable = false notice("检查偏好读取失败，原文件保留") }
}
fn agent_preferences_commit(next){
    next.revision = agent_preferences.revision + 1
    let error = tracking_store_write(agent_preferences_file, next, agent_preferences_valid)
    if error == "" { agent_preferences = next }
    error
}
// END src/data/storage/agent_preferences.splash

// BEGIN src/data/storage/schedule_actions.splash
// Write-ahead action journal: a failed final audit can be reconciled by its ID.
let schedule_actions = {schema_version: 1 revision: 0 items: []}
let schedule_actions_file = {path: "schedule_actions_v1.json" revision: 0 writable: true recovered: false}
fn schedule_actions_valid(v){
    if !record_object(v) || v["schema_version"] != 1 || !record_number(v["revision"]) || !record_array(v["items"]) || v.items.len() > 32 { return false }
    let ids = []
    for a in v.items {
        if !record_object(a) || !tracking_text(a["action_id"], 300) || record_contains(ids, a.action_id) { return false } ids.push(a.action_id)
        if !record_contains(["prepared" "applied" "undone"], a["state"]) || !schedule_valid(a["original"]) || !schedule_interval(a["start"], a["end"]) || !record_number(a["created_at"]) { return false }
    }
    true
}
fn schedule_actions_load(){
    if !fs.exists(schedule_actions_file.path) { return }
    try {
        let v = fs.read(schedule_actions_file.path).parse_json()
        if schedule_actions_valid(v) { schedule_actions = v schedule_actions_file.revision = v.revision }
        else { schedule_actions_file.writable = false notice("改期历史损坏，原文件保留") }
    } { schedule_actions_file.writable = false notice("改期历史读取失败，原文件保留") }
}
fn schedule_actions_commit(next){
    next.revision = schedule_actions.revision + 1
    let error = tracking_store_write(schedule_actions_file, next, schedule_actions_valid)
    if error == "" { schedule_actions = next } error
}
fn schedule_action_find(id){ for a in schedule_actions.items { if a.action_id == id { return a } } nil }
fn schedule_action_apply(id){
    let a = schedule_action_find(id)
    if a == nil { return "没有已预览的提案" }
    if a.state == "applied" || a.state == "undone" { return "" }
    let original = a.original
    let error = schedule_refresh() if error != "" { return error }
    let current = schedule_find(original.schedule_id)
    if current == nil || !schedule_active(current) { return "日程已取消或不存在" }
    if current["last_suggestion_id"] != id {
        if current.version != original.version || current.to_json() != original.to_json() { return "日程已变化，请重新检查与预览" }
        let reply = schedule_update_options(original.schedule_id, original.version, original.title, original.content, original.location, a.start, a.end, original.timezone, id, original["allow_reschedule"] == true)
        if !reply.success { return reply.error }
    } else if current.version != original.version + 1 || current.start != a.start || current.end != a.end { return "改期记录与当前版本不符" }
    let next = schedule_actions.to_json().parse_json()
    let changed = tracking_find(next.items, "action_id", id)
    changed.state = "applied" changed.applied_version = schedule_find(original.schedule_id).version changed.applied_at = time_now()
    error = schedule_actions_commit(next)
    if error != "" { return "日程已改期，历史待保存；重试同一提案可恢复：" + error }
    ""
}
fn schedule_action_undo(id){
    let a = schedule_action_find(id) if a == nil { return "改期记录不存在" }
    if a.state == "undone" { return "" }
    if a.state != "applied" { return "请先恢复改期记录" }
    let error = schedule_refresh() if error != "" { return error }
    let current = schedule_find(a.original.schedule_id)
    if current == nil || !schedule_active(current) { return "日程已不存在或已结束，未撤回" }
    let undo_id = "undo:" + id
    if current["last_suggestion_id"] != undo_id {
        if current.version != a.applied_version || current["last_suggestion_id"] != id { return "改期后日程又被编辑，不能覆盖新版本" }
        let o = a.original
        let reply = schedule_update_options(o.schedule_id, a.applied_version, o.title, o.content, o.location, o.start, o.end, o.timezone, undo_id, o["allow_reschedule"] == true)
        if !reply.success { return reply.error }
    } else if current.version != a.applied_version + 1 { return "撤回后日程又被编辑" }
    let next = schedule_actions.to_json().parse_json()
    let changed = tracking_find(next.items, "action_id", id) changed.state = "undone" changed.undone_at = time_now()
    schedule_actions_commit(next)
}
// END src/data/storage/schedule_actions.splash

// BEGIN src/data/storage/check_states.splash
let check_states = {schema_version: 1 revision: 0 items: []}
let check_states_file = {path: "target_checks_v1.json" revision: 0 writable: true recovered: false}
let check_states_flush_timer = nil
fn check_states_valid(v){
    if !record_object(v) || v["schema_version"] != 1 || !record_number(v["revision"]) || !record_array(v["items"]) || v.items.len() > 28 { return false }
    for item in v.items {
        if !record_contains(["topic" "schedule"], item["target_type"]) || !record_string(item["target_id"]) || !record_number(item["target_version"]) || !record_number(item["watermark"]) || !record_number(item["attempt_at"]) || !record_string(item["status"]) || !record_string(item["category"]) { return false }
        if item["reason"] != nil && !tracking_text(item.reason, 600) { return false }
    }
    true
}
fn check_states_load(){
    if !fs.exists(check_states_file.path) { return }
    try {
        let v = fs.read(check_states_file.path).parse_json()
        if check_states_valid(v) { check_states = v check_states_file.revision = v.revision }
        else { check_states_file.writable = false notice("检查水位文件损坏，原文件保留") }
    } { check_states_file.writable = false notice("检查水位读取失败，原文件保留") }
}
fn check_state_find(kind, id, version){ for item in check_states.items { if item.target_type == kind && item.target_id == id && item.target_version == version { return item } } nil }
fn check_states_record(targets, status, category, checked){
    check_states_record_reason(targets, status, category, checked, "")
}
fn check_states_record_reason(targets, status, category, checked, reason){
    let next = check_states.to_json().parse_json()
    for target in insight_targets(targets) {
        let old = check_state_find(target.target_type, target.target_id, target.target_version)
        let watermark = 0 if old != nil { watermark = old.watermark }
        if checked { watermark = time_now() }
        next.items.retain(|v| v.target_type != target.target_type || v.target_id != target.target_id)
        next.items.push({target_type: target.target_type target_id: target.target_id target_version: target.target_version
            watermark: watermark attempt_at: time_now() status: status category: category reason: if status == "failed" {bm25_prefix(reason, 600)} else {""}})
    }
    while next.items.len() > 28 { next.items.remove(0) }
    next.revision = check_states.revision + 1
    check_states = next
    if check_states_flush_timer == nil {
        check_states_flush_timer = start_timeout(0.01, || {
            check_states_flush_timer = nil
            let error = tracking_store_write(check_states_file, check_states, check_states_valid)
            if error != "" { notice("检查状态未保存：" + error) }
        })
    }
}
// END src/data/storage/check_states.splash

// BEGIN src/data/retrieval/categories.splash
// Reading facets are separate from persisted Agent/interest category IDs.
// Title/summary signals may overlap; source defaults only fill an empty result.
let news_browse_rules = [
    {topic: "browse_tech" label: "AI" name: "AI 进展" pattern: "人工智能|大模型|机器学习|深度学习|生成式|智能体|具身智能|(^|[^A-Za-z0-9_])(AI|LLM|GPT|ChatGPT|Claude|Gemini|DeepSeek|Copilot|agentic|artificial intelligence|machine learning)([^A-Za-z0-9_]|$)"}
    {topic: "browse_tech" label: "数码" name: "数码产品" pattern: "手机|电脑|笔记本|平板|显卡|处理器|芯片|主板|存储|硬盘|耳机|相机|游戏|主机|评测|显示器|(^|[^A-Za-z0-9_])(iPhone|iPad|MacBook|Android|GPU|CPU|RTX|Xbox|PlayStation|smartphone|laptop|gaming|hardware)([^A-Za-z0-9_]|$)"}
    {topic: "browse_tech" label: "效率" name: "工具与效率" pattern: "工作流|效率|办公|笔记工具|笔记应用|笔记软件|笔记管理|笔记整理|笔记同步|知识管理|浏览器|开源|开发者|编程|代码|软件|应用|文档|自动化|(^|[^A-Za-z0-9_])(app|apps|software|workflow|productivity|browser|coding|developer|open source)([^A-Za-z0-9_]|$)"}
    {topic: "browse_tech" label: "科学" name: "科学探索" pattern: "研究|科学|科研|实验|科学发现|航天|太空|宇宙|卫星|月球|火星|量子|物理|生物|(^|[^A-Za-z0-9_])(research|scientist|science|study|discovery|space|NASA|moon|Mars|quantum|biology)([^A-Za-z0-9_]|$)"}
    {topic: "browse_industry" label: "产业" name: "产业与商业" pattern: "融资|财报|营收|上市公司|并购|收购|市场|销量|供应链|产业|商业|企业|创业|投资|政策|监管|(^|[^A-Za-z0-9_])(IPO|funding|revenue|earnings|acquisition|startup|business|market|regulation)([^A-Za-z0-9_]|$)"}
    {topic: "browse_life" label: "生活" name: "生活与环境" pattern: "隐私|订阅|权益|健康|环境|气候|天气|生态|污染|能源|出行|旅行|交通|铁路|航班|生活|家庭|消费|(^|[^A-Za-z0-9_])(privacy|subscription|health|environment|climate|weather|hurricane|wildlife|pollution|energy|travel|transport|home|consumer)([^A-Za-z0-9_]|$)"}]
let news_browse_categories = [{id: "all" label: "全部"}
    {id: "browse_tech" label: "科技"}
    {id: "browse_industry" label: "商业"}
    {id: "browse_life" label: "生活"}]
let news_browse_cache = {}
let news_browse_cache_size = 0
fn news_browse_category(id){
    for item in news_browse_categories { if item.id == id { return item } }
    nil
}
fn news_browse_topics(row){
    let key = row.title + "\n" + row.summary + "\n" + row.source_id + "\n" + row.category
    let saved = news_browse_cache[row.news_id]
    if saved != nil && saved.key == key { return saved.topics }
    let topics = []
    let text = row.title + "\n" + row.summary
    for item in news_browse_rules {
        if !record_contains(topics, item.topic) && regex(item.pattern, "i").test(text) { topics.push(item.topic) }
    }
    if topics.len() == 0 {
        let fallback = "browse_industry"
        if record_contains(["ithome" "expreview" "ifanr" "verge"], row.source_id) { fallback = "browse_tech" }
        else if record_contains(["sspai" "hn" "ars"], row.source_id) { fallback = "browse_tech" }
        else if record_contains(["mit" "nasa" "solidot"], row.source_id) { fallback = "browse_tech" }
        else if row.source_id == "popsci" || row.category == "travel" || row.category == "world" { fallback = "browse_life" }
        else if row.category == "ai" { fallback = "browse_tech" }
        else if row.category == "tech" { fallback = "browse_tech" }
        topics.push(fallback)
    }
    // Bound derived state without changing articles, bookmarks or user rules.
    if news_browse_cache_size >= news_config.browse_cache_entries { news_browse_cache = {} news_browse_cache_size = 0 }
    if news_browse_cache[row.news_id] == nil { news_browse_cache_size = news_browse_cache_size + 1 }
    news_browse_cache[row.news_id] = {key: key topics: topics}
    topics
}
fn news_browse_matches(row, id){
    if id == "all" { return true }
    if news_browse_category(id) != nil { return record_contains(news_browse_topics(row), id) }
    // Older callers and saved interest rules keep their original semantics.
    row.category == id
}
fn news_browse_label(row){
    let topics = news_browse_topics(row)
    let label = ""
    for i id in topics {
        if i >= 2 { break }
        if label != "" { label = label + " · " }
        label = label + news_browse_category(id).label
    }
    label
}
fn news_browse_prepare(rows, current, complete){
    // Reserve a full pass so eviction cannot force synchronous reclassification
    // while filtering up to 500 saved articles.
    if news_browse_cache_size + rows.len() > news_config.browse_cache_entries { news_browse_cache = {} news_browse_cache_size = 0 }
    let work = {rows: rows index: 0 current: current complete: complete}
    start_timeout(0.01, || news_browse_prepare_step(work))
}
fn news_browse_prepare_step(work){
    if !work.current() { work.complete() return }
    let count = 0 let started = time_now()
    while work.index < work.rows.len() && count < news_config.browse_batch_items && time_now() - started < news_config.work_slice_seconds {
        news_browse_topics(work.rows[work.index])
        work.index = work.index + 1 count = count + 1
    }
    if work.index < work.rows.len() { start_timeout(0.01, || news_browse_prepare_step(work)) }
    else { start_timeout(0.01, || work.complete()) }
}
// END src/data/retrieval/categories.splash

// BEGIN src/data/retrieval/interests.splash
// Lexical matching only. These reasons describe user rules, never Agent judgment.
let interest_keyword_matchers = {}
fn interest_reset_matchers(){ interest_keyword_matchers = {} }
fn literal_pattern(text){
    let out = text
    for c in ["\\" "." "*" "+" "?" "(" ")" "[" "]" "{" "}" "|" "^" "$"] { out = out.replace(c, "\\" + c) }
    out
}
fn interest_ascii_word_char(cp){ (cp >= 65 && cp <= 90) || (cp >= 97 && cp <= 122) || (cp >= 48 && cp <= 57) || cp == 95 }
fn interest_keyword_pattern(text){
    let pattern = literal_pattern(text)
    let chars = text.to_chars()
    if chars.len() == 0 { return pattern }
    // ASCII word boundaries keep AI out of Daily/AirPods while permitting
    // Chinese text such as AI助手; Unicode \b would reject that adjacency.
    if interest_ascii_word_char(chars[0]) { pattern = "(^|[^A-Za-z0-9_])" + pattern }
    if interest_ascii_word_char(chars[chars.len() - 1]) { pattern = pattern + "([^A-Za-z0-9_]|$)" }
    pattern
}
fn category_label(id){
    if id == "tech" { return "科技" }
    if id == "ai" { return "AI 与研究" }
    if id == "world" { return "国际" }
    if id == "finance" { return "财经" }
    if id == "china" { return "中文资讯" }
    "其他"
}
fn interest_matches(row, interests){
    let out = []
    for item in interests {
        if !item.enabled { continue }
        if item.kind == "source" && item.value == row.source { out.push("关注来源：" + item.value) }
        if item.kind == "category" && item.value == row.category { out.push("关注主题：" + category_label(item.value)) }
        if item.kind == "keyword" {
            let cached = interest_keyword_matchers[item.interest_id]
            let matcher = nil
            if cached != nil && cached.value == item.value { matcher = cached.matcher }
            else {
                matcher = regex(interest_keyword_pattern(item.value), "i")
                interest_keyword_matchers[item.interest_id] = {value: item.value matcher: matcher}
            }
            if matcher.test(row.title) || matcher.test(row.summary) { out.push("匹配关键词：" + item.value) }
        }
    }
    out
}
fn news_filter(rows, interests, category, followed_only, query){
    let out = []
    let matcher = regex(literal_pattern(query), "i")
    for row in rows {
        if !news_browse_matches(row, category) { continue }
        if followed_only && interest_matches(row, interests).len() == 0 { continue }
        if query != "" && !matcher.test(row.title) && !matcher.test(row.summary) && !matcher.test(row.source) { continue }
        out.push(row)
    }
    out
}
// END src/data/retrieval/interests.splash

// BEGIN src/data/retrieval/tracking.splash
// Lexical recall, not semantic indexing. Stable feed order, unique article IDs.
fn topic_rule_matches(row, topic){
    if topic.status != "active" || !topic_is_user_record(topic) { return [] }
    let rules = []
    for i rule in topic.recall_rules { rules.push({interest_id: topic.topic_id + ":" + i kind: rule.kind value: rule.value enabled: true}) }
    interest_matches(row, rules)
}
fn tracking_rule_hint(row){
    for topic in topic_records.topics {
        if topic_rule_matches(row, topic).len() > 0 { return "规则匹配 · " + topic.title }
    }
    let reasons = interest_matches(row, user_interests)
    if reasons.len() > 0 { return "规则匹配 · " + reasons[0] }
    ""
}
// Recall for browsing only. A location/title match does not prove a dated impact.
fn tracking_schedule_rules(){
    let rules = []
    for item in user_schedules {
        if !schedule_is_user_record(item) || !schedule_active(item) || schedule_instant(item.end) < time_now() { continue }
        let words = [item.title]
        if record_string(item["location"]) && item.location.trim() != "" { words.push(item.location) }
        if item["news_keywords"] != nil { for word in item.news_keywords { words.push(word) } }
        for i word in words { rules.push({interest_id: "schedule:" + item.schedule_id + ":" + item.version + ":" + i kind: "keyword" value: word enabled: true
            schedule_id: item.schedule_id schedule_version: item.version}) }
    }
    rules
}
fn tracking_schedule_decisions(){
    let handled = {}
    for decision in topic_records.decisions {
        if decision["kind"] == "insight" { continue }
        for evidence in decision.evidence {
            let key = decision.schedule_id + ":" + decision.schedule_version + ":" + evidence.news_id
            let keys = handled[key]
            if keys == nil { keys = [] handled[key] = keys }
            keys.push(evidence.key)
        }
    }
    handled
}
fn tracking_schedule_candidate(row, rules, handled){
    let evidence_key = ""
    for rule in rules {
        if interest_matches(row, [rule]).len() == 0 { continue }
        let keys = handled[rule.schedule_id + ":" + rule.schedule_version + ":" + row.news_id]
        let suppressed = false
        if keys != nil {
            if evidence_key == "" { evidence_key = tracking_evidence_key(row) }
            for key in keys { if key == evidence_key { suppressed = true } }
        }
        if !suppressed { return true }
    }
    false
}
fn tracking_target_checked(kind, id, version){
    let checked_at = 0
    let state = check_state_find(kind, id, version)
    if state != nil { checked_at = state.watermark }
    for run in tracking_cache.runs {
        let values = run.snapshot.topics let field = "topic_id"
        if kind == "schedule" { values = run.snapshot.schedules field = "schedule_id" }
        if kind == "legacy" { values = run.snapshot.legacy_interests field = "interest_id" }
        for item in values {
            if item[field] == id {
                if kind == "legacy" || item["version"] == version { checked_at = max(checked_at, run.checked_at) }
            }
        }
    }
    checked_at
}
fn tracking_targets(){
    let units = []
    for item in user_schedules {
        if schedule_is_user_record(item) && schedule_active(item) && schedule_instant(item.end) >= time_now() {
            let checked = tracking_target_checked("schedule", item.schedule_id, item.version)
            if schedule_instant(item.start) - time_now() <= 7 * 86400 { checked = checked - agent_preferences.interval_seconds }
            units.push({kind: "schedule" item: item checked_at: checked})
        }
    }
    for item in topic_records.topics {
        if topic_is_user_record(item) && item.status == "active" { units.push({kind: "topic" item: item checked_at: tracking_target_checked("topic", item.topic_id, item.version)}) }
    }
    let legacy = [] for item in user_interests { if item.enabled { legacy.push(item) } }
    if legacy.len() > 0 { units.push({kind: "legacy" item: legacy checked_at: tracking_target_checked("legacy", legacy[0].interest_id, 1)}) }
    let total = units.len() let topics = [] let schedules = [] let interests = []
    // Least-recently checked units rotate bounded coverage across later triggers.
    for step in min(tracking_config.max_targets, total) {
        let index = 0
        for i item in units { if item.checked_at < units[index].checked_at { index = i } }
        let chosen = units.remove(index)
        if chosen.kind == "topic" { topics.push(chosen.item) }
        if chosen.kind == "schedule" { schedules.push(chosen.item) }
        if chosen.kind == "legacy" { interests = chosen.item }
    }
    {topics: topics schedules: schedules legacy_interests: interests omitted_targets: max(0, total - tracking_config.max_targets)}
}
fn tracking_context_key(){
    let topics = [] let schedules = []
    for item in topic_records.topics { topics.push({topic_id: item.topic_id version: item.version status: item.status}) }
    for item in user_schedules { schedules.push({schedule_id: item.schedule_id version: item.version status: item["status"]}) }
    {topics: topics legacy: user_interests schedules: schedules revision: tracking_prompt_revision config: tracking_config}.to_json()
}
fn tracking_snapshot_evidence(row){
    let summary = row.summary
    let truncated = summary.to_chars().len() > tracking_config.max_summary_chars
    if truncated { summary = bm25_prefix(summary, tracking_config.max_summary_chars) }
    let value = {news_id: row.news_id title: row.title summary: summary source_url: row.source_url
        published_at: row.published_at retrieved_at: row.retrieved_at evidence_kind: row.evidence_kind
        timestamp_kind: row.timestamp_kind summary_truncated: truncated references: row.references
        content_key: tracking_evidence_key(row)}
    if row["fixed_article"] == true {
        value.archive_provenance = {original_title: row.original_title source_role: row.source_role same_event_as: row.same_event_as
            archive_captured_at: row.archive_captured_at source_published_date: row.source_published_date source_updated_date: row.source_updated_date source_verified_date: row["source_verified_date"]
            body_origin: "curated_excerpt" summary_origin: "curator_paraphrase" retrieved_at_meaning: "local_archive_load" coverage_note: row.coverage_note}
    }
    return value
}
fn tracking_decision_matches(item, targets){
    if item["kind"] == "insight" {
        for topic in targets.topics { if item.target_type == "topic" && item.target_id == topic.topic_id && item.target_version == topic.version { return true } }
        for schedule in targets.schedules { if item.target_type == "schedule" && item.target_id == schedule.schedule_id && item.target_version == schedule.version { return true } }
        nil
    } else { for schedule in targets.schedules { if schedule.schedule_id == item.schedule_id { return true } } nil }
    false
}
fn tracking_snapshot(rows, targets){
    let evidence = []
    for row in rows { evidence.push(tracking_snapshot_evidence(row)) }
    let previous = nil
    // Old per-item context is restricted to exactly the same target set/version.
    for i in tracking_cache.runs.len() {
        let old = tracking_cache.runs[tracking_cache.runs.len() - 1 - i]
        if old.snapshot.topics.to_json() == targets.topics.to_json() && old.snapshot.schedules.to_json() == targets.schedules.to_json() && old.snapshot.legacy_interests.to_json() == targets.legacy_interests.to_json() { previous = old.result break }
    }
    let decisions = []
    for item in topic_records.decisions {
        if tracking_decision_matches(item, targets) { decisions.push(item) }
    }
    let omitted_decisions = max(0, decisions.len() - 12)
    while decisions.len() > 12 { decisions.remove(0) }
    let snapshot = {schema_version: 1 topics: targets.topics schedules: targets.schedules legacy_interests: targets.legacy_interests
        evidence: evidence previous_result: previous decisions: decisions omitted_targets: targets.omitted_targets
        omitted_candidates: 0 omitted_decisions: omitted_decisions context_key: tracking_context_key() prompt_revision: tracking_prompt_revision previous_by_target: []}
    snapshot.previous_by_target = insight_previous_for(snapshot)
    snapshot.schedule_weather = schedule_weather_rows(snapshot.schedules)
    evidence_attach(snapshot, rows)
    snapshot
}
fn tracking_input_key(snapshot){
    let evidence = [] for item in snapshot.evidence { evidence.push({news_id: item.news_id content_key: item.content_key body_key: item["body_key"]}) }
    {context: snapshot.context_key evidence: evidence weather: snapshot["schedule_weather"] decisions: snapshot.decisions
        topics: snapshot.topics schedules: snapshot.schedules check_scope: snapshot["check_scope"] omitted_targets: snapshot.omitted_targets omitted_candidates: snapshot.omitted_candidates revision: tracking_prompt_revision}.to_json()
}
// END src/data/retrieval/tracking.splash

// BEGIN src/data/retrieval/bm25.splash
// Query-adaptive BM25, k1=1.2 b=.75, positive Robertson IDF.
// Latin words (case-insensitive) and overlapping Han bigrams; no vectors.
// Topics pass a title gate before evidence retrieval. Other explicit interests
// and dated schedules retain their existing recall paths; BM25 only ranks.
fn bm25_broad_keyword(value){
    record_contains(["ai" "人工智能" "科技" "技术" "商业" "生活" "新闻" "资讯" "动态" "动向" "公司" "产品" "新品" "发布" "更新" "功能" "设备" "数码" "消费" "性能" "耳机" "手机"], bm25_word_key(value.trim()))
}
fn bm25_title_filters(targets){
    let filters = []
    for topic in targets.topics {
        let all = [] let specific = [] let anchors = []
        for rule in topic.recall_rules {
            if rule.kind != "keyword" || rule.value.trim() == "" { continue }
            let matcher = regex(interest_keyword_pattern(rule.value.trim()), "i")
            all.push(matcher)
            if !bm25_broad_keyword(rule.value) {
                specific.push(matcher)
                if record_string(topic["title"]) && matcher.test(topic.title) { anchors.push(matcher) }
            }
        }
        // A concrete subject in the topic title must also occur in the news
        // title. Shared categories or fragments from a long scope cannot pass.
        let matchers = if anchors.len() > 0 {anchors} else {if specific.len() > 0 {specific} else {all}}
        // Practical goals can cover multiple tasks and their explicit aliases;
        // one literal task in the title must not suppress the other tasks.
        if topic["intent_kind"] == "goal" && specific.len() > 0 { matchers = specific }
        if matchers.len() == 0 {
            for scope_text in topic["scope"] {
                if scope_text.to_chars().len() <= 24 && !bm25_broad_keyword(scope_text) { matchers.push(regex(interest_keyword_pattern(scope_text), "i")) }
            }
        }
        filters.push(matchers)
    }
    filters
}
fn bm25_title_matches(title, filters){
    for matchers in filters { for matcher in matchers { if matcher.test(title) { return true } } }
    false
}
fn bm25_prefix(value, chars){
    // Large counted wildcard repetitions exhaust the pinned regex engine's
    // DFA on long Unicode text. A bounded codepoint copy needs no regex.
    let codepoints = value.to_chars()
    if codepoints.len() <= chars { return value }
    let prefix = "".to_chars()
    for i in max(0, chars) { prefix.push(codepoints[i]) }
    prefix.to_string()
}
fn bm25_query_terms(value){
    let words = value.match_all(regex("[A-Za-z0-9_]+|[一-龥]+", "g"))
    let out = []
    for token_match in words {
        if regex("^[A-Za-z0-9_]+$").test(token_match.value) { if token_match.value.len() >= 2 { out.push(token_match.value) } }
        else {
            let chars = token_match.value.match_all(regex("[一-龥]", "g"))
            if chars.len() == 1 { out.push(chars[0].value) }
            for i part in chars { if i + 1 < chars.len() { out.push(part.value + chars[i + 1].value) } }
        }
    }
    out
}
fn bm25_terms(targets){
    let queries = [] let terms = [] let seen = {}
    for topic in targets.topics {
        // Preferences are for assessment; avoid recalling financing solely
        // because the user said they want fewer financing stories.
        for rule in topic.recall_rules { if rule.kind == "keyword" { queries.push(rule.value) } }
        for value in topic["scope"] { queries.push(value) }
    }
    for interest in targets.legacy_interests { if interest.kind == "keyword" { queries.push(interest.value) } }
    for item in targets.schedules {
        if item["news_keywords"] != nil { for word in item.news_keywords { queries.push(word) } }
        if record_string(item["location"]) { queries.push(item["location"]) }
        queries.push(item.title)
        if record_string(item["content"]) { queries.push(item["content"]) }
        queries.push(item.start.split("T")[0])
    }
    for query_text in queries {
        for term in bm25_query_terms(query_text) {
            let key = bm25_word_key(term)
            if seen[key] != true && terms.len() < tracking_config.max_bm25_terms {
                seen[key] = true terms.push({value: key df: 0})
                if terms.len() >= tracking_config.max_bm25_terms { return terms }
            }
        }
    }
    terms
}
fn bm25_gate(row, targets){
    for rule in targets.legacy_interests {
        if rule.kind == "source" && rule.value == row.source { return true }
        if rule.kind == "category" && rule.value == row.category { return true }
    }
    false
}
fn bm25_latin_char(cp){ (cp >= 65 && cp <= 90) || (cp >= 97 && cp <= 122) || (cp >= 48 && cp <= 57) || cp == 95 }
fn bm25_han_char(cp){ cp >= 19968 && cp <= 40869 }
fn bm25_word_key(value){
    let chars = value.to_chars()
    for i cp in chars { if cp >= 65 && cp <= 90 { chars[i] = cp + 32 } }
    chars.to_string()
}
fn bm25_word_finish(work, doc){
    if doc.word.len() == 0 { return }
    let term_index = work.words[doc.word.to_string()]
    if term_index != nil { doc.counts[term_index] = doc.counts[term_index] + 1 }
    doc.length = doc.length + 1 doc.word = "".to_chars()
}
fn bm25_han_finish(doc){
    if doc.han_run == 1 { doc.length = doc.length + 1 }
    doc.han_run = 0 doc.previous_han = nil
}
fn bm25_progress(work){
    if work.progress == nil { return }
    if time_now() - work.progress_at < 0.5 && work.phase == work.progress_phase { return }
    work.progress_at = time_now() work.progress_phase = work.phase
    work.progress({phase: work.phase scanned: if work.phase == "index" {work.index} else {if work.phase == "terms" {0} else {work.rows.len()}} total: work.rows.len() ranked: work.index matched: work.matched})
}
fn bm25_recall(rows, targets, current, complete, progress = nil){
    // Query compilation gets its own native callback, away from record writes
    // and navigation. The host's 64 ms ceiling applies to each callback.
    let work = {rows: rows targets: targets current: current complete: complete terms: []
        docs: [] pending: nil index: 0 phase: "terms" stopped: false total_length: 0 total_docs: 0 seen: {} ranked: [] matched: 0 expired: 0
        words: {} pairs: {} single_han: {} exact_matchers: [] title_filters: [] title_rejected: 0 gc_tick: 0 progress: progress progress_at: 0 progress_phase: ""}
    start_timeout(0.01, || bm25_begin(work))
}
fn bm25_begin(work){
    if work.stopped { return }
    start_timeout(0.01, || { if work.phase == "terms" { bm25_begin(work) } else { bm25_step(work) } })
    if !work.current() { work.stopped = true return }
    work.terms = bm25_terms(work.targets) work.words = {} work.pairs = {} work.single_han = {}
    work.title_filters = bm25_title_filters(work.targets)
    work.exact_matchers = []
    for topic in work.targets.topics { for rule in topic.recall_rules {
        if rule.kind == "keyword" { work.exact_matchers.push(regex(interest_keyword_pattern(rule.value), "i")) }
    } }
    for i term in work.terms {
        let cp = term.value.to_chars()
        if cp.len() == 1 && bm25_han_char(cp[0]) { work.single_han["" + cp[0]] = i }
        else if cp.len() == 2 && bm25_han_char(cp[0]) && bm25_han_char(cp[1]) { work.pairs["" + (cp[0] * 65536 + cp[1])] = i }
        else { work.words[bm25_word_key(term.value)] = i }
    }
    work.phase = "index" bm25_progress(work)
}
fn bm25_step(work){
    if work.stopped || work.phase == "done" { return }
    if work.phase == "rank" { bm25_rank_step(work) return }
    // Arm continuation BEFORE any potentially interrupted work. Keep the
    // document cursor in work; a VM bail no longer discards the callback chain.
    start_timeout(0.01, || bm25_step(work))
    // A slice can finish one document and start the next. Collect by slice,
    // rather than waiting for pending == nil, which may never be observed.
    work.gc_tick = work.gc_tick + 1
    if work.gc_tick >= 4 { work.gc_tick = 0 mod.gc.run() }
    if !work.current() { work.stopped = true return }
    let processed = 0 let char_steps = 0 let started = time_now()
    while (work.pending != nil || work.index < work.rows.len()) && processed < tracking_config.bm25_batch_items && char_steps < tracking_config.bm25_char_batch_items && time_now() - started < news_config.work_slice_seconds {
        if work.pending == nil {
            let row = work.rows[work.index]
            if work.seen[row.news_id] == true { work.index = work.index + 1 processed = processed + 1 continue }
            let topic_only = work.targets.topics.len() > 0 && work.targets.schedules.len() + work.targets.legacy_interests.len() == 0
            if topic_only && !bm25_title_matches(row.title, work.title_filters) {
                work.seen[row.news_id] = true work.title_rejected = work.title_rejected + 1
                work.index = work.index + 1 processed = processed + 1 continue
            }
            let text = row.title
            if !topic_only { text = text + " " + bm25_prefix(row.summary, tracking_config.max_bm25_body_chars) }
            let chars = text.to_chars() let exact = false
            for matcher in work.exact_matchers { if matcher.test(text) { exact = true break } }
            let gate = bm25_gate(row, work.targets)
            let counts = [] for term in work.terms { counts.push(0) }
            work.pending = {row: row chars: chars cursor: 0 word: "".to_chars() previous_han: nil han_run: 0 length: 0 counts: counts gate: gate exact: exact}
            work.seen[row.news_id] = true work.index = work.index + 1
        }
        let doc = work.pending
        // Tokenize once, using exact dictionary lookups instead of scanning
        // the same Unicode string separately for each of the 24 query terms.
        while doc.cursor < doc.chars.len() && char_steps < tracking_config.bm25_char_batch_items && time_now() - started < news_config.work_slice_seconds {
            let cp = doc.chars[doc.cursor]
            if bm25_latin_char(cp) {
                bm25_han_finish(doc)
                if cp >= 65 && cp <= 90 { cp = cp + 32 }
                doc.word.push(cp)
            } else if bm25_han_char(cp) {
                bm25_word_finish(work, doc)
                let single = work.single_han["" + cp]
                if single != nil { doc.counts[single] = doc.counts[single] + 1 }
                if doc.previous_han != nil {
                    let pair = work.pairs["" + (doc.previous_han * 65536 + cp)]
                    if pair != nil { doc.counts[pair] = doc.counts[pair] + 1 }
                    doc.length = doc.length + 1
                }
                doc.previous_han = cp doc.han_run = doc.han_run + 1
            } else { bm25_word_finish(work, doc) bm25_han_finish(doc) }
            doc.cursor = doc.cursor + 1 char_steps = char_steps + 1
        }
        if doc.cursor < doc.chars.len() { break }
        bm25_word_finish(work, doc) bm25_han_finish(doc) doc.length = max(1, doc.length)
        let hit = doc.gate || doc.exact
        for i tf in doc.counts { if tf > 0 { work.terms[i].df = work.terms[i].df + 1 hit = true } }
        work.total_docs = work.total_docs + 1 work.total_length = work.total_length + doc.length
        if hit { work.docs.push({row: doc.row length: doc.length counts: doc.counts gate: doc.gate exact: doc.exact}) }
        work.pending = nil processed = processed + 1
    }
    if work.pending == nil && work.index >= work.rows.len() { work.index = 0 work.phase = "rank" }
    bm25_progress(work)
}
fn bm25_rank_step(work){
    if work.stopped || work.phase == "done" { return }
    start_timeout(0.01, || bm25_rank_step(work))
    if !work.current() { work.stopped = true return }
    let processed = 0 let started = time_now()
    let average = work.total_length / max(1, work.total_docs)
    while work.index < work.docs.len() && processed < tracking_config.bm25_batch_items && time_now() - started < news_config.work_slice_seconds {
        let doc = work.docs[work.index]
        let score = 0
        for i term in work.terms {
            let tf = doc.counts[i]
            if tf > 0 {
                let idf = mod.math.log(1 + (work.total_docs - term.df + 0.5) / (term.df + 0.5))
                score = score + idf * (tf * (tracking_config.bm25_k1 + 1)) / (tf + tracking_config.bm25_k1 * (1 - tracking_config.bm25_b + tracking_config.bm25_b * doc.length / average))
            }
        }
        if score <= 0 && !doc.gate && !doc.exact { work.index = work.index + 1 processed = processed + 1 continue }
        let source = news_source(doc.row.source_id)
        if source != nil && source.category == "travel" && source.kind == "rss" && regex("[0-9]{4}[-/年]").test(doc.row.title + " " + doc.row.summary) {
            for schedule in work.targets.schedules {
                if record_string(schedule["location"]) && schedule.location.trim() != "" {
                    if regex(literal_pattern(schedule.location)).test(doc.row.title + " " + doc.row.summary) { score = score + 2 break }
                }
            }
        }
        if doc.row.retrieved_at <= 0 || time_now() - doc.row.retrieved_at > news_config.cache_stale_seconds {
            work.matched = work.matched + 1 work.expired = work.expired + 1 work.index = work.index + 1 processed = processed + 1 continue
        }
        let next = [] let placed = false
        // Full explicit keyword hits precede broad scope/bigram matches.
        // This is a recall priority, never proof of relevance or a new fact.
        for old in work.ranked {
            if !placed && ((doc.exact && !old.exact) || (doc.exact == old.exact && score > old.score)) {
                next.push({row: doc.row score: score exact: doc.exact}) placed = true
            }
            next.push(old)
        }
        if !placed { next.push({row: doc.row score: score exact: doc.exact}) }
        while next.len() > tracking_config.max_candidates { next.pop() }
        work.ranked = next work.matched = work.matched + 1 work.index = work.index + 1 processed = processed + 1
    }
    bm25_progress(work)
    if work.index < work.docs.len() { return }
    work.phase = "done"
    let rows = [] for item in work.ranked { rows.push(item.row) }
    let result = {rows: rows matched: work.matched expired: work.expired omitted_candidates: max(0, work.matched - work.expired - rows.len())
        title_rejected: work.title_rejected
        retrieval: "topic title gate before evidence; explicit keyword hits first; BM25 Latin words / Han bigrams; legacy source/category and schedule recall; stable ties"}
    start_timeout(0.01, || { if work.current() { work.complete(result) } })
}
// END src/data/retrieval/bm25.splash

// BEGIN src/data/ingestion/http.splash
// One allowlist for every outbound request. News feeds use news_hosts, city
// forecasts use weather_hosts, the holiday calendar uses holiday_hosts. All are
// generated by scripts/assemble.py or declared next to the module that needs
// them, so a host cannot be requested without being declared there and listed in
// bundle/manifest.json.
fn news_request_allowed(url){
    if !record_string(url) { return false }
    let parts = url.split("/")
    if parts.len() < 3 || parts[0] != "https:" || parts[1] != "" { return false }
    record_contains(news_hosts, parts[2]) || record_contains(weather_hosts, parts[2]) || record_contains(holiday_hosts, parts[2]) || record_contains(fx_hosts, parts[2]) || record_contains(article_hosts, parts[2])
}
fn news_redirect_url(current, location){
    if !record_string(location) { return nil }
    if regex("^https://").test(location) { return location }
    if regex("^//").test(location) { return "https:" + location }
    if regex("^/").test(location) { return "https://" + current.split("/")[2] + location }
    nil
}
fn news_http_finish(context, result){
    if context.done { return }
    context.done = true
    stop_timer(context.timer)
    context.callback(result)
}
fn news_http_request(url, redirects, callback){
    let context = {done: false timer: nil callback: callback}
    context.timer = start_timeout(news_config.request_timeout_seconds, || {
        news_http_finish(context, {success: false error: "请求超时" category: "timeout"})
    })
    news_http_step(url, redirects, context)
}
fn news_http_verification(headers){
    if headers == nil { return false }
    let mitigated = headers["cf-mitigated"]
    if mitigated == nil { mitigated = headers["Cf-Mitigated"] }
    if mitigated == nil { mitigated = headers["CF-Mitigated"] }
    if record_array(mitigated) { for action in mitigated { if action == "challenge" { return true } } }
    let actions = headers["x-amzn-waf-action"]
    if actions == nil { actions = headers["X-Amzn-Waf-Action"] }
    if actions == nil { actions = headers["X-AMZN-WAF-ACTION"] }
    if !record_array(actions) { return false }
    for action in actions { if action == "captcha" || action == "challenge" { return true } }
    false
}
fn news_http_step(url, redirects, context){
    if context.done { return }
    if !news_request_allowed(url) { news_http_finish(context, {success: false error: "请求或重定向域名未获许可" category: "permission"}); return }
    try {
        net.http_request(net.HttpRequest{url: url method: net.HttpMethod.GET
            max_response_body_bytes: news_config.max_response_bytes
            // The pinned Windows backend owns User-Agent; overriding it is refused.
            headers: {"Accept": ["application/rss+xml, application/atom+xml, application/json, text/html, text/xml, */*"]}}) do net.HttpEvents{
            on_response: |response| {
                if context.done { return }
                let status = response.status_code
                if news_http_verification(response.headers) {
                    news_http_finish(context, {success: false error: "网站要求浏览器人机验证，暂不支持直接读取" category: "verification"})
                    return
                }
                if status == 301 || status == 302 || status == 303 || status == 307 || status == 308 {
                    let locations = response.headers["location"]
                    if locations == nil { locations = response.headers["Location"] }
                    let target = nil
                    if locations != nil && locations.len() > 0 { target = news_redirect_url(url, locations[0]) }
                    if target == nil || redirects >= news_config.max_redirects { news_http_finish(context, {success: false error: "重定向无效或次数超限" category: "redirect"}); return }
                    news_http_step(target, redirects + 1, context)
                } else if status != 200 { news_http_finish(context, {success: false error: "HTTP " + status category: "http"}) }
                else if response.body == nil { news_http_finish(context, {success: false error: "响应缺少正文" category: "body"}) }
                else { news_http_finish(context, {success: true body: response.body.to_string()}) }
            }
            on_error: |error| {
                news_http_finish(context, {success: false error: error.message category: "network"})
            }
        }
    } {
        news_http_finish(context, {success: false error: "宿主拒绝或无法发起网络请求" category: "host"})
    }
}
// END src/data/ingestion/http.splash

// BEGIN src/data/ingestion/articles.splash
// Read-only reader; bounded paragraphs can also populate the separate evidence
// cache. Each Agent run preserves exactly the paragraphs it actually received.
let article_hosts = ["www.airchinagroup.com", "www.theverge.com", "arstechnica.com", "venturebeat.com", "news.mit.edu", "arxiv.org", "www.bbc.com", "www.bbc.co.uk", "www.theguardian.com", "www.cnbc.com", "techcrunch.com", "www.techmeme.com", "news.ycombinator.com", "www.36kr.com", "36kr.com", "www.ithome.com", "sspai.com", "www.solidot.org", "solidot.org", "www.ifanr.com", "ifanr.com", "www.nasa.gov", "nasa.gov", "www.expreview.com", "www.popsci.com", "theconversation.com", "www.geekpark.net"]
let article_image_hosts = ["ichef.bbci.co.uk", "i.guim.co.uk", "cdn.arstechnica.net", "cdn.vox-cdn.com", "duet-cdn.vox-cdn.com", "img.36krcdn.com", "img.ithome.com", "cdn.sspai.com", "s3.ifanr.com", "images.ifanr.cn", "img.expreview.com", "i0.wp.com", "images.theconversation.com", "imgslim.geekpark.net"]
let article_config = {max_paragraphs: 260 max_text_bytes: 96000 max_nodes: 1500 max_images: 6
    max_image_bytes: 2000000 max_total_image_bytes: 6000000 image_timeout_seconds: 15 image_target_width: 900}
let article_state = {generation: 0 state: "idle" paragraphs: [] blocks: [] images: [] image_bytes: 0 error: "" truncated: false requires_verification: false origin: ""}
let article_http_request = |url, redirects, callback| news_http_request(url, redirects, callback)
fn article_url_allowed(url){
    if !record_string(url) { return false }
    let parts = url.split("/")
    parts.len() >= 3 && parts[0] == "https:" && parts[1] == "" && record_contains(article_hosts, parts[2])
}
fn article_original_allowed(url){
    if !record_string(url) { return false }
    let parts = url.split("/")
    parts.len() >= 3 && (parts[0] == "https:" || parts[0] == "http:") && parts[1] == "" && regex("^[a-zA-Z0-9.-]+$").test(parts[2])
}
fn article_resolve_url(base, value){
    if !record_string(value) || value.trim() == "" { return nil }
    value = value.trim()
    if regex("^https://").test(value) { return value }
    if regex("^//").test(value) { return "https:" + value }
    if !article_original_allowed(base) || regex("^[a-zA-Z][a-zA-Z0-9+.-]*:").test(value) { return nil }
    let parts = base.split("?")[0].split("#")[0].split("/")
    let path = []
    if !regex("^/").test(value) { for i part in parts { if i >= 3 && i < parts.len() - 1 && part != "" { path.push(part) } } }
    for part in value.split("/") {
        if part == ".." { if path.len() > 0 { path.remove(path.len() - 1) } }
        else if part != "" && part != "." { path.push(part) }
    }
    let resolved = "https://" + parts[2]
    for part in path { resolved = resolved + "/" + part }
    resolved
}
fn article_image_allowed(url){
    if !record_string(url) { return false }
    let parts = url.split("/")
    parts.len() >= 3 && parts[0] == "https:" && parts[1] == "" && (record_contains(article_hosts, parts[2]) || record_contains(article_image_hosts, parts[2]))
}
fn article_add_image(blocks, images, seen, base, value, caption){
    let url = article_resolve_url(base, value)
    if !article_image_allowed(url) || seen[url] == true || images.len() >= article_config.max_images { return }
    seen[url] = true
    if !record_string(caption) { caption = "" }
    let block = {kind: "image" url: url text: caption state: "loading" resource: nil error: "" origin: "https://" + base.split("/")[2] + "/"}
    images.push(block) blocks.push(block)
}
fn article_srcset_url(value){
    if !record_string(value) || value.len() > 16000 { return nil }
    let selected = nil let distance = 100000 let pending = nil let visited = 0
    // Only a width descriptor ends an entry. URL query commas stay intact;
    // splitting at `w,` also supports compact srcset separators.
    let tokens = []
    for line in value.split("\n") { for cell in line.split("\t") { for part in cell.split(" ") { if part.trim() != "" { tokens.push(part.trim()) } } } }
    for token in tokens {
        visited = visited + 1 if visited > 96 { break }
        if pending == nil { pending = token.strip_prefix(",") continue }
        let parts = token.split("w,")
        let number = parts[0].strip_suffix("w")
        if !regex("^[0-9]+$").test(number) || (parts.len() == 1 && !regex("^[0-9]+w$").test(parts[0])) { pending = nil continue }
        let width = number.to_number()
        if width >= 320 && width <= 1600 {
            let delta = if width > article_config.image_target_width {width - article_config.image_target_width} else {article_config.image_target_width - width}
            if delta < distance { selected = pending distance = delta }
        }
        pending = nil
        if parts.len() > 1 {
            let rest = parts[1]
            for i part in parts { if i > 1 { rest = rest + "w," + part } }
            if rest != "" { pending = rest }
        }
    }
    selected
}
fn article_node_image_url(node){
    // Prefer the publisher's reader-sized source, including lazy images. Never
    // turn an arbitrary URL into a guessed CDN transformation.
    for attribute in ["data-srcset" "srcset"] {
        let candidate = article_srcset_url(node.attr(attribute))
        if candidate != nil { return candidate }
    }
    for attribute in ["data-src" "data-original" "data-lazy-src" "src"] {
        let candidate = node.attr(attribute)
        if record_string(candidate) && candidate != "" && !regex("^data:").test(candidate) { return candidate }
    }
    nil
}
fn article_image_filename(url){
    let parts = url.split("?")[0].split("#")[0].split("/")
    // Drupal's responsive derivative can add _0 to the same image filename.
    parts[parts.len() - 1].replace("_0.", ".")
}
fn article_cover_url(doc, base, original){
    let cover = article_resolve_url(base, original)
    if !article_image_allowed(cover) { return nil }
    let visited = 0
    for node in doc.query("img").array() {
        visited = visited + 1 if visited > article_config.max_nodes { break }
        let candidate = article_resolve_url(base, article_node_image_url(node))
        if !article_image_allowed(candidate) { continue }
        let width = node.attr("width")
        if record_string(width) && regex("^[0-9]+$").test(width) && width.to_number() < 640 { continue }
        if article_image_filename(candidate) == article_image_filename(cover) { return candidate }
    }
    cover
}
fn article_extract(body, source_url = nil){
    if source_url != nil && regex("^https://sspai[.]com/post/").test(source_url) {
        // SSR pages repeat substantial navigation/extension markup. Keep the
        // publisher's article section before native parsing to fit 64 ms.
        let parts = body.split("class=\"article__main__content")
        if parts.len() > 1 {
            let content = parts[1].split("<div class=\"article__footer")[0]
            body = "<article><div class=\"article__main__content" + content + "</article>"
            // Flatten the SSR text with explicit block separators. Embedded
            // iframe/image-only paragraphs need no script text-node iteration.
            body = body.replace(regex("</p>", "g"), "</p>CFAW_READER_BLOCK_BREAK")
            let text = reading_feed_text(body)
            let paragraphs = text.split("CFAW_READER_BLOCK_BREAK")
            return {paragraphs: paragraphs blocks: [] images: [] truncated: text.len() > article_config.max_text_bytes || paragraphs.len() > article_config.max_paragraphs}
        }
    }
    let doc = body.parse_html()
    // Restrict extraction to article/main containers. Never present navigation,
    // consent pages or the entire HTML document as a news article.
    let container = nil
    for selector in ["div.news-article--content--body" "div.ArticleBody-articleBody" "div.article-body" "div.article-content" "div.entry-content" "div.article__main__content" "div.article__content" "div.post__content" "div.p_main" "article" "main"] {
        let found = doc.query(selector + "[0]")
        if found != nil && found.query("p").length > 0 { container = found break }
    }
    let values = []
    if container != nil { values = container.query("p.text") if record_string(values) { values = [values] } }
    let paragraphs = [] let count = 0 let truncated = false
    let value_index = 0
    while value_index < values.len() {
        let value = values[value_index]
        if record_string(value) {
            let text = value.trim()
            if text != "" {
                if paragraphs.len() >= article_config.max_paragraphs || count + text.len() > article_config.max_text_bytes { truncated = true break }
                paragraphs.push(text) count = count + text.len()
            }
        }
        value_index = value_index + 1
    }
    let blocks = [] let images = [] let seen = {}
    if source_url != nil && container != nil {
        // The cover lives outside the body on several publishers (e.g. MIT).
        for meta in doc.query("meta").array() {
            if meta.attr("property") == "og:image" { article_add_image(blocks, images, seen, source_url, article_cover_url(doc, source_url, meta.attr("content")), "") break }
        }
        let visited = 0 let text_bytes = 0 let paragraph_count = 0
        let nodes = container.query("*").array()
        while visited < nodes.len() {
            let node = nodes[visited] visited = visited + 1
            if visited > article_config.max_nodes { truncated = true break }
            let html = node.html
            if regex("^<img[ >]").test(html) {
                let value = article_node_image_url(node)
                article_add_image(blocks, images, seen, source_url, value, node.attr("alt"))
                continue
            }
            let kind = nil
            if regex("^<p[ >]").test(html) { kind = "paragraph" }
            if regex("^<h[234][ >]").test(html) { kind = "heading" }
            if regex("^<li[ >]").test(html) && node.query("p").length == 0 { kind = "list" }
            if regex("^<blockquote[ >]").test(html) && node.query("p").length == 0 { kind = "quote" }
            if regex("^<figcaption[ >]").test(html) { kind = "caption" }
            if kind == nil { continue }
            let text = node.text.trim()
            if text == "" { continue }
            if text_bytes + text.len() > article_config.max_text_bytes || paragraph_count >= article_config.max_paragraphs { truncated = true break }
            text_bytes = text_bytes + text.len()
            if kind == "paragraph" { paragraph_count = paragraph_count + 1 }
            blocks.push({kind: kind text: text})
        }
    }
    {paragraphs: paragraphs blocks: blocks images: images truncated: truncated}
}
fn article_cancel(){ article_state.generation = article_state.generation + 1 }
fn article_prepare(){
    article_cancel()
    article_state.state = "loading" article_state.paragraphs = [] article_state.blocks = [] article_state.images = [] article_state.image_bytes = 0 article_state.error = "" article_state.truncated = false article_state.requires_verification = false article_state.origin = ""
}
fn article_accept(row, result, origin, complete){
    article_state.state = "ready" article_state.paragraphs = result.paragraphs article_state.truncated = result.truncated
    article_state.blocks = result.blocks article_state.images = result.images article_state.origin = origin
    analysis_article_store(row, result, "")
    complete()
    if article_state.state == "ready" { article_images_next(0, article_state.generation, complete) }
}
fn article_load(row, complete){
    article_prepare()
    let generation = article_state.generation
    if record_string(row["body_html"]) && row["body_html"] != "" {
        let result = nil
        try { result = article_extract("<article>" + row.body_html + "</article>", row.source_url) } { result = nil }
        if result != nil {
            if result.paragraphs.len() == 0 {
                let text = reading_feed_text(row.body_html)
                if text != "" { result.paragraphs = [text] result.blocks = [{kind: "paragraph" text: text}] }
            }
            if result.paragraphs.len() > 0 { article_accept(row, result, row.body_origin, complete) return }
        }
    }
    if !article_url_allowed(row.source_url) {
        article_state.state = "unavailable"
        article_state.error = "此来源暂不支持应用内提取，请点击“打开图文原文”阅读。"
        complete() return
    }
    article_http_request(row.source_url, 0, fn(reply){
        if generation != article_state.generation || article_state.state != "loading" { return }
        if !reply.success {
            if reply.category == "verification" {
                article_state.state = "unavailable"
                article_state.requires_verification = true
                article_state.error = "网站需要验证。请在应用内原文页完成验证后继续阅读。"
            } else { article_state.state = "failed" article_state.error = "正文读取失败：" + reply.error }
            complete() return
        }
        let result = nil
        try { result = article_extract(reply.body, row.source_url) } { result = nil }
        if result == nil || result.paragraphs.len() == 0 {
            article_state.state = "unavailable" article_state.error = "来源网页未提供可读取的正文，以下保留来源摘要。"
        } else {
            article_accept(row, result, "publisher_web", complete) return
        }
        complete()
        if article_state.state == "ready" { article_images_next(0, generation, complete) }
    })
}
fn article_image_step(url, redirects, context){
    if context.done { return }
    if !article_image_allowed(url) { news_http_finish(context, {success: false error: "配图域名未获许可"}) return }
    try {
        net.http_request(net.HttpRequest{url: url method: net.HttpMethod.GET max_response_body_bytes: article_config.max_image_bytes
            headers: context.headers}) do net.HttpEvents{
            on_response: |response| {
                if context.done { return }
                if record_contains([301 302 303 307 308], response.status_code) {
                    let locations = response.headers["location"] if locations == nil { locations = response.headers["Location"] }
                    let target = nil if locations != nil && locations.len() > 0 { target = article_resolve_url(url, locations[0]) }
                    if target == nil || redirects >= news_config.max_redirects { news_http_finish(context, {success: false error: "配图重定向无效或次数超限"}) return }
                    article_image_step(target, redirects + 1, context)
                } else { news_http_finish(context, {success: response.status_code == 200 && response.body != nil bytes: response.body error: if response.status_code != 200 {"配图请求 HTTP " + response.status_code} else {""}}) }
            }
            on_error: |error| news_http_finish(context, {success: false error: if regex("body.*(limit|large)").test(error.message) {"配图超过 2 MB 下载限制"} else {error.message}})
        }
    } { news_http_finish(context, {success: false error: "宿主无法发起配图请求"}) }
}
let article_image_request = fn(url, callback, origin = nil){
    let headers = {"Accept": ["image/jpeg, image/png, image/webp, image/gif, */*;q=0.1"]}
    if article_url_allowed(origin) { headers["Referer"] = [origin] }
    let context = {done: false timer: nil callback: callback headers: headers}
    context.timer = start_timeout(article_config.image_timeout_seconds, || news_http_finish(context, {success: false error: "配图请求超时"}))
    article_image_step(url, 0, context)
}
fn article_image_bytes_supported(bytes){
    // Some sites return an HTML challenge with HTTP 200 instead of an image.
    // Keep the original-link fallback rather than handing that page to Image.
    if !record_array(bytes) || bytes.len() < 12 { return false }
    if bytes[0] == 255 && bytes[1] == 216 && bytes[2] == 255 { return true }
    if bytes[0] == 137 && bytes[1] == 80 && bytes[2] == 78 && bytes[3] == 71 { return true }
    if bytes[0] == 71 && bytes[1] == 73 && bytes[2] == 70 { return true }
    bytes[0] == 82 && bytes[1] == 73 && bytes[2] == 70 && bytes[3] == 70 && bytes[8] == 87 && bytes[9] == 69 && bytes[10] == 66 && bytes[11] == 80
}
fn article_images_next(index, generation, complete){
    if generation != article_state.generation || index >= article_state.images.len() { return }
    let image = article_state.images[index]
    if image.state != "loading" { start_timeout(0.01, || article_images_next(index + 1, generation, complete)) return }
    article_image_load(image, generation, || {
        complete()
        start_timeout(0.01, || article_images_next(index + 1, generation, complete))
    })
}
fn article_retry_image(image, complete){
    if article_state.state != "ready" || image.state != "failed" { return }
    image.state = "loading" image.error = "" complete()
    article_image_load(image, article_state.generation, complete)
}
fn article_image_load(image, generation, complete){
    article_image_request(image.url, fn(reply){
        if generation != article_state.generation || image.state != "loading" { return }
        image.state = "failed"
        image.error = if record_string(reply["error"]) && reply.error != "" {reply.error} else {"配图格式不支持或超过大小限制"}
        if reply.success && article_image_bytes_supported(reply.bytes) && article_state.image_bytes + reply.bytes.len() <= article_config.max_total_image_bytes {
            try { image.resource = binary_resource(reply.bytes) image.state = "ready" image.error = "" article_state.image_bytes = article_state.image_bytes + reply.bytes.len() } { image.state = "failed" image.error = "配图资源创建失败" }
        }
        complete()
    }, image.origin)
}
// END src/data/ingestion/articles.splash

// BEGIN src/data/ingestion/analysis_evidence.splash
// Per-article evidence, separate from the reader's single global article_state.
let analysis_articles = []
let analysis_articles_revision = 0
let evidence_generation = 0
let evidence_work = nil
fn evidence_body_fingerprint(paragraphs){
    // Two bounded polynomial checksums, not a cryptographic signature. Preserve
    // quoted paragraphs separately; the fingerprint only invalidates caches.
    let bytes = paragraphs.to_json().to_bytes() let a = 1 let b = 7
    for byte in bytes { a = (a * 31 + byte) % 2147483647 b = (b * 257 + byte) % 2147483629 }
    {bytes: bytes.len() a: a b: b}.to_json()
}
fn analysis_article_key(row){ tracking_article_key(row) }
fn analysis_article_find(row){
    if row == nil { return nil }
    for entry in analysis_articles {
        if entry.news_id == row.news_id && time_now() - entry.retrieved_at < news_config.cache_stale_seconds {
            let facts = tracking_content_fields(entry.content_key)
            if facts != nil && tracking_article_matches(row, facts) { return entry }
        }
    }
    nil
}
fn analysis_article_store(row, extracted, error){
    analysis_articles_revision = analysis_articles_revision + 1
    let paragraphs = []
    let truncated = false if extracted != nil { truncated = extracted.truncated }
    // Tracking consumes at most six paragraphs / 4 KB. Bound its separate
    // evidence cache before fingerprinting now that the reader accepts longer
    // bodies; manual full-text summaries continue to use article_state.
    let bytes = 0
    if extracted != nil {
        for i text in extracted.paragraphs {
            text = text.trim() if text == "" { continue }
            if bytes == 0 && text.to_bytes().len() > 4000 { text = bm25_prefix(text, 1000) truncated = true }
            if paragraphs.len() >= 6 || bytes + text.to_bytes().len() > 4000 { truncated = true break }
            paragraphs.push({paragraph_id: "p" + (i + 1) text: text}) bytes = bytes + text.to_bytes().len()
        }
    }
    let entry = {news_id: row.news_id content_key: analysis_article_key(row) source_url: row.source_url
        retrieved_at: time_now() paragraphs: paragraphs truncated: truncated error: error
        body_key: evidence_body_fingerprint(paragraphs)}
    if paragraphs.len() == 0 && error == "" { entry.error = "来源未提供可用正文，当前保留" + evidence_summary_label(row) }
    analysis_articles.retain(|old| old.news_id != row.news_id) analysis_articles.push(entry)
    while analysis_articles.len() > tracking_config.max_candidates { analysis_articles.remove(0) }
    entry
}
fn evidence_retry_due(row){
    let old = analysis_article_find(row)
    old == nil || (old.paragraphs.len() == 0 && time_now() - old.retrieved_at >= tracking_config.evidence_retry_seconds)
}
fn evidence_local_body(row){ record_string(row["body_html"]) && row.body_html.trim() != "" }
fn evidence_summary_label(e){
    if record_string(e["summary"]) && e.summary.trim() != "" { return "标题与摘要" }
    "仅有标题"
}
// Preserve recall rank within each group. Dated schedule risks come first,
// then topic candidates missing a summary. All supplied RSS bodies are used
// without spending the two-request web budget.
fn evidence_select(rows, targets, explicit){
    let out = [] let ranked = [] let wants_content = targets.topics.len() > 0
    let date = regex("[0-9]{4}[-/年]") let places = []
    for schedule in targets.schedules { if record_string(schedule["location"]) && schedule.location.trim() != "" { places.push(regex(literal_pattern(schedule.location))) } }
    for row in rows {
        let priority = 3
        if explicit { priority = 0 }
        else {
            let text = row.title + " " + bm25_prefix(row.summary, tracking_config.max_bm25_body_chars)
            if places.len() > 0 && date.test(text) {
                for place in places { if place.test(text) { priority = 0 break } }
            }
            if priority == 3 && wants_content { priority = if row.summary.trim() == "" {1} else {2} }
        }
        if priority < 3 || evidence_local_body(row) { ranked.push({row: row priority: priority}) }
    }
    for pass in 4 { for item in ranked { if item.priority == pass { out.push(item.row) } } }
    out
}
fn evidence_enrich(rows, current, complete){
    evidence_generation = evidence_generation + 1
    let generation = evidence_generation
    evidence_work = {rows: rows current: current complete: complete generation: generation}
    let needs_fetch = false
    for row in rows { if (evidence_local_body(row) || article_url_allowed(row.source_url)) && evidence_retry_due(row) { needs_fetch = true } }
    // Even a cache hit gets a fresh execution slice for snapshot preparation.
    if !needs_fetch { start_timeout(0.01, || { if generation == evidence_generation && current() { complete() } }) return }
    start_timeout(0.01, || evidence_enrich_next(rows, 0, 0, generation, current, complete))
}
fn evidence_enrich_next(rows, index, fetched, generation, current, complete){
    if generation != evidence_generation || !current() { return }
    mod.gc.run()
    if index >= rows.len() { start_timeout(0.01, || { if generation == evidence_generation && current() { complete() } }) return }
    let row = rows[index]
    let local = evidence_local_body(row)
    if !evidence_retry_due(row) || (!local && (!article_url_allowed(row.source_url) || fetched >= tracking_config.max_evidence_requests)) {
        start_timeout(0.01, || evidence_enrich_next(rows, index + 1, fetched, generation, current, complete)) return
    }
    let done = false let received = false
    let next_fetched = fetched if !local { next_fetched = fetched + 1 }
    let timer = start_timeout(news_config.request_timeout_seconds, || {
        if done || generation != evidence_generation || !current() { return }
        // Schedule recovery before potentially expensive cache fingerprinting.
        done = true
        start_timeout(0.01, || evidence_enrich_next(rows, index + 1, next_fetched, generation, current, complete))
        analysis_article_store(row, nil, "正文读取或提取超时，当前保留" + evidence_summary_label(row))
    })
    let accept = fn(reply){
        if done || generation != evidence_generation || !current() { return }
        if received { return } received = true
        // Keep the timeout armed until extraction AND storage have finished.
        // A native VM budget bail cannot be caught by script try; marking the
        // request done first otherwise silences its only recovery callback.
        let extracted = nil let error = ""
        if reply.success {
            try {
                extracted = article_extract(reply.body, row.source_url)
                if local && extracted.paragraphs.len() == 0 {
                    let text = reading_feed_text(row.body_html)
                    if text != "" { extracted.paragraphs = [text] }
                }
                if local && row["body_truncated"] == true { extracted.truncated = true }
            } { error = "正文提取失败" }
        } else if reply["category"] == "verification" { error = "网站要求验证，正文未读取；可打开应用内原文核实" }
        else { error = "来源正文读取失败" }
        if extracted != nil { if extracted.paragraphs.len() == 0 { error = "来源未提供可提取的正文段落" } }
        analysis_article_store(row, extracted, error)
        done = true stop_timer(timer)
        start_timeout(0.01, || evidence_enrich_next(rows, index + 1, next_fetched, generation, current, complete))
    }
    if local { start_timeout(0.01, || accept({success: true body: "<article>" + row.body_html + "</article>"})) }
    else { article_http_request(row.source_url, 0, accept) }
}
fn evidence_attach(snapshot, rows){
    for e in snapshot.evidence {
        evidence_attach_entry(e, tracking_find(rows, "news_id", e.news_id))
    }
}
fn evidence_attach_entry(e, row){
    e.paragraphs = [] e.body_key = "" e.body_truncated = false e.body_error = "未读取正文，当前证据：" + evidence_summary_label(e)
    let article = analysis_article_find(row)
    if article == nil { return }
    e.body_key = article.body_key e.body_error = article.error e.body_truncated = article.truncated e.body_retrieved_at = article.retrieved_at
    let bytes = 0
    for paragraph in article.paragraphs {
        if e.paragraphs.len() >= 6 || bytes + paragraph.text.to_bytes().len() > 4000 { e.body_truncated = true break }
        e.paragraphs.push(paragraph) bytes = bytes + paragraph.text.to_bytes().len()
    }
}
// END src/data/ingestion/analysis_evidence.splash

