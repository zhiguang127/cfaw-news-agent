// BEGIN src/frontend/components/news_list.splash
// Keep unadmitted RSS thumbnails from aborting the whole list render.
fn news_thumbnail_allowed(row){ record_string(row["image_url"]) && article_image_allowed(row.image_url) }
let news_thumbnail_resource = |url| http_resource(url)
let NewsList = ScrollYView{width: Fill height: Fill flow: Down padding: Inset{left: 18 right: 18 top: 10 bottom: 24} spacing: 14 on_render: || {
    let featured_rows = []
    let image_rows = []
    let text_rows = []
    let ordered_rows = []
    if feed_page_offset >= display_rows.len() { feed_page_offset = 0 }
    for index row in display_rows {
        if index < feed_page_offset { continue }
        if index >= feed_page_offset + 40 { break }
        if page != "feed" { ordered_rows.push(row) }
        else if news_thumbnail_allowed(row) {
            if featured_rows.len() < 3 { featured_rows.push(row) }
            else { image_rows.push(row) }
        } else { text_rows.push(row) }
    }
    if featured_rows.len() > 0 {
        ScrollXView{width: Fill height: 228 flow: Right spacing: 12 padding: Inset{bottom: 4}
            for featured_index row in featured_rows {
                GestureView{width: 370 height: 220 on_tap: |x, y| open_story(row)
                    View{width: Fill height: Fill flow: Overlay
                        EditorialImage{width: Fill height: Fill src: news_thumbnail_resource(row.image_url) draw_bg +: {
                            radius: 20.0
                            pixel: fn(){
                                let sdf = Sdf2d.viewport(self.pos * self.rect_size)
                                let c = mix(self.get_color(), #x536076, self.async_load)
                                let shade = smoothstep(0.18, 1.0, self.pos.y) * 0.88
                                sdf.box(0.0, 0.0, self.rect_size.x, self.rect_size.y, self.radius)
                                sdf.fill(vec4(mix(c.xyz, vec3(0.035, 0.045, 0.07), shade), self.opacity))
                                return sdf.result
                            }
                        }}
                        View{width: Fill height: Fill flow: Down padding: 16 spacing: 7
                            RoundedView{width: Fit height: 24 flow: Right align: Align{x: 0.5 y: 0.5}
                                padding: Inset{left: 9 right: 9 top: 0 bottom: 0} show_bg: true draw_bg.color: #x7369c6d9 draw_bg.border_radius: 12.0
                                EditorialBadgeText{text: "今日精选" draw_text.color: white}
                            }
                            View{width: Fill height: Fill}
                            Text{text: row.title max_lines: 2 draw_text.color: white draw_text.text_style: theme.font_bold{font_size: 18 line_spacing: 1.15}}
                            Small{text: row.summary max_lines: 1 draw_text.color: #xe1e4ec draw_text.text_style.font_size: 11}
                            Small{text: news_meta(row) max_lines: 1 draw_text.color: #xc1c8d6 draw_text.text_style.font_size: 9}
                            View{width: Fill height: 6 flow: Right spacing: 5 align: Align{x: 0.5}
                                for dot in [0 1 2] {
                                    if dot < featured_rows.len() {
                                        RoundedView{width: 18 height: 3 show_bg: true draw_bg.border_radius: 1.5 draw_bg.color: if dot == featured_index { white } else { #xffffff55 }}
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    if page == "feed" {
        let context = feed_context_state()
        View{width: Fill height: Fit flow: Right spacing: 10 margin: Inset{top: 6 bottom: 10}
            GestureView{width: Fill height: 68 on_tap: |x,y| select_page("tracking")
                EditorialCard{height: Fill flow: Right padding: 12 spacing: 8 align: Align{y: 0.5} draw_bg.color: #xfafaff
                    EditorialIcon{draw_bg.kind: 1.0 draw_bg.tint: editorial_accent}
                    View{width: Fill height: Fit flow: Down spacing: 4
                        Section{text: "我的关注" draw_text.color: editorial_ink}
                        EditorialCaption{text: if context.topic_label != "" { context.topic_label } else { "添加你的关注" } max_lines: 1 draw_text.text_style.font_size: 10}
                    }
                    Label{text: "›" draw_text.color: editorial_muted draw_text.text_style.font_size: 18}
                }
            }
            GestureView{width: Fill height: 68 on_tap: |x,y| select_page("schedule")
                EditorialCard{height: Fill flow: Right padding: 12 spacing: 8 align: Align{y: 0.5} draw_bg.color: #xfffbfa
                    EditorialIcon{draw_bg.kind: 2.0 draw_bg.tint: #xc88a79}
                    View{width: Fill height: Fit flow: Down spacing: 4
                        Section{text: "今日日程" draw_text.color: editorial_ink}
                        EditorialCaption{text: if context.schedule_label != "" { context.schedule_label } else { "查看或添加安排" } max_lines: 1 draw_text.text_style.font_size: 10}
                    }
                    Label{text: "›" draw_text.color: editorial_muted draw_text.text_style.font_size: 18}
                }
            }
        }
    }
    if page == "feed" || page == "saved" {
        View{width: Fill height: 30 flow: Right align: Align{y: 0.5} spacing: 9
            RoundedView{width: 3 height: 16 show_bg: true draw_bg.color: editorial_accent draw_bg.border_radius: 1.5}
            Section{width: Fill text: if page == "saved" { "收藏文章" } else { "最新文章" } draw_text.color: editorial_ink draw_text.text_style.font_size: 16}
            EditorialCaption{width: Fit text: "共 " + display_rows.len() + " 条新闻"}
        }
    }
    for row in image_rows { ordered_rows.push(row) }
    for row in text_rows { ordered_rows.push(row) }
    for row in ordered_rows {
        let agent_hint = row_agent_hint(row)
        let cache_note = row_cache_note(row)
        let has_image = news_thumbnail_allowed(row)
        GestureView{width: Fill height: Fit flow: Down on_swipe: |dx, dy| feed_swipe_refresh(dx, dy)
            EditorialCard{
                View{width: Fill height: Fit flow: Right spacing: 7 align: Align{y: 0.5}
                    RoundedView{width: 22 height: 22 padding: 0 flow: Right show_bg: true draw_bg.color: soft draw_bg.border_radius: 11.0 align: Align{x: 0.5 y: 0.5}
                        EditorialBadgeText{text: news_avatar(row) draw_text.color: secondary draw_text.text_style: theme.font_bold{font_size: 10 line_spacing: 1.0}}
                    }
                    EditorialCaption{width: Fill text: news_meta(row) max_lines: 1}
                }
                if page == "tracking" {
                    Small{text: "关联关注：" + feed_follow_label(agent_hint) max_lines: 2 text_overflow: TextOverflow.Ellipsis draw_text.color: editorial_accent}
                }
                View{width: Fill height: Fit flow: Right spacing: 12 align: Align{y: 0.0}
                    View{width: Fill height: Fit flow: Down spacing: 7
                        GestureView{width: Fill height: Fit on_tap: |x, y| open_story(row) on_swipe: |dx, dy| feed_swipe_refresh(dx, dy)
                            EditorialTitle{text: row.title max_lines: 3}
                        }
                    }
                    if has_image {
                        EditorialImage{width: 112 height: 88 src: news_thumbnail_resource(row.image_url)}
                    }
                }
                if row.summary != "" { EditorialCaption{text: row.summary max_lines: 2 draw_text.text_style.font_size: 12 draw_text.text_style.line_spacing: 1.2} }
                if agent_hint != nil {
                    HintButton{height: 22 text: agent_hint.text + " ›" on_click: || open_feed_hint(row)}
                }
                if cache_note != "" { Small{text: cache_note max_lines: 2}}
                View{width: Fill height: 26 flow: Right spacing: 5 align: Align{y: 0.5}
                    EditorialTag{EditorialBadgeText{text: news_browse_label(row)}}
                    QuietButton{text: "关注话题" on_click: || follow_story(row)}
                    if records_is_bookmarked(row.news_id) { LinkButton{text: "已收藏" on_click: || toggle_save(row)} }
                    else { QuietButton{text: "收藏" on_click: || toggle_save(row)} }
                    View{width: Fill height: 1}
                    QuietButton{text: "查看" on_click: || open_story(row)}
                }
            }
        }
    }
    if display_rows.len() > 40 {
        ReaderCaption{text: "当前显示 " + (feed_page_offset + 1) + "–" + min(feed_page_offset + 40, display_rows.len()) + " / " + display_rows.len() + " 条"}
        View{width: Fill height: Fit flow: Right spacing: 10
            if feed_page_offset > 0 { previous_news_page := SecondaryButton{text: "上一页" on_click: || feed_page_step(-1)} }
            if feed_page_offset + 40 < display_rows.len() { next_news_page := SecondaryButton{text: "下一页" on_click: || feed_page_step(1)} }
        }
    }
}}
// END src/frontend/components/news_list.splash

// BEGIN src/frontend/components/weather_widget.splash
// Static SDF art keeps the weather glance visible without a continuous redraw
// loop. The native Makepad weather app's full Rust view is not bundled here.
let ForecastGlyph = View{width: 56 height: 56 show_bg: true
    draw_bg +: {
        condition: uniform(7.0)
        pixel: fn(){
            let sdf = Sdf2d.viewport(self.pos * self.rect_size)
            let w = self.rect_size.x
            let h = self.rect_size.y
            if self.condition < 1.5 {
                let sx = w * 0.44
                let sy = h * 0.38
                sdf.circle(sx, sy, w * 0.24) sdf.fill(#xffcf70)
                sdf.circle(sx, sy, w * 0.18) sdf.fill(#xffe6a6)
                sdf.box(sx - 1.0, h * 0.04, 2.0, h * 0.08, 1.0) sdf.fill(#xffe6a6)
                sdf.box(w * 0.07, sy - 1.0, w * 0.08, 2.0, 1.0) sdf.fill(#xffe6a6)
                sdf.box(w * 0.72, sy - 1.0, w * 0.08, 2.0, 1.0) sdf.fill(#xffe6a6)
            }
            if self.condition > 0.5 {
                sdf.circle(w * 0.32, h * 0.53, w * 0.17) sdf.fill(#xc9dcec)
                sdf.circle(w * 0.52, h * 0.42, w * 0.23) sdf.fill(#xf1f7fc)
                sdf.circle(w * 0.75, h * 0.54, w * 0.16) sdf.fill(#xe1edf6)
                sdf.box(w * 0.18, h * 0.53, w * 0.69, h * 0.14, h * 0.065) sdf.fill(#xe1edf6)
            }
            if self.condition > 2.5 && self.condition < 4.5 {
                sdf.box(w * 0.30, h * 0.74, w * 0.045, h * 0.16, w * 0.02) sdf.fill(#x8ed9ff)
                sdf.box(w * 0.50, h * 0.76, w * 0.045, h * 0.16, w * 0.02) sdf.fill(#x8ed9ff)
                sdf.box(w * 0.70, h * 0.74, w * 0.045, h * 0.16, w * 0.02) sdf.fill(#x8ed9ff)
            }
            if self.condition > 3.5 && self.condition < 4.5 {
                sdf.box(w * 0.52, h * 0.50, w * 0.07, h * 0.22, 1.0) sdf.fill(#xffda76)
            }
            if self.condition > 4.5 && self.condition < 5.5 {
                sdf.circle(w * 0.30, h * 0.82, w * 0.035) sdf.fill(#xffffff)
                sdf.circle(w * 0.51, h * 0.86, w * 0.035) sdf.fill(#xffffff)
                sdf.circle(w * 0.71, h * 0.82, w * 0.035) sdf.fill(#xffffff)
            }
            if self.condition > 5.5 {
                sdf.box(w * 0.22, h * 0.77, w * 0.57, 2.0, 1.0) sdf.fill(#xbccee1)
                sdf.box(w * 0.30, h * 0.87, w * 0.43, 2.0, 1.0) sdf.fill(#xbccee1)
            }
            return sdf.result
        }
    }
}
let ForecastSky = RoundedView{width: Fill height: Fit flow: Down show_bg: true
    draw_bg +: {
        border_radius: 16.0
        pixel: fn(){
            let sdf = Sdf2d.viewport(self.pos * self.rect_size)
            let glow = max(0.0, 1.0 - length(self.pos - vec2(0.84, 0.12)))
            let sky = mix(#x243d68, #x476e99, glow * 0.85)
            sdf.box(0.0, 0.0, self.rect_size.x, self.rect_size.y, self.border_radius)
            sdf.fill(sky)
            return sdf.result
        }
    }
}
// The header gets a compact, high-contrast glance while the forecast page
// keeps the larger condition illustration above.
let WeatherHeaderGlyph = View{width: 28 height: 28 show_bg: true
    draw_bg +: {
        condition: uniform(7.0)
        pixel: fn(){
            let sdf = Sdf2d.viewport(self.pos * self.rect_size)
            let w = self.rect_size.x
            let h = self.rect_size.y
            if self.condition < 1.5 {
                sdf.circle(w * 0.34, h * 0.48, w * 0.22) sdf.fill(#xffffd36a)
                sdf.circle(w * 0.70, h * 0.22, w * 0.045) sdf.fill(#xffffffc8)
                sdf.circle(w * 0.79, h * 0.42, w * 0.032) sdf.fill(#xffffff8c)
            }
            if self.condition > 0.5 {
                sdf.circle(w * 0.34, h * 0.56, w * 0.13) sdf.fill(#xc9dced)
                sdf.circle(w * 0.52, h * 0.48, w * 0.18) sdf.fill(#xf2f7fc)
                sdf.circle(w * 0.70, h * 0.57, w * 0.12) sdf.fill(#xdce9f5)
                sdf.box(w * 0.22, h * 0.55, w * 0.60, h * 0.13, h * 0.055) sdf.fill(#xdce9f5)
            }
            if self.condition > 2.5 && self.condition < 4.5 {
                sdf.box(w * 0.31, h * 0.75, w * 0.035, h * 0.14, w * 0.015) sdf.fill(#x8ed9ff)
                sdf.box(w * 0.50, h * 0.77, w * 0.035, h * 0.14, w * 0.015) sdf.fill(#x8ed9ff)
                sdf.box(w * 0.69, h * 0.75, w * 0.035, h * 0.14, w * 0.015) sdf.fill(#x8ed9ff)
            }
            if self.condition > 3.5 && self.condition < 4.5 {
                sdf.box(w * 0.51, h * 0.54, w * 0.055, h * 0.19, 1.0) sdf.fill(#xffffd36a)
            }
            if self.condition > 4.5 && self.condition < 5.5 {
                sdf.circle(w * 0.33, h * 0.82, w * 0.03) sdf.fill(#xffffff)
                sdf.circle(w * 0.52, h * 0.86, w * 0.03) sdf.fill(#xffffff)
                sdf.circle(w * 0.70, h * 0.82, w * 0.03) sdf.fill(#xffffff)
            }
            if self.condition > 5.5 {
                sdf.box(w * 0.22, h * 0.76, w * 0.58, 1.5, 1.0) sdf.fill(#xd2dfed)
                sdf.box(w * 0.30, h * 0.86, w * 0.43, 1.5, 1.0) sdf.fill(#xd2dfed)
            }
            return sdf.result
        }
    }
}
let WeatherHeaderSky = RoundedView{width: Fill height: Fill show_bg: true
    draw_bg +: {
        border_radius: 25.0
        pixel: fn(){
            let sdf = Sdf2d.viewport(self.pos * self.rect_size)
            let glow = clamp(1.0 - length((self.pos - vec2(0.88, 0.12)) * vec2(1.15, 1.6)), 0.0, 1.0)
            let sky = mix(#x29466f, #x466f9a, self.pos.x * 0.42 + glow * 0.28)
            sdf.box(0.0, 0.0, self.rect_size.x, self.rect_size.y, self.border_radius)
            sdf.fill(sky)
            return sdf.result
        }
    }
}
let WeatherHeaderWidget = View{width: 160 height: 50
    weather_header_content := View{width: Fill height: Fill on_render: || {
        let city = weather_primary_city()
        let today = weather_today()
        weather_header_hit := GestureView{width: Fill height: Fill on_tap: |x, y| show_weather()
            WeatherHeaderSky{flow: Right padding: Inset{left: 9 right: 10 top: 6 bottom: 6} spacing: 7 align: Align{y: 0.5}
                    WeatherHeaderGlyph{width: 28 height: 28 draw_bg.condition: weather_glyph_condition(today)}
                    View{width: Fill height: Fit flow: Down spacing: 2
                        if city != nil {
                            Small{height: Fit padding: 0 text: city.name + if today != nil {" · " + today.condition} else {""}
                                draw_text.color: #xc8d8ea max_lines: 1 text_overflow: TextOverflow.Ellipsis
                                draw_text.text_style.font_size: 9.5 draw_text.text_style.line_spacing: 1.0}
                            if today != nil {
                                Text{height: Fit padding: 0 text: weather_temperature(today.temp_min_c) + " / " + weather_temperature(today.temp_max_c)
                                    max_lines: 1 draw_text.color: white draw_text.text_style: theme.font_bold{font_size: 15 line_spacing: 1.0}}
                            } else { Small{height: Fit padding: 0 text: "查看预报 ›" draw_text.color: white max_lines: 1
                                draw_text.text_style.font_size: 10 draw_text.text_style.line_spacing: 1.0} }
                        } else {
                            Small{height: Fit padding: 0 text: "城市天气" draw_text.color: #xc8d8ea max_lines: 1
                                draw_text.text_style.font_size: 9.5 draw_text.text_style.line_spacing: 1.0}
                            Small{height: Fit padding: 0 text: "选择城市 ›" draw_text.color: white max_lines: 1
                                draw_text.text_style.font_size: 10 draw_text.text_style.line_spacing: 1.0}
                        }
                    }
            }
        }
    }}
}
// END src/frontend/components/weather_widget.splash

// BEGIN src/frontend/components/intent_orb.splash
// The assistant mark is decorative inside the intent space. The user-facing
// entry is the centered plus button in the bottom navigation.
let AIOrb = ButtonFlat{width: 72 height: 72 padding: 0 margin: 0 text: "AI"
    draw_text +: {color: white color_hover: white color_down: white text_style: theme.font_bold{font_size: 14}}
    draw_bg +: {
        pixel: fn(){
            let sdf = Sdf2d.viewport(self.pos * self.rect_size)
            let w = self.rect_size.x
            sdf.circle(w * 0.5, w * 0.53, w * 0.49) sdf.fill(#x6b69db18)
            sdf.circle(w * 0.5, w * 0.51, w * 0.43) sdf.fill(#x9aa8ee30)
            let glow = clamp(1.0 - length(self.pos - vec2(0.3, 0.24)) * 1.45, 0.0, 1.0)
            let body = mix(#x6250d8, #x5fbfe3, self.pos.x * 0.55 + (1.0 - self.pos.y) * 0.45)
            sdf.circle(w * 0.5, w * 0.47, w * (0.38 + self.hover * 0.02))
            sdf.fill(mix(body, #xf0f9ff, glow * glow * 0.7))
            sdf.circle(w * 0.5, w * 0.47, w * 0.37) sdf.stroke(#xffffff45, 1.0)
            return sdf.result
        }
    }
}
let IntentNavButton = ButtonFlat{width: 58 height: 58 padding: 0 margin: 0 text: ""
    label_walk: Walk{width: 0 height: 0} icon_walk: Walk{width: 0 height: 0}
    draw_bg +: {
        color: #x6655d8 color_hover: #x7566e4 color_down: #x5545c8 color_focus: #x7566e4
        pixel: fn(){
            let sdf = Sdf2d.viewport(self.pos * self.rect_size)
            let center = self.rect_size * 0.5
            let fill = self.color.mix(self.color_focus, self.focus).mix(self.color_hover, self.hover).mix(self.color_down, self.down)
            sdf.circle(center.x, center.y + 2.0, 27.0) sdf.fill(#x382e7a28)
            sdf.circle(center.x, center.y, 25.5) sdf.fill(fill)
            sdf.circle(center.x, center.y, 25.0) sdf.stroke(#xffffff52, 1.0)
            sdf.move_to(center.x - 8.0, center.y) sdf.line_to(center.x + 8.0, center.y) sdf.stroke(#xffffffff, 3.0)
            sdf.move_to(center.x, center.y - 8.0) sdf.line_to(center.x, center.y + 8.0) sdf.stroke(#xffffffff, 3.0)
            return sdf.result
        }
    }
}
let IntentBackdrop = View{width: Fill height: Fill show_bg: true
    draw_bg +: {
        pixel: fn(){
            let blue = clamp(1.0 - length((self.pos - vec2(0.88, 0.12)) * vec2(1.1, 1.5)), 0.0, 1.0)
            let mint = clamp(1.0 - length((self.pos - vec2(0.05, 0.72)) * vec2(1.4, 1.7)), 0.0, 1.0)
            return mix(mix(#xf8f9ff, #xe2e5ff, blue * 0.7), #xe1f3ef, mint * 0.48)
        }
    }
}
let IntentReveal = View{width: Fill height: Fill show_bg: true
    draw_bg +: {
        progress: uniform(0.0)
        origin_x: uniform(0.5)
        origin_y: uniform(1.0)
        pixel: fn(){
            let sdf = Sdf2d.viewport(self.pos * self.rect_size)
            let origin = vec2(36.0 + (self.rect_size.x - 72.0) * self.origin_x, 36.0 + (self.rect_size.y - 72.0) * self.origin_y)
            let radius = 28.0 + length(self.rect_size) * self.progress
            sdf.circle(origin.x, origin.y, radius + 14.0) sdf.fill(#x93a1ec22)
            sdf.circle(origin.x, origin.y, radius + 6.0) sdf.fill(#xa3b9ef45)
            sdf.circle(origin.x, origin.y, radius)
            let tint = mix(#x6577dc, #xf8f9ff, self.progress)
            sdf.fill(tint)
            return sdf.result
        }
    }
}
let IntentMode = QuietButton{width: Fill height: 38
    draw_bg +: {border_radius: 19.0 color: #xffffffb0 color_hover: white color_down: #xe1e7ff}
    draw_text +: {color: #x66718d color_hover: #x344775 color_down: #x344775 text_style +: {font_size: 12}}
}
let IntentModeActive = IntentMode{draw_bg +: {color: #x334e86 color_hover: #x3f5c97 color_down: #x2b4175}
    draw_text +: {color: white color_hover: white color_down: white}}
let IntentSend = Primary{width: Fill height: 48 draw_bg +: {border_radius: 24.0 color: #x425bd0 color_hover: #x536be0 color_down: #x344cb8}}
let IntentInput = Search{height: 118 is_multiline: true padding: Inset{left: 16 right: 16 top: 16 bottom: 16}
    draw_bg +: {border_radius: 16.0 color: #xffffffd0 color_hover: white color_focus: white color_empty: #xffffffd0
        border_size: 1.0 border_color: #xdde3f4 border_color_hover: #xc7d3ef border_color_focus: #x8c9de1 border_color_empty: #xdde3f4}
    draw_text +: {text_style +: {font_size: 14 line_spacing: 1.35} color_empty: #x8993aa color_empty_hover: #x8993aa}
}
// END src/frontend/components/intent_orb.splash

// BEGIN src/frontend/components/intent_panel.splash
let IntentPanel = View{width: Fill height: Fill flow: Down on_render: || {
    intent_content := ScrollYView{width: Fill height: Fill flow: Down padding: Inset{left: 24 right: 24 top: 12 bottom: 24} spacing: 14 on_render: || {
        if intent_draft != nil {
            let mode = intent_mode()
            if intent_draft.target_topic_id == nil {
                if mode != "schedule" { Small{text: "新建关注 · 确认后新增一条关注"} }
            } else {
                let target = topic_find(intent_draft.target_topic_id)
                if target != nil { Small{text: "正在修改关注：「" + target.title + "」"} }
                else { Small{text: "原关注已不存在"} }
                if !analysis_busy && intent_draft["understanding_edit"] == nil {
                    LinkButton{width: Fit text: "将这份输入作为新关注" on_click: || intent_as_new()}
                    if target != nil && target.status != "cancelled" && target.version != intent_draft.target_version {
                        Small{text: "原关注已更新，整理前请加载最新版本，或转为新关注。"}
                        LinkButton{width: Fit text: "加载原关注最新版本" on_click: || intent_reload_target()}
                    }
                }
            }
            if intent_draft.state != "ready" {
                View{width: Fill height: 80 align: Align{x: 0.5 y: 0.5}
                    AIOrb{width: 80 height: 80 enabled: false}
                }
                Heading{text: "想做什么，\n从这里开始。" draw_text.color: #x253657 draw_text.text_style.font_size: 28}
                Text{text: "一个想法、一份关注，或一段安排。\n说给我听，一起把它变成下一步。" draw_text.color: #x74829b draw_text.text_style.font_size: 13}
            } else if intent_draft["understanding_edit"] != nil {
                Heading{text: "修改待确认的理解。" draw_text.color: #x253657 draw_text.text_style.font_size: 25}
                Small{text: "应用修改后再核对预览，确认保存才会更新关注。"}
            } else {
                Heading{text: "为你整理好了。" draw_text.color: #x253657 draw_text.text_style.font_size: 25}
                Small{text: "看看理解是否准确，可编辑后再确认。"}
            }
            if intent_draft["understanding_edit"] == nil {
                View{width: Fill height: 38 flow: Right spacing: 7
                    if mode == "goal" { IntentModeActive{text: "我想做…" on_click: || intent_pick_mode("goal")} }
                    else { IntentMode{text: "我想做…" on_click: || intent_pick_mode("goal")} }
                    if mode == "news" { IntentModeActive{text: "关注新闻" on_click: || intent_pick_mode("news")} }
                    else { IntentMode{text: "关注新闻" on_click: || intent_pick_mode("news")} }
                    if intent_draft.target_topic_id == nil && intent_draft.origin_reminder_id == nil {
                        if mode == "schedule" { IntentModeActive{text: "安排日程" on_click: || intent_pick_mode("schedule")} }
                        else { IntentMode{text: "安排日程" on_click: || intent_pick_mode("schedule")} }
                    }
                }
                if mode == "goal" { Small{text: "围绕学习、消费或生活中的下一步决策追踪消息；保存为目标关注。"} }
                else if mode == "news" { Small{text: "持续了解一个话题，例如 Agent 新进展；保存为新闻关注。"} }
                else { Small{text: "保存有明确日期和时间的安排，新闻会结合这段日程检查影响。"} }
                let placeholder = "想关注什么新闻？有哪些内容想多看、少看？"
                if mode == "goal" { placeholder = "想做什么、为什么做？我会帮你关注相关的新消息。" }
                if mode == "schedule" { placeholder = "说说你的安排：日期、几点开始和结束、在哪里做什么。" }
                intent_input := IntentInput{text: intent_draft.original_input empty_text: placeholder on_change: |value| intent_changed(value, false)}
                if mode == "schedule" {
                    View{width: Fill height: 30 flow: Right spacing: 6 align: Align{y: 0.5}
                        Small{width: Fit text: "默认时区"}
                        if intent_draft["schedule_timezone"] == "Asia/Shanghai" { Pill{text: "北京时间" on_click: || intent_pick_timezone("Asia/Shanghai")} }
                        else { QuietButton{text: "北京时间" on_click: || intent_pick_timezone("Asia/Shanghai")} }
                        if intent_draft["schedule_timezone"] != "Asia/Shanghai" { Pill{text: "美国东部" on_click: || intent_pick_timezone("America/New_York")} }
                        else { QuietButton{text: "美国东部" on_click: || intent_pick_timezone("America/New_York")} }
                    }
                }
                if intent_draft.question != "" { Text{text: intent_draft.question draw_text.color: #x425bd0} }
                if intent_more {
                    IntentInput{height: 76 text: intent_draft.supplement empty_text: "继续补充，或回答 AI 的问题…" on_change: |value| intent_changed(value, true)}
                } else { LinkButton{width: Fit text: "+ 补充细节" on_click: || {intent_more = true intent_render()}} }
                if intent_draft.origin_reminder_id != nil { Small{text: "确认关注范围后保存；日程保持原安排。"} }
                if intent_guidance != "" && intent_draft.state != "ready" { Small{text: intent_guidance} }
            }
            if intent_error != "" && intent_draft["understanding_edit"] == nil { Text{text: intent_error max_lines: 4 draw_text.color: #x637399 draw_text.text_style.font_size: 12} }
            if intent_draft.state == "ready" {
                Box{draw_bg.color: #xffffffc8 draw_bg.border_radius: 16.0
                    Section{text: "待确认的理解" draw_text.color: #x425bd0}
                    if mode == "schedule" && intent_draft["schedule_understanding"] != nil {
                        let plan = intent_draft.schedule_understanding
                        Heading{text: plan.title draw_text.text_style.font_size: 18}
                        Text{text: schedule_display_time(plan.start, plan.timezone) + "\n→ " + schedule_display_time(plan.end, plan.timezone)}
                        Small{text: schedule_zone_label(plan.timezone)}
                        if plan.location != "" { Small{text: "地点 · " + plan.location} }
                        if plan.content != "" { Text{text: plan.content} }
                        if schedule_conflicts(plan, nil).len() > 0 { Small{text: "与已有日程重叠，请调整时间后重新整理。" draw_text.color: accent} }
                        IntentSend{text: "确认日程并保存" on_click: || intent_confirm()}
                    } else if intent_draft.understanding != nil {
                        if intent_draft["understanding_edit"] != nil {
                            View{width: Fill height: Fit flow: Down spacing: 9
                                let edit = intent_draft.understanding_edit
                                Section{text: "关注名称"}
                                IntentInput{height: 48 is_multiline: false padding: Inset{left: 12 right: 12 top: 10 bottom: 10}
                                    text: edit.title empty_text: "为这项关注命名" on_change: |value| intent_preview_changed("title", value)}
                                Section{text: "关注目的（可留空）"}
                                IntentInput{height: 82 text: edit.purpose empty_text: "希望了解什么，或帮助你做什么判断"
                                    on_change: |value| intent_preview_changed("purpose", value)}
                                Section{text: "关注范围 · 每行一项"}
                                IntentInput{height: 118 text: edit.scope_text empty_text: "例如：小米新品发布\n小米公司业务与经营动态"
                                    on_change: |value| intent_preview_changed("scope_text", value)}
                                Section{text: "偏好与限制 · 每行一项（可留空）"}
                                IntentInput{height: 100 text: edit.preferences empty_text: "想多看、少看哪些内容，有什么限制"
                                    on_change: |value| intent_preview_changed("preferences", value)}
                                Section{text: "检索关键词 · 每行一个"}
                                Small{text: "如修改关注对象，请同步调整关键词。关键词用于查找候选，相关新闻仍由 Agent 核对。"}
                                IntentInput{height: 92 text: edit.keywords empty_text: "例如：小米\nXiaomi"
                                    on_change: |value| intent_preview_changed("keywords", value)}
                                if edit.extra_rules.len() > 0 {
                                    Small{text: "扩展检索（可移除）"}
                                    for rule in edit.extra_rules {
                                        let kind = rule.kind let value = rule.value
                                        let label = "来源 · " + value
                                        if kind == "category" { label = "分类 · " + category_label(value) }
                                        View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
                                            Small{width: Fill text: label}
                                            LinkButton{width: Fit text: "移除" on_click: || intent_preview_remove_rule(kind, value)}
                                        }
                                    }
                                }
                                if intent_error != "" { Text{text: intent_error max_lines: 4 draw_text.color: #xb34949 draw_text.text_style.font_size: 12} }
                                IntentSend{text: "应用修改" on_click: || intent_preview_apply()}
                                LinkButton{width: Fill text: "放弃本次修改" on_click: || intent_preview_cancel()}
                            }
                        } else {
                            let idea = intent_draft.understanding
                            if !analysis_busy { LinkButton{width: Fit text: "编辑理解" on_click: || intent_preview_begin()} }
                            Heading{text: idea.title draw_text.text_style.font_size: 18}
                            if idea.purpose != "" { Text{text: idea.purpose} }
                            for scope_text in idea["scope"] { Text{text: "关注 · " + scope_text} }
                            for preference in idea.preferences { Small{text: "偏好 · " + preference} }
                            if intent_draft.target_topic_id != nil {
                                let old = topic_find(intent_draft.target_topic_id)
                                if old != nil { Small{text: "修改前 · " + old.title + "（版本 " + old.version + "）"} }
                            }
                            if mode == "goal" {
                                Small{text: "保存后收起面板，首页按目标关注优先展示相关消息；具体安排请用「安排日程」。"}
                                IntentSend{text: "确认目标关注并保存" on_click: || intent_confirm()}
                            } else {
                                Small{text: "保存后收起面板，首页按新关注排序。"}
                                IntentSend{text: "确认关注并保存" on_click: || intent_confirm()}
                            }
                        }
                    }
                }
            }
            if analysis_busy {
                SecondaryButton{text: "取消请求" on_click: || {intent_parse_pending = false analysis_cancel()}}
            } else if intent_draft["understanding_edit"] != nil {
                Small{text: "编辑内容尚未确认，取消时可保留草稿。"}
            } else if intent_draft.state == "ready" {
                LinkButton{width: Fit text: "重新整理" on_click: || intent_submit()}
            } else if intent_error != "" {
                IntentSend{text: "重试整理" on_click: || intent_submit()}
            } else {
                IntentSend{text: "整理我的想法 ↗" on_click: || intent_submit()}
            }
            View{width: Fill height: Fit flow: Right spacing: 8 align: Align{x: 0.5}
                QuietButton{text: "取消并保留草稿" on_click: || intent_cancel()}
                QuietButton{text: "丢弃草稿" on_click: || intent_discard()}
            }
            Small{text: "理解由 AI 整理，保存由你决定。" align: Align{x: 0.5} draw_text.color: #x8c97ac}
        }
    }}
}}
// END src/frontend/components/intent_panel.splash

// BEGIN src/frontend/pages/feed.splash
let FeedFilters = View{width: Fill height: Fit flow: Down
    categories := View{width: Fill height: 40 flow: Right padding: Inset{left: 18 right: 18 top: 4 bottom: 4} spacing: 5 on_render: || {
        for item in category_filters {
            if category == item.id { FilterActive{width: Fill height: 32 text: item.label draw_bg.color: #xeeecfc draw_bg.border_radius: 16.0 draw_text.color: editorial_accent on_click: || pick_category(item.id)} }
            else { Filter{width: Fill height: 32 text: item.label draw_text.color: editorial_muted on_click: || pick_category(item.id)} }
        }
    }}
}
// Keep the existing controller's visibility/render handles; the visual cards
// live inside the news scroll below the image recommendations.
let FeedContext = View{visible: false width: Fill height: 0
    feed_context_content := View{width: Fill height: 0 on_render: || {}}
}
// END src/frontend/pages/feed.splash

// BEGIN src/frontend/pages/tracking.splash
let TrackingEditor = View{visible: false width: Fill height: Fill flow: Down
    ScrollYView{width: Fill height: Fill flow: Down padding: 18 spacing: 12
        Heading{text: "关注你想持续了解的变化"}
        Small{text: "用自己的话说明目的、范围和偏好。确认理解后，新闻围绕你的意图展开。"}
        Primary{text: "表达关注 / 继续草稿" on_click: || intent_begin(nil)}
        continuous_controls := View{width: Fill height: Fit flow: Down spacing: 6 on_render: || {
        Section{text: "持续检查"}
        Small{text: "应用打开时按设定间隔检查，共用同一助手队列。关闭后不运行；当前宿主未提供后台唤醒或系统推送。"}
        if agent_preferences.paused { SecondaryButton{text: "恢复自动检查" on_click: || tracking_preferences_change(false, agent_preferences.important_only, agent_preferences.interval_seconds)} }
        else { SecondaryButton{text: "暂停自动检查" on_click: || tracking_preferences_change(true, agent_preferences.important_only, agent_preferences.interval_seconds)} }
        if agent_preferences.important_only { QuietButton{text: "提醒：仅重要变化（点击显示全部）" on_click: || tracking_preferences_change(agent_preferences.paused, false, agent_preferences.interval_seconds)} }
        else { QuietButton{text: "提醒：全部变化（点击只看重要）" on_click: || tracking_preferences_change(agent_preferences.paused, true, agent_preferences.interval_seconds)} }
        Small{text: "检查间隔：" + agent_preferences.interval_seconds / 60 + " 分钟"}
        View{width: Fill height: Fit flow: Right spacing: 6
            QuietButton{text: "5分钟" on_click: || tracking_preferences_change(agent_preferences.paused, agent_preferences.important_only, 300)}
            QuietButton{text: "15分钟" on_click: || tracking_preferences_change(agent_preferences.paused, agent_preferences.important_only, 900)}
            QuietButton{text: "60分钟" on_click: || tracking_preferences_change(agent_preferences.paused, agent_preferences.important_only, 3600)}
        }
        }}
        Section{text: "我的关注"}
        interest_list := View{width: Fill height: Fit flow: Down spacing: 4 on_render: || {
            let has_topics = false
            for topic in topic_records.topics { if topic_is_user_record(topic) && topic.status != "cancelled" { has_topics = true } }
            if user_interests.len() == 0 && !has_topics { Small{text: "尚未添加关注。可从新闻条目创建话题草稿，确认范围后保存。"} }
            for topic in topic_records.topics {
                if !topic_is_user_record(topic) || topic.status == "cancelled" { continue }
                Box{
                    Section{text: topic.title draw_text.color: accent}
                    if topic["demo_preset"] == true { Small{text: "演示预设 · 可修改、暂停或取消"} }
                    else if topic["intent_kind"] == "goal" { Small{text: "目标关注 · 围绕下一步决策追踪"} }
                    else { Small{text: "新闻关注 · 持续了解话题"} }
                    if topic.purpose != "" { Text{text: topic.purpose} }
                    Small{text: topic.original_input}
                    let status_label = "关注中" if topic.status == "paused" { status_label = "已暂停" }
                    Small{text: "版本 " + topic.version + " · " + status_label}
                    Small{text: target_check_label("topic", topic.topic_id, topic.version)}
                    for preference in topic.preferences { Small{text: "偏好：" + preference} }
                    View{width: Fill height: Fit flow: Right spacing: 8
                        QuietButton{text: "修改" on_click: || intent_begin(topic.topic_id)}
                        if topic.status == "active" { QuietButton{text: "暂停" on_click: || topic_toggle_pause(topic.topic_id, topic.version, "paused")} }
                        else { QuietButton{text: "恢复" on_click: || topic_toggle_pause(topic.topic_id, topic.version, "active")} }
                        QuietButton{text: "取消关注" on_click: || topic_toggle_pause(topic.topic_id, topic.version, "cancelled")}
                    }
                }
                Divider{}
            }
            for item in user_interests {
                View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 8
                    View{width: Fill height: Fit flow: Down spacing: 2
                        if item.kind == "category" { Text{text: category_label(item.value)} }
                        else { Text{text: item.value} }
                        if item.kind == "keyword" { Small{text: "已保存的关注词"} }
                        if item.kind == "source" { Small{text: "新闻发布方"} }
                        if item.kind == "category" { Small{text: "新闻源所属主题"} }
                    }
                    QuietButton{text: "取消关注" on_click: || remove_interest(item.interest_id)}
                }
                Divider{}
            }
        }}
    }
}
// END src/frontend/pages/tracking.splash

// BEGIN src/frontend/pages/follow_topics.splash
let FollowOverviewPage = View{width: Fill height: Fill flow: Down
    follow_toolbar := View{width: Fill height: Fit flow: Down padding: Inset{left: 20 right: 20 top: 20 bottom: 12} spacing: 8 on_render: || {
        View{width: Fill height: 34 flow: Right align: Align{y: 0.5} spacing: 8
            Heading{width: Fill text: "我的关注"}
            LinkButton{text: if topic_records.draft != nil {"添加 / 继续草稿"} else {"添加关注"} on_click: || intent_begin(nil)}
        }
        let changed = 0
        for card in follow_cards_view.active { if card.status == "new" || card.status == "verify" { changed = changed + 1 } }
        Small{text: "" + follow_cards_view.active.len() + " 个关注话题" + if changed > 0 {" · " + changed + " 项有进展或待核实"} else {" · 围绕你的关注汇总情况"}}
        View{width: Fill height: 38 flow: Right spacing: 8
            if follow_check_running || tracking_in_progress() { SecondaryButton{width: Fill height: 36 text: "停止检查" on_click: || follow_stop_checks()} }
            else { Primary{width: Fill height: 36 text: "检查更新" on_click: || follow_check_all()} }
            QuietButton{text: "检查设置" on_click: || manage_tracking()}
            if user_schedules.len() > 0 || suggestion_history.len() > 0 || schedule_actions.items.len() > 0 { QuietButton{text: "建议记录" on_click: || show_analysis_results()} }
        }
        if follow_check_progress() != "" { Small{text: follow_check_progress() draw_text.color: accent max_lines: 3} }
        if tracking_in_progress() { Small{text: tracking_message max_lines: 3} }
        if tracking_pending_run != nil && !tracking_in_progress() {
            Small{text: "新结果尚未保存，话题保留上次情况。" draw_text.color: accent}
            SecondaryButton{width: Fill text: "重试保存结果" on_click: || tracking_retry_save()}
        }
    }}
    ScrollYView{width: Fill height: Fill flow: Down padding: Inset{left: 18 right: 18 top: 4 bottom: 30}
        follow_overview_content := View{width: Fill height: Fit flow: Down spacing: 14 on_render: || {
            if follow_cards_view.active.len() == 0 {
                EditorialCard{
                    Section{text: "从一个你关心的话题开始" draw_text.text_style.font_size: 17}
                    Text{text: if follow_cards_view.paused.len() > 0 {"目前的关注都已暂停。可以恢复已有话题，也可以添加新的关注。"} else {"告诉我你想持续了解什么。保存后，这里会汇总目前情况与有依据的下一步建议。"}}
                    SecondaryButton{width: Fill text: "添加我的关注" on_click: || intent_begin(nil)}
                }
            }
            for card in follow_cards_view.active {
                EditorialCard{padding: 16 spacing: 10 draw_bg.border_radius: 18.0
                    View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
                        Section{width: Fill text: card.topic.title draw_text.text_style.font_size: 17 max_lines: 2}
                        EditorialTag{EditorialBadgeText{text: card.status_label}}
                    }
                    Small{text: follow_card_time(card) + if card.checked_at > 0 {" · 判断依据 " + card.news_count + " 篇"} else {""}}
                    if card.note != "" { Small{text: card.note max_lines: 3} }
                    Section{text: if follow_show_previous(card) {"上次情况"} else {"目前情况"} draw_text.color: editorial_accent}
                    for index situation in card.situations {
                        if index < 3 { Text{text: situation draw_text.text_style.font_size: 13 max_lines: 4} }
                    }
                    Divider{}
                    Section{text: follow_next_label(card) draw_text.color: editorial_accent}
                    if card.next_steps.len() > 0 { Text{text: card.next_steps[0] draw_text.text_style.font_size: 13 max_lines: 4} }
                    if card.next_steps.len() > 1 { Small{text: "另有 " + (card.next_steps.len() - 1) + " 项建议，可在话题详情查看。"} }
                    for decision in card.decision_notes { Small{text: decision draw_text.color: accent} }
                    View{width: Fill height: 36 flow: Right spacing: 8
                        SecondaryButton{width: Fill height: 34 text: "查看依据（" + card.news_count + "）" on_click: || follow_open_evidence(card.topic.topic_id)}
                        LinkButton{width: Fill height: 34 text: "话题详情" on_click: || follow_open_topic(card.topic.topic_id)}
                    }
                }
            }
            if follow_cards_view.paused.len() > 0 {
                LinkButton{width: Fill text: if follow_paused_open {"收起已暂停（" + follow_cards_view.paused.len() + "）"} else {"已暂停（" + follow_cards_view.paused.len() + "）"} on_click: || {follow_paused_open = !follow_paused_open follow_render()}}
                if follow_paused_open {
                    for card in follow_cards_view.paused {
                        EditorialCard{
                            Section{text: card.topic.title}
                            Small{text: "已暂停 · " + follow_card_time(card)}
                            View{width: Fill height: 34 flow: Right spacing: 8
                                LinkButton{width: Fill text: "查看最后情况" on_click: || follow_open_topic(card.topic.topic_id)}
                                SecondaryButton{width: Fill height: 34 text: "恢复关注" on_click: || follow_topic_status(card, "active")}
                            }
                        }
                    }
                }
            }
            if user_interests.len() > 0 { Small{text: "旧版关注规则仍保留，可在检查设置中管理；话题卡对应你确认保存的关注。"} }
        }}
    }
}
let FollowTopicPage = View{visible: false width: Fill height: Fill flow: Down
    View{width: Fill height: 46 flow: Right padding: Inset{left: 12 right: 18} align: Align{y: 0.5}
        QuietButton{text: "‹ 我的关注" on_click: || follow_back()}
        Small{text: "话题详情" align: Align{x: 1.0}}
    }
    ScrollYView{width: Fill height: Fill flow: Down padding: Inset{left: 18 right: 18 top: 8 bottom: 30}
        follow_topic_content := View{width: Fill height: Fit flow: Down spacing: 14 on_render: || {
            let card = follow_selected_card()
            if card == nil { Text{text: "这个关注已取消或改变，请返回我的关注。"} }
            else {
                Heading{text: card.topic.title}
                Small{text: card.status_label + " · " + follow_card_time(card) draw_text.color: accent}
                if card.note != "" { Small{text: card.note} }
                let trial = goal_schedule_reference(card)
                if trial != nil {
                    EditorialCard{
                        Section{text: "简单试用计划" draw_text.color: accent}
                        let saved = goal_schedule_saved(trial)
                        if saved != nil {
                            Text{text: saved.title}
                            Text{text: saved.content}
                            Small{text: "已导入我的日程 · " + schedule_display_time(saved.start, saved.timezone)}
                        } else {
                            Text{text: trial.plan.title + " · " + trial.plan.duration_minutes + " 分钟"}
                            Text{text: insight_prose(trial.run, trial.plan.content)}
                            let proposal = goal_schedule_proposal(trial)
                            if proposal.state == "ready" {
                                Small{text: "建议时段：" + schedule_display_time(proposal.plan.start, proposal.plan.timezone) + " → " + schedule_display_time(proposal.plan.end, proposal.plan.timezone)}
                                Small{text: "北京时间；待你确认，可修改。点击导入后保存到我的日程。"}
                                Primary{width: Fill text: "确认并导入日程" on_click: || goal_schedule_import(proposal)}
                                LinkButton{text: "修改时间" on_click: || goal_schedule_edit(proposal)}
                            } else if proposal.state == "preparing" { Small{text: "正在准备建议时段…"} }
                            else {
                                Small{text: proposal.error}
                                LinkButton{text: "修改时间" on_click: || goal_schedule_edit(proposal)}
                            }
                        }
                    }
                }
                if card.values.len() == 0 {
                    EditorialCard{
                        Section{text: "目前情况"}
                        for situation in card.situations { Text{text: situation} }
                        Section{text: "建议下一步"}
                        for step in card.next_steps { Text{text: step} }
                    }
                }
                for index value in card.values {
                    EditorialCard{
                        if card.values.len() > 1 { Small{text: "进展 " + (index + 1) + " / " + card.values.len()} }
                        Section{text: if follow_show_previous(card) {"上次保存的情况"} else {"目前情况"} draw_text.color: accent}
                        Text{text: results_situation(value)}
                        if value.insight.material_change != "" { Small{text: "与上次的区别：" + insight_prose(value.run, value.insight.material_change)} }
                        for uncertainty in value.insight.uncertainties { Small{text: "尚不清楚：" + insight_prose(value.run, uncertainty)} }
                        Divider{}
                        Section{text: if !card.current || value.state == "handled" || value.state == "dismissed" {"当时的建议"} else {follow_next_label(card)} draw_text.color: accent}
                        Text{text: follow_value_next(value)}
                        if value.state == "watch" { Small{text: "你的决定：继续观察" draw_text.color: accent} }
                        if value.state == "handled" { Small{text: "你的决定：已处理" draw_text.color: accent} }
                        if value.state == "dismissed" { Small{text: "你的决定：不采纳" draw_text.color: accent} }
                        LinkButton{text: "查看判断依据" on_click: || follow_open_evidence(card.topic.topic_id)}
                        if card.current && card.topic.status == "active" && value.state != "withdrawn" {
                            if insight_can_verify(value) && value.state != "handled" && value.state != "dismissed" {
                                SecondaryButton{width: Fill text: "补充正文并重新判断" on_click: || insight_verify(value)}
                            }
                            if value.insight["next_step"] != nil && value.insight.decision_effect == "review" && value.state != "handled" && value.state != "dismissed" {
                                LinkButton{text: "把核实安排到日程" on_click: || insight_plan_check(value)}
                            }
                            if value.state != "handled" && value.state != "dismissed" {
                                View{width: Fill height: 34 flow: Right spacing: 4
                                    if value.state != "watch" { QuietButton{width: Fill text: "继续观察" on_click: || follow_decide(value, "watch")} }
                                    QuietButton{width: Fill text: "已处理" on_click: || follow_decide(value, "handled")}
                                    QuietButton{width: Fill text: "不采纳" on_click: || follow_decide(value, "dismissed")}
                                }
                            }
                        } else if !card.current { Small{text: "以上为历史记录；重新检查后，才能依据当前情况记录新决定。"} }
                    }
                }
                EditorialCard{
                    Section{text: "我关注的范围"}
                    if card.topic.purpose != "" { Text{text: card.topic.purpose} }
                    for item in card.topic["scope"] { Small{text: "关注：" + item} }
                    for item in card.topic.preferences { Small{text: "偏好：" + item} }
                    View{width: Fill height: 36 flow: Right spacing: 8
                        LinkButton{width: Fill text: "修改关注" on_click: || intent_begin(card.topic.topic_id)}
                        if card.topic.status == "active" { QuietButton{width: Fill text: "暂停关注" on_click: || follow_topic_status(card, "paused")} }
                        else { LinkButton{width: Fill text: "恢复关注" on_click: || follow_topic_status(card, "active")} }
                    }
                    if card.topic.status == "active" && !tracking_in_progress() && !follow_check_running { SecondaryButton{width: Fill text: "单独检查这个话题" on_click: || follow_check_topic(card.topic.topic_id)} }
                    QuietButton{text: "取消关注" on_click: || follow_topic_status(card, "cancelled")}
                }
            }
        }}
    }
}
// END src/frontend/pages/follow_topics.splash

// BEGIN src/frontend/pages/follow_evidence.splash
// Render the precomputed saved-evidence presentation.
let FollowEvidencePage = View{visible: false width: Fill height: Fill flow: Down
    View{width: Fill height: 46 flow: Right padding: Inset{left: 12 right: 18} align: Align{y: 0.5}
        QuietButton{text: "‹ 返回" on_click: || follow_back()}
        Small{text: "判断依据" align: Align{x: 1.0}}
    }
    ScrollYView{width: Fill height: Fill flow: Down padding: Inset{left: 18 right: 18 top: 18 bottom: 36}
        follow_evidence_content := View{width: Fill height: Fit flow: Down spacing: 14 on_render: || {
            let card = follow_selected_card()
            if card == nil {
                Heading{text: "判断依据"}
                Small{text: "这个关注已变化或取消，请返回我的关注。"}
                SecondaryButton{text: "返回我的关注" on_click: || follow_back()}
            } else {
                Heading{text: "判断依据"}
                Section{text: card.topic.title draw_text.color: accent}
                if card.checked_at > 0 { Small{text: "判断时间：" + age_label(card.checked_at)} }
                if card.note != "" { Small{text: card.note draw_text.color: accent} }
                Small{text: "以下列出这项判断实际使用的报道。保存的摘要、正文片段与原句来自当时的证据版本。"}
                Section{text: "为什么这样判断"}
                for value in card.values {
                    Text{text: results_situation(value)}
                    for uncertainty in value.insight.uncertainties { Small{text: "判断限制：" + insight_prose(value.run, uncertainty)} }
                }
                if follow_evidence_rows.len() == 0 {
                    Box{
                        Section{text: "本轮没有可展开的新闻依据"}
                        Small{text: if card.no_related && card.current {"本轮候选检查已完成，但没有报道被确认为这个话题的新依据，因此未引用新闻。来源覆盖有限；可返回话题查看下一步，或刷新来源后再检查。"} else {if card.last_checked_at > 0 && card.checked_at == 0 {"已完成过检查，但当前没有可展开的分析详情；请单独重查这个话题。没有引用不代表外界没有相关消息。"} else {"尚未检查，或现有线索不足以支持判断。没有引用不代表外界没有相关消息。"}}}
                    }
                }
                for row in follow_evidence_rows {
                    Box{
                        Section{text: row.title draw_text.text_style.font_size: 16}
                        Small{text: row.metadata}
                        Small{text: row.relation draw_text.color: accent}
                        for block in row.blocks {
                            if block.kind == "heading" { Section{text: block.text} }
                            else if block.kind == "paragraph" { ReaderParagraph{text: block.text} }
                            else if block.kind == "text" { Text{text: block.text} }
                            else if block.kind == "divider" { Divider{} }
                            else { Small{text: block.text} }
                        }
                        Small{text: row.retrieved}
                        SecondaryButton{width: Fill text: "阅读报道与保存的段落" on_click: || follow_read_evidence(row.evidence)}
                    }
                }
                SecondaryButton{text: if follow_evidence_return == "topic" {"返回关注话题"} else {"返回我的关注"} on_click: || follow_back()}
            }
        }}
    }
}
// END src/frontend/pages/follow_evidence.splash

// BEGIN src/frontend/pages/bookmarks.splash
let BookmarksHeader = View{visible: false width: Fill height: Fit flow: Right padding: Inset{left: 18 right: 18 top: 8 bottom: 8}
    Small{width: Fill text: "你的收藏 · 可按分类与关键词筛选"}
    LinkButton{text: "返回我的" on_click: || select_page("account")}
}
// END src/frontend/pages/bookmarks.splash

// BEGIN src/frontend/pages/account.splash
let AccountPage = View{visible: false width: Fill height: Fill flow: Down
    ScrollYView{width: Fill height: Fill flow: Down padding: 20 spacing: 16
        Heading{text: "我的"}
        Small{text: "收藏与阅读偏好"}
        Box{
            Section{text: "我的收藏"}
            Small{text: "保存的新闻，可按分类和关键词查找。"}
            SecondaryButton{text: "查看收藏" on_click: || select_page("saved")}
        }
        Section{text: "设置"}
        Box{
            Section{text: "新闻来源与连接"}
            Small{text: "选择新闻来源，查看获取状态和助手连接诊断。"}
            SecondaryButton{text: "新闻来源" on_click: || show_settings()}
        }
    }
}
// END src/frontend/pages/account.splash

// BEGIN src/frontend/pages/schedule.splash
let SchedulePage = View{visible: false width: Fill height: Fill flow: Down
    ScrollYView{width: Fill height: Fill flow: Down padding: 20 spacing: 12
        Heading{text: "我的日程"}
        Small{text: "应用内日程；时间采用 24 小时制。"}
        if schedule_warning != "" { Small{text: schedule_warning draw_text.color: accent} }
        schedule_list := View{width: Fill height: Fit flow: Down spacing: 8 on_render: || {
            let has_schedules = false
            for item in user_schedules { if schedule_is_user_record(item) && item["status"] != "cancelled" { has_schedules = true } }
            if !has_schedules { Small{text: "暂无日程。添加安排后，Agent 可结合内容与地点分析影响。"} }
            for item in user_schedules {
                if !schedule_is_user_record(item) || item["status"] == "cancelled" { continue }
                View{width: Fill height: Fit flow: Down spacing: 3
                    Text{text: item.title}
                    if item["demo_preset"] == true { Small{text: "演示预设 · 可编辑或取消"} }
                    if record_string(item["content"]) && item.content != "" { Small{text: item.content} }
                    if record_string(item["location"]) && item.location != "" { Small{text: "地点：" + item.location} }
                    if item["time_precision"] == "day" {
                        Small{text: schedule_entry_parts(item.start, item.timezone).date + " · 具体时间待补充"}
                    } else { Small{text: schedule_display_time(item.start, item.timezone) + " → " + schedule_display_time(item.end, item.timezone)} }
                    Small{text: schedule_zone_label(item.timezone) + " · 24 小时制"}
                    Small{text: schedule_status_label(item)}
                    for reminder in schedule_weather_reminders(item) {
                        if reminder.origin == "Agent 建议" { Small{text: "Agent 建议：" + reminder.advice} }
                    }
                    Small{text: target_check_label("schedule", item.schedule_id, item.version)}
                    QuietButton{text: "核对行程与消息覆盖" on_click: || trip_review_begin(item.schedule_id)}
                    if trip_review_id == item.schedule_id {
                        Small{text: trip_review_question(item)}
                        Small{text: trip_review_coverage(item)}
                        for reminder in schedule_weather_reminders(item) {
                            Small{text: reminder.facts}
                            Small{text: "天气来源：Open-Meteo · 获取于 " + reminder.retrieved_label}
                            Small{text: reminder.limitation}
                        }
                        QuietButton{text: "编辑并确认补充" on_click: || schedule_begin_edit(item.schedule_id)}
                        QuietButton{text: "检查相关消息" on_click: || schedule_check_messages(item.schedule_id)}
                    }
                    QuietButton{text: "编辑" on_click: || schedule_begin_edit(item.schedule_id)}
                    if item["status"] != "cancelled" {
                        View{width: Fill height: Fit flow: Right spacing: 8
                            if schedule_active(item) { QuietButton{text: "标记完成" on_click: || schedule_change_status(item.schedule_id, item.version, "completed")} }
                            QuietButton{text: "取消日程" on_click: || schedule_change_status(item.schedule_id, item.version, "cancelled")}
                        }
                    }
                }
                Divider{}
            }
        }}
        Divider{}
        schedule_editor := View{width: Fill height: Fit flow: Down spacing: 7 on_render: || {
            if schedule_saved_view {
                Section{text: "日程已保存"}
                Small{text: "可在上方查看安排，或添加下一条日程。"}
                View{width: Fill height: Fit flow: Right spacing: 8
                    Primary{text: "添加另一条" on_click: || schedule_begin_new()}
                    QuietButton{text: "继续编辑" on_click: || schedule_begin_edit(schedule_edit_id)}
                }
            } else {
            if schedule_edit_id == nil { Section{text: "录入日程"} }
            else { Section{text: "编辑日程"} }
            Small{text: "日程标题"}
            Search{text: schedule_title_draft empty_text: "例如：项目讨论" on_change: |value| {schedule_title_draft = value}}
            Small{text: "日程内容"}
            Search{text: schedule_content_draft empty_text: "例如：讨论新闻 Agent 的演示方案" on_change: |value| {schedule_content_draft = value}}
            Small{text: "地点"}
            Search{text: schedule_location_draft empty_text: "例如：会议室 / 线上会议" on_change: |value| {schedule_location_draft = value}}
            Small{text: "时间标准（默认北京时间）"}
            View{width: Fill height: Fit flow: Right spacing: 6
                if schedule_timezone_draft == "Asia/Shanghai" { Pill{text: "✓ 北京时间" on_click: || schedule_pick_zone("Asia/Shanghai")} }
                else { QuietButton{text: "北京时间" on_click: || schedule_pick_zone("Asia/Shanghai")} }
                if schedule_timezone_draft == "America/New_York" { Pill{text: "✓ 美国东部" on_click: || schedule_pick_zone("America/New_York")} }
                else { QuietButton{text: "美国东部" on_click: || schedule_pick_zone("America/New_York")} }
            }
            if schedule_timezone_draft == "America/New_York" { Small{text: "纽约时间；自动处理夏令时。"} }
            Small{text: "日程日期"}
            View{width: Fill height: Fit flow: Right spacing: 8
                QuietButton{text: "今天" on_click: || schedule_pick_day(0)}
                QuietButton{text: "明天" on_click: || schedule_pick_day(1)}
                Search{width: Fill text: schedule_date_draft empty_text: "年-月-日" on_change: |value| {
                    schedule_date_draft = value schedule_custom_date = true
                    if !schedule_next_day { schedule_end_date_draft = value }
                    else if schedule_instant(value + "T00:00:00Z") != nil { schedule_end_date_draft = schedule_date_at(schedule_instant(value + "T00:00:00Z") + 86400) }
                }}
            }
            Small{text: "开始时间 · 24 小时制"}
            View{width: Fill height: Fit flow: Right spacing: 6 align: Align{y: 0.5}
                Search{width: 66 text: schedule_start_hour_draft empty_text: "0–23" on_change: |value| {schedule_start_hour_draft = value}}
                Small{width: Fit text: "时"}
                Search{width: 66 text: schedule_start_minute_draft empty_text: "0–59" on_change: |value| {schedule_start_minute_draft = value}}
                Small{width: Fit text: "分"}
            }
            Small{text: "预计结束时间 · 24 小时制"}
            View{width: Fill height: Fit flow: Right spacing: 6 align: Align{y: 0.5}
                Search{width: 66 text: schedule_end_hour_draft empty_text: "0–23" on_change: |value| {schedule_end_hour_draft = value}}
                Small{width: Fit text: "时"}
                Search{width: 66 text: schedule_end_minute_draft empty_text: "0–59" on_change: |value| {schedule_end_minute_draft = value}}
                Small{width: Fit text: "分"}
            }
            View{width: Fill height: Fit flow: Right spacing: 8
                if !schedule_next_day { Pill{text: "✓ 当日结束" on_click: || schedule_pick_end_day(false)} }
                else { QuietButton{text: "当日结束" on_click: || schedule_pick_end_day(false)} }
                if schedule_next_day { Pill{text: "✓ 次日结束" on_click: || schedule_pick_end_day(true)} }
                else { QuietButton{text: "次日结束" on_click: || schedule_pick_end_day(true)} }
            }
            if schedule_next_day { Search{text: schedule_end_date_draft empty_text: "结束日期：年-月-日" on_change: |value| {schedule_end_date_draft = value}} }
            if schedule_edit_error != "" { Small{text: schedule_edit_error draw_text.color: accent} }
            if schedule_allow_draft { Pill{text: "✓ 允许 Agent 提议改期" on_click: || {schedule_allow_draft = false ui.schedule_editor.render()}} }
            else { SecondaryButton{text: "允许 Agent 提议改期" on_click: || {schedule_allow_draft = true ui.schedule_editor.render()}} }
            Small{text: "Agent 可提议改期；保存变更前仍须你确认。"}
            View{width: Fill height: Fit flow: Right spacing: 8
                Primary{text: "保存日程" on_click: || schedule_save_draft()}
                if schedule_edit_id != nil { QuietButton{text: "新建" on_click: || schedule_begin_new()} }
            }
            }
        }}
    }
}
// END src/frontend/pages/schedule.splash

// BEGIN src/frontend/pages/detail.splash
let StoryContent = ScrollYView{width: Fill height: Fill flow: Down padding: Inset{left: 20 right: 20 top: 24 bottom: 40} align: Align{x: 0.5} on_render: || {
        if reading != nil {
            reader_column := View{width: Fill max_width: 720 height: Fit flow: Down spacing: 18
            ReaderCaption{text: news_meta(reading)}
            Heading{text: reading.title draw_text.text_style.font_size: 26 draw_text.text_style.line_spacing: 1.3}
            if page == "tracking" {
                let follow_label = feed_follow_label(row_agent_hint(reading))
                if follow_label != "" { ReaderCaption{text: "关联关注：" + follow_label draw_text.color: accent} }
            }
            if record_string(reading["publisher_byline"]) { reader_publisher_byline := ReaderCaption{text: "作者 · " + reading.publisher_byline} }
            if record_string(reading["publisher_license"]) { reader_publisher_license := ReaderCaption{text: reading.publisher_license} }
            if article_original_allowed(reading.source_url) {
                original_article := LinkButton{text: "打开图文原文" on_click: || open_original_article()
                    draw_text.color: accent draw_text.text_style.font_size: 14}
            }
            if reading.evidence_kind == "hn_submission" { Small{text: "HN 提交记录；提交时间不等于原文发布时间"} }
            else if article_state.state == "ready" { ReaderCaption{text: if article_state.origin == "publisher_rss" {"来源 RSS · 图文阅读模式"} else if article_state.origin == "publisher_atom" {"来源 Atom · 图文阅读模式"} else {"来源网页 · 图文阅读模式"} draw_text.color: accent} }
            else if reading.summary != "" { ReaderCaption{text: "来源提供的新闻摘要"} }
            Divider{}
            if insight_evidence_view != nil {
                if insight_evidence_view.news_id == reading.news_id {
                    let evidence = tracking_find(insight_evidence_view.value.run.snapshot.evidence, "news_id", reading.news_id)
                    Section{text: insight_basis_label(insight_evidence_view.value.insight, evidence)}
                    Small{text: "以下保留当时使用的证据版本；网页更新后的阅读正文可能不同。"}
                    let quoted = false
                    for ref in insight_evidence_view.value.insight.evidence_refs {
                        if ref.news_id == reading.news_id {
                            quoted = true
                            let p = tracking_find(evidence.paragraphs, "paragraph_id", ref.paragraph_id)
                            Text{text: ref.paragraph_id + " · " + p.text}
                            Small{text: "引用原句：" + ref.quote draw_text.color: accent}
                        }
                    }
                    if !quoted {
                        if evidence.paragraphs.len() == 0 { Small{text: evidence.body_error} Text{text: evidence.summary} }
                        else { for paragraph in evidence.paragraphs { Text{text: paragraph.text} } }
                    }
                    Small{text: "证据抓取：" + age_label(evidence.retrieved_at)}
                    Search{text: evidence.source_url}
                    Divider{}
                }
            }
            if !story_show_analysis {
            Section{text: "新闻摘要"}
            if reader_source_summary(reading) != "" {
                reader_source_summary_caption := ReaderCaption{text: "来源摘要"}
                reader_source_summary_text := ReaderParagraph{text: reader_source_summary(reading)}
            } else {
                if reader_summary.state == "ready" {
                    // Stable IDs prevent the running-state cancel Button from
                    // being reused as the generated paragraph's Label.
                    reader_agent_summary_caption := ReaderCaption{text: "Agent 摘要 · 根据已读取全文生成" draw_text.color: accent}
                    reader_agent_summary_text := ReaderParagraph{text: reader_summary.text}
                } else if reader_summary.state == "running" {
                    reader_summary_progress := Small{text: if reader_summary.chunks.len() == 0 {"正在准备全文摘要…"} else {"正在提取全文摘要 · " + min(reader_summary.index + 1, reader_summary.chunks.len()) + "/" + reader_summary.chunks.len()} draw_text.color: accent}
                    reader_summary_cancel_button := QuietButton{text: "取消摘要提取" on_click: || {reader_summary_cancel() reader_summary_render()}}
                } else {
                    reader_summary_empty := ReaderCaption{text: "来源未单独提供摘要，可由 Agent 读取全文后生成。"}
                    agent_summary_button := SecondaryButton{text: "Agent 摘要提取" on_click: || reader_summary_start()}
                }
                if reader_summary.error != "" { reader_summary_error := Small{text: reader_summary.error} }
            }
            Divider{}
            Section{text: "新闻正文"}
            if article_state.state == "loading" { Small{text: "正在读取来源网页正文…" draw_text.color: accent} }
            if article_state.error != "" { Small{text: article_state.error} }
            if article_state.state == "ready" {
                if article_state.blocks.len() > 0 {
                    for block in article_state.blocks {
                        if block.kind == "image" {
                            View{width: Fill height: Fit flow: Down spacing: 7
                                if block.state == "ready" { ReaderImage{src: block.resource} }
                                else { View{width: Fill height: Fit min_height: 100 padding: 14 flow: Down spacing: 8 show_bg: true draw_bg.color: soft align: Center
                                    if block.state == "loading" { ReaderCaption{width: Fit text: "正在加载原文配图…"} }
                                    else {
                                        ReaderCaption{width: Fill text: block.error}
                                        LinkButton{text: "重试配图" on_click: || article_retry_image(block, || ui.story_content.render())}
                                        LinkButton{text: "在应用内查看原图" on_click: || open_original_article()}
                                    }
                                } }
                                if block.text != "" { ReaderCaption{text: block.text} }
                            }
                        } else if block.kind == "heading" { ReaderHeading{text: block.text} }
                        else if block.kind == "list" { View{width: Fill height: Fit flow: Right spacing: 10
                            ReaderText{width: 14 text: "•"} ReaderText{text: block.text}
                        } }
                        else if block.kind == "quote" { View{width: Fill height: Fit padding: 14 show_bg: true draw_bg.color: soft
                            ReaderText{text: block.text draw_text.color: secondary}
                        } }
                        else if block.kind == "caption" { ReaderCaption{text: block.text} }
                        else { ReaderParagraph{text: block.text} }
                    }
                } else { for paragraph in article_state.paragraphs { ReaderParagraph{text: paragraph} } }
                if article_state.truncated { ReaderCaption{text: "阅读模式展示部分内容；完整文章请打开图文原文。"} }
            } else {
            ReaderText{text: "正文暂不可用，可打开图文原文继续阅读。" draw_text.color: secondary}
            }
            Small{text: "新闻列表抓取于 " + age_label(reading.retrieved_at)}
            ReaderCaption{text: "原文地址（可复制）"}
            Search{text: reading.source_url empty_text: "可复制原文地址"}
            if article_state.state == "failed" || (article_state.state == "unavailable" && article_url_allowed(reading.source_url)) {
                LinkButton{text: "重试读取正文" on_click: || article_load(reading, || ui.story_content.render())}
            }
            if news_source(reading.source_id) != nil {
                Small{text: "抓取来源：" + news_source(reading.source_id).label}
                if news_source(reading.source_id).kind == "google" { Small{text: "通过 Google News 聚合；条目可能保留聚合跳转链接。"} }
            }
            if reading.references.len() > 1 {
                Small{text: "相同链接已合并；重复收录不代表独立证据。"}
                for ref in reading.references { Small{text: ref.source + " · " + ref.source_id} }
            }
            }
            Divider{}
            View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
                Section{width: Fill text: "✦ 这条新闻会影响我吗？" draw_text.color: accent}
                if story_show_analysis { LinkButton{text: "阅读新闻" on_click: || {story_show_analysis = false ui.story_content.render()}} }
                else { LinkButton{text: "展开分析" on_click: || {story_show_analysis = true ui.story_content.render()}} }
            }
            if story_show_analysis {
            Divider{}
            Section{text: "追踪关系与日程提醒"}
            let tracked = tracking_latest_item(reading)
            if tracked == nil {
                Small{text: "尚无当前有效的 Agent 追踪结果；旧结果可能已过期。"}
            } else {
                Text{text: tracked.item.why_related}
                let relevance_label = "关系尚不确定"
                if tracked.item.relevance == "related" { relevance_label = "关注相关" }
                if tracked.item.relevance == "unrelated" { relevance_label = "与关注无关" }
                Small{text: relevance_label + " · 检查于 " + age_label(tracked.run.checked_at)}
                Text{text: tracked.run.result.explanation}
                for uncertainty in tracked.item.uncertainties { Small{text: "不确定性：" + uncertainty} }
                for reminder in tracking_item_reminders(tracked) {
                    let schedule = schedule_find(reminder.schedule_id)
                    Section{text: "可能影响日程「" + schedule.title + "」" draw_text.color: accent}
                    Text{text: reminder.impact_summary}
                    Small{text: "时段依据：" + reminder.overlap_reason}
                    Small{text: schedule_display_time(schedule.start, schedule.timezone) + " → " + schedule_display_time(schedule.end, schedule.timezone)}
                    for uncertainty in reminder.uncertainties { Small{text: "不确定性：" + uncertainty} }
                    if reminder.material_change != "" { Small{text: "变化：" + reminder.material_change} }
                    View{width: Fill height: Fit flow: Right spacing: 8
                        SecondaryButton{text: "忽略提醒" on_click: || tracking_dismiss(reminder.reminder_id)}
                        SecondaryButton{text: "关注这类信息" on_click: || intent_follow_reminder(reminder.reminder_id)}
                    }
                }
                for impact in tracked.item.schedule_impacts {
                    let reminder = tracking_reminder(tracked.item, impact, tracked.run)
                    if tracking_reminder_suppressed(reminder) { Small{text: "已记录决定：相同证据不重复提醒"} }
                }
                Small{text: "未覆盖目标 " + tracked.run.snapshot.omitted_targets + " · 候选 " + tracked.run.snapshot.omitted_candidates}
                Section{text: "判断所用依据（标题 / 摘要）"}
                for id in tracked.item.evidence_ids {
                    let evidence = tracking_find(tracked.run.snapshot.evidence, "news_id", id)
                    Small{text: evidence.title}
                    Small{text: evidence.source_url}
                    if evidence.published_at == nil { Small{text: "发布日期未知"} }
                    if evidence.summary_truncated { Small{text: "摘要已缩减；未读取全文"} }
                }
            }
            Divider{}
            Section{text: "分析检查"}
            Small{text: "本轮检查关注关系及已有日程影响；提醒不修改日程。"}
            agent_status := Small{text: analysis_status_for_news(reading.news_id)}
            let saved_suggestions = []
            for suggestion in history_suggestions_for_news(reading.news_id) {
                if suggestion.state == "pending" || suggestion.state == "needs_review" { saved_suggestions.push(suggestion) }
            }
            if saved_suggestions.len() > 0 {
                Divider{}
                Section{text: "分析与建议"}
                if saved_suggestions.len() > 30 { Small{text: "显示30条待处理建议；其余待处理项可从菜单的分析与建议入口打开。"} }
                for i saved in saved_suggestions {
                    if i >= saved_suggestions.len() - 30 || saved.suggestion_id == suggestion_focus_id {
                    Small{text: history_state_label(saved.state)}
                    Text{text: saved.change_summary}
                    Text{text: saved.rationale}
                    for uncertainty in saved.uncertainties { Small{text: "不确定性：" + uncertainty} }
                    if saved.proposed_action != nil {
                        if saved.proposed_action.kind == "create" { Small{text: "建议新增安排：" + saved.proposed_action.title} }
                        else { Small{text: "建议调整时间：" + saved.proposed_action.title} }
                        Small{text: schedule_display_time(saved.proposed_action.start, saved.proposed_action.timezone) + " → " + schedule_display_time(saved.proposed_action.end, saved.proposed_action.timezone)}
                    }
                    if saved.state == "pending" {
                        View{width: Fill height: Fit flow: Right spacing: 8
                            SecondaryButton{text: "接受" on_click: || update_suggestion_state(saved.suggestion_id, "accepted")}
                            SecondaryButton{text: "忽略" on_click: || update_suggestion_state(saved.suggestion_id, "dismissed")}
                            SecondaryButton{text: "撤回" on_click: || update_suggestion_state(saved.suggestion_id, "withdrawn")}
                        }
                    }
                    if saved.state == "needs_review" {
                        Small{text: "最新证据不足，接受已暂停；请重新分析。"}
                        SecondaryButton{text: "忽略" on_click: || update_suggestion_state(saved.suggestion_id, "dismissed")}
                    }
                    if schedule_confirmation_id == saved.suggestion_id {
                        Section{text: "用户确认 · 日程写入预览"}
                        Small{text: "确认时重新读取日程版本并检查时间冲突；失败不会将建议标记为已接受。"}
                        if saved.proposed_action == nil { Small{text: "此建议没有日程动作；确认仅记录你的决定。"} }
                        else {
                            if saved.proposed_action.kind == "reschedule" {
                                let current = schedule_find(saved.proposed_action.schedule_id)
                                if current != nil { Small{text: "当前安排：" + current.title} Small{text: schedule_display_time(current.start, current.timezone) + " → " + schedule_display_time(current.end, current.timezone)} }
                            }
                            let collisions = schedule_conflicts(saved.proposed_action, saved.proposed_action.schedule_id)
                            if collisions.len() > 0 { Small{text: "当前时间冲突：" + change_join(collisions) draw_text.color: accent} }
                        }
                        View{width: Fill height: Fit flow: Right spacing: 8
                            Primary{text: "确认并保存" on_click: || schedule_confirm()}
                            QuietButton{text: "取消" on_click: || schedule_cancel_confirm()}
                        }
                    }
                    }
                }
            }
            View{width: Fill height: Fit flow: Right spacing: 10
                if tracking_in_progress() { SecondaryButton{text: "取消分析" on_click: || analysis_cancel()} }
                else { SecondaryButton{text: "分析影响" on_click: || analysis_start(reading)} }
            }
            }
            View{width: Fill height: Fit flow: Right spacing: 10
                SecondaryButton{text: "关注话题" on_click: || follow_story(reading)}
                if records_is_bookmarked(reading.news_id) { SecondaryButton{text: "已收藏" on_click: || toggle_save(reading)} }
                else { SecondaryButton{text: "收藏" on_click: || toggle_save(reading)} }
            }
            }
        }
    }}
let StoryPage = View{visible: false width: Fill height: Fill flow: Down
    story_content := StoryContent{}
    on_render: || { story_content := StoryContent{} }
}
// END src/frontend/pages/detail.splash

// BEGIN src/frontend/pages/results.splash
fn results_pending_page(offset){ results_pending_offset = offset ui.results_content.render() }
let AnalysisResultsPage = View{visible: false width: Fill height: Fill flow: Down
    View{width: Fill height: 38 flow: Right padding: Inset{left: 12 right: 18} align: Align{y: 0.5}
        QuietButton{text: "‹ 我的关注" on_click: || select_page("tracking")}
        Small{text: "建议记录与待确认事项" align: Align{x: 1.0}}
    }
    results_content := View{width: Fill height: Fill flow: Down spacing: 0 on_render: || {
        let board = results_board()
        View{width: Fill height: Fit flow: Down padding: Inset{left: 20 right: 20 top: 16 bottom: 12} spacing: 8
            Heading{text: if board.counts.todo > 0 {"有 " + board.counts.todo + " 项需要你决定"} else if board.values.len() > 0 {"本轮暂不新增行动"} else {"让新闻变成下一步"}}
            if results_feedback != "" { Small{text: results_feedback draw_text.color: accent} }
            else { Small{text: "先了解相关新闻与当前情况，再决定下一步。"} }
            if tracking_in_progress() {
                Small{text: tracking_message draw_text.color: accent max_lines: 3}
                QuietButton{text: "停止检查" on_click: || analysis_cancel()}
            } else if tracking_pending_run != nil {
                Small{text: "本轮结果尚未保存，请先重试。" draw_text.color: accent}
                SecondaryButton{text: "重试保存结果" on_click: || tracking_retry_save()}
            } else if !analysis_has_focus() {
                SecondaryButton{text: "添加我的目标" on_click: || intent_begin(nil)}
            } else {
                View{width: Fill height: 30 flow: Right spacing: 8
                    QuietButton{text: "重新检查关注与日程" on_click: || {results_feedback = "" tracking_start(nil)}}
                    LinkButton{text: "表达新目标" on_click: || intent_begin(nil)}
                }
            }
            View{width: Fill height: 36 flow: Right spacing: 6
                if results_tab == "todo" { FilterActive{text: "待办 " + board.counts.todo on_click: || results_select("todo")} }
                else { Filter{text: "待办 " + board.counts.todo on_click: || results_select("todo")} }
                if results_tab == "watch" { FilterActive{text: "观察 " + board.counts.watch on_click: || results_select("watch")} }
                else { Filter{text: "观察 " + board.counts.watch on_click: || results_select("watch")} }
                if results_tab == "record" { FilterActive{text: "记录 " + board.counts.record on_click: || results_select("record")} }
                else { Filter{text: "记录 " + board.counts.record on_click: || results_select("record")} }
            }
        }
        Divider{}
        results_cards := ScrollYView{width: Fill height: Fill flow: Down padding: 20 spacing: 14
            if tracking_status == "failed" || tracking_status == "stale" || tracking_status == "no_candidates" || tracking_status == "cancelled" {
                Small{text: tracking_message draw_text.color: accent}
                Small{text: "检查未得到新判断；下方保留最近一次仍有效的结果。"}
            }
            if analysis_state == "failed" || analysis_needs_reopen {
                Small{text: analysis_error_hint() draw_text.color: accent}
                QuietButton{text: "查看具体原因" on_click: || {results_show_error_detail = !results_show_error_detail ui.results_content.render()}}
                if results_show_error_detail { Small{text: analysis_error} }
            }
            if history_dirty {
                Small{text: "新闻分析结果尚未完整保存。" draw_text.color: accent}
                SecondaryButton{text: "重试保存" on_click: || retry_analysis_save()}
            }
            if analysis_history_warning != "" { Small{text: analysis_history_warning draw_text.color: accent} }
            if results_count(board) == 0 {
                if results_tab == "todo" {
                    Section{text: "暂时没有需要处理的建议"}
                    Small{text: if board.values.len() > 0 {"可在观察中查看本轮判断，在记录中查看你的决定。"} else {"先保存一个关注或日程，再检查相关新闻。没有证据时不会生成行动建议。"}}
                } else if results_tab == "watch" { Small{text: "暂无观察项。待办中的建议可以选择继续观察。"} }
                else { Small{text: "还没有本轮有效判断的决定记录。处理待办后，决定会显示在这里。"} }
            }
            if reschedule_preview != nil {
                let s = tracking_find(reschedule_preview.run.snapshot.schedules, "schedule_id", reschedule_preview.insight.target_id)
                let p = reschedule_preview.insight.reschedule
                Box{
                    Section{text: "确认应用内改期"}
                    Text{text: "原安排：" + schedule_display_time(s.start, s.timezone) + " → " + schedule_display_time(s.end, s.timezone)}
                    Text{text: "新安排：" + schedule_display_time(p.start, s.timezone) + " → " + schedule_display_time(p.end, s.timezone)}
                    Small{text: p.reason}
                    for uncertainty in reschedule_preview.insight.uncertainties { Small{text: "未知项：" + uncertainty} }
                    for ref in p.evidence_refs { Text{text: ref.paragraph_id + "：" + ref.quote} }
                    Primary{width: Fill text: "确认并保存改期" on_click: || reschedule_confirm()}
                    SecondaryButton{width: Fill text: "继续原计划并记录决定" on_click: || reschedule_keep_original()}
                    QuietButton{text: "取消提案" on_click: || {reschedule_preview = nil ui.results_content.render()}}
                }
            }
            for value in board.values {
                if results_group(value) != results_tab { continue }
                let expanded = results_expanded[results_key(value)] == true
                let news = results_news(value)
                Box{
                    Section{text: value.title}
                    Small{text: results_heading(value) + " · " + age_label(value.run.checked_at) draw_text.color: accent}
                    Section{text: "相关新闻"}
                    Small{text: "本轮检查 " + value.run.snapshot.evidence.len() + " 篇候选，筛选出 " + news.len() + " 篇相关或待核实报道；仅覆盖当前来源。" max_lines: 4}
                    if news.len() == 0 { Text{text: "本期未找到与此目标有关的报道，不代表没有产品进展。"} }
                    for i row in news {
                        if i >= 3 && !expanded { continue }
                        Text{text: row.evidence.title}
                        Small{text: if row.relevance == "uncertain" {"关联待核实 · " + evidence_summary_label(row.evidence)} else {evidence_summary_label(row.evidence)} max_lines: 4}
                    }
                    if news.len() > 3 && !expanded { Small{text: "展开判断依据可查看其余 " + (news.len() - 3) + " 篇报道。"} }
                    Section{text: "当前情况"}
                    Text{text: results_situation(value)}
                    if value.insight.change_kind == "unchanged" { Text{text: "本轮没有确认新增实质依据，保留已有判断。"} }
                    if news.len() == 0 {
                        let previous = insight_comparison(value)
                        if previous != nil {
                            Small{text: "上次已知情况 · " + age_label(previous.checked_at) + " · 本轮未重新证实" max_lines: 3}
                            Text{text: insight_prose(previous.run, previous.insight.summary)}
                        }
                    }
                    for uncertainty in value.insight.uncertainties { Text{text: "尚不清楚：" + insight_prose(value.run, uncertainty)} }
                    Divider{}
                    Section{text: if results_tab == "todo" {"建议下一步"} else if results_tab == "watch" {"现在怎么做"} else {"你的决定"}}
                    Text{text: results_next_step(value)}
                    if results_tab == "todo" {
                        if value.state == "withdrawn" {
                            Small{text: insight_prose(value.run, value.insight.summary)}
                            Primary{width: Fill text: if expanded {"收起撤回依据"} else {"查看撤回依据"} on_click: || results_toggle(value)}
                        } else if insight_can_verify(value) {
                            Small{text: "相关来源尚缺正文；补充后再判断是否适合你。"}
                            Primary{width: Fill text: "补充正文并重新判断" on_click: || insight_verify(value)}
                        } else if value.insight["reschedule"] != nil {
                            Primary{width: Fill text: "预览改期提案" on_click: || reschedule_begin(value)}
                        } else {
                            Primary{width: Fill text: if expanded {"收起判断依据"} else {"查看判断依据"} on_click: || results_toggle(value)}
                        }
                    }
                    if value.state != "withdrawn" && (results_tab != "todo" || insight_can_verify(value) || value.insight["reschedule"] != nil) {
                        QuietButton{text: if expanded {"收起判断依据"} else {"查看判断依据"} on_click: || results_toggle(value)}
                    }
                    if expanded {
                        Divider{}
                        Section{text: "判断依据与上次对照"}
                        if record_string(value.insight["material_change"]) && value.insight.material_change != "" {
                            Small{text: "改变判断的新事实：" + insight_prose(value.run, value.insight.material_change)}
                        }
                        let goal = insight_goal(value)
                        if goal != nil {
                            Small{text: "对应我的目标：" + goal.purpose}
                            for preference in goal.preferences { Small{text: "约束与偏好：" + preference} }
                        }
                        let comparison = insight_comparison(value)
                        if comparison != nil && news.len() > 0 {
                            Small{text: "上次判断 · " + age_label(comparison.checked_at)}
                            Text{text: insight_prose(comparison.run, comparison.insight.summary)}
                        } else if comparison == nil && (value.insight.change_kind == "updated" || value.insight.change_kind == "withdrawn") {
                            Small{text: "此前判断不在保留记录中，无法展示完整对照。"}
                        }
                        if value.insight.change_kind == "unchanged" { Small{text: "本轮没有新增实质依据；保留你已有的决定。"} }
                        if value.insight.evidence_ids.len() == 0 { Small{text: "本轮没有可展开的来源引用。"} }
                        for e in results_cited_news(value) {
                            let id = e.news_id
                            Section{text: "来源：" + e.title}
                            Small{text: insight_basis_label(value.insight, e)}
                            if e.paragraphs.len() == 0 { Small{text: e.body_error} }
                            else if e.body_truncated { Small{text: "正文证据已截取部分段落"} }
                            if record_array(value.insight["evidence_refs"]) {
                                for ref in value.insight.evidence_refs { if ref.news_id == id { Text{text: ref.quote} } }
                            }
                            SecondaryButton{width: Fill text: "查看来源与引用段落" on_click: || insight_open_evidence(value, id)}
                        }
                        if results_tab == "todo" && value.state != "withdrawn" && value.insight["next_step"] != nil {
                            SecondaryButton{width: Fill text: "把核实安排到日程" on_click: || insight_plan_check(value)}
                        }
                        if value.state != "withdrawn" && value.insight["reschedule"] != nil && insight_can_verify(value) {
                            SecondaryButton{width: Fill text: "预览改期提案" on_click: || reschedule_begin(value)}
                        }
                    }
                    if results_tab != "record" && value.state != "withdrawn" {
                        Divider{}
                        Small{text: "这条建议对你有用吗？"}
                        View{width: Fill height: 32 flow: Right spacing: 4
                            if value.state != "watch" { QuietButton{text: "继续观察" on_click: || results_decide(value, "watch")} }
                            QuietButton{text: "已处理" on_click: || results_decide(value, "handled")}
                            QuietButton{text: "不采纳" on_click: || results_decide(value, "dismissed")}
                        }
                    }
                }
            }
            if results_tab == "todo" {
                for a in schedule_actions.items {
                    if a.state != "prepared" { continue }
                    Section{text: "待完成的改期"}
                    Small{text: a.original.title + " · " + schedule_action_state_label(a.state)}
                    Small{text: "原：" + schedule_display_time(a.original.start, a.original.timezone) + " → " + schedule_display_time(a.original.end, a.original.timezone)}
                    Small{text: "新：" + schedule_display_time(a.start, a.original.timezone) + " → " + schedule_display_time(a.end, a.original.timezone)}
                    SecondaryButton{text: "恢复已确认的改期记录" on_click: || {notice(reschedule_resume(a.action_id)) tracking_ui_update()}}
                }
                let reminders = board.reminders
                if reminders.len() > 0 { Section{text: "日程影响提醒"} }
                for reminder in reminders {
                    let schedule = schedule_find(reminder.schedule_id)
                    Text{text: "可能影响日程「" + schedule.title + "」：" + reminder.impact_summary}
                    SecondaryButton{text: "查看提醒依据" on_click: || open_story(tracking_current_row(reminder.news_id))}
                }
                if results_pending_count() > 0 {
                    Section{text: "单篇新闻的待确认建议"}
                    let pending = 0
                    for item in suggestion_history {
                        if item.state != "pending" && item.state != "needs_review" { continue }
                        pending = pending + 1
                        if pending > results_pending_offset && pending <= results_pending_offset + 20 {
                            Small{text: history_state_label(item.state)}
                            Text{text: item.change_summary}
                            SecondaryButton{text: "查看证据与建议" on_click: || open_suggestion_record(item.suggestion_id)}
                        }
                    }
                    if results_pending_offset > 0 { SecondaryButton{text: "上一页建议" on_click: || results_pending_page(max(0, results_pending_offset - 20))} }
                    if pending > results_pending_offset + 20 { SecondaryButton{text: "下一页建议" on_click: || results_pending_page(results_pending_offset + 20)} }
                }
            }
        }
    }}
}
// END src/frontend/pages/results.splash

// BEGIN src/frontend/pages/settings.splash
let SourcesPage = View{visible: false width: Fill height: Fill flow: Down
    ScrollYView{width: Fill height: Fill flow: Down padding: 18 spacing: 12
        Heading{text: "选择新闻来源"}
        Small{text: "来源不可用时，已有缓存继续可读。"}
        source_list := View{width: Fill height: Fit flow: Down spacing: 8 on_render: || {
            for source in news_sources {
                View{width: Fill height: Fit flow: Down spacing: 4
                    View{width: Fill height: 30 flow: Right align: Align{y: 0.5} spacing: 6
                        Section{width: Fill text: source.label}
                        if source_enabled(source.id) { LinkButton{text: "已启用" on_click: || toggle_source(source.id)} }
                        else { QuietButton{text: "启用" on_click: || toggle_source(source.id)} }
                    }
                    Small{text: category_label(source.category) + " · " + source.language}
                    Small{text: source_status_text(source)}
                    Divider{}
                }
            }
        }}
        QuietButton{text: "连接诊断" on_click: || { settings_show_diagnostics = !settings_show_diagnostics ui.diagnostics_controls.render() }}
        diagnostics_controls := View{width: Fill height: Fit flow: Down spacing: 8 on_render: || {
            if settings_show_diagnostics {
                Section{text: "分析服务连接"}
                Small{text: "新闻详情和跟踪页可发起分析。此测试仅检查连接，不分析新闻或日程。"}
                SecondaryButton{text: "测试连接" on_click: || test_octos()}
                octos_status := Text{text: octos_message}
            }
        }}
    }
}
// END src/frontend/pages/settings.splash

// BEGIN src/frontend/pages/weather.splash
// Compact city/forecast layout inspired by Makepad apps/weather's resident
// forecast and locations sheet. Native WeatherView is not registered in Rinx;
// this page uses the widgets already available to the script application.
let WeatherPage = View{visible: false width: Fill height: Fill flow: Down
    ScrollYView{width: Fill height: Fill flow: Down padding: 18 spacing: 14
        weather_content := View{width: Fill height: Fit flow: Down spacing: 14 on_render: || {
            let city = weather_primary_city()
            let today = weather_today()
            if city != nil {
                ForecastSky{padding: 18 spacing: 9
                    View{width: Fill height: Fit flow: Right align: Align{y: 0.5}
                        Heading{width: Fill text: city.name draw_text.color: white}
                        Small{width: Fit text: "今日预报" draw_text.color: #xd7e3f3}
                    }
                    if today != nil {
                        View{width: Fill height: 90 flow: Right align: Align{y: 0.5} spacing: 10
                            View{width: Fill height: Fit flow: Down spacing: 8
                                Text{text: today.condition draw_text.color: white draw_text.text_style.font_size: 19}
                                Text{text: weather_temperature(today.temp_min_c) + " / " + weather_temperature(today.temp_max_c)
                                    draw_text.color: white draw_text.text_style.font_size: 32}
                            }
                            ForecastGlyph{width: 80 height: 80 draw_bg.condition: weather_glyph_condition(today)}
                        }
                        Small{text: "最低 / 最高 · 降水 " + today.precipitation_mm + " mm" draw_text.color: #xd7e3f3}
                    } else { Text{text: "今日预报暂不可用" draw_text.color: white} }
                }
            } else {
                Heading{text: "你关心哪里的天气？"}
            }
            Small{text: weather_app_status()}
            if !weather_app_ready { Small{text: "正在恢复城市设置…"} }
            View{width: Fill height: Fit flow: Right spacing: 8
                SecondaryButton{text: "选择城市" on_click: || { weather_picker_open = !weather_picker_open weather_render() }}
                if city != nil { SecondaryButton{text: "更新预报" on_click: || weather_update_selected()} }
            }
            if weather_picker_open {
                Box{
                    Section{text: "城市"}
                    View{width: Fill height: 32 flow: Right spacing: 6 align: Align{y: 0.5}
                        Search{empty_text: "输入城市名称" text: weather_city_query on_change: |text| { weather_city_query = text }}
                        LinkButton{text: "使用城市" on_click: || weather_choose_name()}
                    }
                    let cities = weather_cities
                    for group in 10 {
                        if group * 3 < cities.len() {
                            View{width: Fill height: 32 flow: Right spacing: 4
                                for column in 3 {
                                    let index = group * 3 + column
                                    if index < cities.len() {
                                        let item = cities[index]
                                        if city != nil && city.cid == item.cid { NavActive{height: 30 text: item.name on_click: || weather_choose_city(item.cid)} }
                                        else { Nav{height: 30 text: item.name on_click: || weather_choose_city(item.cid)} }
                                    } else { View{width: Fill height: 30} }
                                }
                            }
                        }
                    }
                }
            }
            if city != nil {
                Section{text: "逐日预报"}
                for row in weather_app_rows() {
                    View{width: Fill height: Fit flow: Down spacing: 5
                        View{width: Fill height: 26 flow: Right align: Align{y: 0.5} spacing: 8
                            Section{width: 48 text: weather_day_label(row.day) draw_text.text_style.font_size: 11}
                            Text{width: Fill text: row.condition draw_text.text_style.font_size: 13}
                            Text{width: Fit text: weather_temperature(row.temp_min_c) + " / " + weather_temperature(row.temp_max_c)
                                draw_text.text_style.font_size: 13}
                        }
                        Small{text: row.day + " · 降水 " + row.precipitation_mm + " mm"}
                        Divider{}
                    }
                }
                if weather_app_rows().len() == 0 { Small{text: "暂无有效日期的预报；旧日期不会显示为今天。"} }
            }
            if weather_tracked.len() > 0 {
                Section{text: "已保存的城市"}
                for cid in weather_tracked {
                    let saved_city = weather_city_by_cid(cid)
                    if saved_city != nil {
                        View{width: Fill height: 32 flow: Right align: Align{y: 0.5}
                            LinkButton{width: Fill align: Align{x: 0.0} text: saved_city.name on_click: || weather_choose_city(cid)}
                            QuietButton{text: "移除" on_click: || weather_remove_city(cid)}
                        }
                    }
                }
            }
            if weather_warning != "" { Small{text: weather_warning draw_text.color: #xa54c3c} }
            Small{text: "数据：Open-Meteo · CC BY 4.0。展示逐日预报，不是实时温度。日期使用北京时间。"}
        }}
    }
}
// END src/frontend/pages/weather.splash

