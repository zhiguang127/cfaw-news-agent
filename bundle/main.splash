// Derived from OctoSense apps/news, commit d1596d739e187c689ada4b59093ca8086c23bbbe.
// CFAW modifications: Rinx callbacks/timeouts, feed-summary reader and Octos connectivity probe.
// Licensed under Apache-2.0; see repository LICENSE and NOTICE.
let sources = [
    {id: "hn" label: "Hacker News" kind: "hn" url: "https://hn.algolia.com/api/v1/search?tags=front_page&hitsPerPage=30"}
    {id: "techmeme" label: "TechMeme" kind: "digest" url: "https://www.techmeme.com/feed.xml"}
    {id: "google" label: "Google News" kind: "google" url: "https://news.google.com/rss?hl=en-US&gl=US&ceid=US:en"}
]
let tabs = [
    {id: "today" label: "Today"}
    {id: "hn" label: "HN"}
    {id: "techmeme" label: "TechMeme"}
    {id: "google" label: "Google"}
    {id: "saved" label: "Saved"}
]
let rows_by = {hn: [] techmeme: [] google: []}
let failed_by = {hn: false techmeme: false google: false}
let saved = []
let tab = "today"
let query = ""
let busy = false
let updated = 0
let reading = nil
let octos_testing = false
let octos_timeout_seconds = 90

// Uses the assistant selected in Rinx, never a model endpoint or app-owned key.
fn test_octos(){
    if octos_testing { return }
    if !host.has("octos.session.open") || !host.has("octos.turn.start") || !host.has("octos.turn.interrupt") {
        ui.octos_status.set_text("Octos permissions missing. Review the updated bundle and run it again.")
        return
    }
    octos_testing = true
    ui.octos_status.set_text("Opening Octos context...")
    let done = false
    let timer = start_timeout(octos_timeout_seconds, || {
        if done { return }
        done = true
        ui.octos_status.set_text("Octos timed out after 90 seconds. Stopping request...")
        let stopping = true
        let stop_timer_id = start_timeout(10, || {
            if stopping {
                ui.octos_status.set_text("Octos timed out; stop was not acknowledged. Close and reopen this app before retrying.")
            }
        })
        host.request("octos.turn.interrupt", {}, fn(stopped){
            if !stopping { return }
            stopping = false
            stop_timer(stop_timer_id)
            if stopped.is_ok {
                octos_testing = false
                ui.octos_status.set_text("Octos timed out; request stopped. Check the host/model connection, then retry.")
            } else {
                ui.octos_status.set_text("Octos timed out; close and reopen this app. Stop error: " + stopped.error)
            }
        })
    })
    host.request("octos.session.open", {}, fn(opened){
        if done { return }
        if !opened.is_ok {
            done = true
            stop_timer(timer)
            octos_testing = false
            ui.octos_status.set_text("Octos context failed: " + opened.error)
            return
        }
        ui.octos_status.set_text("Context opened. Waiting for a real model reply...")
        host.request("octos.turn.start", {text: "Connectivity test. Do not use tools. Reply with only OCTOS_OK."}, fn(reply){
            if done { return }
            done = true
            stop_timer(timer)
            octos_testing = false
            if !reply.is_ok {
                ui.octos_status.set_text("Octos model request failed: " + reply.error)
            } else if reply.data == nil || reply.data.text == nil || reply.data.text == "" {
                ui.octos_status.set_text("Octos returned no model text; connectivity is not confirmed.")
            } else {
                ui.octos_status.set_text("Octos replied: " + reply.data.text)
            }
        })
    })
}
// Where stories come from: the host's `news` service when this shell offers
// it (it fetches on a timer and keeps the stories, so News opens from its
// cache), else this script's own fetch, as in shells without the service.
// TODO(App-Hub#18): the shells register the service, but manifest.json does
// not request `news` yet: App Hub's pinned admission does not know the
// capability. Add it once App Hub is repinned past OctoSense-App-Hub#18.
let use_service = false
let service_waiting = 0
let service_relist = false
let months = ["January" "February" "March" "April" "May" "June" "July" "August" "September" "October" "November" "December"]
let days = ["Sunday" "Monday" "Tuesday" "Wednesday" "Thursday" "Friday" "Saturday"]
let specials = ["\\" "." "*" "+" "?" "(" ")" "[" "]" "{" "}" "|" "^" "$"]

// CFAW Rinx adapter: bounded callbacks avoid the pending await path in this host.
fn request_feed(url, callback){
    let done = false
    let timer = start_timeout(18, || { if !done { done = true callback(nil) } })
    net.http_request(net.HttpRequest{url: url method: net.HttpMethod.GET headers: {"User-Agent": "OctoSense-News/1.0"}}) do net.HttpEvents{
        on_response: |r| { if !done { done = true stop_timer(timer) callback(r) } }
        on_error: |_e| { if !done { done = true stop_timer(timer) callback(nil) } }
    }
}

// Hacker News through Algolia: one page with points, comments and times.
fn hn_rows(body){
    let out = []
    let data = body.parse_json()
    if data == nil || data.hits == nil { return out }
    for hit in data.hits {
        if hit.title == nil || hit.title == "" { continue }
        let discussion = "https://news.ycombinator.com/item?id=" + hit.objectID
        let link = discussion
        if hit.url != nil && hit.url != "" { link = hit.url }
        let published = 0
        if hit.created_at_i != nil { published = hit.created_at_i }
        out.push({title: hit.title link: link source: "Hacker News" published: published summary: ""
            image: "" discussion: discussion points: hit.points comments: hit.num_comments})
    }
    out
}

// RSS or Atom, in the same row shape as Hacker News's.
fn feed_rows(body, s){
    let items = body.parse_feed(s.kind)
    if items == nil { return nil }
    let out = []
    for it in items {
        let source = it.source
        if source == "" { source = s.label }
        out.push({title: it.title link: it.link source: source published: it.published summary: it.summary
            image: it.image discussion: "" points: nil comments: nil})
    }
    out
}

fn accept_source(s, res){
    failed_by[s.id] = true
    if res == nil || res.status_code != 200 || res.body == nil { return }
    if res.body.len() > 2000000 { return }
    let rows = nil
    try {
        let body = res.body.to_string()
        if s.kind == "hn" { rows = hn_rows(body) } else { rows = feed_rows(body, s) }
    } { rows = nil }
    if rows == nil { return }
    let limited = []
    for r in rows { if limited.len() < 30 { limited.push(r) } }
    rows_by[s.id] = limited
    failed_by[s.id] = false
    updated = time_now()
    try { fs.write("cache_" + s.id + ".json", limited.to_json()) } { }
}

fn load_next(index){
    if index >= sources.len() {
        busy = false
        sync_status()
        ui.list.render()
        ui.tile_list.render()
        return
    }
    let s = sources[index]
    request_feed(s.url, fn(res){
        accept_source(s, res)
        ui.list.render()
        ui.tile_list.render()
        sync_status()
        load_next(index + 1)
    })
}

fn refresh(){
    if busy { return }
    if use_service { refresh_service(); return }
    busy = true
    sync_status()
    load_next(0)
}

// A story as the news service keeps it, in this script's row shape.
fn service_row(it){
    let image = ""
    if it.image != nil { image = it.image }
    let discussion = ""
    if it.discussion != nil { discussion = it.discussion }
    let row = {title: it.title link: it.url source: it.source published: it.published summary: it.summary
        image: image discussion: discussion points: it.points comments: it.comments}
    row
}

// Each tab shows exactly its source's latest fetch, in the source's order.
fn list_service(){
    service_waiting = sources.len()
    for s in sources {
        host.request("news.list", {feed: s.id current: true limit: 30}, fn(r){
            if r.is_ok {
                let rows = []
                for it in r.data.items { rows.push(service_row(it)) }
                if rows.len() > 0 {
                    rows_by[s.id] = rows
                    fs.write("cache_" + s.id + ".json", rows.to_json())
                }
                failed_by[s.id] = r.data.feed_error != nil
                if r.data.updated > updated { updated = r.data.updated }
            } else {
                // Granted but not answered (no service registered): fetch here.
                use_service = false
            }
            service_waiting = service_waiting - 1
            if service_waiting == 0 { listed_service() }
        })
    }
}

fn listed_service(){
    busy = false
    if !use_service {
        refresh()
        return
    }
    ui.list.render()
    sync_status()
    ui.tile_list.render()
    if service_relist {
        service_relist = false
        busy = true
        list_service()
    }
}

// Show what the service has now, ask it to fetch what is due, then show that.
fn refresh_service(){
    busy = true
    sync_status()
    list_service()
    host.request("news.refresh", {}, fn(r){
        if !use_service { return }
        if busy { service_relist = true }
        else {
            busy = true
            list_service()
        }
    })
}

fn load_state(){
    if fs.exists("saved.json") {
        let v = fs.read("saved.json").parse_json()
        if v != nil { saved = v }
    }
    for s in sources {
        let path = "cache_" + s.id + ".json"
        if fs.exists(path) {
            let v = fs.read(path).parse_json()
            if v != nil { rows_by[s.id] = v }
        }
    }
}

// All: the first row of each source, then the second, and so on, so every
// source keeps its own ranking and none floods the list.
fn today_rows(){
    let out = []
    for i in 30 {
        for s in sources {
            let rows = rows_by[s.id]
            if i < rows.len() { out.push(rows[i]) }
        }
    }
    out
}

fn escape(text){
    let out = text
    for c in specials { out = out.replace(c, "\\" + c) }
    out
}

fn visible_rows(){
    let rows = []
    if tab == "today" { rows = today_rows() }
    else if tab == "saved" { rows = saved }
    else { rows = rows_by[tab] }
    if query == "" { return rows }
    let re = regex(escape(query), "i")
    let out = []
    for r in rows {
        if re.test(r.title) || re.test(r.summary) || re.test(r.source) { out.push(r) }
    }
    out
}

fn ago(secs){
    if secs == nil || secs <= 0 { return "" }
    let d = time_now() - secs
    if d < 60 { return "now" }
    if d < 3600 { return "" + floor(d / 60) + "m" }
    if d < 86400 { return "" + floor(d / 3600) + "h" }
    "" + floor(d / 86400) + "d"
}

fn meta(r){
    let line = r.source
    let a = ago(r.published)
    if a != "" { line = line + "  ·  " + a }
    if r.points != nil { line = line + "  ·  " + r.points + " points" }
    if r.comments != nil { line = line + "  ·  " + r.comments + " comments" }
    line
}

fn date_line(){
    let t = local_time()
    days[t.weekday] + ", " + months[t.month - 1] + " " + t.day
}

fn sync_status(){
    let text = ""
    if busy { text = "Updating…" }
    else if tab != "today" && tab != "saved" && failed_by[tab] && rows_by[tab].len() == 0 {
        text = "Couldn't load this source. Pull the refresh button to try again."
    }
    else if updated > 0 { text = "Updated " + ago(updated) + " ago" }
    if text == "Updated now ago" { text = "Updated just now" }
    if !use_service {
        let counts = ""
        for s in sources {
            if counts != "" { counts = counts + " · " }
            counts = counts + s.label + ": " + rows_by[s.id].len()
            if failed_by[s.id] { counts = counts + " (request failed; cached if any)" }
        }
        if text != "" { text = text + "\n" }
        text = text + counts
    }
    ui.status.set_text(text)
}

fn pick(id){
    tab = id
    ui.tabbar.render()
    ui.list.render()
    sync_status()
}

fn set_query(text){
    query = ("" + text).trim()
    ui.list.render()
}

fn is_saved(link){
    for s in saved { if s.link == link { return true } }
    false
}

fn toggle_save(r){
    if is_saved(r.link) { saved.retain(|s| s.link != r.link) } else { saved.push(r) }
    fs.write("saved.json", saved.to_json())
    sync_reader_bar()
    if tab == "saved" { ui.list.render() }
}

fn sync_reader_bar(){
    if reading == nil { return }
    if is_saved(reading.link) { ui.save.set_text("Saved") } else { ui.save.set_text("Save") }
}

// This Linux Rinx build has no embedded browser implementation. Keep the
// official reader toolbar, show the actual feed excerpt and copyable source.
fn open_story(r){
    reading = r
    ui.reader_title.set_text(r.source)
    ui.reader_fail.set_text("Feed excerpt only. Copy the source URL to read the original in a browser.")
    sync_reader_bar()
    ui.comments.set_visible(r.discussion != "" && r.discussion != r.link)
    ui.reader_pane.set_visible(true)
    ui.main.set_visible(false)
    ui.reader_content.render()
}

fn open_comments(){
    if reading != nil && reading.discussion != "" {
        ui.reader_url.set_text(reading.discussion)
        ui.reader_fail.set_text("Discussion URL shown below; copy it to your browser.")
    }
}

fn close_story(){
    ui.main.set_visible(true)
    ui.reader_pane.set_visible(false)
    reading = nil
}

fn empty_text(){
    if tab == "saved" { return "Long-press a story, or tap Save while reading, to keep it here." }
    if query != "" { return "No stories match." }
    "No stories yet."
}

fn boot(){
    ui.date.set_text(date_line())
    load_state()
    ui.tabbar.render()
    ui.list.render()
    ui.tile_list.render()
    use_service = host.has("news")
    refresh()
}
start_timeout(0.05, || boot())
start_interval(900, || refresh())

let ink = #x1c1c1e
let secondary = #x8e8e93
let accent = #xe0245e
let ground = #xf2f2f7

let TabButton = ButtonFlat{height: 32 padding: Inset{left: 11 right: 11}
    draw_bg +: {border_radius: 16.0 color: #x00000000 color_hover: #x0000000a color_down: #x00000014 border_size: 0.0}
    draw_text +: {color: #x3a3a3c color_hover: #x3a3a3c color_down: #x3a3a3c text_style +: {font_size: 13}}
}
let TabButtonActive = TabButton{
    draw_bg +: {color: #x1c1c1e color_hover: #x1c1c1e color_down: #x3a3a3c}
    draw_text +: {color: #xffffff color_hover: #xffffff color_down: #xffffff}
}
let BarButton = ButtonFlat{height: 36 padding: Inset{left: 10 right: 10}
    draw_bg +: {color: #x00000000 color_hover: #x0000000a color_down: #x00000014 border_size: 0.0}
    draw_text +: {color: accent color_hover: accent color_down: accent text_style +: {font_size: 15}}
}

let StoryHead = View{width: Fill height: Fit flow: Down spacing: 4
    meta := Label{width: Fill text: "" max_lines: 1 draw_text.color: secondary draw_text.text_style.font_size: 11}
    title := Label{width: Fill text: "" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 16}}
}
let StoryText = StoryHead{
    summary := Label{width: Fill text: "" max_lines: 2 draw_text.color: #x3a3a3c draw_text.text_style.font_size: 13}
}
let StoryCard = RoundedView{width: Fill height: Fit flow: Right spacing: 12 align: Align{y: 0.0}
    padding: Inset{top: 12 bottom: 12 left: 14 right: 14}
    new_batch: true show_bg: true draw_bg.color: #xffffff draw_bg.border_radius: 12.0
}
let CardText = StoryCard{text := StoryText{}}
let CardHead = StoryCard{text := StoryHead{}}
let CardTextImage = StoryCard{text := StoryText{} thumb := Image{width: 76 height: 76 fit: ImageFit.CropToFill}}
let CardHeadImage = StoryCard{text := StoryHead{} thumb := Image{width: 76 height: 76 fit: ImageFit.CropToFill}}

HostedView{width: Fill height: Fill
    full: View{width: Fill height: Fill flow: Overlay show_bg: true draw_bg.color: ground
        main := View{width: Fill height: Fill flow: Down
            View{width: Fill height: Fit flow: Right align: Align{y: 1.0} padding: Inset{left: 18 right: 12 top: 14 bottom: 6}
                View{width: Fill height: Fit flow: Down spacing: 2
                    date := Label{text: "" draw_text.color: secondary draw_text.text_style: theme.font_bold{font_size: 12}}
                    Label{text: "News" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 32}}
                }
                BarButton{text: "Refresh" on_click: || refresh()}
            }
            View{width: Fill height: Fit padding: Inset{left: 16 right: 16 bottom: 8}
                search := TextInput{width: Fill height: 36 empty_text: "Search stories"
                    on_change: |text| set_query(text)
                    draw_bg +: {color: #xe5e5ea color_hover: #xe5e5ea color_focus: #xe5e5ea color_empty: #xe5e5ea
                        border_color: #x00000000 border_color_hover: #x00000000 border_color_focus: #x00000000 border_color_empty: #x00000000
                        border_radius: 10.0}
                    draw_text +: {color: ink color_hover: ink color_focus: ink color_empty: secondary color_empty_hover: secondary}
                }
            }
            tabbar := ScrollXView{width: Fill height: 44 flow: Right spacing: 4 padding: Inset{left: 12 right: 12 top: 4 bottom: 8}
                on_render: || {
                    for t in tabs {
                        if t.id == tab { TabButtonActive{text: t.label on_click: || pick(t.id)} }
                        else { TabButton{text: t.label on_click: || pick(t.id)} }
                    }
                }
            }
            status := Label{width: Fill padding: Inset{left: 18 right: 18 bottom: 6} text: "" draw_text.color: secondary draw_text.text_style.font_size: 11}
            View{width: Fill height: Fit flow: Down padding: Inset{left: 18 right: 18 bottom: 8} spacing: 4
                BarButton{text: "Test Octos" on_click: || test_octos()}
                ScrollYView{width: Fill height: 58 flow: Down
                    octos_status := Label{width: Fill text: "Not tested. Select an assistant in Rinx, then click Test Octos."
                        draw_text.color: ink draw_text.text_style.font_size: 12}
                }
            }
            list := ScrollYView{width: Fill height: Fill flow: Down spacing: 10 padding: Inset{left: 12 right: 12 bottom: 24}
                on_render: || {
                    let rows = visible_rows()
                    if rows.len() == 0 {
                        View{width: Fill height: 200 align: Align{x: 0.5 y: 0.5}
                            Label{text: empty_text() draw_text.color: secondary draw_text.text_style.font_size: 13}
                        }
                    }
                    for r in rows {
                        GestureView{width: Fill height: Fit
                            on_tap: |x, y| open_story(r)
                            on_long_press: |x, y| toggle_save(r)
                            if r.image != "" && r.summary != "" {
                                CardTextImage{text.meta.text: meta(r) text.title.text: r.title text.summary.text: r.summary thumb.src: http_resource(r.image)}
                            } else if r.image != "" {
                                CardHeadImage{text.meta.text: meta(r) text.title.text: r.title thumb.src: http_resource(r.image)}
                            } else if r.summary != "" {
                                CardText{text.meta.text: meta(r) text.title.text: r.title text.summary.text: r.summary}
                            } else {
                                CardHead{text.meta.text: meta(r) text.title.text: r.title}
                            }
                        }
                    }
                }
            }
        }
        reader_pane := View{visible: false width: Fill height: Fill flow: Down new_batch: true show_bg: true draw_bg.color: #xffffff
            View{width: Fill height: 52 flow: Right align: Align{y: 0.5} padding: Inset{left: 4 right: 8} spacing: 4
                BarButton{text: "‹ News" on_click: || close_story()}
                reader_title := Label{width: Fill text: "" max_lines: 1 align: Align{x: 0.5}
                    draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 14}}
                comments := BarButton{text: "Comments" on_click: || open_comments()}
                save := BarButton{text: "Save" on_click: || { if reading != nil { toggle_save(reading) } }}
            }
            reader_fail := Label{width: Fill padding: Inset{left: 18 right: 18} text: "" draw_text.color: secondary draw_text.text_style.font_size: 12}
            reader_content := ScrollYView{width: Fill height: Fill flow: Down spacing: 14 padding: 18 on_render: || {
                if reading != nil {
                    Label{width: Fill text: reading.title draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 23}}
                    Label{width: Fill text: meta(reading) draw_text.color: secondary draw_text.text_style.font_size: 12}
                    reader_url := TextInput{width: Fill height: 44 text: reading.link
                        draw_text +: {color: ink color_hover: ink color_focus: ink}}
                    Label{width: Fill text: reading.link draw_text.color: secondary draw_text.text_style.font_size: 11}
                    Label{width: Fill text: reading.summary draw_text.color: ink draw_text.text_style.font_size: 15}
                    if reading.summary == "" { Label{width: Fill text: "This feed provides no article excerpt." draw_text.color: secondary} }
                }
            }}
        }
    }
    tile: View{width: Fill height: Fill flow: Down padding: Inset{left: 14 right: 14 top: 12 bottom: 12} spacing: 8
        new_batch: true show_bg: true draw_bg.color: #xffffff
        Label{text: "News" draw_text.color: accent draw_text.text_style: theme.font_bold{font_size: 13}}
        tile_list := View{width: Fill height: Fill flow: Down spacing: 8 on_render: || {
            let rows = today_rows()
            if rows.len() == 0 { Label{text: "Headlines appear here." draw_text.color: secondary draw_text.text_style.font_size: 12} }
            for i r in rows {
                if i < 3 {
                    View{width: Fill height: Fit flow: Down spacing: 1
                        Label{width: Fill text: r.source max_lines: 1 draw_text.color: secondary draw_text.text_style.font_size: 10}
                        Label{width: Fill text: r.title max_lines: 2 draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 13}}
                    }
                }
            }
        }}
    }
}
